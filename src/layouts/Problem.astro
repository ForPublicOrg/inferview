---
// Problem page. Renders the MDX body split at its fixed headings: the question, then the tool for the problem type
// (choices, code runner or estimate check), then hints, then the answer behind a reveal that opens on a correct attempt.
// Replay problems step through a timeline, multistage problems run in the LabRunner and repo problems in the CodeRunner
// with their files. Checklist types show their checklist once the answer is revealed; it rates the problem from the ticks.
import Base from './Base.astro';
import Choices from '../components/Choices.astro';
import CodeRunner from '../components/CodeRunner.astro';
import Checklist from '../components/Checklist.astro';
import Estimate from '../components/Estimate.astro';
import LabRunner from '../components/LabRunner.astro';
import Replay from '../components/Replay.astro';
import SelfRate from '../components/SelfRate.astro';
import { TRACKS, trackIndex, getModule } from '../data/tracks.ts';
import { isGradable, typeLabel } from '../lib/schemas.ts';
import { problems, problemUrl, problemKey, moduleUrl, trackUrl, formatDay, DIFF_LABEL, type Problem } from '../lib/content.ts';

interface Props {
  entry: Problem;
}
const { entry } = Astro.props;
const d = entry.data;
const tIdx = trackIndex(d.track);
const track = TRACKS[tIdx]!;
const mod = getModule(d.track, d.module);
const gradable = isGradable(d.type);
const key = problemKey(d.id);

const html = await Astro.slots.render('default');
const cut = (src: string, id: string): [string, string] => {
  const i = src.indexOf(`<h2 id="${id}"`);
  return i === -1 ? [src, ''] : [src.slice(0, i), src.slice(i)];
};
const [beforeAnswer, answerHtml] = cut(html, 'answer');
const [questionHtml, hintsHtml] = cut(beforeAnswer, 'hints');

const all = await problems();
const core = all.filter((p) => p.data.core);
const coreIdx = core.findIndex((p) => p.data.id === d.id);
const nextCore = coreIdx >= 0 ? core[coreIdx + 1] : core.find((p) => p.data.id > d.id);
const label = typeLabel(d.type);
const stages = d.type === 'multistage' && d.code && d.stages
  ? d.stages.map((s, i) => ({ ...s, starter: i === 0 ? d.code!.starter : undefined }))
  : [];
const repoTarget = d.type === 'repo' && d.code?.files && d.code.target ? d.code.target : undefined;
const revealLabel = gradable ? 'Show the answer without solving it (it will not count as solved)' : 'Show the answer';
const title = d.subtitle ? `${d.title}: ${d.subtitle}` : d.title;
---
<Base title={title} description={`${track.short} ${label.toLowerCase()} problem, ${d.difficulty}, about ${d.minutes} minutes.`} active="problems">
  <div class="wrap">
    <div class="problem-wrap" data-pagefind-body data-problem-id={d.id} data-gradable={gradable ? '1' : '0'}>
      <div class="crumb"><a href="/problems">Problems</a> / <a href={trackUrl(track.slug)}>Track {tIdx + 1}, {track.short}</a>{mod && <> / <a href={moduleUrl(track.slug, d.module)}>{mod.title}</a></>} / {label}</div>
      <h1 style="font-size: 32px; margin-top: 6px">{title}</h1>
      <div class="meta-tags">
        <span class:list={['tag', d.difficulty]}>{DIFF_LABEL[d.difficulty]}</span>
        <span class="tag">{label}</span>
        <span class="tag">{d.minutes} min</span>
        <span class="tag">{d.seniority.join(', ')}</span>
        {d.core && <span class="tag">Core 100</span>}
        {d.companies.map((c) => <a class="tag co" href={c.url} rel="noopener" title="Public source naming this company and topic">{c.name}</a>)}
        <span class="tag" data-status-tag hidden></span>
      </div>

      <div class="problem-body">
        <Fragment set:html={questionHtml} />

        {(d.type === 'mcq' || d.type === 'debug') && d.choices && (
          <Choices id={d.id} choices={d.choices} title={d.type === 'debug' ? 'Root cause' : 'Pick one'} gradable />
        )}
        {d.type === 'code' && d.code && (
          <CodeRunner id={d.id} starter={d.code.starter ?? ''} tests={d.code.tests ?? ''} hidden={d.code.hidden} solution={d.code.solution} />
        )}
        {repoTarget && d.code?.files && (
          <CodeRunner id={d.id} starter={d.code.files[repoTarget] ?? ''} tests={d.code.tests ?? ''} hidden={d.code.hidden} solution={d.code.solution} files={d.code.files} target={repoTarget} />
        )}
        {stages.length > 0 && <LabRunner slug={key} steps={stages} kind="multistage" problem={d.id} />}
        {d.type === 'replay' && d.replay && <Replay id={d.id} events={d.replay} />}
        {d.type === 'estimate' && d.range && <Estimate id={d.id} low={d.range.low} high={d.range.high} unit={d.range.unit} />}

        <Fragment set:html={hintsHtml} />

        {gradable && <p class="lockednote" data-locknote>The answer, the follow-ups and the common mistakes open here once you solve the problem.</p>}
        <details class="answer-region" data-answer-region>
          <summary class="btn">{revealLabel}</summary>
          {d.checklist && <Checklist id={key} items={d.checklist} />}
          <Fragment set:html={answerHtml} />
          {d.type === 'multistage' && d.code && (
            <details class="solution">
              <summary>Show the reference solution for every stage</summary>
              <pre><code>{d.code.solution}</code></pre>
            </details>
          )}
          {!d.checklist && <SelfRate id={key} title="How solid was your answer?" note="Rate yourself and this problem joins your review deck." doneAt={gradable ? 0 : 3} />}
          {d.sources.length > 0 && (
            <>
              <h2 id="sources">Sources</h2>
              <ol class="sources">
                {d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a>{s.note && <span>. {s.note}</span>}</li>)}
              </ol>
            </>
          )}
        </details>

        <div class="row" style="justify-content: space-between; margin-top: 24px">
          <span class="tiny">
            {nextCore ? <>Next in Core 100: <a href={problemUrl(nextCore.data.id)}>{nextCore.data.title}</a></> : 'Checked against sources ' + formatDay(d.updated) + '.'}
          </span>
          <a class="btn" href="/problems">Back to the catalog</a>
        </div>
        {nextCore && <p class="tiny" style="margin-top: 8px">Checked against sources {formatDay(d.updated)}.</p>}
      </div>
    </div>
  </div>
</Base>

<script>
  import { onProgress } from '../lib/progress.ts';

  const root = document.querySelector<HTMLElement>('[data-problem-id]');
  const region = document.querySelector<HTMLDetailsElement>('[data-answer-region]');
  const summary = region?.querySelector('summary');
  const tag = document.querySelector<HTMLElement>('[data-status-tag]');
  const id = root?.dataset.problemId ?? '';

  const lockNote = document.querySelector<HTMLElement>('[data-locknote]');
  const open = () => {
    if (!region) return;
    region.open = true;
    if (summary) summary.hidden = true;
    if (lockNote) lockNote.hidden = true;
  };
  document.addEventListener('inferview:reveal', (e) => {
    const detail = (e as CustomEvent<{ id: string; solved: boolean }>).detail;
    if (detail.id === id) open();
  });
  region?.addEventListener('toggle', () => {
    if (region.open) open();
  });
  onProgress((p) => {
    const item = p.items[`problem:${id}`];
    if (!tag) return;
    tag.hidden = !item;
    tag.textContent = item?.s === 'done' ? 'Solved' : 'Attempted';
  });
</script>
