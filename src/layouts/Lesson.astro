---
// Lesson page: table of contents, the lesson body, sources, next lesson, and the module sidebar for the track.
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import JsonData from '../components/JsonData.astro';
import { TRACKS, trackIndex } from '../data/tracks.ts';
import { lessons, lessonKey, lessonUrl, formatDay, type Lesson } from '../lib/content.ts';

interface Props {
  entry: Lesson;
  headings: MarkdownHeading[];
}
const { entry, headings } = Astro.props;
const d = entry.data;
const tIdx = trackIndex(d.track);
const track = TRACKS[tIdx]!;
const mIdx = track.modules.findIndex((m) => m.slug === d.module);
const all = await lessons();
const written = new Map(all.filter((l) => l.data.track === d.track).map((l) => [l.data.module, l]));
const toc = headings.filter((h) => h.depth === 2);
const nextModule = track.modules[mIdx + 1];
const nextLesson = nextModule ? written.get(nextModule.slug) : undefined;
const nextTrack = !nextModule ? TRACKS[tIdx + 1] : undefined;
const nextTrackFirst = nextTrack ? all.find((l) => l.data.track === nextTrack.slug && l.data.module === nextTrack.modules[0]?.slug) : undefined;
const key = lessonKey(entry);
const trackLessonKeys = [...written.values()].map((l) => lessonKey(l));
---
<Base title={d.title} description={d.summary} active="learn">
  <div class="wrap lesson-layout">
    <aside class="side" aria-label="On this page">
      <nav class="toc" data-toc>
        <div class="label" style="margin-bottom: 8px; padding-left: 12px">On this page</div>
        {toc.map((h, i) => <a href={`#${h.slug}`} class:list={{ on: i === 0 }}>{h.text}</a>)}
        <a href="#sources">Sources</a>
      </nav>
    </aside>

    <article class="lesson" data-pagefind-body data-lesson-key={key}>
      <div class="crumb">
        <a href={`/learn/${track.slug}`}>Track {tIdx + 1}, {track.short}</a> / Module {mIdx + 1}, {track.modules[mIdx]?.title}
      </div>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <div class="meta-tags">
        <span class="tag">{d.minutes} min</span>
        <span class="tag">Checked against sources {formatDay(d.updated)}</span>
      </div>

      <slot />

      <h2 id="sources">Sources</h2>
      <ol class="sources">
        {d.sources.map((s) => (
          <li><a href={s.url} rel="noopener">{s.title}</a>{s.note && <span>. {s.note}</span>}</li>
        ))}
      </ol>

      <div class="card next-card">
        {nextModule ? (
          <>
            <div class="label">Next in this track</div>
            <h3>{nextLesson ? <a href={lessonUrl(nextLesson)}>{nextLesson.data.title}</a> : nextModule.title}</h3>
            <p class="muted" style="font-size: 14px; margin: 0">
              {nextLesson ? nextLesson.data.summary : 'This lesson is not written yet. The track page lists what exists.'}
            </p>
          </>
        ) : nextTrack ? (
          <>
            <div class="label">Next track</div>
            <h3><a href={`/learn/${nextTrack.slug}`}>{nextTrack.title}</a></h3>
            <p class="muted" style="font-size: 14px; margin: 0">{nextTrackFirst ? nextTrackFirst.data.summary : nextTrack.blurb}</p>
          </>
        ) : (
          <>
            <div class="label">End of the path</div>
            <p class="muted" style="font-size: 14px; margin: 0">This is the last module. <a href="/review">Your review deck</a> is the next stop.</p>
          </>
        )}
      </div>
    </article>

    <aside class="side" aria-label="Modules in this track">
      <div class="card sticky">
        <div class="label" style="margin-bottom: 8px">Track {tIdx + 1}: {track.short}</div>
        <div class="progress" aria-hidden="true"><i data-track-progress style="width: 0%"></i></div>
        <div class="tiny" style="margin-top: 6px" data-track-progress-label></div>
        <ol>
          {track.modules.map((m) => {
            const l = written.get(m.slug);
            return (
              <li class:list={{ cur: m.slug === d.module }}>
                {l && m.slug !== d.module ? <a href={lessonUrl(l)}>{m.title}</a> : m.title}
                {!l && <span class="tiny"> (not written yet)</span>}
              </li>
            );
          })}
        </ol>
        <hr class="rule" />
        <a href={`/problems?track=${track.slug}`}>Problems in this track</a>
      </div>
    </aside>
  </div>
  <JsonData id="track-lesson-keys" data={trackLessonKeys} />
</Base>

<script>
  import { onProgress, markSeen } from '../lib/progress.ts';
  import { readJson } from '../lib/dom.ts';

  const article = document.querySelector<HTMLElement>('[data-lesson-key]');
  if (article?.dataset.lessonKey) markSeen(article.dataset.lessonKey);

  const keys = readJson<string[]>('track-lesson-keys', []);
  const bar = document.querySelector<HTMLElement>('[data-track-progress]');
  const label = document.querySelector<HTMLElement>('[data-track-progress-label]');
  onProgress((p) => {
    const done = keys.filter((k) => p.items[k]?.s === 'done').length;
    const pct = keys.length ? Math.round((done / keys.length) * 100) : 0;
    if (bar) bar.style.width = `${pct}%`;
    if (label) label.textContent = `${done} of ${keys.length} written lessons rated`;
  });

  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  const spy = () => {
    let cur = 0;
    heads.forEach((h, i) => {
      if (h && h.getBoundingClientRect().top < 120) cur = i;
    });
    links.forEach((a, i) => a.classList.toggle('on', i === cur));
  };
  addEventListener('scroll', spy, { passive: true });
  spy();
</script>
