---
// Lesson page: table of contents, the lesson body, sources, previous and next lesson inside the module, and a
// module sidebar listing the module's lessons in order with the reader's progress.
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import JsonData from '../components/JsonData.astro';
import { TRACKS, trackIndex } from '../data/tracks.ts';
import { lessons, moduleLessons, lessonKey, lessonUrl, moduleUrl, trackUrl, formatDay, LEVEL_LABEL, KIND_LABEL, type Lesson } from '../lib/content.ts';

interface Props {
  entry: Lesson;
  headings: MarkdownHeading[];
}
const { entry, headings } = Astro.props;
const d = entry.data;
const tIdx = trackIndex(d.track);
const track = TRACKS[tIdx]!;
const mIdx = track.modules.findIndex((m) => m.slug === d.module);
const mod = track.modules[mIdx]!;
const siblings = await moduleLessons(d.track, d.module);
const pos = siblings.findIndex((l) => l.id === entry.id);
const prev = siblings[pos - 1];
const next = siblings[pos + 1];
const toc = headings.filter((h) => h.depth === 2);
const key = lessonKey(entry);
const moduleKeys = siblings.map((l) => lessonKey(l));
const byRef = new Map((await lessons()).map((l) => [`${l.data.track}/${l.data.module}/${l.id.split('/').pop()}`, l]));
const prereqs = d.prerequisites.map((p) => byRef.get(p)).filter((l): l is Lesson => Boolean(l));
---
<Base title={d.title} description={d.summary} active="learn">
  <div class="wrap lesson-layout">
    <aside class="side" aria-label="On this page">
      <nav class="toc" data-toc>
        <div class="label" style="margin-bottom: 8px; padding-left: 12px">On this page</div>
        {toc.map((h, i) => <a href={`#${h.slug}`} class:list={{ on: i === 0 }}>{h.text}</a>)}
        <a href="#sources">Sources</a>
      </nav>
    </aside>

    <article class="lesson" data-pagefind-body data-lesson-key={key}>
      <div class="crumb">
        <a href={trackUrl(track.slug)}>Track {tIdx + 1}, {track.short}</a> / <a href={moduleUrl(track.slug, mod.slug)}>Module {mIdx + 1}, {mod.title}</a>
      </div>
      <h1>{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <div class="meta-tags">
        <span class="tag">{KIND_LABEL[d.kind]}</span>
        <span class="tag">{LEVEL_LABEL[d.level]}</span>
        <span class="tag">{d.minutes} min</span>
        <span class="tag">Checked against sources {formatDay(d.updated)}</span>
      </div>
      {prereqs.length > 0 && (
        <div class="tiny" style="margin: -12px 0 24px">Read first: {prereqs.map((p, i) => <>{i > 0 && ', '}<a href={lessonUrl(p)}>{p.data.title}</a></>)}</div>
      )}

      <slot />

      <h2 id="sources">Sources</h2>
      <ol class="sources">
        {d.sources.map((s) => (
          <li><a href={s.url} rel="noopener">{s.title}</a>{s.note && <span>. {s.note}</span>}</li>
        ))}
      </ol>

      <nav class="card next-card pager" aria-label="Lessons in this module">
        {prev && (
          <div>
            <div class="label">Previous in this module</div>
            <a href={lessonUrl(prev)}>{prev.data.title}</a>
          </div>
        )}
        {next && (
          <div>
            <div class="label">Next in this module</div>
            <a href={lessonUrl(next)}>{next.data.title}</a>
            <p class="muted" style="font-size: 14px; margin: 4px 0 0">{next.data.summary}</p>
          </div>
        )}
        <div>
          <div class="label">Module {mIdx + 1}</div>
          <a href={moduleUrl(track.slug, mod.slug)}>{mod.title}: lessons, problems and labs</a>
        </div>
      </nav>
    </article>

    <aside class="side" aria-label="Lessons in this module">
      <div class="card sticky">
        <div class="label" style="margin-bottom: 8px">Module {mIdx + 1}: {mod.title}</div>
        <div class="progress" aria-hidden="true"><i data-module-progress style="width: 0%"></i></div>
        <div class="tiny" style="margin-top: 6px" data-module-progress-label></div>
        <ol>
          {siblings.map((l) => (
            <li class:list={{ cur: l.id === entry.id }}>
              {l.id === entry.id ? <span aria-current="page">{l.data.title}</span> : <a href={lessonUrl(l)}>{l.data.title}</a>}
              <span class="tiny" data-lesson-state={lessonKey(l)}></span>
            </li>
          ))}
        </ol>
        <hr class="rule" />
        <a href={moduleUrl(track.slug, mod.slug)}>Module page</a>
      </div>
    </aside>
  </div>
  <JsonData id="module-lesson-keys" data={moduleKeys} />
</Base>

<script>
  import { onProgress, markSeen } from '../lib/progress.ts';
  import { readJson } from '../lib/dom.ts';

  const article = document.querySelector<HTMLElement>('[data-lesson-key]');
  if (article?.dataset.lessonKey) markSeen(article.dataset.lessonKey);

  const keys = readJson<string[]>('module-lesson-keys', []);
  const bar = document.querySelector<HTMLElement>('[data-module-progress]');
  const label = document.querySelector<HTMLElement>('[data-module-progress-label]');
  const states = [...document.querySelectorAll<HTMLElement>('[data-lesson-state]')];
  onProgress((p) => {
    const done = keys.filter((k) => p.items[k]?.s === 'done').length;
    const pct = keys.length ? Math.round((done / keys.length) * 100) : 0;
    if (bar) bar.style.width = `${pct}%`;
    if (label) label.textContent = `${done} of ${keys.length} ${keys.length === 1 ? 'lesson' : 'lessons'} rated`;
    for (const el of states) {
      const it = p.items[el.dataset.lessonState ?? ''];
      el.textContent = it?.s === 'done' ? ' (rated)' : it ? ' (opened)' : '';
    }
  });

  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a')];
  const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
  const spy = () => {
    let cur = 0;
    heads.forEach((h, i) => {
      if (h && h.getBoundingClientRect().top < 120) cur = i;
    });
    links.forEach((a, i) => a.classList.toggle('on', i === cur));
  };
  addEventListener('scroll', spy, { passive: true });
  spy();
</script>
