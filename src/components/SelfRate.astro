---
// Self-rating that schedules a review card. Props: id = "lesson:<track>/<slug>" or "problem:<id>"; title, note optional;
// doneAt = lowest rating that also marks the item done (default 1 for lessons, 0 = never for problems).
interface Props {
  id: string;
  title?: string;
  note?: string;
  doneAt?: 0 | 1 | 2 | 3 | 4;
}
const { id, title = 'How solid was your answer?', note = 'Rate yourself and this question joins your review deck.' } = Astro.props;
const doneAt = Astro.props.doneAt ?? (id.startsWith('lesson:') ? 1 : 0);
const ratings = [
  { r: 1, label: 'Blanked' },
  { r: 2, label: 'Shaky' },
  { r: 3, label: 'Solid' },
  { r: 4, label: 'Could teach it' },
];
---
<div class="widget" data-selfrate={id} data-done-at={doneAt} style="margin-top: 20px">
  <header><h4>{title}</h4><span class="tiny">sets when this comes back for review</span></header>
  <div class="rate" role="group" aria-label={title}>
    {ratings.map((x) => <button class="btn sm" type="button" data-r={x.r} aria-pressed="false">{x.label}</button>)}
  </div>
  <div class="tiny" data-msg aria-live="polite" style="margin-top: 10px">{note}</div>
</div>

<script>
  import { rate, getItem, onProgress, complete } from '../lib/progress.ts';
  import { localDate, intervalFrom, type Rating } from '../lib/schedule.ts';
  import { formatDate } from '../lib/daily.ts';

  document.querySelectorAll<HTMLElement>('[data-selfrate]').forEach((root) => {
    const key = root.dataset.selfrate ?? '';
    const msg = root.querySelector<HTMLElement>('[data-msg]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('button[data-r]')];
    const show = () => {
      const item = getItem(key);
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(item?.r === Number(b.dataset.r))));
      if (msg && item?.due) {
        const days = intervalFrom(localDate(), item.due);
        msg.textContent = days <= 0 ? 'Due for review today.' : `In your review deck. Next review in ${days} day${days === 1 ? '' : 's'}, on ${formatDate(item.due)}.`;
      }
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const r = Number(b.dataset.r) as Rating;
        rate(key, r);
        const doneAt = Number(root.dataset.doneAt ?? 0);
        if (doneAt && r >= doneAt && getItem(key)?.s !== 'done') complete(key, false);
        show();
      }),
    );
    onProgress(show);
  });
</script>
