---
// Site footer with links to the pages that exist and the licence line.
import { firebaseConfigured } from '../lib/firebase.ts';

const links = [
  { href: '/about', label: 'About' },
  { href: '/lists', label: 'Lists' },
  { href: '/contribute', label: 'Contribute' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/labs', label: 'Labs' },
  { href: '/teardowns', label: 'Teardowns' },
  { href: '/account', label: firebaseConfigured ? 'Account and data' : 'Your data' },
];
---
<footer>
  <div class="wrap">
    <span>Inferview. Code MIT, content CC BY-SA 4.0.</span>
    <nav aria-label="Footer">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>
