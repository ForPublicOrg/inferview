---
// RoPE frequency pairs under a context-stretching method. For a head dimension of 128 (64 rotating pairs) it shows,
// per pair, the wavelength in tokens, the per-token angle after scaling, and whether the angles reached at the new
// length were seen during training. Deterministic arithmetic, no randomness. Props: title, id (unique on the page).
// Formulas: theta_i = base^(-2i/d); PI divides every theta by s (arXiv 2306.15595); NTK-aware changes the base to
// base * s^(d/(d-2)) (as written in arXiv 2309.00071); YaRN by-parts ramps between alpha = 1 and beta = 32 rotations
// per trained window (arXiv 2309.00071); llama3 follows transformers' _compute_llama3_parameters with low_freq_factor 1
// and high_freq_factor 4.
interface Props {
  title?: string;
  id?: string;
}
const { title = 'RoPE pairs: what a stretching method does to each frequency', id = 'mlcrope' } = Astro.props;
const f = (k: string) => `${id}-${k}`;
---
<div class="widget mlcr" data-mlcr>
  <header><h4>{title}</h4><span class="tiny">head dimension 128, so 64 pairs; every figure is computed here</span></header>
  <div class="mlcr-grid">
    <label for={f('m')}>Model shape
      <select class="field" id={f('m')} data-k="m">
        <option value="10000:4096">Base 10,000, trained on 4,096 positions (Llama 2 shape)</option>
        <option value="500000:8192" selected>Base 500,000, trained on 8,192 positions (Llama 3.1 shape)</option>
      </select>
    </label>
    <label for={f('x')}>Method
      <select class="field" id={f('x')} data-k="x">
        <option value="none">No scaling (extrapolate)</option>
        <option value="pi">Position Interpolation</option>
        <option value="ntk">NTK-aware base change</option>
        <option value="yarn">YaRN by-parts</option>
        <option value="llama3" selected>llama3 rope_type</option>
      </select>
    </label>
    <label for={f('s')}>Factor s
      <select class="field" id={f('s')} data-k="s">
        <option value="2">2</option>
        <option value="4">4</option>
        <option value="8" selected>8</option>
        <option value="16">16</option>
      </select>
    </label>
  </div>
  <p class="tiny mlcr-note" data-head></p>
  <div class="tablewrap">
    <table class="mlcr-table">
      <thead>
        <tr>
          <th scope="col">pair i</th>
          <th scope="col">wavelength</th>
          <th scope="col">turns in trained window</th>
          <th scope="col">per-token angle kept</th>
          <th scope="col">angles at the new length</th>
        </tr>
      </thead>
      <tbody data-rows></tbody>
    </table>
  </div>
  <div class="kv mlcr-sum"><span>Pairs (of 64) whose per-token step shrank while they still wrap in the trained window</span><b data-lost></b></div>
  <div class="kv mlcr-sum"><span>Pairs (of 64) reaching angles never produced in training</span><b data-ood></b></div>
  <div class="kv mlcr-sum"><span>Attention logit multiplier</span><b data-temp></b></div>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style>
  .mlcr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 10px; }
  .mlcr-grid label { display: flex; flex-direction: column; gap: 6px; font-size: 13.5px; min-width: 0; }
  .mlcr-grid select { width: 100%; max-width: 100%; }
  .mlcr-note { margin: 4px 0 10px; }
  .mlcr-table td, .mlcr-table th { padding: 6px 8px; font-size: 13px; }
  .mlcr-table td { font-family: var(--mono); white-space: nowrap; }
  .mlcr-table td.bad { color: var(--accent); font-weight: 650; }
  .mlcr-sum { margin-top: 8px; gap: 12px; }
  .mlcr-sum span { min-width: 0; }
</style>

<script>
  const D = 128;
  const PAIRS = D / 2;
  const SHOW = [0, 8, 16, 24, 28, 30, 32, 36, 40, 48, 56, 63];
  const ALPHA = 1;
  const BETA = 32;

  const fmtInt = (x: number) => Math.round(x).toLocaleString('en-US');
  const fmt = (x: number, d = 2) => x.toLocaleString('en-US', { maximumFractionDigits: d, minimumFractionDigits: d });

  // Returns the scaled angular frequency of pair i.
  function scaled(method: string, base: number, L: number, s: number, i: number): number {
    const theta = Math.pow(base, (-2 * i) / D);
    const wave = (2 * Math.PI) / theta;
    if (method === 'pi') return theta / s;
    if (method === 'ntk') return Math.pow(base * Math.pow(s, D / (D - 2)), (-2 * i) / D);
    if (method === 'yarn') {
      const r = L / wave;
      const g = r < ALPHA ? 0 : r > BETA ? 1 : (r - ALPHA) / (BETA - ALPHA);
      return (1 - g) * (theta / s) + g * theta;
    }
    if (method === 'llama3') {
      const lowWave = L / 1;
      const highWave = L / 4;
      if (wave < highWave) return theta;
      if (wave > lowWave) return theta / s;
      const smooth = (L / wave - 1) / (4 - 1);
      return (1 - smooth) * (theta / s) + smooth * theta;
    }
    return theta;
  }

  function pair(method: string, base: number, L: number, s: number, i: number) {
    const theta = Math.pow(base, (-2 * i) / D);
    const wave = (2 * Math.PI) / theta;
    const t2 = scaled(method, base, L, s, i);
    const trainedMax = theta * L;
    const newMax = t2 * L * s;
    const wraps = trainedMax >= 2 * Math.PI;
    const ood = !wraps && newMax > trainedMax * (1 + 1e-9);
    const keep = t2 / theta;
    return { theta, wave, turns: L / wave, keep, wraps, ood, ratio: newMax / trainedMax };
  }

  function cell(tag: string, text: string, cls = ''): HTMLElement {
    const c = document.createElement(tag);
    c.textContent = text;
    if (cls) c.className = cls;
    return c;
  }

  document.querySelectorAll<HTMLElement>('[data-mlcr]').forEach((root) => {
    const sel = (k: string) => root.querySelector<HTMLSelectElement>(`[data-k="${k}"]`)!;
    const rows = root.querySelector<HTMLElement>('[data-rows]')!;

    const render = () => {
      const [b, l] = sel('m').value.split(':').map(Number) as [number, number];
      const method = sel('x').value;
      const s = Number(sel('s').value);
      const target = l * s;
      root.querySelector('[data-head]')!.textContent =
        `Trained on ${fmtInt(l)} positions, stretched by ${s} to ${fmtInt(target)}. A pair "wraps" when its wavelength is shorter than the trained window, so training already produced every angle it can take.`;

      rows.replaceChildren(
        ...SHOW.map((i) => {
          const p = pair(method, b, l, s, i);
          const tr = document.createElement('tr');
          const keep = p.keep > 0.9999 ? '1 (unchanged)' : `1/${fmt(1 / p.keep, 2)}`;
          let status = 'all seen (wraps)';
          let cls = '';
          if (!p.wraps) {
            status = p.ood ? `${fmt(p.ratio, 2)}x the trained range` : `inside (${fmt(p.ratio, 2)}x)`;
            cls = p.ood ? 'bad' : '';
          }
          tr.append(
            cell('th', String(i)),
            cell('td', `${fmtInt(p.wave)} tokens`),
            cell('td', fmt(p.turns, p.turns < 10 ? 3 : 1)),
            cell('td', keep, p.wraps && p.keep < 0.9999 ? 'bad' : ''),
            cell('td', status, cls),
          );
          return tr;
        }),
      );

      let lost = 0;
      let ood = 0;
      for (let i = 0; i < PAIRS; i++) {
        const p = pair(method, b, l, s, i);
        if (p.wraps && p.keep < 0.9999) lost++;
        if (p.ood) ood++;
      }
      root.querySelector('[data-lost]')!.textContent = String(lost);
      root.querySelector('[data-ood]')!.textContent = String(ood);
      const m = 0.1 * Math.log(s) + 1;
      root.querySelector('[data-temp]')!.textContent =
        method === 'yarn' ? `(0.1 ln ${s} + 1)^2 = ${fmt(m * m, 3)}` : 'none (YaRN only)';
      root.querySelector('[data-summary]')!.textContent =
        `${method}, factor ${s}: ${lost} pairs lose local resolution, ${ood} pairs reach unseen angles.`;
    };

    ['m', 'x', 's'].forEach((k) => sel(k).addEventListener('change', render));
    render();
  });
</script>
