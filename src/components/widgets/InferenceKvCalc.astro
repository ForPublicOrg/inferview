---
// KV cache and weight memory per GPU, plus the decode bandwidth floor. Props: title, id (unique on the page).
// Model configs: Llama 3 paper Table 3 and the Qwen3-32B config.json. GPU specs: NVIDIA product pages.
interface Props {
  title?: string;
  id?: string;
}
const { title = 'KV cache and memory calculator', id = 'kvcalc' } = Astro.props;
const f = (k: string) => `${id}-${k}`;
---
<div class="widget ikv" data-ikv>
  <header><h4>{title}</h4><span class="tiny">bandwidth model, upper bounds, not measurements</span></header>
  <div class="ikv-grid">
    <label for={f('model')}>Model
      <select id={f('model')} data-k="model">
        <option value="8b">Llama 3 8B (32 layers, 8 KV heads)</option>
        <option value="70b" selected>Llama 3 70B (80 layers, 8 KV heads)</option>
        <option value="70mha">Llama 3 70B if it had 64 KV heads</option>
        <option value="405b">Llama 3 405B (126 layers, 8 KV heads)</option>
        <option value="q32">Qwen3-32B (64 layers, 8 KV heads)</option>
      </select>
    </label>
    <label for={f('gpu')}>GPU
      <select id={f('gpu')} data-k="gpu">
        <option value="h100">H100 SXM, 80 GB, 3.35 TB/s</option>
        <option value="h200">H200, 141 GB, 4.8 TB/s</option>
        <option value="b200">B200 in a DGX B200, 180 GB, 8 TB/s</option>
      </select>
    </label>
    <label for={f('n')}>GPUs (tensor parallel)
      <select id={f('n')} data-k="n"><option>1</option><option selected>2</option><option>4</option><option>8</option></select>
    </label>
    <label for={f('wfmt')}>Weights
      <select id={f('wfmt')} data-k="wfmt">
        <option value="16">BF16 (16 bits)</option>
        <option value="8" selected>FP8 (8 bits)</option>
        <option value="4.5">GGUF Q4_K (4.5 bits)</option>
      </select>
    </label>
    <label for={f('kvfmt')}>KV cache
      <select id={f('kvfmt')} data-k="kvfmt"><option value="2">BF16 (2 bytes)</option><option value="1">FP8 (1 byte)</option></select>
    </label>
    <label for={f('ctx')}>Context per sequence
      <select id={f('ctx')} data-k="ctx">
        <option value="1024">1,024</option><option value="4096">4,096</option><option value="8192">8,192</option>
        <option value="32768" selected>32,768</option><option value="131072">131,072</option>
      </select>
    </label>
    <label for={f('batch')} class="ikv-wide">Concurrent sequences <b class="mono" data-bv>8</b>
      <input type="range" id={f('batch')} min="1" max="128" step="1" value="8" data-k="batch" />
    </label>
  </div>
  <div class="ikv-bar" aria-hidden="true"><span class="w" data-barw></span><span class="k" data-bark></span></div>
  <p class="tiny ikv-legend"><span class="sw w"></span>weights <span class="sw k"></span>KV cache, as a share of one GPU's memory</p>
  <div class="gauges">
    <div><b data-o="kvtok"></b><span>KV bytes per token</span></div>
    <div><b data-o="pergpu"></b><span>memory per GPU</span></div>
    <div><b data-o="step"></b><span>decode step, at least</span></div>
    <div><b data-o="tps"></b><span>tokens/s per user, at most</span></div>
  </div>
  <p class="tiny" data-o="note"></p>
  <p class="sr-only" aria-live="polite" data-o="live"></p>
</div>

<style>
  .ikv-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 14px; }
  @media (max-width: 700px) { .ikv-grid { grid-template-columns: minmax(0, 1fr); } }
  .ikv-grid label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--ink-2); min-width: 0; }
  .ikv-grid .ikv-wide { grid-column: 1 / -1; }
  .ikv-grid select { font: inherit; font-size: 14px; padding: 8px 10px; min-height: 44px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); max-width: 100%; }
  .ikv-bar { display: flex; height: 18px; border-radius: 6px; background: var(--bg-2); overflow: hidden; margin-top: 14px; border: 1px solid var(--line); }
  .ikv-bar span { display: block; height: 100%; transition: width .2s ease; }
  .ikv-bar .w, .ikv-legend .w { background: var(--ink-3); }
  .ikv-bar .k, .ikv-legend .k { background: var(--accent); }
  .ikv-bar.over { border-color: var(--rose); box-shadow: inset 0 0 0 1px var(--rose); }
  .ikv-legend { margin: 6px 0 0; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .ikv-legend .sw { display: inline-block; width: 12px; height: 12px; border-radius: 3px; }
  @media (prefers-reduced-motion: reduce) { .ikv-bar span { transition: none; } }
</style>

<script>
  type Model = { layers: number; kvHeads: number; headDim: number; params: number; name: string };
  const MODELS: Record<string, Model> = {
    '8b': { layers: 32, kvHeads: 8, headDim: 128, params: 8e9, name: 'Llama 3 8B' },
    '70b': { layers: 80, kvHeads: 8, headDim: 128, params: 70e9, name: 'Llama 3 70B' },
    '70mha': { layers: 80, kvHeads: 64, headDim: 128, params: 70e9, name: 'Llama 3 70B with 64 KV heads' },
    '405b': { layers: 126, kvHeads: 8, headDim: 128, params: 405e9, name: 'Llama 3 405B' },
    q32: { layers: 64, kvHeads: 8, headDim: 128, params: 32e9, name: 'Qwen3-32B' },
  };
  const GPUS: Record<string, { mem: number; bw: number }> = {
    h100: { mem: 80e9, bw: 3.35e12 },
    h200: { mem: 141e9, bw: 4.8e12 },
    b200: { mem: 180e9, bw: 8e12 },
  };
  const gb = (b: number) => `${(b / 1e9).toFixed(1)} GB`;

  document.querySelectorAll<HTMLElement>('[data-ikv]').forEach((root) => {
    const val = (k: string) => root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-k="${k}"]`)!.value;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const render = () => {
      const m = MODELS[val('model')]!;
      const g = GPUS[val('gpu')]!;
      const n = Number(val('n'));
      const ctx = Number(val('ctx'));
      const batch = Number(val('batch'));
      const kvBytes = Number(val('kvfmt'));
      const kvTok = 2 * m.layers * m.kvHeads * m.headDim * kvBytes;
      const weights = (m.params * Number(val('wfmt'))) / 8;
      const kv = kvTok * ctx * batch;
      const perGpu = (weights + kv) / n;
      const fits = perGpu <= g.mem;
      // Each GPU reads its shard of the weights and the KV cache once per decode step; communication is ignored.
      const step = perGpu / g.bw;
      root.querySelector('[data-bv]')!.textContent = String(batch);
      out('kvtok').textContent = `${(kvTok / 1024).toLocaleString('en-US')} KiB`;
      out('pergpu').textContent = `${gb(perGpu)} of ${g.mem / 1e9}`;
      out('pergpu').classList.toggle('bad', !fits);
      out('step').textContent = fits ? `${(step * 1e3).toFixed(1)} ms` : 'does not fit';
      out('tps').textContent = fits ? `${(1 / step).toFixed(0)} (total ${(batch / step).toFixed(0)})` : 'n/a';
      const share = (x: number) => `${Math.min(100, (x / n / g.mem) * 100).toFixed(1)}%`;
      root.querySelector<HTMLElement>('[data-barw]')!.style.width = share(weights);
      root.querySelector<HTMLElement>('[data-bark]')!.style.width = share(Math.min(kv, Math.max(0, g.mem * n - weights)));
      root.querySelector('.ikv-bar')!.classList.toggle('over', !fits);
      out('note').textContent =
        `Weights ${gb(weights)} and KV cache ${gb(kv)} in total, split evenly across ${n} GPU${n > 1 ? 's' : ''}. ` +
        'Every sequence is assumed to be at full context. Activations, CUDA graphs and runtime overhead are not counted, so real headroom is smaller.';
      out('live').textContent = fits
        ? `${m.name}: ${gb(perGpu)} per GPU, decode step at least ${(step * 1e3).toFixed(1)} milliseconds.`
        : `${m.name}: ${gb(perGpu)} per GPU, more than the ${g.mem / 1e9} GB available.`;
    };
    root.querySelectorAll('[data-k]').forEach((el) => {
      el.addEventListener('input', render);
      el.addEventListener('change', render);
    });
    render();
  });
</script>
