---
// Code multi-agent trace excerpts against MAST's three failure categories. Each excerpt takes one pick; the first pick
// counts, then the key's failure mode and reason appear. A tally compares the reader's codes with the key, which is
// Inferview's own coding of constructed excerpts, not the paper's annotations.
interface Trace {
  lines: string[];
  cat: 1 | 2 | 3;
  mode: string;
  why: string;
}
interface Props {
  traces: Trace[];
  title?: string;
}
const { traces, title = 'Code the traces' } = Astro.props;
const CATS = ['System design', 'Inter-agent misalignment', 'Task verification'];
for (const t of traces) if (![1, 2, 3].includes(t.cat)) throw new Error(`MAST coder: category must be 1, 2 or 3, found ${t.cat}.`);
---
<div class="widget" data-mastcoder data-total={traces.length}>
  <header><h4>{title}</h4><span class="tiny">first pick counts; key is Inferview's coding</span></header>
  {traces.map((t, i) => (
    <section class="mc-item" data-item={i} data-cat={t.cat} aria-labelledby={`mc-h-${i}`}>
      <p class="mc-h" id={`mc-h-${i}`}>Excerpt {i + 1}</p>
      <ol class="mc-lines">
        {t.lines.map((l) => <li>{l}</li>)}
      </ol>
      <div class="mc-picks" role="group" aria-label={`Category for excerpt ${i + 1}`}>
        {CATS.map((c, k) => (
          <button type="button" class="btn sm" data-pick={k + 1} aria-pressed="false">FC{k + 1} {c}</button>
        ))}
      </div>
      <p class="mc-why" data-why hidden>
        <b data-verdict></b> Key: FC{t.cat} {CATS[t.cat - 1]}, {t.mode}. {t.why}
      </p>
    </section>
  ))}
  <div class="kv" style="margin-top: 12px">
    <span>codes that match the key</span>
    <b data-tally aria-live="polite">0 of 0 coded</b>
  </div>
  <button type="button" class="btn sm" data-reset style="margin-top: 8px">Clear picks</button>
</div>

<style>
  .mc-item { border-top: 1px solid var(--line); padding: 12px 0; min-width: 0; }
  .mc-h { font-size: 13px; font-weight: 600; margin: 0 0 6px; }
  .mc-lines { margin: 0 0 10px; padding-left: 20px; font-family: var(--mono); font-size: 12.5px; color: var(--ink-2); }
  .mc-lines li { overflow-wrap: anywhere; margin-bottom: 4px; }
  .mc-picks { display: flex; flex-wrap: wrap; gap: 6px; }
  .mc-picks .btn { white-space: normal; text-align: left; }
  .mc-picks .btn.right { border-color: var(--mint); box-shadow: inset 0 0 0 1px var(--mint); }
  .mc-picks .btn.wrong { border-color: var(--rose); box-shadow: inset 0 0 0 1px var(--rose); }
  .mc-why { margin: 10px 0 0; padding: 10px 12px; border-radius: 8px; background: var(--bg-2); font-size: 14px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mastcoder]').forEach((root) => {
    const total = Number(root.dataset.total ?? 0);
    const items = [...root.querySelectorAll<HTMLElement>('[data-item]')];
    const tally = root.querySelector<HTMLElement>('[data-tally]')!;
    const picks = new Map<number, number>();

    const renderTally = () => {
      let match = 0;
      picks.forEach((p, i) => {
        if (String(p) === items[i]?.dataset.cat) match += 1;
      });
      tally.textContent = `${match} of ${picks.size} coded${picks.size === total ? ', all excerpts done' : ''}`;
    };

    items.forEach((item, i) => {
      const buttons = [...item.querySelectorAll<HTMLButtonElement>('[data-pick]')];
      const why = item.querySelector<HTMLElement>('[data-why]')!;
      const verdict = item.querySelector<HTMLElement>('[data-verdict]')!;
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          if (picks.has(i)) return;
          const pick = Number(b.dataset.pick);
          const ok = String(pick) === item.dataset.cat;
          picks.set(i, pick);
          b.classList.add(ok ? 'right' : 'wrong');
          b.setAttribute('aria-pressed', 'true');
          buttons.forEach((x) => (x.disabled = true));
          verdict.textContent = ok ? 'Matches the key.' : 'Differs from the key.';
          why.hidden = false;
          renderTally();
        }),
      );
    });

    root.querySelector<HTMLButtonElement>('[data-reset]')!.addEventListener('click', () => {
      picks.clear();
      items.forEach((item) => {
        item.querySelectorAll<HTMLButtonElement>('[data-pick]').forEach((b) => {
          b.disabled = false;
          b.classList.remove('right', 'wrong');
          b.setAttribute('aria-pressed', 'false');
        });
        item.querySelector<HTMLElement>('[data-why]')!.hidden = true;
      });
      renderTally();
    });

    renderTally();
  });
</script>
