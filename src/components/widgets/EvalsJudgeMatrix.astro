---
// Judge-alignment sheet: 100 labelled traces, the human says pass or fail, the judge says pass or fail. Sliders set how many
// traces really fail, how many of those the judge catches, and how many good traces it wrongly fails. Shows the confusion
// matrix, raw agreement, TPR, TNR, Cohen's kappa and the pass rate each side reports. Convention: "positive" = a failure.
interface Props {
  title?: string;
}
const { title = 'Judge alignment on 100 labelled traces' } = Astro.props;
const uid = 'jm';
---
<div class="widget" data-judgematrix>
  <header>
    <h4>{title}</h4>
    <div class="row" style="gap: 6px">
      <button class="btn sm" type="button" data-preset="10,0,0">Judge that always passes</button>
      <button class="btn sm" type="button" data-preset="10,8,6">A useful judge</button>
    </div>
  </header>
  <div class="row">
    <label class="jm-l" for={`${uid}-f`}>traces that really fail <b class="mono" data-fv></b>
      <input type="range" id={`${uid}-f`} min="1" max="50" step="1" value="10" data-f />
    </label>
    <label class="jm-l" for={`${uid}-c`}>failures the judge catches <b class="mono" data-cv></b>
      <input type="range" id={`${uid}-c`} min="0" max="10" step="1" value="8" data-c />
    </label>
    <label class="jm-l" for={`${uid}-w`}>good traces the judge fails <b class="mono" data-wv></b>
      <input type="range" id={`${uid}-w`} min="0" max="90" step="1" value="6" data-w />
    </label>
  </div>
  <div class="tablewrap" style="margin-top: 12px">
    <table class="jm-t">
      <caption class="sr-only">Confusion matrix, human label by judge verdict</caption>
      <thead><tr><th scope="col">human says</th><th scope="col">judge: fail</th><th scope="col">judge: pass</th></tr></thead>
      <tbody>
        <tr><th scope="row">fail</th><td data-tp></td><td data-fn></td></tr>
        <tr><th scope="row">pass</th><td data-fp></td><td data-tn></td></tr>
      </tbody>
    </table>
  </div>
  <div class="gauges">
    <div><b data-agree></b><span>raw agreement</span></div>
    <div><b data-tpr></b><span>TPR: failures caught</span></div>
    <div><b data-tnr></b><span>TNR: good traces passed</span></div>
    <div><b data-kappa></b><span>Cohen's kappa</span></div>
  </div>
  <div class="kv"><span>pass rate by human labels</span><b data-hp></b></div>
  <div class="kv"><span>pass rate the judge reports</span><b data-jp></b></div>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style>
  .jm-l { flex: 1; font-size: 13px; min-width: 150px; }
  .jm-t { border-collapse: collapse; font-size: 14px; width: 100%; max-width: 420px; }
  .jm-t th, .jm-t td { border: 1px solid var(--line); padding: 6px 10px; text-align: center; }
  .jm-t td { font-family: var(--mono); }
  .jm-t thead th { font-weight: 600; color: var(--ink-3); font-size: 12.5px; }
</style>

<script>
  const pct = (x: number) => (Number.isFinite(x) ? `${(x * 100).toFixed(1)}%` : 'n/a');

  document.querySelectorAll<HTMLElement>('[data-judgematrix]').forEach((root) => {
    const N = 100;
    const f = root.querySelector<HTMLInputElement>('[data-f]')!;
    const c = root.querySelector<HTMLInputElement>('[data-c]')!;
    const w = root.querySelector<HTMLInputElement>('[data-w]')!;
    const set = (sel: string, v: string) => (root.querySelector(sel)!.textContent = v);

    const render = () => {
      const F = Number(f.value);
      c.max = String(F);
      w.max = String(N - F);
      const tp = Math.min(Number(c.value), F);
      const fp = Math.min(Number(w.value), N - F);
      const fn = F - tp;
      const tn = N - F - fp;
      const agree = (tp + tn) / N;
      const tpr = tp / F;
      const tnr = tn / (N - F);
      const pH = F / N;
      const pJ = (tp + fp) / N;
      const pe = pH * pJ + (1 - pH) * (1 - pJ);
      const kappa = pe < 1 ? (agree - pe) / (1 - pe) : NaN;
      set('[data-fv]', String(F));
      set('[data-cv]', `${tp} of ${F}`);
      set('[data-wv]', `${fp} of ${N - F}`);
      set('[data-tp]', String(tp));
      set('[data-fn]', String(fn));
      set('[data-fp]', String(fp));
      set('[data-tn]', String(tn));
      set('[data-agree]', pct(agree));
      set('[data-tpr]', pct(tpr));
      set('[data-tnr]', pct(tnr));
      set('[data-kappa]', Number.isFinite(kappa) ? kappa.toFixed(3) : 'n/a');
      set('[data-hp]', pct(1 - pH));
      set('[data-jp]', pct(1 - pJ));
      root.querySelector('[data-agree]')!.classList.toggle('bad', agree >= 0.85 && tpr < 0.5);
      root.querySelector('[data-tpr]')!.classList.toggle('bad', tpr < 0.5);
      set(
        '[data-summary]',
        `Agreement ${pct(agree)}, judge catches ${tp} of ${F} failures, kappa ${Number.isFinite(kappa) ? kappa.toFixed(2) : 'undefined'}.`,
      );
    };

    [f, c, w].forEach((el) => el.addEventListener('input', render));
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) =>
      b.addEventListener('click', () => {
        const [F, C, W] = (b.dataset.preset ?? '10,0,0').split(',').map(Number);
        f.value = String(F);
        c.max = String(F);
        w.max = String(100 - F!);
        c.value = String(C);
        w.value = String(W);
        render();
      }),
    );
    render();
  });
</script>
