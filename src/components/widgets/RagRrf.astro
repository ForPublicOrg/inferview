---
// Reciprocal rank fusion blender. Two ranked lists (lexical and dense, best first) are fused with
// score(d) = sum of w / (k + rank); the reader moves k and the dense weight and watches the fused order change.
// Props: lexical, dense (document labels, best first), title.
interface Props {
  lexical?: string[];
  dense?: string[];
  title?: string;
}
const {
  lexical = ['E1234 runbook', 'Payment timeouts', 'Checkout FAQ', 'Error code index', 'Release notes 4.2'],
  dense = ['Checkout latency postmortem', 'Payment timeouts', 'Checkout FAQ', 'Cart abandonment report', 'E1234 runbook'],
  title = 'RRF blender',
} = Astro.props;
---
<div class="widget" data-ragrrf data-lexical={JSON.stringify(lexical)} data-dense={JSON.stringify(dense)}>
  <header><h4>{title}</h4><button class="btn sm" type="button" data-reset>Reset to k = 60, equal weights</button></header>
  <p class="tiny" style="margin-top: 0">Query: "E1234 timeout at checkout". Lexical weight is fixed at 1.</p>
  <div class="split" style="margin-top: 0">
    <div>
      <div class="label" style="margin-bottom: 6px">Lexical (BM25) ranking</div>
      <ol class="rr-list">{lexical.map((d) => <li>{d}</li>)}</ol>
    </div>
    <div>
      <div class="label" style="margin-bottom: 6px">Dense ranking</div>
      <ol class="rr-list">{dense.map((d) => <li>{d}</li>)}</ol>
    </div>
  </div>
  <div style="margin-top: 14px">
    <label class="kv" for="rr-k"><span>rank constant k</span><b data-k-out>60</b></label>
    <input type="range" id="rr-k" min="1" max="100" step="1" value="60" data-k />
    <label class="kv" for="rr-w"><span>dense weight</span><b data-w-out>1.00</b></label>
    <input type="range" id="rr-w" min="0" max="3" step="0.25" value="1" data-w />
  </div>
  <div class="label" style="margin: 12px 0 6px">Fused ranking</div>
  <ol class="rr-fused" data-fused aria-live="polite"></ol>
  <p class="tiny" style="margin: 8px 0 0">A dash means the document is absent from that list and adds nothing. Ties break alphabetically.</p>
</div>

<style is:global>
  [data-ragrrf] .kv b { white-space: nowrap; }
  .rr-list { margin: 0; padding-left: 22px; font-size: 14px; }
  .rr-list li { overflow-wrap: anywhere; }
  .rr-fused { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .rr-fused li { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; font-size: 14px; }
  .rr-fused .n { font-family: var(--mono); color: var(--ink-3); width: 18px; }
  .rr-fused .d { flex: 1; min-width: 140px; font-weight: 600; overflow-wrap: anywhere; }
  .rr-fused .r { font-family: var(--mono); font-size: 12.5px; color: var(--ink-2); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-ragrrf]').forEach((root) => {
    const lexical = JSON.parse(root.dataset.lexical ?? '[]') as string[];
    const dense = JSON.parse(root.dataset.dense ?? '[]') as string[];
    const kIn = root.querySelector<HTMLInputElement>('[data-k]')!;
    const wIn = root.querySelector<HTMLInputElement>('[data-w]')!;
    const kOut = root.querySelector<HTMLElement>('[data-k-out]')!;
    const wOut = root.querySelector<HTMLElement>('[data-w-out]')!;
    const list = root.querySelector<HTMLElement>('[data-fused]')!;

    const render = () => {
      const k = Number(kIn.value);
      const w = Number(wIn.value);
      kOut.textContent = String(k);
      wOut.textContent = w.toFixed(2);
      const docs = [...new Set([...lexical, ...dense])];
      const rows = docs.map((d) => {
        const lr = lexical.indexOf(d) + 1;
        const dr = dense.indexOf(d) + 1;
        const score = (lr ? 1 / (k + lr) : 0) + (dr ? w / (k + dr) : 0);
        return { d, lr, dr, score };
      });
      rows.sort((a, b) => b.score - a.score || a.d.localeCompare(b.d));
      list.replaceChildren();
      rows.forEach((r, i) => {
        const li = document.createElement('li');
        const n = document.createElement('span');
        n.className = 'n';
        n.textContent = String(i + 1);
        const d = document.createElement('span');
        d.className = 'd';
        d.textContent = r.d;
        const meta = document.createElement('span');
        meta.className = 'r';
        meta.textContent = `BM25 ${r.lr ? '#' + r.lr : '-'}, dense ${r.dr ? '#' + r.dr : '-'}, score ${r.score.toFixed(4)}`;
        li.append(n, d, meta);
        list.append(li);
      });
    };

    kIn.addEventListener('input', render);
    wIn.addEventListener('input', render);
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      kIn.value = '60';
      wIn.value = '1';
      render();
    });
    render();
  });
</script>
