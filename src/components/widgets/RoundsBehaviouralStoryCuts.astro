---
// Story cuts: the two-minute and five-minute versions of one story plus its deep-dive appendix, timed at the reader's own
// measured speaking rate, with plain-text checks for the evidence a staff story carries. Nothing is stored or sent.
// Deterministic: no randomness; the only clock is the reader's own stopwatch. The checks are this site's choice.
interface Props {
  title?: string;
}
const { title = 'Cut one story three ways' } = Astro.props;
const uid = `cuts-${title.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
const parts = [
  { key: 'short', label: 'Two-minute cut', target: 120, rows: 6, hint: 'Scope, the decision and what you rejected, the number against its baseline, who else had to change, what went wrong.' },
  { key: 'mid', label: 'Five-minute cut', target: 300, rows: 8, hint: 'Adds how you knew, the other side stated fairly, the cost you accepted and what happened after.' },
  { key: 'deep', label: 'Deep-dive appendix (never recited)', target: 0, rows: 6, hint: 'Dates, sizes, metric definitions, the rollout, who disagreed, what would reverse the decision today.' },
];
---
<div class="widget cuts" data-cuts>
  <header><h4>{title}</h4><span class="tiny">nothing you type is saved or leaves this page</span></header>
  {parts.map((p) => (
    <label class="cuts-l" for={`${uid}-${p.key}`}>
      <span class="cuts-name">{p.label}</span>
      <span class="tiny">{p.hint}</span>
      <textarea id={`${uid}-${p.key}`} rows={p.rows} data-part={p.key} data-target={p.target}></textarea>
      <span class="tiny" data-len={p.key}></span>
    </label>
  ))}
  <div class="cuts-rate">
    <p class="cuts-name">Your speaking rate</p>
    <p class="tiny">Press Start, read the two-minute cut aloud at interview pace, press Stop. The rate is its word count over the time you took. You can also type a rate you measured before.</p>
    <div class="row">
      <button class="btn sm" type="button" data-sw aria-pressed="false">Start</button>
      <span role="timer" class="cuts-clock" data-clock>0:00</span>
      <label class="tiny" for={`${uid}-rate`}>words per minute</label>
      <input type="number" id={`${uid}-rate`} min="40" max="400" step="1" inputmode="numeric" style="width: 90px" data-rate />
    </div>
  </div>
  <div class="row" style="margin-top: 10px">
    <button class="btn sm primary" type="button" data-check>Check the cuts</button>
  </div>
  <div class="reveal" data-out aria-live="polite">
    <p data-summary style="font-weight: 650"></p>
    <ul class="cuts-findings" data-findings></ul>
    <p class="tiny" style="margin: 6px 0 0">These are word matches, not a judgement of the story. A cut can pass every check and still be vague; tell it to a colleague who will interrupt.</p>
  </div>
</div>

<style is:global>
  .cuts .cuts-l { display: flex; flex-direction: column; gap: 4px; min-width: 0; margin-bottom: 12px; }
  .cuts .cuts-l textarea { width: 100%; max-width: 100%; box-sizing: border-box; font: inherit; font-size: 14px; }
  .cuts .cuts-name { font-size: 14px; font-weight: 650; margin: 0; }
  .cuts .cuts-rate p { margin: 0 0 6px; }
  .cuts .row { flex-wrap: wrap; align-items: center; }
  .cuts .cuts-clock { font-variant-numeric: tabular-nums; min-width: 3.5em; }
  .cuts .cuts-findings { margin: 6px 0 0; padding-left: 20px; }
  .widget .cuts-findings li { font-size: 14px; margin-bottom: 6px; font-family: var(--font); overflow-wrap: anywhere; }
</style>

<script>
  const words = (s: string) => s.trim().split(/\s+/).filter(Boolean).length;
  const count = (s: string, re: RegExp) => (s.match(re) ?? []).length;
  const clock = (sec: number) => { const t = Math.round(sec); return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`; };

  // Evidence markers for the two-minute cut. Each is a crude word match.
  const MARKERS: [RegExp, string][] = [
    [/\d/, 'No number. Name the metric, its baseline and how it was measured.'],
    [/\b(instead|rather than|rejected|considered|alternative|option|chose|trade-?off)\b/i, 'No alternative you rejected. Name one and the reason it lost.'],
    [/\b(other teams?|teams|legal|security|compliance|product|partners?|customers?|leadership|VP|director|counsel|platform|infra\w*)\b/i, 'No one outside your own team appears. Name the role that had to change its plans.'],
    [/\b(adopt\w*|used by|using it|rolled out|migrat\w*|in production|after launch|weeks? later|months? later|deprecat\w*)\b/i, 'Nothing after the launch. Say who used it and what changed when they did not.'],
    [/\b(cost|failed|fail\w*|broke|regress\w*|wrong|roll(ed)? back|rollback|delay\w*|missed|overruled)\b/i, 'Nothing went wrong or cost anything. Name the cost you accepted or the failure you fixed.'],
  ];

  document.querySelectorAll<HTMLElement>('[data-cuts]').forEach((root) => {
    const field = (k: string) => root.querySelector<HTMLTextAreaElement>(`[data-part="${k}"]`)!;
    const lenOut = (k: string) => root.querySelector<HTMLElement>(`[data-len="${k}"]`)!;
    const rate = root.querySelector<HTMLInputElement>('[data-rate]')!;
    const sw = root.querySelector<HTMLButtonElement>('[data-sw]')!;
    const clockEl = root.querySelector<HTMLElement>('[data-clock]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const list = root.querySelector<HTMLUListElement>('[data-findings]')!;

    const showLengths = () => {
      const wpm = Number(rate.value);
      ['short', 'mid', 'deep'].forEach((k) => {
        const n = words(field(k).value);
        const target = Number(field(k).dataset.target);
        let text = n ? `${n} words` : '';
        if (n && wpm > 0) text += `, about ${clock((n / wpm) * 60)} spoken`;
        if (target && wpm > 0) text += `; budget at your rate ${Math.floor((wpm * target) / 60)} words`;
        lenOut(k).textContent = text;
      });
    };
    ['short', 'mid', 'deep'].forEach((k) => field(k).addEventListener('input', showLengths));
    rate.addEventListener('input', showLengths);

    let start = 0;
    let timer = 0;
    sw.addEventListener('click', () => {
      if (!start) {
        start = performance.now();
        sw.textContent = 'Stop';
        sw.setAttribute('aria-pressed', 'true');
        timer = window.setInterval(() => { clockEl.textContent = clock((performance.now() - start) / 1000); }, 250);
        return;
      }
      const sec = (performance.now() - start) / 1000;
      window.clearInterval(timer);
      start = 0;
      sw.textContent = 'Start';
      sw.setAttribute('aria-pressed', 'false');
      clockEl.textContent = clock(sec);
      const n = words(field('short').value);
      if (n && sec >= 5) rate.value = String(Math.round((n * 60) / sec));
      showLengths();
    });

    root.querySelector<HTMLButtonElement>('[data-check]')!.addEventListener('click', () => {
      const s = field('short').value;
      const m = field('mid').value;
      const d = field('deep').value;
      const wpm = Number(rate.value);
      const findings: string[] = [];
      if (!s.trim()) findings.push('Write the two-minute cut first; the other checks depend on it.');
      if (!(wpm > 0)) findings.push('Measure or type your speaking rate; the timings depend on it.');
      const cuts: [string, string, string][] = [['short', s, 'two-minute'], ['mid', m, 'five-minute']];
      cuts.forEach(([k, text, name]) => {
        const target = Number(field(k).dataset.target);
        const n = words(text);
        if (!n || !(wpm > 0)) return;
        const sec = (n / wpm) * 60;
        if (sec > target * 1.1) {
          const over = n - Math.floor((wpm * target) / 60);
          findings.push(`The ${name} cut runs about ${clock(sec)} at ${wpm} words per minute. Cut about ${over} words.`);
        }
      });
      if (s.trim()) {
        MARKERS.forEach(([re, msg]) => { if (!re.test(s)) findings.push(`Two-minute cut: ${msg}`); });
        const we = count(s, /\b(we|our|us)\b/gi);
        const i = count(s, /\b(I|[Mm]y|[Mm]e)\b/g);
        if (we > i) findings.push(`Two-minute cut: "we", "our" or "us" ${we} times against "I", "my" or "me" ${i} times. Separate your decisions from the team's.`);
      }
      if (m.trim() && words(m) <= words(s)) findings.push('The five-minute cut is no longer than the two-minute cut. It should add the evidence chain and the other side.');
      if (m.trim() && !/\b(argued|disagree\w*|objected|pushed back|their (case|view|argument)|other side|concern)\b/i.test(m)) {
        findings.push('Five-minute cut: no disagreement appears. State the other side in a sentence its owner would sign.');
      }
      if (d.trim()) {
        const nums = count(d, /\d+(?:[.,]\d+)?/g);
        if (nums < 3) findings.push(`The appendix holds ${nums} number${nums === 1 ? '' : 's'}. Each follow-up on how something was measured lands here.`);
        if (!/\b(revers\w*|would change|change my mind|if we saw|unless)\b/i.test(d)) findings.push('The appendix has no reversal condition: what evidence would make you decide the other way today.');
      } else if (s.trim()) {
        findings.push('No appendix yet. Most follow-ups ask for facts that never fit in the cuts.');
      }
      list.replaceChildren(...findings.map((f) => {
        const li = document.createElement('li');
        li.textContent = f;
        return li;
      }));
      summary.textContent = findings.length
        ? `${findings.length} thing${findings.length === 1 ? '' : 's'} to fix.`
        : 'No gaps found by these checks.';
      out.classList.add('show');
    });
  });
</script>
