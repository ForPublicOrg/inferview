---
// Tool-set audit for one agent session: which tools supply the lethal trifecta legs (Willison, June 2025) and how many
// Rule of Two properties (Meta, October 2025) are present. Props: title, checked (tool ids ticked at load).
interface Tool {
  id: string;
  name: string;
  note: string;
  priv?: boolean;
  untrusted?: boolean;
  exfil?: boolean;
  state?: boolean;
}
interface Props {
  title?: string;
  checked?: string[];
}
const TOOLS: Tool[] = [
  { id: 'read_inbox', name: 'read_inbox', note: "The user's mail. Anyone on the internet can put a message in it.", priv: true, untrusted: true },
  { id: 'search_wiki', name: 'search_wiki', note: 'Internal wiki that only staff can edit.', priv: true },
  { id: 'read_upload', name: 'read_upload', note: 'A file the user attached. It may have come from anyone.', untrusted: true },
  { id: 'web_fetch', name: 'web_fetch(url)', note: 'Reads any page. The URL it requests can carry data out in its query string.', untrusted: true, exfil: true },
  { id: 'send_email', name: 'send_email', note: 'Sends mail to any address.', exfil: true, state: true },
  { id: 'md_images', name: 'Markdown images rendered', note: 'The chat UI renders any image URL the model writes, so the browser fetches it.', exfil: true },
  { id: 'update_ticket', name: 'update_ticket', note: 'Changes a support record that only staff read.', state: true },
];
const { title = 'Trifecta audit: tick the tools this agent has in one session', checked = ['read_inbox', 'send_email'] } = Astro.props;
const uid = `tri-${title.replace(/[^a-z0-9]+/gi, '-').toLowerCase().slice(0, 20)}`;
---
<div class="widget" data-trifecta={JSON.stringify(TOOLS)}>
  <header><h4>{title}</h4><span class="tiny">fixed tool catalogue, no model runs here</span></header>
  <fieldset class="faults">
    <legend>Tools and channels in this session</legend>
    {TOOLS.map((t) => (
      <label for={`${uid}-${t.id}`}>
        <input type="checkbox" id={`${uid}-${t.id}`} data-tool={t.id} checked={checked.includes(t.id)} />
        <span><span class="mono">{t.name}</span><small>{t.note}</small></span>
      </label>
    ))}
  </fieldset>
  <label class="row" style="margin-top: 12px; font-size: 14px; min-height: 44px" for={`${uid}-approve`}>
    <input type="checkbox" id={`${uid}-approve`} data-approve />
    A person approves every send or state change before it runs, and sees the full arguments
  </label>
  <div class="meter">
    <div><b data-o="p">no</b><span>private data</span></div>
    <div><b data-o="u">no</b><span>untrusted content</span></div>
    <div><b data-o="x">no</b><span>can send data out</span></div>
    <div><b data-o="c">no</b><span>can send or change state</span></div>
  </div>
  <div aria-live="polite" style="margin-top: 12px">
    <p data-o="tri"></p>
    <p data-o="two"></p>
    <p data-o="fix" class="tiny"></p>
  </div>
</div>

<script>
  type Tool = { id: string; name: string; priv?: boolean; untrusted?: boolean; exfil?: boolean; state?: boolean };

  const list = (ts: Tool[]) => ts.map((t) => t.name).join(', ');
  const legs = (sel: Tool[]) => ({
    p: sel.filter((t) => t.priv),
    u: sel.filter((t) => t.untrusted),
    x: sel.filter((t) => t.exfil),
    c: sel.filter((t) => t.exfil || t.state),
  });
  const hasTrifecta = (sel: Tool[]) => {
    const l = legs(sel);
    return l.p.length > 0 && l.u.length > 0 && l.x.length > 0;
  };

  document.querySelectorAll<HTMLElement>('[data-trifecta]').forEach((root) => {
    const tools = JSON.parse(root.dataset.trifecta ?? '[]') as Tool[];
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[data-tool]')];
    const approve = root.querySelector<HTMLInputElement>('[data-approve]');
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`);

    const render = () => {
      const on = new Set(boxes.filter((b) => b.checked).map((b) => b.dataset.tool));
      boxes.forEach((b) => b.closest('label')?.classList.toggle('on', b.checked));
      const sel = tools.filter((t) => on.has(t.id));
      const l = legs(sel);
      const cell = (k: 'p' | 'u' | 'x' | 'c') => {
        const el = out(k);
        if (!el) return;
        el.textContent = l[k].length ? 'yes' : 'no';
        el.classList.toggle('bad', l[k].length > 0);
        el.title = l[k].length ? list(l[k]) : 'no tool supplies this';
      };
      (['p', 'u', 'x', 'c'] as const).forEach(cell);

      const tri = out('tri');
      if (tri) {
        tri.textContent = hasTrifecta(sel)
          ? `Lethal trifecta present. Text injected through ${list(l.u)} can make the model read ${list(l.p)} and send it out through ${list(l.x)}.`
          : `No lethal trifecta. Missing: ${[!l.p.length && 'private data', !l.u.length && 'untrusted content', !l.x.length && 'a way out'].filter(Boolean).join(', ')}.`;
      }

      const count = [l.p, l.u, l.c].filter((a) => a.length > 0).length;
      const two = out('two');
      if (two) {
        if (count < 3) two.textContent = `Rule of Two: ${count} of 3 properties. This session may run autonomously under the rule.`;
        else if (approve?.checked) two.textContent = 'Rule of Two: 3 of 3 properties, supervised. The rule allows this only with a reliable check before each risky action, which here is a person who sees the real arguments.';
        else two.textContent = 'Rule of Two: 3 of 3 properties, unsupervised. Under the rule this session should not run autonomously.';
      }

      const fix = out('fix');
      if (fix) {
        if (!hasTrifecta(sel)) fix.textContent = l.c.length && l.u.length && l.p.length ? 'Untrusted input plus private data plus a state change still matters: an injection can corrupt records even with no way to send data out.' : '';
        else {
          const singles = sel.filter((t) => !hasTrifecta(sel.filter((s) => s.id !== t.id)));
          fix.textContent = singles.length
            ? `Removing any one of these breaks the trifecta: ${list(singles)}.`
            : 'No single removal breaks it, because more than one tool supplies a leg. Remove a whole leg, or split the work into separate sessions.';
        }
      }
    };

    boxes.forEach((b) => b.addEventListener('change', render));
    approve?.addEventListener('change', render);
    render();
  });
</script>
