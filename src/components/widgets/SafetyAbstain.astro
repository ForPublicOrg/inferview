---
// Abstention threshold over a fixed toy set of 20 answers with a confidence and a correct/wrong label. Two sliders:
// the confidence threshold for answering, and t, which sets the penalty for a wrong answer to t/(1-t) points
// (scoring rule from Kalai et al., 2025). Props: title. Deterministic.
interface Props {
  title?: string;
}
const { title = 'Answer or abstain: pick a threshold' } = Astro.props;
const uid = `ab-${title.replace(/[^a-z0-9]+/gi, '-').toLowerCase().slice(0, 20)}`;
---
<div class="widget" data-abstain>
  <header><h4>{title}</h4><span class="tiny">toy set of 20 answers, not a real model</span></header>
  <div class="row">
    <label style="flex: 1; font-size: 13px; min-width: 160px" for={`${uid}-c`}>answer when confidence is at least <b class="mono" data-cv></b>
      <input type="range" min="0" max="1" step="0.01" value="0" id={`${uid}-c`} data-c />
    </label>
    <label style="flex: 1; font-size: 13px; min-width: 160px" for={`${uid}-t`}>t <b class="mono" data-tv></b>, so a wrong answer costs <b class="mono" data-pv></b>
      <input type="range" min="0" max="0.9" step="0.05" value="0" id={`${uid}-t`} data-t />
    </label>
  </div>
  <div class="meter">
    <div><b data-o="ans">0</b><span>answered of 20</span></div>
    <div><b data-o="acc">0</b><span>right when it answers</span></div>
    <div><b data-o="wrong">0</b><span>confident wrong answers</span></div>
    <div><b data-o="score">0</b><span>score (right = 1, abstain = 0)</span></div>
  </div>
  <p class="tiny" aria-live="polite" data-o="best" style="margin-top: 12px"></p>
  <div class="strip" data-o="dots" aria-hidden="true" style="margin-top: 8px"></div>
</div>

<script>
  // [confidence, correct]: a made-up set where higher confidence is right more often, as in a roughly calibrated model.
  const SET: [number, boolean][] = [
    [0.98, true], [0.95, true], [0.93, true], [0.91, false], [0.88, true], [0.85, true], [0.82, false], [0.8, true],
    [0.77, true], [0.74, false], [0.7, true], [0.66, false], [0.62, true], [0.58, false], [0.55, false], [0.51, true],
    [0.45, false], [0.4, false], [0.33, true], [0.25, false],
  ];

  const evaluate = (c: number, t: number) => {
    const penalty = t / (1 - t);
    const answered = SET.filter(([conf]) => conf >= c);
    const right = answered.filter(([, ok]) => ok).length;
    const wrong = answered.length - right;
    return { answered: answered.length, right, wrong, score: right - wrong * penalty };
  };

  document.querySelectorAll<HTMLElement>('[data-abstain]').forEach((root) => {
    const cIn = root.querySelector<HTMLInputElement>('[data-c]');
    const tIn = root.querySelector<HTMLInputElement>('[data-t]');
    const q = (k: string) => root.querySelector<HTMLElement>(`[data-${k}]`) ?? root.querySelector<HTMLElement>(`[data-o="${k}"]`);
    const dots = root.querySelector<HTMLElement>('[data-o="dots"]');
    if (!cIn || !tIn) return;
    const chips = SET.map(([conf, ok]) => {
      const s = document.createElement('span');
      s.className = 'tok';
      s.textContent = `${conf.toFixed(2)} ${ok ? 'right' : 'wrong'}`;
      dots?.append(s);
      return s;
    });

    const render = () => {
      const c = Number(cIn.value);
      const t = Number(tIn.value);
      const r = evaluate(c, t);
      const set = (k: string, v: string) => {
        const el = q(k);
        if (el) el.textContent = v;
      };
      set('cv', c.toFixed(2));
      set('tv', t.toFixed(2));
      set('pv', `${(t / (1 - t)).toFixed(2)} points`);
      set('ans', String(r.answered));
      set('acc', r.answered ? `${Math.round((r.right / r.answered) * 100)}%` : 'n/a');
      set('wrong', String(r.wrong));
      set('score', r.score.toFixed(2));
      // Best threshold on this set: try each confidence value (and "answer nothing") as the cut.
      let best = { c: 1.01, score: 0 };
      for (const [conf] of SET) {
        const s = evaluate(conf, t).score;
        if (s > best.score + 1e-9) best = { c: conf, score: s };
      }
      set(
        'best',
        best.c > 1
          ? `At this t, answering nothing scores best on this set.`
          : `At this t, the best cut on this set is confidence ${best.c.toFixed(2)} or higher, scoring ${best.score.toFixed(2)}. With calibrated confidences the cut would sit at t = ${t.toFixed(2)}; a gap means these confidences are not calibrated in that band.`,
      );
      chips.forEach((chip, i) => {
        const on = SET[i]![0] >= c;
        chip.style.opacity = on ? '1' : '0.35';
        chip.classList.toggle('alt', on && SET[i]![1]);
      });
    };

    cIn.addEventListener('input', render);
    tIn.addEventListener('input', render);
    render();
  });
</script>
