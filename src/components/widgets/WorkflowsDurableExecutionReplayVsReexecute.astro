---
// Three meanings of "replay" on one five-step run: crash resume, time travel from a checkpoint, bulk replay as a new run.
// Shows which steps come from the log, which execute again, and which effects reach the customer twice.
interface Props {
  title?: string;
}
const { title = 'Which replay re-executes what?' } = Astro.props;
const STEPS = [
  { id: 'classify', label: 'classify the ticket (model call)', kind: 'llm' },
  { id: 'account', label: 'read the account', kind: 'read' },
  { id: 'credit', label: 'issue a credit (payment API)', kind: 'effect' },
  { id: 'email', label: 'email the customer', kind: 'effect' },
  { id: 'summary', label: 'write the case summary (model call)', kind: 'llm' },
];
const MODES = [
  { id: 'crash', label: 'Resume after a crash', note: 'Temporal, Inngest, DBOS, Lambda durable functions, Restate, Cloudflare Workflows, Workflow SDK, LangGraph resume. The worker dies inside the chosen step, after its effect and before its result is saved.' },
  { id: 'travel', label: 'Time travel from a checkpoint', note: 'LangGraph replay or fork on a finished thread, from the checkpoint before the chosen step.' },
  { id: 'bulk', label: 'Bulk replay of a failed run', note: 'Inngest Replay. The run failed at the chosen step with no effect; replay starts a new execution.' },
];
const KEYS = [
  { id: 'none', label: 'No idempotency key' },
  { id: 'run', label: 'Key from run or thread id + step name' },
  { id: 'biz', label: 'Key from ticket id + step name' },
];
const uid = `rvr-${title.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
---
<div class="widget" data-rvr={JSON.stringify(STEPS)}>
  <header><h4>{title}</h4><span class="tiny">simulated; no engine, model or payment runs here</span></header>
  <fieldset class="faults">
    <legend>Which replay?</legend>
    {MODES.map((m, i) => (
      <label class:list={{ on: i === 0 }}>
        <input type="radio" name={`${uid}-mode`} value={m.id} checked={i === 0} />
        <span>{m.label}<small>{m.note}</small></span>
      </label>
    ))}
  </fieldset>
  <div class="row" style="margin-top: 12px">
    <label for={`${uid}-at`} style="font-size: 14px">Starts at step</label>
    <select class="field" id={`${uid}-at`} data-at style="max-width: 100%">
      {STEPS.map((s, i) => <option value={i} selected={i === 2}>{`${i + 1}. ${s.label}`}</option>)}
    </select>
  </div>
  <fieldset class="faults" style="margin-top: 12px">
    <legend>Idempotency key on the credit and the email</legend>
    {KEYS.map((k, i) => (
      <label class:list={{ on: i === 0 }}>
        <input type="radio" name={`${uid}-key`} value={k.id} checked={i === 0} />
        <span>{k.label}</span>
      </label>
    ))}
  </fieldset>
  <div class="split">
    <div><div class="striplabel">First execution</div><div class="trace" data-a1></div></div>
    <div><div class="striplabel" data-a2label>Second execution</div><div class="trace" data-a2></div></div>
  </div>
  <div class="gauges">
    <div><b data-o="log">0</b><span>steps answered from the log</span></div>
    <div><b data-o="llm">0</b><span>model calls paid a second time</span></div>
    <div><b data-o="dup">0</b><span>effects the customer gets twice</span></div>
    <div><b data-o="rerun">0</b><span>steps whose code executed a second time</span></div>
  </div>
  <p class="tiny" data-note></p>
  <p class="sr-only" aria-live="polite" data-o="summary"></p>
</div>

<script>
  type Step = { id: string; label: string; kind: 'llm' | 'read' | 'effect' };
  type Row = { label: string; status: string; bad?: boolean };
  type Out = { a1: Row[]; a2: Row[]; log: number; llm: number; dup: number; rerun: number; note: string };

  function simulate(steps: Step[], mode: string, at: number, key: string): Out {
    const a1: Row[] = [];
    const a2: Row[] = [];
    const sent = new Set<string>(); // keys the provider has already seen, as "<key-scope>:<step>"
    const done = new Set<string>(); // effects that already reached the customer
    let log = 0, llm = 0, dup = 0, rerun = 0;
    const scope = (run: string) => (key === 'none' ? null : key === 'run' ? run : 'ticket-1');
    // An effect runs at the provider; it reaches the customer unless the provider has seen the same key.
    const effect = (s: Step, run: string): { status: string; bad: boolean } => {
      const sc = scope(run);
      if (sc && sent.has(`${sc}:${s.id}`)) return { status: 'ran; provider saw the same key and did nothing', bad: false };
      if (sc) sent.add(`${sc}:${s.id}`);
      const twice = done.has(s.id);
      done.add(s.id);
      if (twice) dup++;
      return { status: twice ? 'ran again; customer affected twice' : 'ran', bad: twice };
    };
    // First execution, run id run-1.
    const last = mode === 'travel' ? steps.length - 1 : at;
    for (const [i, s] of steps.entries()) {
      if (i > last) break;
      if (mode === 'bulk' && i === at) {
        a1.push({ label: s.label, status: 'failed on every attempt; no effect; run marked failed', bad: true });
        break;
      }
      const r = s.kind === 'effect' ? effect(s, 'run-1') : { status: 'ran', bad: false };
      if (mode === 'crash' && i === at) {
        a1.push({ label: s.label, status: `${r.status}, then the worker died before the result was saved`, bad: true });
        break;
      }
      a1.push({ label: s.label, status: `${r.status}; result saved` });
    }
    // Second execution. Crash resume and time travel keep the run or thread; bulk replay is a new run, run-2.
    const run = mode === 'bulk' ? 'run-2' : 'run-1';
    steps.forEach((s, i) => {
      const fromLog = mode !== 'bulk' && i < at;
      if (fromLog) {
        log++;
        a2.push({ label: s.label, status: 'result returned from the log; code not executed' });
        return;
      }
      const ranBefore = mode === 'travel' || i < at || (mode === 'crash' && i === at);
      if (ranBefore) rerun++;
      if (s.kind === 'llm' && ranBefore) llm++;
      if (s.kind === 'effect') {
        const r = effect(s, run);
        a2.push({ label: s.label, status: r.status, bad: r.bad });
        return;
      }
      a2.push({ label: s.label, status: ranBefore ? 'ran again' : 'ran for the first time' });
    });
    const note =
      mode === 'bulk'
        ? 'The Replay page says replay creates new executions and does not say whether results from the failed run are reused, so this shows every earlier step running again: the case its advice to check for repeated charges and messages guards against. A key built from the run id changes with the new run and stops nothing.'
        : mode === 'travel'
          ? 'LangGraph re-executes every node after the checkpoint, model calls and API requests included. The thread is the same, so a key built from the thread id still deduplicates; the model output that feeds later steps can still differ.'
          : 'Only the step that was running at the crash executes twice. Every engine in this group behaves this way; they differ in where the log lives.';
    return { a1, a2, log, llm, dup, rerun, note };
  }

  function rowEl(r: Row, i: number): HTMLElement {
    const el = document.createElement('div');
    el.className = 'step seen';
    const n = document.createElement('span');
    n.className = 'n';
    n.textContent = String(i + 1);
    const body = document.createElement('div');
    const b = document.createElement('span');
    b.className = 'role';
    b.textContent = r.label;
    const s = document.createElement('span');
    s.className = `body${r.bad ? ' warn' : ''}`;
    s.textContent = r.status;
    body.append(b, s);
    el.append(n, body);
    return el;
  }

  document.querySelectorAll<HTMLElement>('[data-rvr]').forEach((root) => {
    const steps = JSON.parse(root.dataset.rvr ?? '[]') as Step[];
    const radios = [...root.querySelectorAll<HTMLInputElement>('.faults input')];
    const at = root.querySelector<HTMLSelectElement>('[data-at]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const picked = (prefix: string) => radios.find((r) => r.name.endsWith(prefix) && r.checked)?.value ?? '';
    const render = () => {
      radios.forEach((r) => r.closest('label')?.classList.toggle('on', r.checked));
      const mode = picked('-mode');
      const r = simulate(steps, mode, Number(at.value), picked('-key'));
      root.querySelector('[data-a1]')!.replaceChildren(...r.a1.map(rowEl));
      root.querySelector('[data-a2]')!.replaceChildren(...r.a2.map(rowEl));
      root.querySelector<HTMLElement>('[data-a2label]')!.textContent =
        mode === 'bulk' ? 'Second execution (new run id)' : mode === 'travel' ? 'Second execution (same thread)' : 'Second execution (same run, after restart)';
      root.querySelector<HTMLElement>('[data-note]')!.textContent = r.note;
      for (const k of ['log', 'llm', 'dup', 'rerun'] as const) out(k).textContent = String(r[k]);
      out('dup').classList.toggle('bad', r.dup > 0);
      out('summary').textContent = `${r.log} steps from the log, ${r.llm} model calls paid again, ${r.dup} effects repeated for the customer.`;
    };
    [at, ...radios].forEach((el) => el.addEventListener('change', render));
    render();
  });
</script>
