---
// Saturation meter for error analysis: read synthetic traces ten at a time and count the failure categories each batch adds.
// Props: traces (one array of category labels per trace, [] for a trace with no failure), batch (default 10), title, note.
interface Props {
  traces?: string[][];
  batch?: number;
  title?: string;
  note?: string;
}
// Default data: 50 synthetic labelled traces. Traces 1 to 40 match snippet 9 in research/tracks/evals.md; 41 to 50 add one rare category.
const DEFAULT: string[][] = [
  ['wrong_date'], [], ['ignored_policy'], [], ['wrong_date'], [], ['tone'], [], [], ['hallucinated_listing'],
  [], ['wrong_date'], [], ['handoff_late'], [], [], ['tone'], [], [], [],
  ['ignored_policy'], [], [], [], ['wrong_date'], [], [], [], [], [],
  [], [], ['tone'], [], [], [], [], ['wrong_date'], [], [],
  [], [], [], ['wrong_date'], [], [], ['promised_refund'], [], [], [],
];
const { traces = DEFAULT, batch = 10, title = 'Saturation meter: read traces ten at a time', note = 'synthetic labels for a property-search assistant' } = Astro.props;
---
<div class="widget" data-saturation={JSON.stringify(traces)} data-batch={batch}>
  <header>
    <h4>{title}</h4>
    <div class="row" style="gap: 6px">
      <button class="btn sm primary" type="button" data-next>Read the next {batch}</button>
      <button class="btn sm" type="button" data-reset>Start over</button>
    </div>
  </header>
  <div class="gauges">
    <div><b data-read>0</b><span>traces read</span></div>
    <div><b data-fails>0</b><span>traces with a failure</span></div>
    <div><b data-cats>0</b><span>categories found</span></div>
    <div><b data-last>none</b><span>new in the last batch</span></div>
  </div>
  <ol class="sat-list" data-batches aria-live="polite"></ol>
  <p class="tiny" style="margin: 8px 0 0">{note}. Each row is one batch; the bar is the number of categories that batch added.</p>
</div>

<style>
  .sat-list { list-style: none; padding: 0; margin: 8px 0 0; font-size: 14px; }
  .sat-list li { display: grid; grid-template-columns: 7.5em 1fr; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .sat-list li > * { min-width: 0; }
  .sat-list .lbl { font-family: var(--mono); font-size: 12.5px; color: var(--ink-3); }
  .sat-list .bar { height: 10px; background: var(--accent); border-radius: 3px; margin: 5px 0 6px; }
  .sat-list .bar.zero { background: var(--line); width: 100% !important; height: 2px; margin: 9px 0 10px; }
  .sat-list .new { font-family: var(--mono); font-size: 12.5px; color: var(--ink-2); overflow-wrap: anywhere; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-saturation]').forEach((root) => {
    const traces = JSON.parse(root.dataset.saturation ?? '[]') as string[][];
    const size = Math.max(1, Number(root.dataset.batch ?? 10));
    const list = root.querySelector<HTMLOListElement>('[data-batches]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const set = (sel: string, v: string) => (root.querySelector(sel)!.textContent = v);
    let read = 0;

    const render = () => {
      const seen = new Set<string>();
      let fails = 0;
      let lastNew: string[] = [];
      list.replaceChildren();
      for (let start = 0; start < read; start += size) {
        const chunk = traces.slice(start, Math.min(start + size, read));
        const added: string[] = [];
        for (const t of chunk) {
          if (t.length) fails++;
          for (const c of t) {
            if (!seen.has(c)) {
              seen.add(c);
              added.push(c);
            }
          }
        }
        lastNew = added;
        const li = document.createElement('li');
        const lbl = document.createElement('span');
        lbl.className = 'lbl';
        lbl.textContent = `traces ${start + 1} to ${start + chunk.length}`;
        const right = document.createElement('div');
        const bar = document.createElement('div');
        bar.className = added.length ? 'bar' : 'bar zero';
        bar.style.width = `${Math.min(100, added.length * 20)}%`;
        const text = document.createElement('div');
        text.className = 'new';
        text.textContent = added.length ? `${added.length} new: ${added.join(', ')}` : '0 new';
        right.append(bar, text);
        li.append(lbl, right);
        list.append(li);
      }
      set('[data-read]', String(read));
      set('[data-fails]', String(fails));
      set('[data-cats]', String(seen.size));
      set('[data-last]', read ? String(lastNew.length) : 'none');
      next.disabled = read >= traces.length;
      next.textContent = read >= traces.length ? 'All traces read' : `Read the next ${Math.min(size, traces.length - read)}`;
    };

    next.addEventListener('click', () => {
      read = Math.min(traces.length, read + size);
      render();
    });
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      read = 0;
      render();
      next.focus();
    });
    render();
  });
</script>
