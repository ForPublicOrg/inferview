---
// Selection on a dev set, computed exactly from the binomial. K candidate prompts are scored on the same n dev examples.
// K - 1 of them share a true accuracy p; one is better by g points. Shows the expected dev score of the winner when all
// K are equally good (the inflation a held-out set will take back), the 95% half-width of one dev score, and the
// probability that the truly better candidate strictly outscores every other one. Props: k, n, p, g (points), title.
interface Props {
  k?: number;
  n?: number;
  p?: number;
  g?: number;
  title?: string;
}
const { k = 20, n = 100, p = 60, g = 3, title = 'How much of the dev-set win is selection' } = Astro.props;
const fields = [
  { key: 'k', label: 'candidates scored', value: k, min: 1, max: 200, step: 1 },
  { key: 'n', label: 'dev examples', value: n, min: 10, max: 2000, step: 10 },
  { key: 'p', label: 'true accuracy, %', value: p, min: 5, max: 95, step: 1 },
  { key: 'g', label: 'real gain of one, points', value: g, min: 0, max: 30, step: 1 },
];
---
<div class="widget" data-winners-curse>
  <header><h4>{title}</h4><span class="tiny">exact binomial, independent candidates, no simulation</span></header>
  <div class="wc-grid">
    {fields.map((f) => (
      <label class="wc-l" for={`wc-${f.key}`}>{f.label}
        <input type="number" id={`wc-${f.key}`} min={f.min} max={f.max} step={f.step} value={f.value} inputmode="numeric" data-in={f.key} data-min={f.min} data-max={f.max} />
      </label>
    ))}
  </div>
  <div class="gauges">
    <div><b data-best></b><span>expected dev score of the winner, all equal</span></div>
    <div><b data-infl></b><span>points a held-out set takes back</span></div>
    <div><b data-half></b><span>95% half-width of one dev score</span></div>
    <div><b data-win></b><span>chance the better one ranks first</span></div>
  </div>
  <p class="tiny" data-note aria-live="polite" style="margin: 10px 0 0"></p>
</div>

<style>
  .wc-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 600px) { .wc-grid { grid-template-columns: 1fr 1fr; } }
  .wc-l { display: flex; flex-direction: column; gap: 4px; font-size: 13px; min-width: 0; }
  .wc-l input { width: 100%; min-width: 0; }
</style>

<script>
  // Binomial pmf over 0..n, built in log space so n = 2000 does not underflow at the tails.
  function pmf(n: number, p: number): number[] {
    const lp = Math.log(p);
    const lq = Math.log(1 - p);
    const out: number[] = new Array(n + 1);
    let lnC = 0;
    for (let x = 0; x <= n; x++) {
      if (x > 0) lnC += Math.log(n - x + 1) - Math.log(x);
      out[x] = Math.exp(lnC + x * lp + (n - x) * lq);
    }
    return out;
  }

  function cdf(f: number[]): number[] {
    const out: number[] = new Array(f.length);
    let s = 0;
    for (let x = 0; x < f.length; x++) {
      s += f[x]!;
      out[x] = Math.min(1, s);
    }
    return out;
  }

  // E[max of k iid counts] = sum over x of P(max > x) = sum of 1 - F(x)^k.
  function expectedMax(F: number[], k: number): number {
    let e = 0;
    for (let x = 0; x < F.length - 1; x++) e += 1 - Math.pow(F[x]!, k);
    return e;
  }

  // P(the better candidate's count is strictly above all k - 1 others).
  function strictWin(fBetter: number[], F: number[], k: number): number {
    if (k === 1) return 1;
    let s = 0;
    for (let x = 1; x < fBetter.length; x++) s += fBetter[x]! * Math.pow(F[x - 1]!, k - 1);
    return Math.min(1, s);
  }

  document.querySelectorAll<HTMLElement>('[data-winners-curse]').forEach((root) => {
    const inputs = new Map([...root.querySelectorAll<HTMLInputElement>('[data-in]')].map((el) => [el.dataset.in ?? '', el]));
    const set = (sel: string, v: string) => (root.querySelector(sel)!.textContent = v);
    const note = root.querySelector<HTMLElement>('[data-note]')!;
    let clamped = false;
    const val = (key: string) => {
      const el = inputs.get(key)!;
      const lo = Number(el.dataset.min);
      const hi = Number(el.dataset.max);
      const raw = Math.round(Number(el.value));
      const v = Number.isFinite(raw) ? Math.min(hi, Math.max(lo, raw)) : lo;
      if (v !== raw) clamped = true;
      return v;
    };

    const render = () => {
      clamped = false;
      const k = val('k');
      const n = val('n');
      const p = val('p') / 100;
      const g = Math.min(val('g') / 100, 0.99 - p);
      const F = cdf(pmf(n, p));
      const best = expectedMax(F, k) / n;
      const win = g > 0 ? strictWin(pmf(n, p + g), F, k) : strictWin(pmf(n, p), F, k);
      const half = 1.96 * Math.sqrt((p * (1 - p)) / n);
      set('[data-best]', `${(best * 100).toFixed(1)}%`);
      set('[data-infl]', `${((best - p) * 100).toFixed(1)}`);
      set('[data-half]', `${(half * 100).toFixed(1)} pts`);
      set('[data-win]', `${(win * 100).toFixed(0)}%`);
      note.textContent =
        (clamped ? 'Some inputs were out of range and were clamped. ' : '') +
        `With ${k} equally good candidates at ${(p * 100).toFixed(0)}% on ${n} examples, the one you pick scores ` +
        `${(best * 100).toFixed(1)}% on dev and ${(p * 100).toFixed(0)}% anywhere else. ` +
        (k === 1
          ? 'With one candidate there is no selection, so no inflation.'
          : `A candidate truly ${(g * 100).toFixed(0)} points better beats all ${k - 1} others outright ${(win * 100).toFixed(0)}% of the time; ties count against it. ` +
            'Real candidates fail on many of the same examples, which lowers the inflation.');
    };
    inputs.forEach((el) => el.addEventListener('input', render));
    render();
  });
</script>
