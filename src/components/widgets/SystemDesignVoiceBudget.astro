---
// Voice-turn latency waterfall against a budget. Stage times default to the P50 and P95 example budget in ElevenLabs'
// latency post; tokens per clause, reply length and ms per token are assumptions the reader sets.
interface Stage {
  name: string;
  p50: number;
  p95: number;
}
interface Props {
  title?: string;
  budget?: number;
  stages?: Stage[];
  note?: string;
}
const {
  title = 'Voice latency budget',
  budget = 800,
  note = 'stage times from ElevenLabs, checked 28 Oct 2026',
  stages = [
    { name: 'capture and endpointing', p50: 120, p95: 280 },
    { name: 'speech-to-text finalization', p50: 60, p95: 150 },
    { name: 'network', p50: 60, p95: 160 },
    { name: 'LLM time to first token', p50: 250, p95: 600 },
    { name: 'TTS time to first audio', p50: 110, p95: 220 },
    { name: 'player buffering', p50: 80, p95: 150 },
  ],
} = Astro.props;
const uid = `sdv-${budget}-${stages.length}`;
---
<div class="widget sdv" data-sdvoice={JSON.stringify(stages)}>
  <header><h4>{title}</h4><span class="tiny">{note}</span></header>
  <div class="row sdv-controls">
    <div class="toggle" role="group" aria-label="Percentile">
      <button type="button" data-pct="p50" aria-pressed="true">P50</button>
      <button type="button" data-pct="p95" aria-pressed="false">P95</button>
    </div>
    <div class="toggle" role="group" aria-label="When text-to-speech starts">
      <button type="button" data-mode="clause" aria-pressed="true">Speak from first clause</button>
      <button type="button" data-mode="full" aria-pressed="false">Wait for full reply</button>
    </div>
  </div>
  <div class="sdv-inputs">
    <label for={`${uid}-clause`}>tokens in the first clause<input type="number" id={`${uid}-clause`} data-in="clause" value="8" min="1" step="1" /></label>
    <label for={`${uid}-reply`}>tokens in the whole reply<input type="number" id={`${uid}-reply`} data-in="reply" value="60" min="1" step="1" /></label>
    <label for={`${uid}-ms`}>ms per output token<input type="number" id={`${uid}-ms`} data-in="ms" value="25" min="0" step="1" /></label>
    <label for={`${uid}-budget`}>budget (ms)<input type="number" id={`${uid}-budget`} data-in="budget" value={budget} min="1" step="10" /></label>
  </div>
  <div class="sdv-rows" data-rows></div>
  <div class="kv sdv-total"><span>time until the user hears audio</span><b data-total></b></div>
  <p class="tiny sdv-err" data-err role="alert" hidden>Every field needs a positive number.</p>
  <p class="tiny" style="margin: 8px 0 0">Adding stage P95s gives a pessimistic bound: stages rarely hit their tails on the same turn.</p>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style is:global>
  .sdv-controls { margin-bottom: 10px; }
  .sdv .toggle button { min-height: 44px; }
  .sdv-inputs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 12px; }
  .sdv-inputs label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--ink-2); min-width: 0; }
  .widget.sdv .sdv-inputs input { width: 100%; min-height: 40px; }
  .sdv-row { display: grid; grid-template-columns: minmax(0, 42%) 1fr; gap: 8px; align-items: center; font-size: 12.5px; margin: 3px 0; }
  .sdv-row > span { color: var(--ink-2); overflow-wrap: anywhere; }
  .sdv-track { position: relative; height: 20px; background: var(--bg-2); border-radius: 3px; overflow: hidden; }
  .sdv-track i { position: absolute; top: 0; bottom: 0; background: var(--accent); }
  .sdv-track i.over { background: var(--amber); }
  .sdv-track .line { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--ink); }
  .sdv-total { margin-top: 10px; font-size: 14px; }
  .sdv-total b.over { color: var(--amber); }
  .sdv-err { color: var(--rose); }
  @media (max-width: 600px) { .sdv-inputs { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  type Stage = { name: string; p50: number; p95: number };

  document.querySelectorAll<HTMLElement>('[data-sdvoice]').forEach((root) => {
    const stages = JSON.parse(root.dataset.sdvoice ?? '[]') as Stage[];
    const rows = root.querySelector<HTMLElement>('[data-rows]')!;
    const totalEl = root.querySelector<HTMLElement>('[data-total]')!;
    const err = root.querySelector<HTMLElement>('[data-err]')!;
    const num = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)?.value);
    let pct: 'p50' | 'p95' = 'p50';
    let mode: 'clause' | 'full' = 'clause';

    const press = (attr: string, value: string) =>
      root.querySelectorAll<HTMLButtonElement>(`[${attr}]`).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === value)));

    const render = () => {
      const clause = num('clause');
      const reply = num('reply');
      const ms = num('ms');
      const budget = num('budget');
      if (![clause, reply, ms, budget].every((n) => Number.isFinite(n) && n >= 0) || budget <= 0) {
        err.hidden = false;
        return;
      }
      err.hidden = true;
      // The LLM has to produce the tokens TTS needs before it can speak: one clause when streaming, all of it otherwise.
      const genTokens = mode === 'clause' ? clause : reply;
      const list = stages.map((s) => ({ name: s.name, ms: s[pct] }));
      const ttft = list.findIndex((s) => /first token/i.test(s.name));
      list.splice(ttft + 1, 0, { name: `LLM writes ${genTokens} tokens before TTS starts`, ms: genTokens * ms });
      const total = list.reduce((a, s) => a + s.ms, 0);
      const scale = Math.max(total, budget);

      rows.replaceChildren();
      let start = 0;
      for (const s of list) {
        const row = document.createElement('div');
        row.className = 'sdv-row';
        const label = document.createElement('span');
        label.textContent = `${s.name}, ${Math.round(s.ms)} ms`;
        const track = document.createElement('div');
        track.className = 'sdv-track';
        track.setAttribute('aria-hidden', 'true');
        const bar = document.createElement('i');
        bar.style.left = `${(start / scale) * 100}%`;
        bar.style.width = `${Math.max(0.5, (s.ms / scale) * 100)}%`;
        if (start + s.ms > budget) bar.className = 'over';
        const line = document.createElement('span');
        line.className = 'line';
        line.style.left = `calc(${(budget / scale) * 100}% - 1px)`;
        track.append(bar, line);
        row.append(label, track);
        rows.append(row);
        start += s.ms;
      }
      const over = total - budget;
      totalEl.textContent = over > 0 ? `${Math.round(total)} ms, ${Math.round(over)} ms over` : `${Math.round(total)} ms, ${Math.round(-over)} ms to spare`;
      totalEl.classList.toggle('over', over > 0);
      root.querySelector('[data-summary]')!.textContent =
        `${pct.toUpperCase()}, ${mode === 'clause' ? 'streaming from the first clause' : 'waiting for the whole reply'}: ${Math.round(total)} ms against a ${budget} ms budget.`;
    };

    root.querySelectorAll<HTMLButtonElement>('[data-pct]').forEach((b) =>
      b.addEventListener('click', () => {
        pct = b.dataset.pct === 'p95' ? 'p95' : 'p50';
        press('data-pct', pct);
        render();
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
      b.addEventListener('click', () => {
        mode = b.dataset.mode === 'full' ? 'full' : 'clause';
        press('data-mode', mode);
        render();
      }),
    );
    root.querySelectorAll<HTMLInputElement>('[data-in]').forEach((i) => i.addEventListener('input', render));
    render();
  });
</script>
