---
// STAR story checker. Four text areas; "Check my draft" runs plain-text heuristics for the gaps interviewers probe:
// a result with no number, "we" instead of "I", a situation longer than the action, no failure or lesson. Nothing is stored or sent.
interface Props {
  title?: string;
}
const { title = 'STAR builder' } = Astro.props;
const parts = [
  { key: 's', label: 'Situation', hint: 'Who the users were and what hurt. Two sentences.' },
  { key: 't', label: 'Task', hint: 'What you owned, in one sentence.' },
  { key: 'a', label: 'Action', hint: 'The decisions you made, the options you rejected, how you checked.' },
  { key: 'r', label: 'Result', hint: 'The measured change against a baseline, and what went wrong.' },
];
const uid = `star-${title.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
---
<div class="widget" data-star>
  <header><h4>{title}</h4><span class="tiny">nothing you type is saved or leaves this page</span></header>
  <div class="star-grid">
    {parts.map((p) => (
      <label class="star-l" for={`${uid}-${p.key}`}>
        <span class="star-name">{p.label}</span>
        <span class="tiny">{p.hint}</span>
        <textarea id={`${uid}-${p.key}`} rows="4" data-part={p.key}></textarea>
      </label>
    ))}
  </div>
  <div class="row" style="margin-top: 10px">
    <button class="btn sm primary" type="button" data-check>Check my draft</button>
    <span class="tiny" data-count></span>
  </div>
  <div class="reveal" data-out aria-live="polite">
    <p data-summary style="font-weight: 650"></p>
    <ul class="star-findings" data-findings></ul>
    <p class="tiny" style="margin: 6px 0 0">These are text checks, not a judgement of the story. A draft can pass all of them and still be vague; read it aloud to someone.</p>
  </div>
</div>

<style is:global>
  .star-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 640px) { .star-grid { grid-template-columns: 1fr; } }
  .star-l { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .star-name { font-size: 14px; font-weight: 650; }
  .star-findings { margin: 6px 0 0; padding-left: 20px; }
  .widget .star-findings li { font-size: 14px; margin-bottom: 6px; font-family: var(--font); }
</style>

<script>
  const words = (s: string) => s.trim().split(/\s+/).filter(Boolean);
  const countWord = (s: string, re: RegExp) => (s.match(re) ?? []).length;
  const LESSON = /\b(wrong|fail(ed|ure)?|broke|mistake|missed|learn(ed|t)?|differently|regret|should have|would not|wouldn't)\b/i;

  document.querySelectorAll<HTMLElement>('[data-star]').forEach((root) => {
    const field = (k: string) => root.querySelector<HTMLTextAreaElement>(`[data-part="${k}"]`)!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const list = root.querySelector<HTMLUListElement>('[data-findings]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const names: Record<string, string> = { s: 'Situation', t: 'Task', a: 'Action', r: 'Result' };

    const updateCount = () => {
      const n = ['s', 't', 'a', 'r'].reduce((sum, k) => sum + words(field(k).value).length, 0);
      count.textContent = n ? `${n} words` : '';
    };
    ['s', 't', 'a', 'r'].forEach((k) => field(k).addEventListener('input', updateCount));

    root.querySelector<HTMLButtonElement>('[data-check]')!.addEventListener('click', () => {
      const v = { s: field('s').value, t: field('t').value, a: field('a').value, r: field('r').value };
      const findings: string[] = [];
      const empty = (Object.keys(v) as (keyof typeof v)[]).filter((k) => !v[k].trim());
      if (empty.length) findings.push(`Fill in ${empty.map((k) => names[k]).join(', ')} before checking the rest.`);
      if (v.r.trim() && !/\d/.test(v.r)) {
        findings.push('Your result has no number. Add the baseline, the change, and how and over what period you measured it.');
      }
      const story = `${v.t} ${v.a}`;
      const we = countWord(story, /\b(we|our|us)\b/gi);
      const i = countWord(story, /\b(I|[Mm]y|[Mm]e)\b/g);
      if (story.trim() && we > i) {
        findings.push(`Task and action say "we", "our" or "us" ${we} times and "I", "my" or "me" ${i} times. Say what you did.`);
      }
      const sw = words(v.s).length;
      const aw = words(v.a).length;
      if (sw && aw && sw > aw) {
        findings.push(`Your situation (${sw} words) is longer than your action (${aw} words). Cut the context; the action is what is being assessed.`);
      }
      if ((v.a.trim() || v.r.trim()) && !LESSON.test(`${v.a} ${v.r}`)) {
        findings.push('Nothing went wrong in this story. Prepare the failure: what broke, how you found out, what you changed.');
      }
      if (v.a.trim() && !/\b(instead|rather than|considered|rejected|chose|trade-?off|option)\b/i.test(v.a)) {
        findings.push('The action names no alternative you rejected. One sentence on what else you considered shows judgement.');
      }
      list.replaceChildren(...findings.map((f) => {
        const li = document.createElement('li');
        li.textContent = f;
        return li;
      }));
      summary.textContent = findings.length
        ? `${findings.length} thing${findings.length === 1 ? '' : 's'} to fix.`
        : 'No gaps found by these checks.';
      out.classList.add('show');
    });
  });
</script>
