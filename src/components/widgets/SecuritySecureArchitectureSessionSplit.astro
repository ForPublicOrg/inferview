---
// Per-session capability matrix for one email and calendar assistant. The reader assigns each tool or channel to
// session 1, session 2 or neither, and chooses whether session 2 reads session 1's free text. Each session is scored on
// the Agents Rule of Two (Meta, 31 October 2025): [A] untrusted input, [B] sensitive data or systems, [C] state change
// or external communication. The lethal trifecta (Willison, 16 June 2025) is A, B and an outbound channel.
interface Tool {
  id: string;
  name: string;
  note: string;
  a?: boolean;
  b?: boolean;
  c?: boolean;
  out?: boolean;
  start: '1' | '2' | 'x';
}
interface Props {
  title?: string;
}
const TOOLS: Tool[] = [
  { id: 'inbox', name: 'read_inbox', note: 'Private mail; anyone on the internet can write a message into it.', a: true, b: true, start: '1' },
  { id: 'cal', name: 'read_calendar', note: 'Private calendar; invitations from outside also land here.', a: true, b: true, start: '1' },
  { id: 'fetch', name: 'fetch_url(url)', note: 'Reads any page; the URL it requests carries data out.', a: true, c: true, out: true, start: '1' },
  { id: 'send', name: 'send_email', note: 'Sends mail to any address.', c: true, out: true, start: '1' },
  { id: 'event', name: 'create_event', note: 'Writes the calendar; external attendees get an invitation.', c: true, out: true, start: '2' },
  { id: 'img', name: 'Markdown images rendered', note: 'The client fetches any image URL the model writes.', c: true, out: true, start: '1' },
];
const { title = 'Split one agent into sessions' } = Astro.props;
const uid = `ssa-${title.replace(/[^a-z0-9]+/gi, '-').toLowerCase().slice(0, 24)}`;
const PLACES = [
  { v: '1', label: 'Session 1' },
  { v: '2', label: 'Session 2' },
  { v: 'x', label: 'Not given' },
];
---
<div class="widget" data-ssa={JSON.stringify(TOOLS)}>
  <header><h4>{title}</h4><span class="tiny">fixed tool catalogue, no model runs here</span></header>
  <div class="tablewrap">
    <table>
      <thead><tr><th scope="col">Tool or channel</th><th scope="col">Where it lives</th></tr></thead>
      <tbody>
        {TOOLS.map((t) => (
          <tr>
            <td>
              <label for={`${uid}-${t.id}`}><span class="mono">{t.name}</span></label>
              <br /><small>{t.note}</small>
            </td>
            <td>
              <select class="field" id={`${uid}-${t.id}`} data-tool={t.id} style="max-width: 100%">
                {PLACES.map((p) => <option value={p.v} selected={p.v === t.start}>{p.label}</option>)}
              </select>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <label class="row" style="margin-top: 12px; font-size: 14px; min-height: 44px" for={`${uid}-flow`}>
    <input type="checkbox" id={`${uid}-flow`} data-flow />
    Session 2 reads session 1's free-text output (a summary, a draft, extracted notes)
  </label>
  <label class="row" style="font-size: 14px; min-height: 44px" for={`${uid}-typed`}>
    <input type="checkbox" id={`${uid}-typed`} data-typed />
    Session 2 receives only validated typed fields from session 1 (a contact id from the address book, a date)
  </label>
  <div class="tablewrap" style="margin-top: 12px">
    <table>
      <thead>
        <tr><th scope="col">Session</th><th scope="col">A</th><th scope="col">B</th><th scope="col">C</th><th scope="col">Verdict</th></tr>
      </thead>
      <tbody>
        {['1', '2'].map((s) => (
          <tr>
            <th scope="row">{`Session ${s}`}</th>
            <td class="mono" data-cell={`${s}a`}></td>
            <td class="mono" data-cell={`${s}b`}></td>
            <td class="mono" data-cell={`${s}c`}></td>
            <td data-cell={`${s}v`}></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="tiny" style="margin-top: 8px">A: untrusted input. B: sensitive data or systems. C: state change or external communication.</p>
  <p data-o="note" aria-live="polite"></p>
</div>

<script>
  type Tool = { id: string; name: string; a?: boolean; b?: boolean; c?: boolean; out?: boolean };
  type Legs = { a: string[]; b: string[]; c: string[]; out: string[] };

  const legsOf = (ts: Tool[]): Legs => ({
    a: ts.filter((t) => t.a).map((t) => t.name),
    b: ts.filter((t) => t.b).map((t) => t.name),
    c: ts.filter((t) => t.c).map((t) => t.name),
    out: ts.filter((t) => t.out).map((t) => t.name),
  });

  document.querySelectorAll<HTMLElement>('[data-ssa]').forEach((root) => {
    const tools = JSON.parse(root.dataset.ssa ?? '[]') as Tool[];
    const selects = [...root.querySelectorAll<HTMLSelectElement>('select[data-tool]')];
    const flow = root.querySelector<HTMLInputElement>('[data-flow]');
    const typed = root.querySelector<HTMLInputElement>('[data-typed]');
    const cell = (k: string) => root.querySelector<HTMLElement>(`[data-cell="${k}"]`);
    const note = root.querySelector<HTMLElement>('[data-o="note"]');

    const render = () => {
      const place = new Map(selects.map((s) => [s.dataset.tool, s.value]));
      const in1 = tools.filter((t) => place.get(t.id) === '1');
      const in2 = tools.filter((t) => place.get(t.id) === '2');
      const l1 = legsOf(in1);
      const l2 = legsOf(in2);
      // Free text derived from untrusted input carries A into the session that reads it.
      const tainted = !!flow?.checked && l1.a.length > 0;
      if (tainted) l2.a.push('session 1 free text');
      const lines: string[] = [];
      ([['1', l1], ['2', l2]] as const).forEach(([s, l]) => {
        const mark = (k: 'a' | 'b' | 'c') => {
          const el = cell(`${s}${k}`);
          if (!el) return;
          el.textContent = l[k].length ? 'yes' : 'no';
          el.title = l[k].join(', ') || 'nothing supplies this';
        };
        mark('a');
        mark('b');
        mark('c');
        const count = [l.a, l.b, l.c].filter((x) => x.length > 0).length;
        const tri = l.a.length > 0 && l.b.length > 0 && l.out.length > 0;
        const v = cell(`${s}v`);
        if (v) v.textContent = count === 3 ? `3 of 3: supervise${tri ? ', trifecta' : ''}` : `${count} of 3: autonomous`;
        if (count === 3) lines.push(`Session ${s}: text from ${l.a.join(', ')} can drive ${l.c.join(', ')} with ${l.b.join(', ')} in context.`);
      });
      if (!!flow?.checked && !!typed?.checked) lines.push('Both crossings are ticked; the free-text one decides. A typed field only removes A when it is the only thing that crosses.');
      else if (!flow?.checked && !!typed?.checked && l1.a.length > 0) lines.push('Typed fields cross without carrying A only if the validator rejects anything outside the type, and the values (which contact, which date) are still chosen under attacker influence.');
      if (!lines.length) lines.push('No session holds all three properties.');
      if (note) note.textContent = lines.join(' ');
    };

    selects.forEach((s) => s.addEventListener('change', render));
    flow?.addEventListener('change', render);
    typed?.addEventListener('change', render);
    render();
  });
</script>
