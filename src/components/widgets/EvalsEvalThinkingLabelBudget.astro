---
// Labelling budget for one failure mode: how many binary labels it takes to reach a target count of failing and
// passing examples, how many expert hours that costs, and whether it fits the programme window.
// Every value is an input; defaults are the lesson's scenario. Pure arithmetic, so the output is deterministic.
interface Props {
  title?: string;
  note?: string;
}
const { title = 'Labelling budget for one failure mode', note = 'scenario defaults; change any field' } = Astro.props;
const uid = `elb-${Math.abs([...title].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7))}`;
const fields = [
  { k: 'hours', label: 'expert hours per week', value: 4, step: '0.5' },
  { k: 'reserved', label: 'of which reserved for fresh traces', value: 1, step: '0.5' },
  { k: 'min', label: 'minutes per binary label', value: 1.5, step: '0.1' },
  { k: 'rate', label: 'failure rate in the sampled pool, %', value: 6, step: '1' },
  { k: 'fails', label: 'failing examples needed', value: 60, step: '5' },
  { k: 'passes', label: 'passing examples needed', value: 60, step: '5' },
  { k: 'weeks', label: 'programme length, weeks', value: 6, step: '1' },
];
---
<div class="widget elb" data-elb>
  <header><h4>{title}</h4><span class="tiny">{note}</span></header>
  <div class="elb-grid">
    {fields.map((f) => (
      <label class="elb-field" for={`${uid}-${f.k}`}>
        <span>{f.label}</span>
        <input type="number" id={`${uid}-${f.k}`} data-k={f.k} value={f.value} step={f.step} min="0" inputmode="decimal" />
      </label>
    ))}
  </div>
  <p class="tiny elb-err" data-err role="alert" hidden></p>
  <div class="meter" data-out>
    <div><b data-o="labels"></b><span>labels to reach both targets</span></div>
    <div><b data-o="hours"></b><span>expert hours for this mode</span></div>
    <div><b data-o="weeks"></b><span>weeks at the labelling budget</span></div>
    <div><b data-o="modes"></b><span>modes like this one in the window</span></div>
  </div>
  <div class="elb-kv">
    <div class="kv"><span>binding target</span><b data-o="bind"></b></div>
    <div class="kv"><span>labels of the other class beyond its target</span><b data-o="waste"></b></div>
    <div class="kv"><span>fits in the window</span><b data-o="fit"></b></div>
  </div>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style is:global>
  .elb-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 8px; }
  .elb-field { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--ink-2); min-width: 0; }
  .widget.elb .elb-field input { width: 100%; min-height: 40px; }
  .elb-err { color: var(--rose); margin: 8px 0 0; }
  .elb-kv { margin-top: 12px; display: grid; gap: 4px; }
  .elb-kv .kv { flex-wrap: wrap; }
  @media (max-width: 760px) { .elb-grid { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  type Inputs = { hours: number; reserved: number; min: number; rate: number; fails: number; passes: number; weeks: number };
  const int = (n: number) => Math.ceil(n).toLocaleString('en-US');
  const one = (n: number) => (Math.round(n * 10) / 10).toLocaleString('en-US');

  document.querySelectorAll<HTMLElement>('[data-elb]').forEach((root) => {
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-k]')];
    const err = root.querySelector<HTMLElement>('[data-err]')!;
    const outBox = root.querySelector<HTMLElement>('[data-out]')!;
    const out = (k: string, text: string) => {
      const el = root.querySelector<HTMLElement>(`[data-o="${k}"]`);
      if (el) el.textContent = text;
    };

    const read = (): Inputs | string => {
      const v: Inputs = { hours: 0, reserved: 0, min: 0, rate: 0, fails: 0, passes: 0, weeks: 0 };
      for (const i of inputs) {
        const n = Number(i.value);
        if (i.value.trim() === '' || !Number.isFinite(n) || n < 0) return 'Every field needs a number of zero or more.';
        const k = i.dataset.k as keyof Inputs;
        if (k in v) v[k] = n;
      }
      if (v.rate <= 0 || v.rate >= 100) return 'The failure rate must be above 0% and below 100%.';
      if (v.reserved >= v.hours) return 'Reserved hours must be fewer than the weekly hours, or nothing is left for labelling.';
      if (v.min <= 0) return 'Minutes per label must be above zero.';
      return v;
    };

    const render = () => {
      const v = read();
      if (typeof v === 'string') {
        err.textContent = v;
        err.hidden = false;
        outBox.style.opacity = '0.4';
        return;
      }
      err.hidden = true;
      outBox.style.opacity = '';
      const p = v.rate / 100;
      // Labels are drawn from the pool at its failure rate, so the class that is rarer in the pool sets the count.
      const forFails = v.fails / p;
      const forPasses = v.passes / (1 - p);
      const labels = Math.ceil(Math.max(forFails, forPasses));
      const hours = (labels * v.min) / 60;
      const perWeek = v.hours - v.reserved;
      const weeks = hours / perWeek;
      const windowHours = perWeek * v.weeks;
      const modes = hours > 0 ? Math.floor(windowHours / hours) : 0;
      const failsBind = forFails >= forPasses;

      out('labels', int(labels));
      out('hours', one(hours));
      out('weeks', one(weeks));
      out('modes', String(modes));
      out('bind', failsBind ? `failing examples (${v.fails} at ${v.rate}%)` : `passing examples (${v.passes} at ${one(100 - v.rate)}%)`);
      const extra = failsBind ? labels * (1 - p) - v.passes : labels * p - v.fails;
      out('waste', `${int(Math.max(0, extra))} ${failsBind ? 'passes' : 'fails'}`);
      out('fit', weeks <= v.weeks ? `yes, ${one(v.weeks - weeks)} weeks spare` : `no, short by ${one(hours - windowHours)} hours`);

      root.querySelector('[data-summary]')!.textContent =
        `${int(labels)} labels, ${one(hours)} expert hours, ${one(weeks)} weeks at ${one(perWeek)} labelling hours a week; ` +
        `${modes} modes like this fit in ${v.weeks} weeks.`;
    };
    inputs.forEach((i) => i.addEventListener('input', render));
    render();
  });
</script>
