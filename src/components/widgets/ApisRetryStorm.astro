---
// Retry storm simulator: N clients hit a server that admits a fixed number of requests per 100 ms tick.
// Compares immediate retry, exponential backoff and exponential backoff with full jitter. Seeded, so every run is repeatable.
// Props: title, capacity (requests admitted per tick), maxAttempts.
interface Props {
  title?: string;
  capacity?: number;
  maxAttempts?: number;
}
const { title = 'Retry storm: one server, many clients, three retry policies', capacity = 10, maxAttempts = 8 } = Astro.props;
const uid = `rs-${capacity}-${maxAttempts}`;
---
<div class="widget rs" data-retrystorm data-cap={capacity} data-max={maxAttempts}>
  <header><h4>{title}</h4><span class="tiny">toy model, seeded; not a provider measurement</span></header>
  <p>Every client sends at the same moment. The server admits {capacity} requests per 100 ms and answers the rest with 429. A client gives up after {maxAttempts} attempts. Backoff starts at 100 ms and is capped at 3.2 s.</p>
  <div class="row">
    <div class="toggle" role="group" aria-label="Retry policy">
      <button type="button" data-policy="immediate" aria-pressed="true">Retry at once</button>
      <button type="button" data-policy="exp" aria-pressed="false">Exponential</button>
      <button type="button" data-policy="jitter" aria-pressed="false">Full jitter</button>
    </div>
    <label class="rs-n" for={`${uid}-n`}>clients <b class="mono" data-nv>100</b>
      <input type="range" id={`${uid}-n`} min="20" max="200" step="10" value="100" data-n />
    </label>
  </div>
  <div class="rs-chart" data-bars role="img" aria-label="Attempts per 100 ms tick"></div>
  <div class="rs-axis tiny"><span>0 s</span><span>attempts per 100 ms; red ticks were over capacity</span><span>10 s</span></div>
  <div class="meter">
    <div><b data-m-att>0</b><span>total attempts</span></div>
    <div><b data-m-peak>0</b><span>peak attempts in one tick</span></div>
    <div><b data-m-ok>0</b><span>clients served</span></div>
    <div><b data-m-drain>0</b><span>last client served at</span></div>
  </div>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style>
  .rs-n { flex: 1; min-width: 160px; font-size: 13px; }
  .rs-chart { display: flex; align-items: flex-end; gap: 1px; height: 120px; margin-top: 14px; padding: 0 2px; border-bottom: 1px solid var(--line); }
  .rs-chart i { flex: 1; min-width: 0; background: var(--accent); border-radius: 2px 2px 0 0; }
  .rs-chart i.over { background: var(--rose); }
  .rs-axis { display: flex; justify-content: space-between; gap: 8px; margin-top: 4px; }
  .rs-axis span:nth-child(2) { text-align: center; }
</style>

<script>
  type Policy = 'immediate' | 'exp' | 'jitter';
  const TICKS = 100;
  const SIM_TICKS = 400;
  const BASE = 1;
  const CAP_DELAY = 32;

  // mulberry32: small seeded PRNG so the same inputs always draw the same chart.
  function rng(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function simulate(n: number, cap: number, maxAttempts: number, policy: Policy) {
    const rand = rng(42);
    const next = new Array<number>(n).fill(0);
    const tries = new Array<number>(n).fill(0);
    const done = new Array<boolean>(n).fill(false);
    const perTick: number[] = [];
    let attempts = 0, served = 0, drained = -1, peak = 0;
    for (let t = 0; t < SIM_TICKS; t++) {
      const now: number[] = [];
      for (let i = 0; i < n; i++) if (!done[i] && next[i] === t) now.push(i);
      // Arrival order inside a tick is random, so who gets the free slots is luck, as on a real server.
      for (let k = now.length - 1; k > 0; k--) {
        const j = Math.floor(rand() * (k + 1));
        [now[k], now[j]] = [now[j]!, now[k]!];
      }
      perTick.push(now.length);
      attempts += now.length;
      peak = Math.max(peak, now.length);
      now.forEach((i, pos) => {
        const tried = (tries[i] ?? 0) + 1;
        tries[i] = tried;
        if (pos < cap) {
          done[i] = true;
          served += 1;
          drained = t;
          return;
        }
        if (tried >= maxAttempts) {
          done[i] = true;
          return;
        }
        const ceiling = Math.min(CAP_DELAY, BASE * 2 ** (tried - 1));
        let delay = 1;
        if (policy === 'exp') delay = ceiling;
        if (policy === 'jitter') delay = Math.max(1, Math.round(rand() * ceiling));
        next[i] = t + delay;
      });
    }
    return { perTick: perTick.slice(0, TICKS), attempts, peak, served, gaveUp: n - served, drained };
  }

  document.querySelectorAll<HTMLElement>('[data-retrystorm]').forEach((root) => {
    const cap = Number(root.dataset.cap ?? 10);
    const maxAttempts = Number(root.dataset.max ?? 8);
    const bars = root.querySelector<HTMLElement>('[data-bars]')!;
    const slider = root.querySelector<HTMLInputElement>('[data-n]')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-policy]')];
    const set = (sel: string, v: string) => {
      const el = root.querySelector(sel);
      if (el) el.textContent = v;
    };
    const cols = Array.from({ length: TICKS }, () => {
      const i = document.createElement('i');
      bars.append(i);
      return i;
    });
    let policy: Policy = 'immediate';

    const render = () => {
      const n = Number(slider.value);
      set('[data-nv]', String(n));
      const r = simulate(n, cap, maxAttempts, policy);
      const top = Math.max(cap * 2, ...r.perTick);
      cols.forEach((c, i) => {
        const v = r.perTick[i] ?? 0;
        c.style.height = `${v === 0 ? 0 : Math.max(2, (v / top) * 118)}px`;
        c.classList.toggle('over', v > cap);
        c.title = `${(i / 10).toFixed(1)} s: ${v} attempts`;
      });
      set('[data-m-att]', String(r.attempts));
      set('[data-m-peak]', String(r.peak));
      set('[data-m-ok]', `${r.served} / ${n}`);
      set('[data-m-drain]', r.drained < 0 ? 'never' : `${(r.drained / 10).toFixed(1)} s`);
      const label = buttons.find((b) => b.dataset.policy === policy)?.textContent ?? policy;
      const summary = `${label}: ${r.attempts} attempts, peak ${r.peak} in one tick, ${r.served} of ${n} served, ${r.gaveUp} gave up.`;
      set('[data-summary]', summary);
      bars.setAttribute('aria-label', `Attempts per 100 ms tick. ${summary}`);
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        policy = (b.dataset.policy as Policy) ?? 'immediate';
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        render();
      }),
    );
    slider.addEventListener('input', render);
    render();
  });
</script>
