---
// Judgment pool simulator. Four systems return a top 10 for one query; the reader picks which systems contribute to
// the judgment pool and how deep it goes. Every document outside the pool counts as not relevant, so the widget shows,
// per system, the hole rate in its top 10 and nDCG@10 measured on the pool beside nDCG@10 with every document judged.
// Gains are 2^grade - 1 on a 0 to 3 scale; the measured ideal ordering uses judged documents only. Props: systems ({ name, docs }), grades (document to grade), title.
interface System {
  name: string;
  docs: string[];
}
interface Props {
  systems?: System[];
  grades?: Record<string, number>;
  title?: string;
}
const {
  systems = [
    { name: 'BM25', docs: ['d03', 'd01', 'd07', 'd02', 'd14', 'd04', 'd05', 'd11', 'd06', 'd08'] },
    { name: 'Dense', docs: ['d11', 'd21', 'd03', 'd09', 'd18', 'd10', 'd07', 'd12', 'd27', 'd13'] },
    { name: 'Hybrid (RRF)', docs: ['d03', 'd11', 'd07', 'd21', 'd01', 'd14', 'd18', 'd02', 'd09', 'd04'] },
    { name: 'New embedding model', docs: ['d27', 'd11', 'd21', 'd25', 'd03', 'd18', 'd15', 'd16', 'd07', 'd17'] },
  ],
  grades = { d03: 3, d07: 2, d11: 3, d14: 1, d18: 2, d21: 2, d25: 1, d27: 3 },
  title = 'Judgment pool simulator',
} = Astro.props;
const startIn = [0, 2];
---
<div class="widget" data-rsqpool data-systems={JSON.stringify(systems)} data-grades={JSON.stringify(grades)}>
  <header>
    <h4>{title}</h4>
    <div class="toggle" role="group" aria-label="Pool depth">
      {[5, 10].map((d) => <button type="button" data-depth={d} aria-pressed={d === 10 ? 'true' : 'false'}>depth {d}</button>)}
    </div>
  </header>
  <p class="tiny" style="margin-top: 0">One query, four systems, toy documents d01 to d27 graded 0 to 3. Choose the systems whose top results annotators judge.</p>
  <fieldset class="rsq-pick">
    <legend class="label">Systems in the pool</legend>
    {systems.map((s, i) => (
      <label><input type="checkbox" data-sys={i} checked={startIn.includes(i)} /> {s.name}</label>
    ))}
  </fieldset>
  <p class="rsq-total" data-total aria-live="polite"></p>
  <ul class="rsq-rows" data-rows></ul>
  <p class="tiny" style="margin: 8px 0 0">Measured: unjudged documents score 0 and the ideal ordering knows only judged documents. Full: every document judged. Holes: unjudged documents in that system's top 10.</p>
</div>

<style is:global>
  .rsq-pick { border: 0; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; }
  .rsq-pick legend { margin-bottom: 6px; }
  .rsq-pick label { display: inline-flex; gap: 6px; align-items: center; font-size: 14px; }
  .rsq-total { margin: 12px 0 8px; font-size: 14px; }
  .rsq-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .rsq-rows li { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; padding: 6px 8px; border: 1px solid var(--line); border-radius: 6px; font-size: 14px; }
  .rsq-rows .s { flex: 1; min-width: 150px; font-weight: 600; overflow-wrap: anywhere; }
  .rsq-rows .m { font-family: var(--mono); font-size: 12.5px; color: var(--ink-2); }
  .rsq-rows .gap { color: var(--ink); font-weight: 600; }
</style>

<script>
  type Sys = { name: string; docs: string[] };
  document.querySelectorAll<HTMLElement>('[data-rsqpool]').forEach((root) => {
    const systems = JSON.parse(root.dataset.systems ?? '[]') as Sys[];
    const grades = JSON.parse(root.dataset.grades ?? '{}') as Record<string, number>;
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-sys]')];
    const depthBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-depth]')];
    const total = root.querySelector<HTMLElement>('[data-total]')!;
    const rows = root.querySelector<HTMLElement>('[data-rows]')!;
    let depth = 10;

    const gain = (g: number) => 2 ** g - 1;
    const dcg = (gs: number[]) => gs.reduce((s, g, i) => s + gain(g) / Math.log2(i + 2), 0);
    // The ideal ordering can only use documents someone judged, as trec_eval computes it from the qrels.
    const ndcg = (docs: string[], judged: (d: string) => boolean) => {
      const known = Object.keys(grades).filter(judged).map((d) => grades[d]!).sort((a, b) => b - a).slice(0, 10);
      const ideal = dcg(known);
      return ideal ? dcg(docs.slice(0, 10).map((d) => (judged(d) ? grades[d] ?? 0 : 0))) / ideal : 0;
    };

    const render = () => {
      const pool = new Set<string>();
      boxes.forEach((b) => {
        if (b.checked) systems[Number(b.dataset.sys)]!.docs.slice(0, depth).forEach((d) => pool.add(d));
      });
      const relevantInPool = [...pool].filter((d) => (grades[d] ?? 0) > 0).length;
      const relevantAll = Object.values(grades).filter((g) => g > 0).length;
      total.textContent = pool.size
        ? `${pool.size} judgments for this query; the pool holds ${relevantInPool} of the ${relevantAll} relevant documents.`
        : 'No system in the pool: nothing is judged and every score is 0.';
      rows.replaceChildren();
      systems.forEach((s) => {
        const holes = s.docs.slice(0, 10).filter((d) => !pool.has(d)).length;
        const measured = ndcg(s.docs, (d) => pool.has(d));
        const full = ndcg(s.docs, () => true);
        const li = document.createElement('li');
        const name = document.createElement('span');
        name.className = 's';
        name.textContent = s.name;
        const m = document.createElement('span');
        m.className = 'm';
        m.textContent = `holes ${holes}/10, measured ${measured.toFixed(3)}, full ${full.toFixed(3)}`;
        li.append(name, m);
        const diff = measured - full;
        if (Math.abs(diff) > 0.0005) {
          const gap = document.createElement('span');
          gap.className = 'm gap';
          gap.textContent = `${diff > 0 ? 'overstated' : 'understated'} by ${Math.abs(diff).toFixed(3)}`;
          li.append(gap);
        }
        rows.append(li);
      });
    };

    boxes.forEach((b) => b.addEventListener('change', render));
    depthBtns.forEach((btn) =>
      btn.addEventListener('click', () => {
        depth = Number(btn.dataset.depth);
        depthBtns.forEach((o) => o.setAttribute('aria-pressed', o === btn ? 'true' : 'false'));
        render();
      }),
    );
    render();
  });
</script>
