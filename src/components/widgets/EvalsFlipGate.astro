---
// Paired CI gate: the same n cases run on the baseline and the candidate. Inputs: n, baseline passes, cases that broke
// (passed before, fail now) and cases that got fixed. Shows both Wilson 95% intervals, whether they overlap, and the exact
// one-sided sign test on the flipped cases (McNemar's exact form). Props: n, base, broke, fixed, alpha, title.
interface Props {
  n?: number;
  base?: number;
  broke?: number;
  fixed?: number;
  alpha?: number;
  title?: string;
}
const { n = 200, base = 170, broke = 9, fixed = 2, alpha = 0.05, title = 'CI gate on a paired eval' } = Astro.props;
const fields = [
  { key: 'n', label: 'cases in the suite', value: n },
  { key: 'base', label: 'baseline passes', value: base },
  { key: 'broke', label: 'cases that broke', value: broke },
  { key: 'fixed', label: 'cases that got fixed', value: fixed },
];
---
<div class="widget" data-flipgate data-alpha={alpha}>
  <header><h4>{title}</h4><span class="tiny">same cases, baseline vs candidate, pass or fail per case</span></header>
  <div class="fg-grid">
    {fields.map((f) => (
      <label class="fg-l" for={`fg-${f.key}`}>{f.label}
        <input type="number" id={`fg-${f.key}`} min="0" step="1" value={f.value} inputmode="numeric" data-in={f.key} />
      </label>
    ))}
  </div>
  <div class="gauges">
    <div><b data-bp></b><span>baseline pass rate</span></div>
    <div><b data-cp></b><span>candidate pass rate</span></div>
    <div><b data-pv></b><span>sign test p, one-sided</span></div>
    <div><b data-verdict></b><span>gate at alpha {alpha}</span></div>
  </div>
  <div class="kv"><span>baseline 95% Wilson interval</span><b data-bci></b></div>
  <div class="kv"><span>candidate 95% Wilson interval</span><b data-cci></b></div>
  <div class="kv"><span>do the intervals overlap?</span><b data-overlap></b></div>
  <p class="tiny" data-note aria-live="polite" style="margin: 10px 0 0"></p>
</div>

<style>
  .fg-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  @media (max-width: 600px) { .fg-grid { grid-template-columns: 1fr 1fr; } }
  .fg-l { display: flex; flex-direction: column; gap: 4px; font-size: 13px; min-width: 0; }
  .fg-l input { width: 100%; min-width: 0; }
</style>

<script>
  function wilson(passes: number, n: number, z = 1.96): [number, number] {
    const p = passes / n;
    const centre = (p + (z * z) / (2 * n)) / (1 + (z * z) / n);
    const half = (z * Math.sqrt((p * (1 - p)) / n + (z * z) / (4 * n * n))) / (1 + (z * z) / n);
    return [centre - half, centre + half];
  }

  // P(at least `broke` regressions among the flips if each flip were a fair coin). Summed in log space so large
  // flip counts do not overflow.
  function oneSidedP(broke: number, fixed: number): number {
    const m = broke + fixed;
    if (m === 0 || broke === 0) return 1;
    let lnC = 0;
    let s = 0;
    for (let i = 0; i <= m; i++) {
      if (i > 0) lnC += Math.log(m - i + 1) - Math.log(i);
      if (i >= broke) s += Math.exp(lnC - m * Math.LN2);
    }
    return Math.min(1, s);
  }

  const pct = (x: number) => `${(x * 100).toFixed(1)}%`;
  const ci = ([lo, hi]: [number, number]) => `${lo.toFixed(3)} to ${hi.toFixed(3)}`;

  document.querySelectorAll<HTMLElement>('[data-flipgate]').forEach((root) => {
    const alpha = Number(root.dataset.alpha ?? 0.05);
    const inputs = new Map([...root.querySelectorAll<HTMLInputElement>('[data-in]')].map((el) => [el.dataset.in ?? '', el]));
    const val = (k: string) => Math.max(0, Math.floor(Number(inputs.get(k)?.value) || 0));
    const set = (sel: string, v: string) => (root.querySelector(sel)!.textContent = v);
    const note = root.querySelector<HTMLElement>('[data-note]')!;

    const render = () => {
      const n = Math.max(1, Math.min(val('n'), 5000));
      const base = Math.min(val('base'), n);
      const broke = Math.min(val('broke'), base);
      const fixed = Math.min(val('fixed'), n - base);
      const cand = base - broke + fixed;
      const b = wilson(base, n);
      const c = wilson(cand, n);
      const p = oneSidedP(broke, fixed);
      const pass = p >= alpha;
      set('[data-bp]', `${base}/${n}`);
      set('[data-cp]', `${cand}/${n}`);
      set('[data-pv]', p.toFixed(4));
      set('[data-verdict]', pass ? 'merge' : 'block');
      root.querySelector('[data-verdict]')!.classList.toggle('bad', !pass);
      set('[data-bci]', ci(b));
      set('[data-cci]', ci(c));
      set('[data-overlap]', b[0] <= c[1] && c[0] <= b[1] ? 'yes' : 'no');
      const clamped = broke !== val('broke') || fixed !== val('fixed') || base !== val('base');
      note.textContent =
        (clamped ? 'Some inputs were out of range and were clamped. ' : '') +
        `${broke + fixed} cases flipped: ${broke} broke, ${fixed} fixed. Pass rates ${pct(base / n)} and ${pct(cand / n)}. ` +
        (pass ? 'The flips are consistent with noise at this alpha.' : 'Too many flips went one way for noise to explain at this alpha.');
    };
    inputs.forEach((el) => el.addEventListener('input', render));
    render();
  });
</script>
