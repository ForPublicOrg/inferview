---
// Temperature and top-p over fixed example logits, drawn as bars. Props: prompt, logits ([token, logit][]), note, title.
interface Props {
  prompt?: string;
  logits?: [string, number][];
  note?: string;
  title?: string;
  inline?: boolean;
}
const {
  prompt = 'The capital of France is',
  logits = [['Paris', 6.1], ['the', 3.4], ['a', 3.0], ['Lyon', 2.2], ['located', 2.0], ['Marseille', 1.1]],
  note = 'example logits, not a model',
  title,
  inline = false,
} = Astro.props;
const heading = title ?? `Sampling lab: next token after "${prompt}"`;
const uid = `sl-${prompt.replace(/[^a-z0-9]+/gi, '-').toLowerCase().slice(0, 24)}`;
---
<div class="widget" data-sampling={JSON.stringify(logits)} style={inline ? 'margin: 0' : undefined}>
  <header><h4>{heading}</h4><span class="tiny">{note}</span></header>
  <div class="bars" data-bars role="img" aria-label="Probability of each candidate token"></div>
  <div style="height: 22px"></div>
  <div class="row" style="margin-top: 10px">
    <label style="flex: 1; font-size: 13px; min-width: 140px" for={`${uid}-t`}>temperature <b class="mono" data-tv>1.00</b>
      <input type="range" min="0.05" max="2" step="0.05" value="1" id={`${uid}-t`} data-temp />
    </label>
    <label style="flex: 1; font-size: 13px; min-width: 140px" for={`${uid}-p`}>top-p <b class="mono" data-pv>1.00</b>
      <input type="range" min="0.1" max="1" step="0.05" value="1" id={`${uid}-p`} data-topp />
    </label>
  </div>
  <div class="kv" style="margin-top: 8px"><span>tokens still in the draw</span><b data-inplay></b></div>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-sampling]').forEach((root) => {
    const logits = JSON.parse(root.dataset.sampling ?? '[]') as [string, number][];
    const bars = root.querySelector<HTMLElement>('[data-bars]')!;
    const temp = root.querySelector<HTMLInputElement>('[data-temp]')!;
    const topp = root.querySelector<HTMLInputElement>('[data-topp]')!;
    const cols = logits.map(([tok]) => {
      const d = document.createElement('div');
      const s = document.createElement('span');
      s.textContent = tok;
      d.append(s);
      bars.append(d);
      return d;
    });
    const render = () => {
      const T = Number(temp.value);
      const P = Number(topp.value);
      root.querySelector('[data-tv]')!.textContent = T.toFixed(2);
      root.querySelector('[data-pv]')!.textContent = P.toFixed(2);
      const z = logits.map(([, l]) => l / T);
      const m = Math.max(...z);
      const e = z.map((v) => Math.exp(v - m));
      const sum = e.reduce((a, b) => a + b, 0);
      const p = e.map((v) => v / sum);
      // Nucleus: keep the most likely tokens until their cumulative probability reaches top-p.
      const order = p.map((v, i) => [v, i] as const).sort((a, b) => b[0] - a[0]);
      let cum = 0;
      const keep = new Set<number>();
      for (const [v, i] of order) {
        if (cum < P) keep.add(i);
        cum += v;
      }
      cols.forEach((c, i) => {
        c.style.height = `${Math.max(3, p[i]! * 118)}px`;
        c.classList.toggle('cut', !keep.has(i));
        c.title = `${logits[i]![0]}: ${(p[i]! * 100).toFixed(1)}%`;
      });
      root.querySelector('[data-inplay]')!.textContent = `${keep.size} / ${p.length}`;
      const top = order[0];
      root.querySelector('[data-summary]')!.textContent = top
        ? `${logits[top[1]]![0]} has ${(top[0] * 100).toFixed(0)}% probability; ${keep.size} of ${p.length} tokens in the draw.`
        : '';
    };
    temp.addEventListener('input', render);
    topp.addEventListener('input', render);
    render();
  });
</script>
