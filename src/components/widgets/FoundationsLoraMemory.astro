---
// Model-state memory for full, LoRA and QLoRA fine-tuning of the Llama 3.1 8B config. Props: title.
// Bytes: 16 per trained parameter (ZeRO), 2 per frozen bf16, 0.5 per frozen 4-bit; activations are not counted.
interface Props {
  title?: string;
}
const { title = 'Fine-tuning memory: full, LoRA, QLoRA' } = Astro.props;
const ranks = [4, 8, 16, 32, 64, 128];
const methods = ['full', 'LoRA', 'QLoRA'];
---
<div class="widget" data-flora>
  <header><h4>{title}</h4><span class="tiny">Llama 3.1 8B shape, model states only</span></header>
  <div class="row" style="margin-bottom: 10px">
    <span class="label">Method</span>
    <span class="toggle" role="group" aria-label="Fine-tuning method">
      {methods.map((m, i) => <button type="button" data-method={m} aria-pressed={i === 1 ? 'true' : 'false'}>{m}</button>)}
    </span>
  </div>
  <div class="row" style="margin-bottom: 12px">
    <span class="label">Adapter rank r</span>
    <span class="toggle" role="group" aria-label="Adapter rank" style="flex-wrap: wrap">
      {ranks.map((r) => <button type="button" data-rank={r} aria-pressed={r === 16 ? 'true' : 'false'}>{r}</button>)}
    </span>
  </div>
  <div class="meter" style="grid-template-columns: repeat(auto-fit, minmax(130px, 1fr))">
    <div><b data-trainable>0</b><span>trainable parameters</span></div>
    <div><b data-share>0</b><span>share of the model</span></div>
    <div><b data-frozen>0</b><span>GB frozen weights</span></div>
    <div><b data-total>0</b><span>GB model states</span></div>
  </div>
  <p class="tiny" style="margin: 10px 0 0" aria-live="polite" data-formula></p>
</div>

<script>
  // From config.json: untied 128256 x 4096 embedding and output, 32 layers of attention and MLP, RMSNorm weights.
  const TOTAL = 8_030_261_248;
  // LoRA on q, k, v, o, gate, up and down: r x (d_in + d_out) per matrix, 32 layers.
  const LORA_PER_RANK = 32 * ((4096 + 4096) * 2 + (4096 + 1024) * 2 + (4096 + 14336) * 3);

  const gb = (bytes: number) => (bytes / 1e9).toLocaleString('en-US', { maximumFractionDigits: 1 });
  const big = (n: number) =>
    n >= 1e9 ? `${(n / 1e9).toFixed(2)}B` : n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n.toLocaleString('en-US');

  document.querySelectorAll<HTMLElement>('[data-flora]').forEach((root) => {
    const mBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-method]')];
    const rBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-rank]')];
    let method = 'LoRA';
    let rank = 16;

    const render = () => {
      mBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.method === method)));
      rBtns.forEach((b) => {
        b.setAttribute('aria-pressed', String(Number(b.dataset.rank) === rank));
        b.disabled = method === 'full';
      });
      const trainable = method === 'full' ? TOTAL : rank * LORA_PER_RANK;
      const frozenBytes = method === 'full' ? 0 : method === 'LoRA' ? TOTAL * 2 : TOTAL * 0.5;
      const trainBytes = trainable * 16;
      const total = frozenBytes + trainBytes;
      root.querySelector('[data-trainable]')!.textContent = big(trainable);
      root.querySelector('[data-share]')!.textContent = `${((trainable / TOTAL) * 100).toFixed(method === 'full' ? 0 : 2)}%`;
      root.querySelector('[data-frozen]')!.textContent = gb(frozenBytes);
      root.querySelector('[data-total]')!.textContent = gb(total);
      const frozenText =
        method === 'full' ? '' : ` + ${big(TOTAL)} frozen × ${method === 'LoRA' ? '2 bytes (bf16)' : '0.5 bytes (4-bit)'}`;
      root.querySelector('[data-formula]')!.textContent =
        `${big(trainable)} trained × 16 bytes${frozenText} = ${gb(total)} GB, before activations.`;
    };

    mBtns.forEach((b) => b.addEventListener('click', () => { method = b.dataset.method ?? 'LoRA'; render(); }));
    rBtns.forEach((b) => b.addEventListener('click', () => { rank = Number(b.dataset.rank); render(); }));
    render();
  });
</script>
