---
// pass@k vs pass^k for one task with a fixed per-trial success rate p and independent trials:
// pass@k = 1 - (1 - p)^k (at least one of k trials succeeds), pass^k = p^k (all k succeed). Props: p, k, title.
interface Props {
  p?: number;
  k?: number;
  title?: string;
}
const { p = 0.75, k = 3, title = 'pass@k and pass^k for one task' } = Astro.props;
---
<div class="widget" data-passk data-p={p} data-k={k}>
  <header><h4>{title}</h4><span class="tiny">independent trials, same success rate each time</span></header>
  <div class="row">
    <label class="pk-l">success rate per trial, p <b class="mono" data-pv></b>
      <input type="range" min="0.05" max="1" step="0.05" data-p-in />
    </label>
    <label class="pk-l">trials, k <b class="mono" data-kv></b>
      <input type="range" min="1" max="10" step="1" data-k-in />
    </label>
  </div>
  <div class="gauges">
    <div><b data-at></b><span>pass@k: at least one succeeds</span></div>
    <div><b data-hat></b><span>pass^k: all k succeed</span></div>
    <div><b data-fail></b><span>chance a user sees a failure in k tries</span></div>
    <div><b data-gap></b><span>gap between the two, points</span></div>
  </div>
  <div class="tablewrap">
    <table class="pk-t">
      <caption class="sr-only">pass@k and pass^k for k from 1 to 10 at the chosen p</caption>
      <thead><tr><th scope="col">k</th><th scope="col">pass@k</th><th scope="col">pass^k</th></tr></thead>
      <tbody data-rows></tbody>
    </table>
  </div>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style>
  .pk-l { flex: 1; font-size: 13px; min-width: 150px; }
  .pk-t { border-collapse: collapse; width: 100%; font-size: 13px; }
  .pk-t th, .pk-t td { padding: 3px 6px; border-bottom: 1px solid var(--line); text-align: left; }
  .pk-t th:first-child, .pk-t td:first-child { width: 2.5em; font-family: var(--mono); }
  .pk-t thead th { color: var(--ink-3); font-weight: 600; font-size: 12.5px; }
  .pk-t tr.cur td { background: var(--bg-2); font-weight: 600; }
  .pk-cell { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .pk-cell i { display: block; height: 8px; border-radius: 2px; background: var(--accent); flex: none; }
  .pk-cell i.hat { background: var(--ember); }
  .pk-cell span { font-family: var(--mono); font-size: 12.5px; white-space: nowrap; }
</style>

<script>
  const pct = (x: number) => `${(x * 100).toFixed(1)}%`;

  function cell(v: number, cls: string): HTMLTableCellElement {
    const td = document.createElement('td');
    const wrap = document.createElement('div');
    wrap.className = 'pk-cell';
    const bar = document.createElement('i');
    bar.className = cls;
    bar.style.width = `${Math.round(v * 50)}px`;
    const s = document.createElement('span');
    s.textContent = pct(v);
    wrap.append(bar, s);
    td.append(wrap);
    return td;
  }

  document.querySelectorAll<HTMLElement>('[data-passk]').forEach((root) => {
    const pIn = root.querySelector<HTMLInputElement>('[data-p-in]')!;
    const kIn = root.querySelector<HTMLInputElement>('[data-k-in]')!;
    const rows = root.querySelector<HTMLElement>('[data-rows]')!;
    const set = (sel: string, v: string) => (root.querySelector(sel)!.textContent = v);
    pIn.value = root.dataset.p ?? '0.75';
    kIn.value = root.dataset.k ?? '3';

    const render = () => {
      const p = Number(pIn.value);
      const k = Number(kIn.value);
      const at = 1 - (1 - p) ** k;
      const hat = p ** k;
      set('[data-pv]', p.toFixed(2));
      set('[data-kv]', String(k));
      set('[data-at]', pct(at));
      set('[data-hat]', pct(hat));
      set('[data-fail]', pct(1 - hat));
      set('[data-gap]', ((at - hat) * 100).toFixed(1));
      rows.replaceChildren();
      for (let j = 1; j <= 10; j++) {
        const tr = document.createElement('tr');
        if (j === k) tr.className = 'cur';
        const th = document.createElement('td');
        th.textContent = String(j);
        tr.append(th, cell(1 - (1 - p) ** j, ''), cell(p ** j, 'hat'));
        rows.append(tr);
      }
      set('[data-summary]', `p ${p.toFixed(2)}, k ${k}: pass@k ${pct(at)}, pass^k ${pct(hat)}.`);
    };
    pIn.addEventListener('input', render);
    kIn.addEventListener('input', render);
    render();
  });
</script>
