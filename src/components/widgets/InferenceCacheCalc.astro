---
// Prompt caching break-even. Multipliers are relative to the base input price and were read from the
// Anthropic and OpenAI pricing pages on 2026-10-28. Simplification: every miss writes the prefix to the cache.
// Props: title, id (unique on the page).
interface Props {
  title?: string;
  id?: string;
}
const { title = 'Prompt caching: when does it pay?', id = 'cachecalc' } = Astro.props;
const PRESETS = [
  { v: '1.25,0.1', label: 'Anthropic, 5-minute write, most models (write 1.25x, read 0.1x)' },
  { v: '2,0.1', label: 'Anthropic, 1-hour write, most models (write 2x, read 0.1x)' },
  { v: '1.25,0.05', label: 'Anthropic Opus 5.5 or Sonnet 5.5, 5-minute write (write 1.25x, read 0.05x)' },
  { v: '1.25,0.05', label: 'OpenAI gpt-6.1-sol, 30-minute write (write 1.25x, read 0.05x)' },
  { v: '2.5,0.05', label: 'OpenAI gpt-6.1-sol, 12-hour write, Responses API (write 2.5x, read 0.05x)' },
];
---
<div class="widget icc" data-icc>
  <header><h4>{title}</h4><span class="tiny">list-price multipliers checked 28 Oct 2026</span></header>
  <label class="icc-field" for={`${id}-p`}>Provider and cache lifetime
    <select id={`${id}-p`} data-k="p">{PRESETS.map((p, i) => <option value={p.v} selected={i === 0}>{p.label}</option>)}</select>
  </label>
  <div class="row" style="margin-top: 10px">
    <label class="icc-field" for={`${id}-h`}>cache hit rate <b class="mono" data-v="h"></b>
      <input type="range" id={`${id}-h`} min="0" max="1" step="0.01" value="0.5" data-k="h" />
    </label>
    <label class="icc-field" for={`${id}-s`}>cacheable prefix, share of input tokens <b class="mono" data-v="s"></b>
      <input type="range" id={`${id}-s`} min="0.05" max="1" step="0.05" value="0.9" data-k="s" />
    </label>
  </div>
  <div class="gauges">
    <div><b data-o="pre"></b><span>prefix cost vs no caching</span></div>
    <div><b data-o="all"></b><span>all input cost vs no caching</span></div>
    <div><b data-o="be"></b><span>break-even hit rate</span></div>
    <div><b data-o="verdict"></b><span>at this hit rate</span></div>
  </div>
  <p class="tiny" style="margin: 0">Output tokens are not affected by caching and are left out. A real cache miss on a prefix that is still warm elsewhere may not write again, so treat this as the pessimistic case.</p>
  <p class="sr-only" aria-live="polite" data-o="live"></p>
</div>

<style>
  .icc-field { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--ink-2); flex: 1; min-width: 200px; }
  .icc-field select { font: inherit; font-size: 14px; padding: 8px 10px; min-height: 44px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); max-width: 100%; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-icc]').forEach((root) => {
    const input = (k: string) => root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-k="${k}"]`)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const pct = (x: number) => `${(x * 100).toFixed(0)}%`;
    const render = () => {
      const [w, r] = input('p').value.split(',').map(Number) as [number, number];
      const h = Number(input('h').value);
      const s = Number(input('s').value);
      // Per request, the prefix costs r on a hit and w on a miss, against 1 without caching.
      const pre = h * r + (1 - h) * w;
      const all = s * pre + (1 - s);
      const be = (w - 1) / (w - r);
      root.querySelector('[data-v="h"]')!.textContent = pct(h);
      root.querySelector('[data-v="s"]')!.textContent = pct(s);
      out('pre').textContent = pct(pre);
      out('all').textContent = pct(all);
      out('be').textContent = pct(be);
      const loses = h < be;
      out('verdict').textContent = loses ? 'costs more' : 'saves';
      out('verdict').classList.toggle('bad', loses);
      out('pre').classList.toggle('bad', loses);
      out('live').textContent = `At a ${pct(h)} hit rate the cached prefix costs ${pct(pre)} of the uncached price. Break-even is ${pct(be)}.`;
    };
    ['p', 'h', 's'].forEach((k) => {
      input(k).addEventListener('input', render);
      input(k).addEventListener('change', render);
    });
    render();
  });
</script>
