---
// Cost of one agent run that re-sends its whole history every turn, with and without prompt-cache hits.
// Prices are Claude Opus 5.5 list prices in USD per million tokens (platform.claude.com pricing page, checked 2026-10-28).
interface Props {
  title?: string;
}
const { title = 'Loop cost: every turn re-sends the history' } = Astro.props;
const PRICES = { input: 4, cacheWrite: 5, cacheRead: 0.2, output: 20 };
const sliders = [
  { key: 'turns', label: 'model calls in the run', min: 1, max: 60, step: 1, value: 30 },
  { key: 'prefix', label: 'system prompt and tool definitions (tokens)', min: 1000, max: 30000, step: 1000, value: 8000 },
  { key: 'add', label: 'tokens added per turn (tool results, replies)', min: 500, max: 10000, step: 500, value: 3000 },
  { key: 'out', label: 'output tokens per call', min: 100, max: 2000, step: 100, value: 400 },
];
---
<div class="widget" data-loopcost={JSON.stringify(PRICES)}>
  <header><h4>{title}</h4><span class="tiny">Opus 5.5 list prices; every cache read assumed to hit</span></header>
  <div class="grid g2" style="gap: 10px 16px">
    {sliders.map((s) => (
      <label style="font-size: 13px; min-width: 0">
        {s.label} <b class="mono" data-v={s.key}>{s.value.toLocaleString('en-US')}</b>
        <input type="range" min={s.min} max={s.max} step={s.step} value={s.value} data-k={s.key} />
      </label>
    ))}
  </div>
  <div class="gauges">
    <div><b data-o="sent">0</b><span>input tokens sent over the run</span></div>
    <div><b data-o="last">0</b><span>context on the last call</span></div>
    <div><b data-o="nocache">$0</b><span>run cost, no caching</span></div>
    <div><b data-o="cache">$0</b><span>run cost, cache hit every turn</span></div>
  </div>
  <div class="kv"><span>doubling the calls multiplies input tokens by</span><b data-o="ratio">0</b></div>
  <p class="sr-only" aria-live="polite" data-o="summary"></p>
</div>

<script>
  type Prices = { input: number; cacheWrite: number; cacheRead: number; output: number };
  type Run = { sent: number; last: number; noCache: number; cache: number };

  function runCost(turns: number, prefix: number, add: number, out: number, p: Prices): Run {
    let history = prefix;
    let sent = 0;
    let noCache = 0;
    let cache = 0;
    for (let t = 0; t < turns; t++) {
      sent += history;
      noCache += history * p.input + out * p.output;
      // Turn 0 writes the prefix to the cache; later turns read everything already sent and write only the new tokens.
      cache += t === 0 ? history * p.cacheWrite : (history - add) * p.cacheRead + add * p.cacheWrite;
      cache += out * p.output;
      history += add;
    }
    return { sent, last: history - add, noCache: noCache / 1e6, cache: cache / 1e6 };
  }

  document.querySelectorAll<HTMLElement>('[data-loopcost]').forEach((root) => {
    const prices = JSON.parse(root.dataset.loopcost ?? '{}') as Prices;
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-k]')];
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const fmt = (n: number) => Math.round(n).toLocaleString('en-US');
    const render = () => {
      const v: Record<string, number> = {};
      for (const i of inputs) {
        v[i.dataset.k!] = Number(i.value);
        root.querySelector(`[data-v="${i.dataset.k}"]`)!.textContent = fmt(Number(i.value));
      }
      const r = runCost(v.turns!, v.prefix!, v.add!, v.out!, prices);
      const doubled = runCost(v.turns! * 2, v.prefix!, v.add!, v.out!, prices);
      out('sent').textContent = fmt(r.sent);
      out('last').textContent = fmt(r.last);
      out('nocache').textContent = `$${r.noCache.toFixed(2)}`;
      out('cache').textContent = `$${r.cache.toFixed(2)}`;
      out('ratio').textContent = `${(doubled.sent / r.sent).toFixed(2)}x`;
      out('summary').textContent = `${fmt(r.sent)} input tokens; $${r.noCache.toFixed(2)} without caching, $${r.cache.toFixed(2)} with.`;
    };
    inputs.forEach((i) => i.addEventListener('input', render));
    render();
  });
</script>
