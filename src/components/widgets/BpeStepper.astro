---
// Step-through BPE training on a small corpus. Props: corpus (space-separated words; default is the low/lower/newest/
// widest example from Sennrich et al. 2016), title.
interface Props {
  corpus?: string;
  title?: string;
}
const {
  corpus = 'low low low low low lower lower newest newest newest newest newest newest widest widest widest',
  title = 'BPE merge stepper',
} = Astro.props;
---
<div class="widget" data-bpe={corpus}>
  <header>
    <h4>{title}</h4>
    <div class="row" style="gap: 6px">
      <button class="btn sm" type="button" data-undo>Undo</button>
      <button class="btn sm primary" type="button" data-next>Merge next</button>
      <button class="btn sm" type="button" data-reset>Reset</button>
    </div>
  </header>
  <div class="corpus" data-corpus aria-live="polite"></div>
  <div class="split">
    <div><div class="label" style="margin-bottom: 6px">Merges so far</div><div class="merges" data-merges></div></div>
    <div><div class="label" style="margin-bottom: 6px">Most frequent pairs now</div><div class="merges" data-pairs></div></div>
  </div>
  <div class="kv" style="margin-top: 12px"><span>vocabulary (base symbols + merges)</span><b data-vocab>0</b></div>
  <div class="kv"><span>tokens in corpus</span><b data-ctoks>0</b></div>
  <p class="tiny" style="margin: 8px 0 0">The dot marks the end of a word.</p>
</div>

<script>
  type Pair = [string, string];
  const END = '</w>';
  const dot = (s: string) => s.replace(END, '·');

  function applyMerge(w: string[], a: string, b: string): string[] {
    const out: string[] = [];
    for (let i = 0; i < w.length; i++) {
      if (i < w.length - 1 && w[i] === a && w[i + 1] === b) {
        out.push(a + b);
        i++;
      } else out.push(w[i]!);
    }
    return out;
  }

  function pairCounts(words: string[][]): [Pair, number][] {
    const m = new Map<string, number>();
    for (const w of words) for (let i = 0; i < w.length - 1; i++) {
      const k = w[i] + '\u0000' + w[i + 1];
      m.set(k, (m.get(k) ?? 0) + 1);
    }
    return [...m.entries()].sort((a, b) => b[1] - a[1]).map(([k, c]) => [k.split('\u0000') as Pair, c]);
  }

  function el(tag: string, cls: string, text?: string): HTMLElement {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }

  document.querySelectorAll<HTMLElement>('[data-bpe]').forEach((root) => {
    const words0 = (root.dataset.bpe ?? '').split(/\s+/).filter(Boolean).map((w) => [...Array.from(w), END]);
    const base = new Set(words0.flat()).size;
    let steps: Pair[] = [];
    const corpus = root.querySelector<HTMLElement>('[data-corpus]')!;
    const mergeList = root.querySelector<HTMLElement>('[data-merges]')!;
    const pairsEl = root.querySelector<HTMLElement>('[data-pairs]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const undo = root.querySelector<HTMLButtonElement>('[data-undo]')!;

    const state = () => steps.reduce((ws, [a, b]) => ws.map((w) => applyMerge(w, a, b)), words0.map((w) => w.slice()));

    const render = () => {
      const words = state();
      const pairs = pairCounts(words);
      const last = steps[steps.length - 1];
      const lastSym = last ? last[0] + last[1] : null;
      corpus.replaceChildren();
      words.forEach((w, wi) => {
        if (wi) corpus.append('  ');
        w.forEach((t) => corpus.append(el('span', `t${t === lastSym ? ' new' : ''}`, dot(t))));
      });
      mergeList.replaceChildren();
      if (!steps.length) mergeList.append(el('span', 'tiny', 'none yet'));
      steps.forEach(([a, b], i) => {
        const row = el('div', `m${i === steps.length - 1 ? ' on' : ''}`);
        row.append(el('span', 'i', String(i + 1)), el('span', 'pair', `${dot(a)} + ${dot(b)}`), ` gives ${dot(a + b)}`);
        mergeList.append(row);
      });
      pairsEl.replaceChildren();
      if (!pairs.length) pairsEl.append(el('span', 'tiny', 'nothing left to merge'));
      pairs.slice(0, 5).forEach(([[a, b], c], i) => {
        const row = el('div', `m${i === 0 ? ' on' : ''}`);
        row.append(el('span', 'i', `${c}x`), `${dot(a)} + ${dot(b)}`);
        pairsEl.append(row);
      });
      root.querySelector('[data-vocab]')!.textContent = `${base} + ${steps.length} = ${base + steps.length}`;
      root.querySelector('[data-ctoks]')!.textContent = String(words.flat().length);
      next.disabled = !pairs.length || (pairs[0]?.[1] ?? 0) < 2;
      undo.disabled = !steps.length;
    };

    next.addEventListener('click', () => {
      const p = pairCounts(state());
      if (p[0]) {
        steps.push(p[0][0]);
        render();
      }
    });
    undo.addEventListener('click', () => {
      steps.pop();
      render();
    });
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      steps = [];
      render();
    });
    render();
  });
</script>
