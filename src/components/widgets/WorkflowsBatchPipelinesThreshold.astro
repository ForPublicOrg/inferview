---
// Review threshold over a labelled sample: each confidence bin lists items and wrong values; the slider routes every
// bin below the threshold to review and reports review rate, reviewer hours, escaped errors and expected cost.
// The sample is a fixed toy table passed in by the lesson, so the output is deterministic.
export type Bin = { label: string; n: number; wrong: number };
interface Props {
  title?: string;
  note?: string;
  bins: Bin[];
}
const { title = 'Review threshold over a labelled sample', note = 'toy sample, every field is an input', bins } = Astro.props;
if (bins.length < 2) throw new Error('WorkflowsBatchPipelinesThreshold needs at least two bins.');
for (const b of bins) if (b.wrong > b.n || b.n <= 0) throw new Error(`Bin ${b.label}: wrong must be between 0 and n.`);
const total = bins.reduce((s, b) => s + b.n, 0);
const uid = `wbt-${Math.abs([...title].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7))}`;
const fields = [
  { k: 'vol', label: 'items per day', value: 20000, step: '1000' },
  { k: 'min', label: 'minutes per review', value: 2, step: '0.5' },
  { k: 'rate', label: 'reviewer cost, USD per hour', value: 40, step: '5' },
  { k: 'err', label: 'cost of an escaped error, USD', value: 25, step: '1' },
];
---
<div class="widget wbt" data-wbt data-bins={JSON.stringify(bins)}>
  <header><h4>{title}</h4><span class="tiny">{note}</span></header>
  <label class="wbt-slide" for={`${uid}-t`}>
    <span>send to review: <b class="mono" data-tlabel></b></span>
    <input type="range" id={`${uid}-t`} data-t min="0" max={bins.length} step="1" value="5" aria-describedby={`${uid}-help`} />
  </label>
  <p class="tiny" id={`${uid}-help`}>Position 0 reviews nothing; position {bins.length} reviews all {total.toLocaleString('en-US')} items. Arrow keys move one bin.</p>
  <div class="wbt-grid">
    {fields.map((f) => (
      <label class="wbt-field" for={`${uid}-${f.k}`}>
        <span>{f.label}</span>
        <input type="number" id={`${uid}-${f.k}`} data-k={f.k} value={f.value} step={f.step} min="0" inputmode="decimal" />
      </label>
    ))}
  </div>
  <p class="tiny wbt-err" data-err role="alert" hidden></p>
  <div class="tablewrap">
    <table class="wbt-table">
      <thead><tr><th>confidence</th><th>items</th><th>wrong</th><th>observed accuracy</th><th>route</th></tr></thead>
      <tbody>
        {bins.map((b, i) => (
          <tr data-row={i}>
            <td class="mono">{b.label}</td>
            <td class="mono">{b.n}</td>
            <td class="mono">{b.wrong}</td>
            <td class="mono">{(((b.n - b.wrong) / b.n) * 100).toFixed(1)}%</td>
            <td data-route>auto</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="meter" data-out>
    <div><b data-o="rr"></b><span>review rate</span></div>
    <div><b data-o="hours"></b><span>reviewer hours per day</span></div>
    <div><b data-o="esc"></b><span>escaped errors per day</span></div>
    <div><b data-o="cost"></b><span>USD per day, review plus errors</span></div>
  </div>
  <div class="wbt-kv">
    <div class="kv"><span>error rate among auto-accepted items (95% upper bound)</span><b data-o="acc"></b></div>
    <div class="kv"><span>reviews per error caught in the last bin added</span><b data-o="marg"></b></div>
    <div class="kv"><span>cheapest position for these inputs</span><b data-o="best"></b></div>
  </div>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style is:global>
  .wbt-slide { display: block; font-size: 13px; color: var(--ink-2); margin-top: 6px; }
  .wbt-slide input { min-height: 32px; }
  .wbt-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 8px; }
  .wbt-field { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--ink-2); min-width: 0; }
  .widget.wbt .wbt-field input { width: 100%; min-height: 40px; }
  .wbt-err { color: var(--rose); margin: 8px 0 0; }
  .wbt-table { margin-top: 12px; font-size: 13px; }
  .wbt-table th, .wbt-table td { padding: 6px 8px; }
  .wbt-table tr.review td { background: var(--bg-2); font-weight: 600; }
  .wbt-kv { margin-top: 12px; display: grid; gap: 4px; }
  .wbt-kv .kv { flex-wrap: wrap; }
  @media (max-width: 760px) { .wbt-grid { grid-template-columns: 1fr 1fr; } }
</style>

<script>
  type Bin = { label: string; n: number; wrong: number };
  const int = (n: number) => Math.round(n).toLocaleString('en-US');
  const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
  // Wilson score upper bound at 95%: the sample is small enough that the point estimate alone overstates certainty.
  const wilsonHigh = (x: number, n: number) => {
    const z = 1.96;
    const p = x / n;
    const d = 1 + (z * z) / n;
    return (p + (z * z) / (2 * n) + z * Math.sqrt((p * (1 - p)) / n + (z * z) / (4 * n * n))) / d;
  };

  document.querySelectorAll<HTMLElement>('[data-wbt]').forEach((root) => {
    const bins: Bin[] = JSON.parse(root.dataset.bins ?? '[]');
    const total = bins.reduce((s, b) => s + b.n, 0);
    const wrongTotal = bins.reduce((s, b) => s + b.wrong, 0);
    const slider = root.querySelector<HTMLInputElement>('[data-t]')!;
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-k]')];
    const rows = [...root.querySelectorAll<HTMLTableRowElement>('tr[data-row]')];
    const err = root.querySelector<HTMLElement>('[data-err]')!;
    const outBox = root.querySelector<HTMLElement>('[data-out]')!;
    const out = (k: string, text: string) => {
      const el = root.querySelector<HTMLElement>(`[data-o="${k}"]`);
      if (el) el.textContent = text;
    };
    const label = (t: number) =>
      t === 0 ? 'nothing' : t >= bins.length ? 'everything' : `bins below ${(bins[t]?.label ?? '').split(' to ')[0] ?? ''}`;

    // Position t routes bins 0..t-1 to review; reviewers are treated as correct, which the lesson flags as a limit.
    const at = (t: number) => {
      let reviewed = 0;
      let caught = 0;
      for (const b of bins.slice(0, t)) {
        reviewed += b.n;
        caught += b.wrong;
      }
      return { reviewed, escaped: wrongTotal - caught };
    };

    const render = () => {
      const v = { vol: 0, min: 0, rate: 0, err: 0 };
      let bad = false;
      for (const i of inputs) {
        const n = Number(i.value);
        const k = i.dataset.k;
        if (i.value.trim() === '' || !Number.isFinite(n) || n < 0) bad = true;
        if (k === 'vol' || k === 'min' || k === 'rate' || k === 'err') v[k] = n;
      }
      const t = Number(slider.value);
      root.querySelector('[data-tlabel]')!.textContent = label(t);
      rows.forEach((r, i) => {
        const rev = i < t;
        r.classList.toggle('review', rev);
        r.querySelector('[data-route]')!.textContent = rev ? 'review' : 'auto';
      });
      if (bad) {
        err.textContent = 'Every field needs a number of zero or more.';
        err.hidden = false;
        outBox.style.opacity = '0.4';
        return;
      }
      err.hidden = true;
      outBox.style.opacity = '';

      const cost = (pos: number) => {
        const { reviewed, escaped } = at(pos);
        const reviewsPerDay = (v.vol * reviewed) / total;
        const hours = (reviewsPerDay * v.min) / 60;
        const escPerDay = (v.vol * escaped) / total;
        return { reviewed, escaped, hours, escPerDay, usd: hours * v.rate + escPerDay * v.err };
      };
      const c = cost(t);
      out('rr', `${((c.reviewed / total) * 100).toFixed(1)}%`);
      out('hours', c.hours.toFixed(1));
      out('esc', int(c.escPerDay));
      out('cost', usd(c.usd));

      const accepted = total - c.reviewed;
      out('acc', accepted === 0 ? 'nothing auto-accepted' : `${((c.escaped / accepted) * 100).toFixed(2)}% (${(wilsonHigh(c.escaped, accepted) * 100).toFixed(2)}%)`);
      const last = t > 0 ? (bins[t - 1] ?? null) : null;
      out('marg', !last ? 'no bin routed' : last.wrong === 0 ? `${last.n} reviews, no error caught` : (last.n / last.wrong).toFixed(1));

      let best = 0;
      for (let p = 1; p <= bins.length; p++) if (cost(p).usd < cost(best).usd) best = p;
      out('best', `position ${best}, ${label(best)}, ${usd(cost(best).usd)}`);

      root.querySelector('[data-summary]')!.textContent =
        `Reviewing ${label(t)}: ${((c.reviewed / total) * 100).toFixed(1)}% review rate, ${c.hours.toFixed(1)} reviewer hours and ${int(c.escPerDay)} escaped errors per day.`;
    };
    slider.addEventListener('input', render);
    inputs.forEach((i) => i.addEventListener('input', render));
    render();
  });
</script>
