---
// Error compounding for a chain of steps, and pass@k against pass^k over repeated trials.
// Assumes steps and trials are independent, which real agents are not; the note says so.
interface Props {
  title?: string;
}
const { title = 'Compounding: steps in a run, trials of a task' } = Astro.props;
const sliders = [
  { key: 'p', label: 'success rate of one step', min: 0.8, max: 0.999, step: 0.001, value: 0.95, digits: 3 },
  { key: 'n', label: 'steps that must all succeed', min: 1, max: 50, step: 1, value: 10, digits: 0 },
  { key: 'k', label: 'trials of the same task', min: 1, max: 16, step: 1, value: 4, digits: 0 },
];
---
<div class="widget" data-compound>
  <header><h4>{title}</h4><span class="tiny">independent steps assumed</span></header>
  <div class="grid" style="gap: 10px">
    {sliders.map((s) => (
      <label style="font-size: 13px; min-width: 0">
        {s.label} <b class="mono" data-v={s.key}>{s.value.toFixed(s.digits)}</b>
        <input type="range" min={s.min} max={s.max} step={s.step} value={s.value} data-k={s.key} data-digits={s.digits} />
      </label>
    ))}
  </div>
  <div class="gauges">
    <div><b data-o="run">0</b><span>one run succeeds (p to the power n)</span></div>
    <div><b data-o="fail">0</b><span>one run fails</span></div>
    <div><b data-o="at">0</b><span>pass@k: at least one of k trials succeeds</span></div>
    <div><b data-o="hat">0</b><span>pass^k: all k trials succeed</span></div>
  </div>
  <div class="kv"><span>longest chain that still succeeds at least half the time</span><b data-o="half">0</b></div>
  <p class="sr-only" aria-live="polite" data-o="summary"></p>
</div>

<script>
  function compound(p: number, n: number, k: number) {
    const run = p ** n;
    return { run, fail: 1 - run, at: 1 - (1 - run) ** k, hat: run ** k, half: p >= 1 ? Infinity : Math.floor(Math.log(0.5) / Math.log(p)) };
  }

  document.querySelectorAll<HTMLElement>('[data-compound]').forEach((root) => {
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-k]')];
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const pct = (x: number) => `${(x * 100).toFixed(1)}%`;
    const render = () => {
      const v: Record<string, number> = {};
      for (const i of inputs) {
        v[i.dataset.k!] = Number(i.value);
        root.querySelector(`[data-v="${i.dataset.k}"]`)!.textContent = Number(i.value).toFixed(Number(i.dataset.digits));
      }
      const r = compound(v.p!, v.n!, v.k!);
      out('run').textContent = pct(r.run);
      out('fail').textContent = pct(r.fail);
      out('at').textContent = pct(r.at);
      out('hat').textContent = pct(r.hat);
      out('half').textContent = String(r.half);
      out('summary').textContent = `One run succeeds ${pct(r.run)} of the time; pass@k ${pct(r.at)}, pass^k ${pct(r.hat)}.`;
    };
    inputs.forEach((i) => i.addEventListener('input', render));
    render();
  });
</script>
