---
// What a Claude Code hook's result does to the action, per the hooks reference checked 2026-10-28: pick the event,
// what the hook process did, whether onFailure is "block", and (for Stop) how many continuations already ran in a row.
// The table of outcomes is fixed in the script below, so the widget is deterministic and needs no network.
interface Props {
  title?: string;
}
const { title = 'What the hook result does to the action' } = Astro.props;
const uid = `hpho-${Math.abs([...title].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7))}`;
const EVENTS = [
  { v: 'pre', label: 'PreToolUse, before a Bash or Edit call' },
  { v: 'stop', label: 'Stop, when Claude tries to end its turn' },
];
const RESULTS = [
  { v: 'ok', label: 'exits 0 and prints no decision' },
  { v: 'json', label: 'exits 0 with a JSON block (deny on PreToolUse, decision block on Stop)' },
  { v: 'two', label: 'exits 2, reason on stderr' },
  { v: 'one', label: 'exits 1, reason on stderr' },
  { v: 'crash', label: 'crashes or fails to start (interpreter missing, import error)' },
  { v: 'timeout', label: 'times out (default 600 s for command hooks)' },
];
---
<div class="widget hpho" data-hpho>
  <header><h4>{title}</h4><span class="tiny">from the Claude Code hooks reference; onFailure needs v2.1.295 or later</span></header>
  <div class="hpho-cols">
    <fieldset class="faults">
      <legend>Event</legend>
      {EVENTS.map((e, i) => (
        <label class:list={{ on: i === 0 }}>
          <input type="radio" name={`${uid}-ev`} value={e.v} checked={i === 0} />
          <span>{e.label}</span>
        </label>
      ))}
    </fieldset>
    <fieldset class="faults">
      <legend>The command hook</legend>
      {RESULTS.map((r, i) => (
        <label class:list={{ on: i === 3 }}>
          <input type="radio" name={`${uid}-res`} value={r.v} checked={i === 3} />
          <span>{r.label}</span>
        </label>
      ))}
    </fieldset>
  </div>
  <label class="hpho-row">
    <input type="checkbox" data-block /> <span><span class="mono">"onFailure": "block"</span> on this hook</span>
  </label>
  <label class="hpho-row" for={`${uid}-n`}>
    <span>Stop continuations already in a row, with no tool call between them</span>
    <input type="number" id={`${uid}-n`} data-n min="0" max="20" step="1" value="0" inputmode="numeric" />
  </label>
  <div class="kv hpho-kv"><span>outcome</span><b data-out aria-live="polite"></b></div>
  <p class="hpho-why" data-why></p>
</div>

<style is:global>
  .hpho-cols { display: grid; grid-template-columns: 1fr 1.4fr; gap: 14px; }
  .hpho-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; min-height: 44px; font-size: 14px; margin-top: 8px; }
  .widget.hpho .hpho-row input[type='number'] { width: 80px; min-height: 40px; }
  .hpho-kv { margin-top: 10px; flex-wrap: wrap; }
  .hpho-why { font-size: 14px; color: var(--ink-2); margin: 8px 0 0; }
  @media (max-width: 700px) { .hpho-cols { grid-template-columns: 1fr; } }
</style>

<script>
  type Out = { verdict: string; tone: 'allow' | 'block' | 'neutral'; why: string };
  const CAP = 8;

  function preToolUse(res: string, block: boolean): Out {
    if (res === 'json')
      return {
        verdict: 'blocked',
        tone: 'block',
        why: 'The JSON deny stops the call and its reason goes back to Claude. A hook decision can add a refusal to the rule engine; an allow from a hook cannot get past a matching deny or ask rule.',
      };
    if (res === 'two')
      return {
        verdict: 'blocked',
        tone: 'block',
        why: 'The call does not run, and the reason goes back to Claude. Exit 2 blocks even if stdout also carried JSON saying allow, and it blocks before permission rules are evaluated, so an allow rule cannot rescue the call.',
      };
    if (res === 'ok')
      return {
        verdict: 'continues to permission rules',
        tone: 'neutral',
        why: 'Silence is not approval. With no decision, deny, ask and allow rules and the permission mode decide, exactly as if the hook were absent.',
      };
    const what = res === 'timeout' ? 'The hook is canceled and its output discarded.' : 'This is a non-blocking error.';
    if (block)
      return {
        verdict: 'blocked',
        tone: 'block',
        why: `${what} With onFailure set to block, a failure to start, any exit code other than 0 or 2, a timeout or invalid output behaves like exit 2 on this event.`,
      };
    return {
      verdict: 'continues to permission rules (fails open)',
      tone: 'allow',
      why: `${what} Without onFailure, the action proceeds as if the hook had not run: in bypass mode it runs, in auto mode the classifier decides. A policy hook that exits 1 on a violation enforces nothing.`,
    };
  }

  function stop(res: string, block: boolean, n: number): Out {
    if (res === 'two' || res === 'json') {
      if (n >= CAP)
        return {
          verdict: 'turn ends (cap reached)',
          tone: 'allow',
          why: `Stop hooks have already continued the turn ${CAP} times in a row, so Claude Code overrides this block and ends the turn. The counter resets whenever Claude calls a tool; CLAUDE_CODE_STOP_HOOK_BLOCK_CAP raises it.`,
        };
      return {
        verdict: `turn continues (continuation ${n + 1} of ${CAP})`,
        tone: 'block',
        why: 'The reason becomes Claude\'s next instruction and it keeps working. The hook input carries stop_hook_active: true on the next stop, so the script can tell it is already in a loop.',
      };
    }
    if (res === 'ok')
      return { verdict: 'turn ends', tone: 'neutral', why: 'Exit 0 with no block lets Claude stop.' };
    return {
      verdict: 'turn ends (fails open)',
      tone: 'allow',
      why: `A ${res === 'timeout' ? 'timeout' : 'non-blocking error'} lets Claude stop without the check passing. onFailure${block ? ', which you set,' : ''} has no effect on Stop, so a typecheck gate that crashes ends the turn unverified.`,
    };
  }

  document.querySelectorAll<HTMLElement>('[data-hpho]').forEach((root) => {
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[type="radio"]')];
    const block = root.querySelector<HTMLInputElement>('[data-block]')!;
    const nInput = root.querySelector<HTMLInputElement>('[data-n]')!;
    const out = root.querySelector<HTMLElement>('[data-out]')!;
    const why = root.querySelector<HTMLElement>('[data-why]')!;
    const picked = (suffix: string) => radios.find((r) => r.name.endsWith(suffix) && r.checked)?.value ?? '';
    const render = () => {
      radios.forEach((r) => r.closest('label')?.classList.toggle('on', r.checked));
      const ev = picked('-ev');
      const res = picked('-res');
      const raw = Math.floor(Number(nInput.value));
      const n = Number.isFinite(raw) && raw >= 0 ? raw : 0;
      nInput.disabled = ev !== 'stop';
      const o = ev === 'stop' ? stop(res, block.checked, n) : preToolUse(res, block.checked);
      out.textContent = o.verdict;
      out.style.color = o.tone === 'block' ? 'var(--rose)' : o.tone === 'allow' ? 'var(--amber)' : 'var(--ink)';
      why.textContent = o.why;
    };
    [...radios, block, nInput].forEach((el) => el.addEventListener('input', render));
    radios.forEach((r) => r.addEventListener('change', render));
    render();
  });
</script>
