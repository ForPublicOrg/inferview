---
// Experiment planner for a two-arm A/B test on a binary outcome. Part one: users per arm from the baseline rate, the
// target rate, alpha (two-sided) and power, with the pooled-variance formula for two proportions; when the outcome is
// per conversation and assignment is per user, the conversation count is inflated by Kish's design effect
// 1 + (m - 1) * rho and divided by m to get users. Duration assumes the stated number of new eligible users each day.
// Part two: a sample ratio mismatch check, a chi-squared goodness-of-fit test with one degree of freedom.
// Props: base, target (percent), m, rho, daily, share (percent), title.
interface Props {
  base?: number;
  target?: number;
  m?: number;
  rho?: number;
  daily?: number;
  share?: number;
  title?: string;
}
const { base = 70, target = 72, m = 1, rho = 0, daily = 2000, share = 50, title = 'Plan the experiment, then check the split' } = Astro.props;
const id = 'lrss';
const fields = [
  { key: 'base', label: 'baseline rate, %', value: base, step: '0.1' },
  { key: 'target', label: 'rate to detect, %', value: target, step: '0.1' },
  { key: 'm', label: 'conversations per user', value: m, step: '0.1' },
  { key: 'rho', label: 'within-user correlation', value: rho, step: '0.01' },
  { key: 'daily', label: 'new eligible users per day', value: daily, step: '1' },
  { key: 'share', label: 'share in the experiment, %', value: share, step: '1' },
];
const srm = [
  { key: 'na', label: 'users seen in A', value: 10240 },
  { key: 'nb', label: 'users seen in B', value: 9760 },
  { key: 'exp', label: 'planned share for A, %', value: 50 },
];
---
<div class="widget" data-lrss>
  <header><h4>{title}</h4><span class="tiny">two arms, binary outcome, two-sided test</span></header>
  <div class="lrss-grid">
    {fields.map((f) => (
      <label class="lrss-l" for={`${id}-${f.key}`}>{f.label}
        <input type="number" id={`${id}-${f.key}`} min="0" step={f.step} value={f.value} inputmode="decimal" data-in={f.key} />
      </label>
    ))}
    <label class="lrss-l" for={`${id}-alpha`}>alpha
      <select id={`${id}-alpha`} data-in="alpha"><option value="0.05" selected>0.05</option><option value="0.01">0.01</option></select>
    </label>
    <label class="lrss-l" for={`${id}-power`}>power
      <select id={`${id}-power`} data-in="power"><option value="0.8" selected>0.8</option><option value="0.9">0.9</option></select>
    </label>
  </div>
  <div class="gauges">
    <div><b data-o="iid"></b><span>outcomes per arm if independent</span></div>
    <div><b data-o="deff"></b><span>design effect</span></div>
    <div><b data-o="users"></b><span>users per arm</span></div>
    <div><b data-o="days"></b><span>days to fill both arms</span></div>
  </div>
  <p class="tiny" data-o="note" aria-live="polite"></p>
  <h5 class="lrss-h">Sample ratio check, before reading any metric</h5>
  <div class="lrss-grid lrss-3">
    {srm.map((f) => (
      <label class="lrss-l" for={`${id}-${f.key}`}>{f.label}
        <input type="number" id={`${id}-${f.key}`} min="0" step="1" value={f.value} inputmode="numeric" data-in={f.key} />
      </label>
    ))}
  </div>
  <div class="kv"><span>observed share in A</span><b data-o="obs"></b></div>
  <div class="kv"><span>chi-squared, 1 degree of freedom</span><b data-o="chi"></b></div>
  <div class="kv"><span>p-value</span><b data-o="p"></b></div>
  <div class="kv"><span>flag at p below 0.001 (a policy choice)</span><b data-o="flag"></b></div>
</div>

<style>
  .lrss-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .lrss-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-bottom: 8px; }
  @media (max-width: 600px) { .lrss-grid, .lrss-3 { grid-template-columns: 1fr 1fr; } }
  .lrss-l { display: flex; flex-direction: column; gap: 4px; font-size: 13px; min-width: 0; }
  .lrss-l input, .lrss-l select { width: 100%; min-width: 0; }
  .lrss-h { margin: 14px 0 8px; font-size: 14px; }
</style>

<script>
  // Standard normal quantiles for the two alphas (two-sided) and two powers the widget offers.
  const Z_ALPHA: Record<string, number> = { '0.05': 1.959964, '0.01': 2.575829 };
  const Z_POWER: Record<string, number> = { '0.8': 0.841621, '0.9': 1.281552 };

  // Complementary error function, Abramowitz and Stegun 7.1.26 (absolute error below 1.5e-7).
  function erfc(x: number): number {
    const t = 1 / (1 + 0.3275911 * x);
    const poly = t * (0.254829592 + t * (-0.284496736 + t * (1.421413741 + t * (-1.453152027 + t * 1.061405429))));
    return poly * Math.exp(-x * x);
  }

  const fmt = (x: number) => Math.round(x).toLocaleString('en-GB');

  document.querySelectorAll<HTMLElement>('[data-lrss]').forEach((root) => {
    const els = [...root.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-in]')];
    const raw = (k: string) => root.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-in="${k}"]`)!.value;
    const num = (k: string) => Math.max(0, Number(raw(k)) || 0);
    const out = (k: string, v: string) => (root.querySelector(`[data-o="${k}"]`)!.textContent = v);

    const render = () => {
      const p1 = Math.min(num('base'), 99.9) / 100;
      const p2 = Math.min(num('target'), 99.9) / 100;
      const m = Math.max(1, num('m'));
      const rho = Math.min(num('rho'), 1);
      const daily = num('daily');
      const share = Math.min(num('share'), 100) / 100;
      const za = Z_ALPHA[raw('alpha')] ?? 1.959964;
      const zb = Z_POWER[raw('power')] ?? 0.841621;
      const note: string[] = [];

      if (p1 === p2) {
        ['iid', 'deff', 'users', 'days'].forEach((k) => out(k, 'n/a'));
        note.push('The two rates are equal, so there is no effect to detect.');
      } else {
        const pbar = (p1 + p2) / 2;
        const delta = Math.abs(p2 - p1);
        const iid = Math.ceil(((za * Math.sqrt(2 * pbar * (1 - pbar)) + zb * Math.sqrt(p1 * (1 - p1) + p2 * (1 - p2))) / delta) ** 2);
        const deff = 1 + (m - 1) * rho;
        const conv = iid * deff;
        const users = Math.ceil(conv / m);
        const perDay = daily * share;
        out('iid', fmt(iid));
        out('deff', deff.toFixed(2));
        out('users', fmt(users));
        out('days', perDay > 0 ? String(Math.ceil((2 * users) / perDay)) : 'never');
        note.push(
          `Detecting ${(p1 * 100).toFixed(1)}% to ${(p2 * 100).toFixed(1)}% needs ${fmt(iid)} independent outcomes per arm.`,
        );
        if (m > 1) {
          note.push(
            `With ${m} conversations per user and correlation ${rho}, each user is worth ${(m / deff).toFixed(2)} independent conversations, so ${fmt(conv)} conversations from ${fmt(users)} users per arm.`,
          );
        }
        if (perDay > 0) note.push(`At ${fmt(perDay)} new users a day entering the test, both arms fill in ${Math.ceil((2 * users) / perDay)} days.`);
      }
      out('note', note.join(' '));

      const na = Math.floor(num('na'));
      const nb = Math.floor(num('nb'));
      const q = Math.min(Math.max(num('exp'), 0.1), 99.9) / 100;
      const n = na + nb;
      if (n === 0) {
        ['obs', 'chi', 'p', 'flag'].forEach((k) => out(k, 'n/a'));
        return;
      }
      const ea = n * q;
      const eb = n * (1 - q);
      const chi = (na - ea) ** 2 / ea + (nb - eb) ** 2 / eb;
      const p = erfc(Math.sqrt(chi / 2));
      out('obs', `${((na / n) * 100).toFixed(2)}%`);
      out('chi', chi.toFixed(2));
      out('p', p < 1e-6 ? 'below 0.000001' : p.toPrecision(2));
      const flagged = p < 0.001;
      out('flag', flagged ? 'mismatch: find the cause first' : 'no mismatch flagged');
    };
    els.forEach((el) => el.addEventListener('input', render));
    els.forEach((el) => el.addEventListener('change', render));
    render();
  });
</script>
