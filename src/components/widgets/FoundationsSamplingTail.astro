---
// Top-k, top-p and min-p side by side over one fixed next-token distribution. Props: none required; title optional.
// Logits are examples, not model output. Temperature is applied first, then each rule truncates independently.
interface Props {
  title?: string;
}
const { title = 'Three tail policies on the same distribution' } = Astro.props;
const presets = {
  peaked: { label: 'Peaked: next token after "total": ', logits: [['4', 9.0], ['5', 6.5], ['3', 5.8], ['"', 4.0], ['null', 3.5], ['1', 3.0], ['-', 2.0], ['the', 1.0]] },
  flat: { label: 'Flat: next word after "She"', logits: [['walked', 3.0], ['ran', 2.9], ['turned', 2.8], ['stopped', 2.6], ['looked', 2.5], ['smiled', 2.3], ['fell', 1.5], ['banana', -1.0]] },
};
---
<div class="widget fst" data-fst={JSON.stringify(presets)}>
  <header><h4>{title}</h4><span class="tiny">example logits, not a model</span></header>
  <fieldset class="fst-preset">
    <legend class="tiny">distribution</legend>
    <label><input type="radio" name="fst-preset" value="peaked" checked /> peaked</label>
    <label><input type="radio" name="fst-preset" value="flat" /> flat</label>
  </fieldset>
  <p class="tiny" data-label></p>
  <div class="fst-controls">
    <label>temperature <b class="mono" data-out="t"></b>
      <input type="range" min="0.25" max="3" step="0.25" value="1" data-in="t" />
    </label>
    <label>top-k <b class="mono" data-out="k"></b>
      <input type="range" min="1" max="8" step="1" value="4" data-in="k" />
    </label>
    <label>top-p <b class="mono" data-out="p"></b>
      <input type="range" min="0.5" max="1" step="0.05" value="0.9" data-in="p" />
    </label>
    <label>min-p <b class="mono" data-out="m"></b>
      <input type="range" min="0" max="0.5" step="0.05" value="0.1" data-in="m" />
    </label>
  </div>
  <table class="fst-table">
    <caption class="sr-only">Probability of each token after temperature, and whether each rule keeps it</caption>
    <thead><tr><th scope="col">token</th><th scope="col">prob</th><th scope="col">top-k</th><th scope="col">top-p</th><th scope="col">min-p</th></tr></thead>
    <tbody data-rows></tbody>
    <tfoot><tr><th scope="row">kept</th><td></td><td data-n="k"></td><td data-n="p"></td><td data-n="m"></td></tr></tfoot>
  </table>
  <p class="tiny" data-cut></p>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style is:global>
  .fst .fst-preset { border: 0; padding: 0; margin: 0 0 6px; display: flex; gap: 16px; flex-wrap: wrap; font-size: 13px; }
  .fst .fst-preset legend { padding: 0; margin-bottom: 4px; }
  .fst-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px 16px; font-size: 13px; }
  .fst-controls label { display: flex; flex-direction: column; gap: 2px; }
  .fst-controls input { width: 100%; }
  .fst-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; table-layout: fixed; }
  .fst-table th, .fst-table td { padding: 3px 4px; text-align: left; border-bottom: 1px solid var(--line, #ddd); overflow-wrap: anywhere; }
  .fst-table td.on { font-weight: 600; }
  .fst-table td.off { opacity: 0.45; }
</style>

<script>
  type Preset = { label: string; logits: [string, number][] };
  document.querySelectorAll<HTMLElement>('[data-fst]').forEach((root, n) => {
    const presets = JSON.parse(root.dataset.fst ?? '{}') as Record<string, Preset>;
    root.querySelectorAll<HTMLInputElement>('input[type=radio]').forEach((r) => (r.name = `fst-preset-${n}`));
    const val = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-in="${k}"]`)!.value);
    const rows = root.querySelector<HTMLElement>('[data-rows]')!;

    const softmax = (logits: number[], t: number) => {
      const z = logits.map((v) => v / t);
      const m = Math.max(...z);
      const e = z.map((v) => Math.exp(v - m));
      const s = e.reduce((a, b) => a + b, 0);
      return e.map((v) => v / s);
    };

    const render = () => {
      const key = root.querySelector<HTMLInputElement>('input[type=radio]:checked')?.value ?? 'peaked';
      const preset = presets[key]!;
      const t = val('t'), k = val('k'), p = val('p'), m = val('m');
      root.querySelector('[data-out="t"]')!.textContent = t.toFixed(2);
      root.querySelector('[data-out="k"]')!.textContent = String(k);
      root.querySelector('[data-out="p"]')!.textContent = p.toFixed(2);
      root.querySelector('[data-out="m"]')!.textContent = m.toFixed(2);
      root.querySelector('[data-label]')!.textContent = preset.label;

      const probs = softmax(preset.logits.map(([, l]) => l), t);
      const order = probs.map((q, i) => [q, i] as const).sort((a, b) => b[0] - a[0] || a[1] - b[1]);
      const keepK = new Set(order.slice(0, k).map(([, i]) => i));
      const keepP = new Set<number>();
      let cum = 0;
      for (const [q, i] of order) {
        keepP.add(i);
        cum += q;
        if (cum >= p - 1e-12) break;
      }
      const top = order[0]![0];
      const cutoff = m * top;
      const keepM = new Set(order.filter(([q]) => q >= cutoff).map(([, i]) => i));

      rows.replaceChildren(
        ...order.map(([q, i]) => {
          const tr = document.createElement('tr');
          const cells: [string, string][] = [
            [preset.logits[i]![0], ''],
            [q.toFixed(3), 'mono'],
            ...[keepK, keepP, keepM].map((s): [string, string] => (s.has(i) ? ['kept', 'on'] : ['cut', 'off'])),
          ];
          cells.forEach(([text, cls], c) => {
            const td = document.createElement(c === 0 ? 'th' : 'td');
            if (c === 0) td.setAttribute('scope', 'row');
            td.textContent = text;
            if (cls) td.className = cls;
            tr.append(td);
          });
          return tr;
        }),
      );
      const counts = { k: keepK.size, p: keepP.size, m: keepM.size };
      (Object.keys(counts) as (keyof typeof counts)[]).forEach((c) => {
        root.querySelector(`[data-n="${c}"]`)!.textContent = `${counts[c]} of ${probs.length}`;
      });
      root.querySelector('[data-cut]')!.textContent =
        `Top probability ${top.toFixed(3)}, so the min-p cutoff is ${m.toFixed(2)} x ${top.toFixed(3)} = ${cutoff.toFixed(3)}. Top-p kept mass ${cum.toFixed(3)}.`;
      root.querySelector('[data-summary]')!.textContent =
        `Temperature ${t.toFixed(2)}: top-k keeps ${counts.k}, top-p keeps ${counts.p}, min-p keeps ${counts.m} of ${probs.length} tokens.`;
    };

    root.querySelectorAll('input').forEach((el) => el.addEventListener('input', render));
    root.querySelectorAll('input[type=radio]').forEach((el) => el.addEventListener('change', render));
    render();
  });
</script>
