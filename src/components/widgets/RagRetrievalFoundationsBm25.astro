---
// BM25 knobs. Scores six short runbook documents with Lucene 9's BM25 (idf * f / (f + k1 * (1 - b + b * dl / avgdl)),
// idf = ln(1 + (N - df + 0.5) / (df + 0.5))). The reader picks a query and moves k1 and b; the ranking, each document's
// per-term contribution and the field length update live. Tokens are lowercase runs of letters and digits, no stemming.
// Props: title.
interface Props {
  title?: string;
}
const { title = 'BM25 with the knobs exposed' } = Astro.props;
const docs = [
  ['A', 'Runbook E1234: the payment gateway returns E1234 when its upstream call times out. Drain the gateway pod, then retry the capture once.'],
  ['B', 'Timeout reference. Every service sets a connect timeout, a read timeout and an idle timeout. The client timeout must exceed the server timeout, and each retry inherits the remaining timeout budget. Gateway, ledger, search and checkout services each document their timeout values in the service catalogue, and a timeout change ships behind a flag like any other config change.'],
  ['C', 'Retry policy: retry a timeout once with jitter, never a decline.'],
  ['D', 'Checkout latency dashboard: p95 and p99 per region, per payment method.'],
  ['E', 'Postmortem: a database failover caused a checkout timeout spike for eleven minutes; no retry storm followed.'],
  ['F', 'Gateway deploy guide: build, canary, promote, roll back.'],
];
const queries = ['E1234 timeout', 'timeout retry', 'gateway timeout'];
const uid = 'rrf-bm25';
---
<div class="widget" data-rfbm25={JSON.stringify(docs)} data-queries={JSON.stringify(queries)}>
  <header><h4>{title}</h4><span class="tiny">Lucene 9 formula, six documents</span></header>
  <div class="toggle rfb-q" role="group" aria-label="Query">
    {queries.map((q, i) => <button type="button" data-q={i} aria-pressed={i === 0 ? 'true' : 'false'}>{q}</button>)}
  </div>
  <div class="row rfb-sliders">
    <label for={`${uid}-k1`}>k1 (saturation) <b class="mono" data-k1v>1.20</b>
      <input type="range" min="0" max="3" step="0.1" value="1.2" id={`${uid}-k1`} data-k1 />
    </label>
    <label for={`${uid}-b`}>b (length) <b class="mono" data-bv>0.75</b>
      <input type="range" min="0" max="1" step="0.05" value="0.75" id={`${uid}-b`} data-b />
    </label>
    <button class="btn sm" type="button" data-reset>Lucene defaults</button>
  </div>
  <ol class="rfb-list" data-list aria-live="polite"></ol>
  <p class="tiny" data-idf style="margin: 8px 0 0"></p>
  <details class="rfb-docs">
    <summary>Read the six documents</summary>
    <dl>
      {docs.map(([id, text]) => (<Fragment><dt>{id}</dt><dd>{text}</dd></Fragment>))}
    </dl>
  </details>
</div>

<style is:global>
  [data-rfbm25] .rfb-q { display: flex; flex-wrap: wrap; max-width: 100%; }
  [data-rfbm25] .rfb-sliders { margin: 12px 0; gap: 12px; flex-wrap: wrap; align-items: flex-end; }
  [data-rfbm25] .rfb-sliders label { flex: 1; min-width: 140px; font-size: 13px; }
  [data-rfbm25] .rfb-sliders input { width: 100%; }
  .rfb-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .rfb-list li { display: grid; grid-template-columns: 22px 1fr auto; gap: 8px; align-items: baseline; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); font-size: 13.5px; }
  .rfb-list li[data-zero] { opacity: 0.55; }
  .rfb-list .rfb-id { font-family: var(--mono); font-weight: 650; }
  .rfb-list .rfb-parts { color: var(--ink-3); font-size: 12.5px; overflow-wrap: anywhere; }
  .rfb-list .rfb-score { font-family: var(--mono); font-weight: 600; }
  .rfb-docs { margin-top: 10px; font-size: 13px; }
  .rfb-docs dl { display: grid; grid-template-columns: 22px 1fr; gap: 6px 8px; margin: 8px 0 0; }
  .rfb-docs dt { font-family: var(--mono); font-weight: 650; }
  .rfb-docs dd { margin: 0; color: var(--ink-2); overflow-wrap: anywhere; }
</style>

<script>
  const tokenize = (s: string): string[] => s.toLowerCase().match(/[a-z0-9]+/g) ?? [];

  document.querySelectorAll<HTMLElement>('[data-rfbm25]').forEach((root) => {
    const docs = (JSON.parse(root.dataset.rfbm25 ?? '[]') as [string, string][]).map(([id, text]) => ({ id, toks: tokenize(text) }));
    const queries = JSON.parse(root.dataset.queries ?? '[]') as string[];
    const qButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-q]')];
    const k1In = root.querySelector<HTMLInputElement>('[data-k1]')!;
    const bIn = root.querySelector<HTMLInputElement>('[data-b]')!;
    const k1Out = root.querySelector<HTMLElement>('[data-k1v]')!;
    const bOut = root.querySelector<HTMLElement>('[data-bv]')!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const idfOut = root.querySelector<HTMLElement>('[data-idf]')!;
    const n = docs.length;
    const avgdl = docs.reduce((s, d) => s + d.toks.length, 0) / n;
    let q = 0;

    const idf = (term: string) => {
      const df = docs.filter((d) => d.toks.includes(term)).length;
      return Math.log(1 + (n - df + 0.5) / (df + 0.5));
    };

    const render = () => {
      const k1 = Number(k1In.value);
      const b = Number(bIn.value);
      k1Out.textContent = k1.toFixed(2);
      bOut.textContent = b.toFixed(2);
      qButtons.forEach((btn, i) => btn.setAttribute('aria-pressed', i === q ? 'true' : 'false'));
      const terms = [...new Set(tokenize(queries[q] ?? ''))];
      const rows = docs.map((d) => {
        const dl = d.toks.length;
        const parts = terms.flatMap((t) => {
          const f = d.toks.filter((x) => x === t).length;
          if (!f) return [];
          const norm = k1 * (1 - b + (b * dl) / avgdl);
          const c = norm === 0 ? idf(t) : (idf(t) * f) / (f + norm);
          return [{ t, f, c }];
        });
        return { id: d.id, dl, parts, score: parts.reduce((s, p) => s + p.c, 0) };
      });
      rows.sort((x, y) => y.score - x.score || x.id.localeCompare(y.id));
      list.replaceChildren(
        ...rows.map((r) => {
          const li = document.createElement('li');
          if (r.score === 0) li.dataset.zero = '';
          const id = document.createElement('span');
          id.className = 'rfb-id';
          id.textContent = r.id;
          const parts = document.createElement('span');
          parts.className = 'rfb-parts';
          parts.textContent =
            (r.parts.length ? r.parts.map((p) => `${p.t} x${p.f}: ${p.c.toFixed(3)}`).join(' + ') : 'no query term') + `; length ${r.dl}`;
          const sc = document.createElement('span');
          sc.className = 'rfb-score';
          sc.textContent = r.score.toFixed(3);
          li.append(id, parts, sc);
          return li;
        }),
      );
      idfOut.textContent =
        terms.map((t) => `idf(${t}) = ${idf(t).toFixed(3)}`).join(', ') + `; average length ${avgdl.toFixed(1)} tokens.`;
    };

    qButtons.forEach((btn, i) =>
      btn.addEventListener('click', () => {
        q = i;
        render();
      }),
    );
    k1In.addEventListener('input', render);
    bIn.addEventListener('input', render);
    root.querySelector('[data-reset]')!.addEventListener('click', () => {
      k1In.value = '1.2';
      bIn.value = '0.75';
      render();
    });
    render();
  });
</script>
