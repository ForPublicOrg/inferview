---
// End-to-end arithmetic for the five workflow patterns from one set of per-call inputs. Each pattern is a closed form,
// so the output is deterministic: success, share escalated to a human, share wrong and not caught, expected calls,
// latency and cost. Calls are independent and each call takes the same time; the header says so.
interface Props {
  title?: string;
}
const { title = 'Pattern sandbox: one item through each pattern' } = Astro.props;
const PATTERNS = [
  { key: 'chain', label: 'Prompt chain', hint: 'n calls in series; an optional code gate after each step retries once' },
  { key: 'router', label: 'Router', hint: 'one classifier call, then one specialised call' },
  { key: 'vote', label: 'Parallel voting', hint: 'k identical calls at once; code takes the majority' },
  { key: 'orch', label: 'Orchestrator-workers', hint: 'plan call, w workers in parallel, synthesis call' },
  { key: 'eval', label: 'Evaluator-optimiser', hint: 'draft and critique per round, up to r rounds' },
];
const SHARED = [
  { key: 'p', label: 'one call is right', min: 0.8, max: 0.999, step: 0.001, value: 0.95, digits: 3 },
  { key: 'L', label: 'seconds per call', min: 0.5, max: 20, step: 0.5, value: 2, digits: 1 },
  { key: 'c', label: 'cents per call', min: 0.1, max: 20, step: 0.1, value: 1, digits: 1 },
];
const OWN = [
  { key: 'n', group: 'chain', label: 'steps in the chain', min: 1, max: 10, step: 1, value: 4, digits: 0 },
  { key: 'g', group: 'chain', label: 'gate catches a bad step', min: 0, max: 1, step: 0.05, value: 0, digits: 2 },
  { key: 'a', group: 'router', label: 'router picks the right branch', min: 0.5, max: 1, step: 0.01, value: 0.9, digits: 2 },
  { key: 'k', group: 'vote', label: 'votes (odd)', min: 1, max: 9, step: 2, value: 3, digits: 0 },
  { key: 'w', group: 'orch', label: 'workers the plan creates', min: 1, max: 20, step: 1, value: 5, digits: 0 },
  { key: 'r', group: 'eval', label: 'maximum rounds', min: 1, max: 6, step: 1, value: 3, digits: 0 },
  { key: 'q', group: 'eval', label: 'critic rejects a bad draft', min: 0, max: 1, step: 0.05, value: 0.8, digits: 2 },
];
const name = `pattern-${title.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
---
<div class="widget" data-patterns>
  <header><h4>{title}</h4><span class="tiny">scenario inputs; calls independent, equal latency</span></header>
  <fieldset class="faults">
    <legend>Pattern</legend>
    {PATTERNS.map((pt, i) => (
      <label class:list={{ on: i === 0 }}>
        <input type="radio" name={name} value={pt.key} checked={i === 0} />
        <span>{pt.label}<small>{pt.hint}</small></span>
      </label>
    ))}
  </fieldset>
  <div class="grid" style="gap: 10px; margin-top: 14px">
    {SHARED.map((s) => (
      <label style="font-size: 13px; min-width: 0">
        {s.label} <b class="mono" data-v={s.key}>{s.value.toFixed(s.digits)}</b>
        <input type="range" min={s.min} max={s.max} step={s.step} value={s.value} data-k={s.key} data-digits={s.digits} />
      </label>
    ))}
    {OWN.map((s) => (
      <label style="font-size: 13px; min-width: 0" data-group={s.group} hidden={s.group !== 'chain'}>
        {s.label} <b class="mono" data-v={s.key}>{s.value.toFixed(s.digits)}</b>
        <input type="range" min={s.min} max={s.max} step={s.step} value={s.value} data-k={s.key} data-digits={s.digits} />
      </label>
    ))}
  </div>
  <div class="gauges">
    <div><b data-o="ok">0</b><span>item ends correct</span></div>
    <div><b data-o="human">0</b><span>stopped and sent to a human</span></div>
    <div><b data-o="bad">0</b><span>wrong and not caught</span></div>
    <div><b data-o="calls">0</b><span>model calls per item (expected)</span></div>
  </div>
  <div class="kv"><span>latency per item (expected)</span><b data-o="lat">0</b></div>
  <div class="kv"><span>model cost per 1,000 items</span><b data-o="cost">0</b></div>
  <p class="tiny" data-o="formula" style="margin: 10px 0 0; overflow-wrap: anywhere"></p>
  <p class="sr-only" aria-live="polite" data-o="summary"></p>
</div>

<script>
  type V = Record<string, number>;
  type Out = { ok: number; human: number; calls: number; lat: number; formula: string };

  function choose(n: number, k: number): number {
    let r = 1;
    for (let i = 1; i <= k; i++) r = (r * (n - k + i)) / i;
    return r;
  }

  // Geometric sum 1 + x + ... + x^(m-1), safe at x = 1.
  function geo(x: number, m: number): number {
    return Math.abs(1 - x) < 1e-12 ? m : (1 - x ** m) / (1 - x);
  }

  function run(pattern: string, v: V): Out {
    const p = v.p!, L = v.L!;
    if (pattern === 'chain') {
      const n = v.n!, g = v.g!;
      const s = p + (1 - p) * g * p; // right first time, or caught and right on the one retry
      const e = (1 - p) * g * (1 - p) * g; // retry also wrong and caught again: stop and escalate
      const callsPerStep = 1 + (1 - p) * g;
      const calls = geo(1 - e, n) * callsPerStep;
      return { ok: s ** n, human: 1 - (1 - e) ** n, calls, lat: calls * L, formula: 'correct = (p + (1 - p) g p)^n; calls run in series' };
    }
    if (pattern === 'router') {
      const a = v.a!;
      return { ok: a * p, human: 0, calls: 2, lat: 2 * L, formula: 'correct = a p; no branch can beat the router accuracy a' };
    }
    if (pattern === 'vote') {
      const k = v.k!;
      let ok = 0;
      for (let j = Math.floor(k / 2) + 1; j <= k; j++) ok += choose(k, j) * p ** j * (1 - p) ** (k - j);
      return { ok, human: 0, calls: k, lat: L, formula: 'correct = P(more than k/2 of k votes right); wrong votes assumed to agree' };
    }
    if (pattern === 'orch') {
      const w = v.w!;
      return { ok: p ** (w + 2), human: 0, calls: w + 2, lat: 3 * L, formula: 'correct = p^(w + 2): plan, every worker and the synthesis' };
    }
    const r = v.r!, q = v.q!;
    const x = (1 - p) * q; // a round that drafts badly and the critic catches it
    const rounds = geo(x, r);
    return { ok: p * rounds, human: x ** r, calls: 2 * rounds, lat: 2 * rounds * L, formula: 'correct = p (1 + x + ... + x^(r-1)), x = (1 - p) q; good drafts always accepted' };
  }

  document.querySelectorAll<HTMLElement>('[data-patterns]').forEach((root) => {
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-k]')];
    const radios = [...root.querySelectorAll<HTMLInputElement>('input[type=radio]')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-group]')];
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const pct = (x: number) => `${(Math.max(0, x) * 100).toFixed(1)}%`;
    const render = () => {
      const pattern = radios.find((r) => r.checked)?.value ?? 'chain';
      radios.forEach((r) => r.closest('label')!.classList.toggle('on', r.checked));
      groups.forEach((g) => (g.hidden = g.dataset.group !== pattern));
      const v: V = {};
      for (const i of inputs) {
        v[i.dataset.k!] = Number(i.value);
        root.querySelector(`[data-v="${i.dataset.k}"]`)!.textContent = Number(i.value).toFixed(Number(i.dataset.digits));
      }
      const r = run(pattern, v);
      const bad = 1 - r.ok - r.human;
      out('ok').textContent = pct(r.ok);
      out('human').textContent = pct(r.human);
      out('bad').textContent = pct(bad);
      out('bad').classList.toggle('bad', bad > 0.05);
      out('calls').textContent = r.calls.toFixed(2);
      out('lat').textContent = `${r.lat.toFixed(1)} s`;
      out('cost').textContent = `$${((r.calls * v.c!) * 10).toFixed(2)}`;
      out('formula').textContent = r.formula;
      out('summary').textContent = `${pct(r.ok)} correct, ${pct(r.human)} to a human, ${pct(bad)} wrong and shipped, ${r.lat.toFixed(1)} seconds.`;
    };
    inputs.forEach((i) => i.addEventListener('input', render));
    radios.forEach((r) => r.addEventListener('change', render));
    render();
  });
</script>
