---
// Toy self-attention on four tokens with made-up 2-dimensional Q, K and V. Props: title.
interface Props {
  title?: string;
}
const { title = 'Attention calculator: four tokens, two dimensions' } = Astro.props;
const tokens = ['The', 'cat', 'sat', 'down'];
---
<div class="widget fa" data-fattn>
  <header><h4>{title}</h4><span class="tiny">made-up vectors, real arithmetic</span></header>
  <div class="row" style="margin-bottom: 10px">
    <span class="label">Query token</span>
    <span class="toggle" role="group" aria-label="Query token">
      {tokens.map((t, i) => <button type="button" data-q={i} aria-pressed={i === 2 ? 'true' : 'false'}>{t}</button>)}
    </span>
  </div>
  <div class="row" style="margin-bottom: 12px">
    <label class="fa-check"><input type="checkbox" data-causal checked /> causal mask (decoder)</label>
    <label class="fa-check"><input type="checkbox" data-scale checked /> divide by sqrt(d_k)</label>
  </div>
  <div class="tablewrap">
    <table class="fa-table">
      <thead><tr><th scope="col">key</th><th scope="col">k</th><th scope="col">v</th><th scope="col">q·k</th><th scope="col">score</th><th scope="col">weight</th></tr></thead>
      <tbody data-rows></tbody>
    </table>
  </div>
  <div class="kv" style="margin-top: 10px"><span>output = sum of weight × v</span><b data-out></b></div>
  <div class="label" style="margin: 14px 0 6px">All weights (rows are queries, columns are keys)</div>
  <div class="tablewrap"><table class="fa-grid" data-grid aria-label="Attention weight matrix"></table></div>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style>
  .fa-check { font-size: 13.5px; display: inline-flex; gap: 6px; align-items: center; min-height: 36px; }
  .fa-table td, .fa-table th, .fa-grid td, .fa-grid th { padding: 6px 8px; font-size: 13px; }
  .fa-table td { font-family: var(--mono); white-space: nowrap; }
  .fa-bar { display: inline-block; height: 10px; background: var(--accent); border-radius: 2px; vertical-align: middle; margin-right: 6px; }
  .fa-grid td { font-family: var(--mono); text-align: center; min-width: 52px; }
  .fa-grid td.masked { color: var(--ink-3); }
  .fa-grid tr.sel th { color: var(--ink); }
</style>

<script>
  type Vec = [number, number];
  const TOK = ['The', 'cat', 'sat', 'down'];
  const Q: Vec[] = [[0.5, 0.5], [0.9, 0.1], [1.0, 0.6], [0.2, 1.0]];
  const K: Vec[] = [[0.2, 0.1], [1.0, 0.2], [0.3, 1.0], [0.4, 0.8]];
  const V: Vec[] = [[1, 0], [0, 1], [1, 1], [0.5, 0]];
  const D_K = 2;

  const fmt = (x: number, d = 2) => (Number.isFinite(x) ? x.toFixed(d) : 'masked');
  const vec = (v: number[]) => `[${v.map((x) => fmt(x)).join(', ')}]`;

  function row(qi: number, causal: boolean, scale: boolean) {
    const dots = K.map((k) => Q[qi]![0] * k[0] + Q[qi]![1] * k[1]);
    const scores = dots.map((d, j) => (causal && j > qi ? -Infinity : scale ? d / Math.sqrt(D_K) : d));
    const m = Math.max(...scores);
    const e = scores.map((s) => (Number.isFinite(s) ? Math.exp(s - m) : 0));
    const z = e.reduce((a, b) => a + b, 0);
    const w = e.map((x) => x / z);
    const out = [0, 1].map((c) => w.reduce((acc, wj, j) => acc + wj * V[j]![c]!, 0));
    return { dots, scores, w, out };
  }

  function cell(tag: string, text: string, cls = ''): HTMLElement {
    const c = document.createElement(tag);
    c.textContent = text;
    if (cls) c.className = cls;
    return c;
  }

  document.querySelectorAll<HTMLElement>('[data-fattn]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-q]')];
    const causal = root.querySelector<HTMLInputElement>('[data-causal]')!;
    const scale = root.querySelector<HTMLInputElement>('[data-scale]')!;
    const rows = root.querySelector<HTMLElement>('[data-rows]')!;
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    let qi = 2;

    const render = () => {
      buttons.forEach((b, i) => b.setAttribute('aria-pressed', String(i === qi)));
      const r = row(qi, causal.checked, scale.checked);
      rows.replaceChildren(
        ...TOK.map((t, j) => {
          const tr = document.createElement('tr');
          const wcell = cell('td', '');
          const bar = cell('span', '', 'fa-bar');
          bar.style.width = `${Math.round(r.w[j]! * 60)}px`;
          wcell.append(bar, fmt(r.w[j]!, 3));
          tr.append(cell('th', t), cell('td', vec(K[j]!)), cell('td', vec(V[j]!)), cell('td', fmt(r.dots[j]!)), cell('td', fmt(r.scores[j]!)), wcell);
          return tr;
        }),
      );
      root.querySelector('[data-out]')!.textContent = vec(r.out);

      const head = document.createElement('tr');
      head.append(cell('th', ''), ...TOK.map((t) => cell('th', t)));
      const body = TOK.map((t, i) => {
        const tr = document.createElement('tr');
        if (i === qi) tr.className = 'sel';
        const ri = row(i, causal.checked, scale.checked);
        tr.append(cell('th', t));
        ri.w.forEach((w, j) => {
          const masked = causal.checked && j > i;
          const c = cell('td', masked ? '0' : w.toFixed(2), masked ? 'masked' : '');
          if (!masked) c.style.background = `color-mix(in srgb, var(--accent) ${Math.round(w * 60)}%, transparent)`;
          tr.append(c);
        });
        return tr;
      });
      grid.replaceChildren(head, ...body);

      const top = r.w.indexOf(Math.max(...r.w));
      root.querySelector('[data-summary]')!.textContent =
        `${TOK[qi]} puts the most weight, ${r.w[top]!.toFixed(2)}, on ${TOK[top]}. Output ${vec(r.out)}.`;
    };

    buttons.forEach((b, i) => b.addEventListener('click', () => { qi = i; render(); }));
    causal.addEventListener('change', render);
    scale.addEventListener('change', render);
    render();
  });
</script>
