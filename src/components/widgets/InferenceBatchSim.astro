---
// Static versus continuous (iteration-level) batching on a toy workload. Deterministic: the request lengths come
// from a seeded generator, so every reader sees the same run. Props: title, id (unique on the page).
interface Props {
  title?: string;
  id?: string;
}
const { title = 'Batching simulator: static versus continuous', id = 'batchsim' } = Astro.props;
---
<div class="widget ibs" data-ibs>
  <header><h4>{title}</h4><span class="tiny">toy workload of 256 requests, one token per running request per step</span></header>
  <div class="row">
    <label for={`${id}-mix`} class="ibs-field">Output lengths
      <select id={`${id}-mix`} data-mix>
        <option value="mixed" selected>Mixed: 20, 50 or 400 tokens</option>
        <option value="even">Similar: 100, 120 or 140 tokens</option>
        <option value="tail">Long tail: 30 tokens, 1 in 10 is 1,000</option>
      </select>
    </label>
    <label for={`${id}-b`} class="ibs-field">Batch slots <b class="mono" data-bv>16</b>
      <input type="range" id={`${id}-b`} min="2" max="64" step="1" value="16" data-batch />
    </label>
  </div>
  <div class="striplabel">Static: a batch runs until its longest request finishes</div>
  <div class="ibs-strip" data-strip="static" role="img"></div>
  <div class="striplabel">Continuous: a finished slot is refilled on the next step</div>
  <div class="ibs-strip" data-strip="cont" role="img"></div>
  <p class="tiny" style="margin: 4px 0 0">Bar height is the share of slots doing useful work. Both strips share one time axis, the length of the static run.</p>
  <div class="gauges">
    <div><b data-o="ss"></b><span>static, decode steps</span></div>
    <div><b data-o="su"></b><span>static, slot use</span></div>
    <div><b data-o="cs"></b><span>continuous, decode steps</span></div>
    <div><b data-o="cu"></b><span>continuous, slot use</span></div>
  </div>
  <p class="sr-only" aria-live="polite" data-o="live"></p>
</div>

<style>
  .ibs-field { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--ink-2); flex: 1; min-width: 200px; }
  .ibs-field select { font: inherit; font-size: 14px; padding: 8px 10px; min-height: 44px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); max-width: 100%; }
  .ibs-strip { display: flex; align-items: flex-end; gap: 1px; height: 46px; background: var(--bg-2); border-radius: 6px; padding: 3px; }
  .ibs-strip i { flex: 1; min-width: 0; background: var(--accent); border-radius: 1px; }
  .ibs-strip i.idle { background: transparent; }
</style>

<script>
  const BUCKETS = 60;
  const N = 256;

  // mulberry32: a small seeded generator so the simulation is the same on every load.
  function rng(seed: number) {
    let a = seed >>> 0;
    return () => {
      a = (a + 0x6d2b79f5) >>> 0;
      let t = a;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function lengths(mix: string): number[] {
    const r = rng(7);
    const pick = (xs: number[]) => xs[Math.floor(r() * xs.length)]!;
    return Array.from({ length: N }, () => {
      if (mix === 'even') return pick([100, 120, 140]);
      if (mix === 'tail') return r() < 0.1 ? 1000 : 30;
      return pick([20, 50, 400]);
    });
  }

  // Each function returns the number of busy slots at every decode step.
  function staticRun(ls: number[], b: number): number[] {
    const busy: number[] = [];
    for (let i = 0; i < ls.length; i += b) {
      const group = ls.slice(i, i + b);
      const longest = Math.max(...group);
      for (let s = 0; s < longest; s++) busy.push(group.filter((x) => x > s).length);
    }
    return busy;
  }

  function continuousRun(ls: number[], b: number): number[] {
    const queue = [...ls];
    let running: number[] = [];
    const busy: number[] = [];
    while (queue.length || running.length) {
      while (queue.length && running.length < b) running.push(queue.shift()!);
      busy.push(running.length);
      running = running.map((x) => x - 1).filter((x) => x > 0);
    }
    return busy;
  }

  document.querySelectorAll<HTMLElement>('[data-ibs]').forEach((root) => {
    const mix = root.querySelector<HTMLSelectElement>('[data-mix]')!;
    const slider = root.querySelector<HTMLInputElement>('[data-batch]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const strips = {
      static: root.querySelector<HTMLElement>('[data-strip="static"]')!,
      cont: root.querySelector<HTMLElement>('[data-strip="cont"]')!,
    };
    const draw = (el: HTMLElement, busy: number[], b: number, horizon: number) => {
      const per = horizon / BUCKETS;
      const bars: HTMLElement[] = [];
      for (let k = 0; k < BUCKETS; k++) {
        const lo = Math.floor(k * per);
        const hi = Math.max(lo + 1, Math.floor((k + 1) * per));
        const slice = busy.slice(lo, hi);
        const i = document.createElement('i');
        if (!slice.length) i.className = 'idle';
        else i.style.height = `${(slice.reduce((a, x) => a + x, 0) / slice.length / b) * 100}%`;
        bars.push(i);
      }
      el.replaceChildren(...bars);
    };
    const render = () => {
      const b = Number(slider.value);
      const ls = lengths(mix.value);
      const useful = ls.reduce((a, x) => a + x, 0);
      const st = staticRun(ls, b);
      const ct = continuousRun(ls, b);
      const su = useful / (st.length * b);
      const cu = useful / (ct.length * b);
      root.querySelector('[data-bv]')!.textContent = String(b);
      draw(strips.static, st, b, st.length);
      draw(strips.cont, ct, b, st.length);
      strips.static.setAttribute('aria-label', `Static batching slot use over time, ${(su * 100).toFixed(0)} percent overall`);
      strips.cont.setAttribute('aria-label', `Continuous batching slot use over time, ${(cu * 100).toFixed(0)} percent overall`);
      out('ss').textContent = st.length.toLocaleString('en-US');
      out('su').textContent = `${(su * 100).toFixed(0)}%`;
      out('cs').textContent = ct.length.toLocaleString('en-US');
      out('cu').textContent = `${(cu * 100).toFixed(0)}%`;
      out('live').textContent = `Static takes ${st.length} steps at ${(su * 100).toFixed(0)}% slot use; continuous takes ${ct.length} steps at ${(cu * 100).toFixed(0)}%.`;
    };
    mix.addEventListener('change', render);
    slider.addEventListener('input', render);
    render();
  });
</script>
