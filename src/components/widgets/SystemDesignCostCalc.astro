---
// Linked cost and capacity calculator: tokens per request to dollars per day, and peak traffic to replicas via
// Little's law. Every default is an input the reader can change; prices are dated by the caller through `note`.
interface Field {
  k: string;
  label: string;
  value: number;
  step: string;
  min?: string;
  max?: string;
}
interface Props {
  title?: string;
  note?: string;
  defaults?: Partial<Record<string, number>>;
}
const {
  title = 'Cost and capacity calculator',
  note = 'every field is an input',
  defaults = {},
} = Astro.props;

const groups: { name: string; fields: Field[] }[] = [
  {
    name: 'Traffic and tokens',
    fields: [
      { k: 'qpd', label: 'requests per day', value: 1_000_000, step: '1000', min: '0' },
      { k: 'prefix', label: 'shared prefix tokens (cacheable)', value: 2000, step: '100', min: '0' },
      { k: 'dyn', label: 'per-request input tokens', value: 1500, step: '100', min: '0' },
      { k: 'out', label: 'output tokens', value: 300, step: '10', min: '0' },
    ],
  },
  {
    name: 'Prices (USD per million tokens)',
    fields: [
      { k: 'pin', label: 'input price', value: 2, step: '0.01', min: '0' },
      { k: 'pout', label: 'output price', value: 10, step: '0.01', min: '0' },
      { k: 'read', label: 'cache read, x input price', value: 0.1, step: '0.005', min: '0' },
      { k: 'write', label: 'cache write, x input price', value: 1.25, step: '0.05', min: '0' },
    ],
  },
  {
    name: 'Serving',
    fields: [
      { k: 'peak', label: 'peak-to-average ratio', value: 3, step: '0.5', min: '1' },
      { k: 'ttft', label: 'time to first token (s)', value: 0.5, step: '0.05', min: '0' },
      { k: 'mspt', label: 'ms per output token', value: 40, step: '1', min: '0' },
      { k: 'conc', label: 'max concurrent requests per replica', value: 64, step: '1', min: '1' },
      { k: 'head', label: 'planned utilisation (%)', value: 70, step: '5', min: '1', max: '100' },
    ],
  },
];
for (const g of groups) for (const f of g.fields) if (defaults[f.k] !== undefined) f.value = defaults[f.k]!;
const hit = defaults.hit ?? 90;
const uid = `sdc-${Math.abs([...title].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7))}`;
---
<div class="widget sdc" data-sdcalc>
  <header><h4>{title}</h4><span class="tiny">{note}</span></header>
  <div class="sdc-grid">
    {groups.map((g) => (
      <fieldset class="sdc-set">
        <legend class="label">{g.name}</legend>
        {g.fields.map((f) => (
          <label class="sdc-field" for={`${uid}-${f.k}`}>
            <span>{f.label}</span>
            <input type="number" id={`${uid}-${f.k}`} data-k={f.k} value={f.value} step={f.step} min={f.min} max={f.max} inputmode="decimal" />
          </label>
        ))}
      </fieldset>
    ))}
  </div>
  <label class="sdc-hit" for={`${uid}-hit`}>
    <span>cache hit rate on the shared prefix <b class="mono" data-hitv>{hit}%</b></span>
    <input type="range" id={`${uid}-hit`} data-k="hit" min="0" max="100" step="1" value={hit} />
  </label>
  <p class="tiny sdc-err" data-err role="alert" hidden></p>
  <div class="meter" data-out>
    <div><b data-o="day"></b><span>USD per day</span></div>
    <div><b data-o="k"></b><span>USD per 1,000 requests</span></div>
    <div><b data-o="inflight"></b><span>in flight at peak</span></div>
    <div><b data-o="rep"></b><span>replicas</span></div>
  </div>
  <div class="sdc-kv">
    <div class="kv"><span>cost with the cache off</span><b data-o="nocache"></b></div>
    <div class="kv"><span>break-even hit rate for the cache</span><b data-o="even"></b></div>
    <div class="kv"><span>share of the bill: prefix / other input / output</span><b data-o="share"></b></div>
    <div class="kv"><span>average and peak requests per second</span><b data-o="rps"></b></div>
    <div class="kv"><span>time in system per request</span><b data-o="lat"></b></div>
  </div>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style is:global>
  .sdc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .sdc-set { border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px 12px; margin: 0; min-width: 0; }
  .sdc-set legend { padding: 0 4px; }
  .sdc-field { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--ink-2); margin-top: 8px; }
  .widget.sdc .sdc-field input { width: 100%; min-height: 40px; }
  .sdc-hit { display: block; font-size: 13px; color: var(--ink-2); margin-top: 14px; }
  .sdc-hit input { min-height: 32px; }
  .sdc-err { color: var(--rose); margin: 8px 0 0; }
  .sdc-kv { margin-top: 12px; display: grid; gap: 4px; }
  .sdc-kv .kv { flex-wrap: wrap; }
  @media (max-width: 760px) { .sdc-grid { grid-template-columns: 1fr; } }
</style>

<script>
  const usd = (n: number) =>
    '$' + n.toLocaleString('en-US', { maximumFractionDigits: n < 100 ? 2 : 0, minimumFractionDigits: n < 100 ? 2 : 0 });
  const int = (n: number) => Math.round(n).toLocaleString('en-US');

  document.querySelectorAll<HTMLElement>('[data-sdcalc]').forEach((root) => {
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-k]')];
    const out = (k: string, text: string) => {
      const el = root.querySelector<HTMLElement>(`[data-o="${k}"]`);
      if (el) el.textContent = text;
    };
    const err = root.querySelector<HTMLElement>('[data-err]')!;
    const outBox = root.querySelector<HTMLElement>('[data-out]')!;

    const render = () => {
      const v: Record<string, number> = {};
      const bad: string[] = [];
      for (const i of inputs) {
        const n = Number(i.value);
        if (i.value.trim() === '' || !Number.isFinite(n) || n < 0) bad.push(i.dataset.k ?? '');
        v[i.dataset.k ?? ''] = n;
      }
      root.querySelector('[data-hitv]')!.textContent = `${v.hit}%`;
      if (bad.length || v.conc! <= 0 || v.head! <= 0) {
        err.textContent = 'Every field needs a number of zero or more, and concurrency and utilisation must be above zero.';
        err.hidden = false;
        outBox.style.opacity = '0.4';
        return;
      }
      err.hidden = true;
      outBox.style.opacity = '';

      const h = v.hit! / 100;
      // A miss writes the cache, so the prefix costs the write multiplier on misses and the read multiplier on hits.
      const prefixMult = h === 0 ? 1 : h * v.read! + (1 - h) * v.write!;
      const perReq = {
        prefix: (v.prefix! * v.pin! * prefixMult) / 1e6,
        dyn: (v.dyn! * v.pin!) / 1e6,
        out: (v.out! * v.pout!) / 1e6,
      };
      const reqCost = perReq.prefix + perReq.dyn + perReq.out;
      const noCache = ((v.prefix! + v.dyn!) * v.pin! + v.out! * v.pout!) / 1e6;
      const day = reqCost * v.qpd!;
      out('day', usd(day));
      out('k', usd(reqCost * 1000));
      out('nocache', `${usd(noCache * v.qpd!)} per day`);

      const gap = v.write! - v.read!;
      const even = gap > 0 ? (v.write! - 1) / gap : NaN;
      out('even', v.write! <= 1 ? 'any hit rate above 0%' : Number.isFinite(even) && even <= 1 ? `${(even * 100).toFixed(1)}%` : 'never pays off');

      const pct = (x: number) => (reqCost > 0 ? `${Math.round((x / reqCost) * 100)}%` : '0%');
      out('share', `${pct(perReq.prefix)} / ${pct(perReq.dyn)} / ${pct(perReq.out)}`);

      const avg = v.qpd! / 86_400;
      const peak = avg * v.peak!;
      const lat = v.ttft! + (v.out! * v.mspt!) / 1000;
      // Little's law: requests in flight = arrival rate x time each request spends in the system.
      const inflight = peak * lat;
      const usable = v.conc! * (v.head! / 100);
      const replicas = Math.ceil(inflight / usable);
      out('rps', `${avg.toFixed(1)} / ${peak.toFixed(1)}`);
      out('lat', `${lat.toFixed(2)} s`);
      out('inflight', int(inflight));
      out('rep', int(replicas));

      root.querySelector('[data-summary]')!.textContent =
        `${usd(day)} per day at a ${v.hit}% hit rate, ${usd(noCache * v.qpd!)} with the cache off; ${int(inflight)} requests in flight at peak need ${int(replicas)} replicas.`;
    };
    inputs.forEach((i) => i.addEventListener('input', render));
    render();
  });
</script>
