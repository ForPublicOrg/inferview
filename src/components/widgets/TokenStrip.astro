---
// Tokenizer playground: a toy BPE trained in the browser next to real cl100k strips measured by scripts/tokens.mjs.
// Props: preset (english | hindi | japanese | strawberry | numbers | code; default english), title.
// Real counts exist only for the presets; regenerate them with `npm run tokens`.
import real from '../../data/tokens-real.json';

interface Props {
  preset?: 'english' | 'hindi' | 'japanese' | 'strawberry' | 'numbers' | 'code';
  title?: string;
}
const { preset = 'english', title = 'Tokenizer playground' } = Astro.props;
const PRESET_LABELS = [
  ['english', 'English'],
  ['hindi', 'Hindi'],
  ['japanese', 'Japanese'],
  ['strawberry', 'strawberry'],
  ['numbers', 'numbers'],
  ['code', 'code'],
] as const;
const initial = real.presets[preset].text;
const uid = `ts-${preset}`;
---
<div class="widget" data-tokenstrip>
  <header>
    <h4>{title}</h4>
    <span class="tiny">toy BPE: <span data-merges>…</span> merges, trained in <span data-ms>…</span> ms</span>
  </header>
  <label class="sr-only" for={`${uid}-input`}>Text to tokenize</label>
  <textarea id={`${uid}-input`} rows="2" data-input>{initial}</textarea>
  <div class="row" style="margin: 10px 0">
    <span class="tiny">Presets:</span>
    {PRESET_LABELS.map(([k, label]) => <button class="btn sm" type="button" data-p={k}>{label}</button>)}
  </div>
  <div class="row" style="margin-bottom: 8px; justify-content: space-between">
    <span class="striplabel" style="margin: 0">Toy BPE</span>
    <span class="row" style="gap: 8px">
      <span class="tiny">pre-tokenizer treats combining marks as</span>
      <span class="toggle" role="group" aria-label="Pre-tokenizer regex">
        <button type="button" data-re="letters" aria-pressed="true" title="\p{L}+ like cl100k">punctuation</button>
        <button type="button" data-re="marks" aria-pressed="false" title="[\p{L}\p{M}]+ like o200k">part of the word</button>
      </span>
    </span>
  </div>
  <div class="strip" data-strip aria-live="polite"></div>
  <div class="striplabel">Real cl100k <span class="tiny" style="font-weight: 400" data-realnote></span></div>
  <div class="strip" data-strip-real></div>
  <div class="meter">
    <div><b data-m-tok>0</b><span>toy tokens</span></div>
    <div><b data-m-real>n/a</b><span>real cl100k tokens</span></div>
    <div><b data-m-chr>0</b><span>characters</span></div>
    <div><b data-m-ratio>n/a</b><span>chars per real token</span></div>
  </div>
  <p class="tiny" style="margin: 10px 0 0">
    Real strips measured with {real.measuredWith} on {real.measuredOn}. A <span class="mono">�</span> in the real strip is a partial UTF-8 byte: cl100k had no token for that character and fell back to bytes.
  </p>
</div>

<script>
  import real from '../../data/tokens-real.json';

  type PresetKey = keyof typeof real.presets;

  // Toy corpus: English plus a little Hindi prose. The preset sentences are deliberately not in it.
  const CORPUS = `Language models read tokens, not words, and tokens are learned from the training corpus by merging the most frequent adjacent pairs. The model then predicts the next token given the previous tokens. Lower is lower than low. The lowest new widest newer wider low lower newest. Engineers who ship software already understand lexers, parsers, caches and queues. A tokenizer is a lexer that was trained instead of written. The function returns the result of the request when the server responds with the data. Attention lets every token look at every other token in the context, and the cost of that grows with the square of the number of tokens. The capital of a country is a city on a river. We count the tokens, we measure the cost, and then we decide what to keep in the context window. For every request the system prompt is sent again, so the system prompt is the thing you pay for the most. Retries with backoff, rate limits, streaming and caching are the first things an engineer should learn about the model API. The dog did not care about the river or the city, and the engineer did not care about the dog. भारत की राजधानी दिल्ली है। यह शहर नदी के किनारे है। मॉडल टोकन पढ़ता है, शब्द नहीं। हर अनुरोध के साथ सिस्टम प्रॉम्प्ट फिर से भेजा जाता है, इसलिए वही सबसे महंगा है। लोमड़ी नदी के ऊपर कूदती है और कुत्ता देखता है। वह फिर से कोशिश करती है, और फिर से, और फिर से। यह सब टोकन की गिनती के बारे में है। हम लागत मापते हैं और फिर तय करते हैं कि क्या रखना है।`;
  const RE_LETTERS = /\s*[\p{L}']+|\s*\p{N}+|\s*[^\s\p{L}\p{N}]+|\s+/gu;
  const RE_MARKS = /\s*[\p{L}\p{M}']+|\s*\p{N}+|\s*[^\s\p{L}\p{M}\p{N}]+|\s+/gu;
  type Merge = [string, string];

  function applyMerge(w: string[], a: string, b: string): string[] {
    const out: string[] = [];
    for (let i = 0; i < w.length; i++) {
      if (i < w.length - 1 && w[i] === a && w[i + 1] === b) {
        out.push(a + b);
        i++;
      } else out.push(w[i]!);
    }
    return out;
  }

  function trainBPE(text: string, re: RegExp, numMerges: number): Merge[] {
    let words = (text.match(re) ?? []).map((w) => Array.from(w));
    const merges: Merge[] = [];
    for (let k = 0; k < numMerges; k++) {
      const pairs = new Map<string, number>();
      for (const w of words) for (let i = 0; i < w.length - 1; i++) {
        const key = w[i] + '\u0000' + w[i + 1];
        pairs.set(key, (pairs.get(key) ?? 0) + 1);
      }
      let best = '';
      let bc = 0;
      for (const [key, c] of pairs) if (c > bc) { bc = c; best = key; }
      if (bc < 2) break;
      const [a, b] = best.split('\u0000') as Merge;
      merges.push([a, b]);
      words = words.map((w) => applyMerge(w, a, b));
    }
    return merges;
  }

  function encode(text: string, re: RegExp, merges: Merge[]): string[] {
    const toks: string[] = [];
    for (const w of text.match(re) ?? []) {
      let s = Array.from(w);
      for (const [a, b] of merges) {
        if (s.length < 2) break;
        s = applyMerge(s, a, b);
      }
      toks.push(...s);
    }
    return toks;
  }

  const show = (t: string) => t.replace(/ /g, '␣').replace(/\n/g, '⏎');

  function tokEl(t: string, i: number, sub?: number): HTMLElement {
    const span = document.createElement('span');
    span.className = `tok ${i % 2 ? 'alt' : 'base'}`;
    span.textContent = show(t);
    if (sub !== undefined) {
      const s = document.createElement('sub');
      s.textContent = String(sub);
      span.append(s);
    }
    return span;
  }

  document.querySelectorAll<HTMLElement>('[data-tokenstrip]').forEach((root) => {
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const input = $<HTMLTextAreaElement>('[data-input]');
    const strip = $('[data-strip]');
    const stripReal = $('[data-strip-real]');
    if (!input || !strip || !stripReal) return;
    let re = RE_LETTERS;
    let merges: Merge[] = [];

    const retrain = () => {
      const t0 = performance.now();
      merges = trainBPE(CORPUS, re, 500);
      $('[data-ms]')!.textContent = (performance.now() - t0).toFixed(0);
      $('[data-merges]')!.textContent = String(merges.length);
    };

    const render = () => {
      const text = input.value;
      const toks = encode(text, re, merges);
      strip.replaceChildren(...toks.map((t, i) => tokEl(t, i)));
      const chars = Array.from(text).length;
      $('[data-m-tok]')!.textContent = String(toks.length);
      $('[data-m-chr]')!.textContent = String(chars);
      const key = (Object.keys(real.presets) as PresetKey[]).find((k) => real.presets[k].text === text);
      const r = key ? real.presets[key] : undefined;
      if (r) {
        stripReal.replaceChildren(...r.cl100k.toks.map((t, i) => tokEl(t, i, r.cl100k.ids[i])));
        $('[data-realnote]')!.textContent = `(${r.o200k.ids.length} tokens in o200k)`;
        $('[data-m-real]')!.textContent = String(r.cl100k.ids.length);
        $('[data-m-ratio]')!.textContent = (chars / r.cl100k.ids.length).toFixed(1);
      } else {
        const note = document.createElement('span');
        note.className = 'tiny';
        note.textContent = 'Real counts are measured for the preset sentences only. Pick a preset to compare.';
        stripReal.replaceChildren(note);
        $('[data-realnote]')!.textContent = '';
        $('[data-m-real]')!.textContent = 'n/a';
        $('[data-m-ratio]')!.textContent = 'n/a';
      }
    };

    input.addEventListener('input', render);
    root.querySelectorAll<HTMLButtonElement>('[data-p]').forEach((b) =>
      b.addEventListener('click', () => {
        const k = b.dataset.p as PresetKey;
        input.value = real.presets[k].text;
        render();
      }),
    );
    const reButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-re]')];
    reButtons.forEach((b) =>
      b.addEventListener('click', () => {
        re = b.dataset.re === 'marks' ? RE_MARKS : RE_LETTERS;
        reButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        retrain();
        render();
      }),
    );
    retrain();
    render();
  });
</script>
