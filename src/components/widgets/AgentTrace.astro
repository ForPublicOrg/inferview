---
// Recorded agent trace with a step-through player, cost gauges and fault injection. Props: title, faults (TraceFault[];
// the first entry is the trace as recorded), maxCalls (step budget shown in the gauge), price (USD per million input
// tokens, shown as illustrative), legend (question above the fault list). Types live in src/data/traces/types.ts.
import type { TraceFault } from '../../data/traces/types.ts';
import Inline from '../Inline.astro';

interface Props {
  title: string;
  faults: TraceFault[];
  maxCalls?: number;
  price?: number;
  legend?: string;
  note?: string;
}
const {
  title,
  faults,
  maxCalls = 20,
  price = 2.5,
  legend = 'Fault injection: which one reproduces the recorded trace?',
  note = 'recorded; no model runs here',
} = Astro.props;
const name = `fault-${title.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
---
<div class="widget" data-trace={JSON.stringify(faults)} data-max={maxCalls} data-price={price}>
  <header><h4>{title}</h4><span class="tiny">{note}</span></header>
  <div class="ctrls">
    <button class="btn sm" type="button" data-back>Back</button>
    <button class="btn sm primary" type="button" data-fwd>Step</button>
    <button class="btn sm" type="button" data-play>Play</button>
    <button class="btn sm" type="button" data-rst>Reset</button>
    <span class="tiny" data-pos aria-live="polite"></span>
  </div>
  <div class="gauges">
    <div><b data-g-steps>0</b><span>model calls / {maxCalls}</span></div>
    <div><b data-g-ctx>0</b><span>context tokens now</span></div>
    <div><b data-g-bill>0</b><span>input tokens billed up to this step (context re-sent each call)</span></div>
    <div><b data-g-rep>0</b><span>identical calls</span></div>
  </div>
  <div class="kv"><span>cost per 1,000 runs at an illustrative ${price.toFixed(2)} per million input tokens</span><b data-g-cost>$0</b></div>
  <div class="trace" data-steps style="margin-top: 10px" tabindex="0" aria-label="Trace steps"></div>
  <hr class="rule" style="margin: 14px 0" />
  <fieldset class="faults">
    <legend>{legend}</legend>
    {faults.map((f, i) => (
      <label class:list={{ on: i === 0 }}>
        <input type="radio" name={name} value={f.id} checked={i === 0} />
        <span><Inline text={f.label} /> <small><Inline text={f.note} /></small></span>
      </label>
    ))}
  </fieldset>
  <slot />
</div>

<script>
  import type { TraceFault, TraceStep } from '../../data/traces/types.ts';

  function stepEl(s: TraceStep, i: number, pos: number): HTMLElement {
    const row = document.createElement('div');
    row.className = `step ${s.role}${i < pos ? ' seen' : ''}${i === pos - 1 ? ' cur' : ''}`;
    const n = document.createElement('span');
    n.className = 'n';
    n.textContent = s.role === 'note' ? '' : String(i + 1);
    const wrap = document.createElement('div');
    const role = document.createElement('span');
    role.className = 'role';
    role.textContent = s.role;
    const body = document.createElement('span');
    body.className = `body${s.warn ? ' warn' : ''}`;
    body.textContent = s.body;
    wrap.append(role, body);
    row.append(n, wrap);
    return row;
  }

  document.querySelectorAll<HTMLElement>('[data-trace]').forEach((root) => {
    const faults = JSON.parse(root.dataset.trace ?? '[]') as TraceFault[];
    const price = Number(root.dataset.price ?? 2.5);
    const steps = root.querySelector<HTMLElement>('[data-steps]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const set = (sel: string, v: string) => (root.querySelector(sel)!.textContent = v);
    let fault = faults[0];
    let pos = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const render = () => {
      if (!fault) return;
      const t = fault.steps;
      pos = Math.max(0, Math.min(pos, t.length));
      steps.replaceChildren(...t.map((s, i) => stepEl(s, i, pos)));
      let ctx = 0;
      let billed = 0;
      let calls = 0;
      let rep = 0;
      const counts = new Map<string, number>();
      for (const s of t.slice(0, pos)) {
        if (s.role === 'assistant') {
          calls++;
          billed += ctx;
          const call = s.body.match(/calls .*/)?.[0];
          if (call) {
            const c = (counts.get(call) ?? 0) + 1;
            counts.set(call, c);
            rep = Math.max(rep, c);
          }
        }
        ctx += s.tok;
      }
      set('[data-g-steps]', String(calls));
      set('[data-g-ctx]', ctx.toLocaleString('en-US'));
      set('[data-g-bill]', billed.toLocaleString('en-US'));
      set('[data-g-cost]', `$${((billed * price) / 1e6 * 1000).toFixed(2)}`);
      const r = root.querySelector<HTMLElement>('[data-g-rep]')!;
      r.textContent = String(rep);
      r.classList.toggle('bad', rep >= 3);
      set('[data-pos]', `${pos} / ${t.length}`);
      const cur = steps.querySelector<HTMLElement>('.step.cur');
      if (cur) steps.scrollTop = cur.offsetTop - steps.offsetTop - steps.clientHeight / 2;
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
      playBtn.textContent = 'Play';
    };

    root.querySelector('[data-fwd]')!.addEventListener('click', () => {
      pos++;
      render();
    });
    root.querySelector('[data-back]')!.addEventListener('click', () => {
      pos--;
      render();
    });
    root.querySelector('[data-rst]')!.addEventListener('click', () => {
      stop();
      pos = 0;
      render();
    });
    playBtn.addEventListener('click', () => {
      if (timer) return stop();
      playBtn.textContent = 'Pause';
      timer = setInterval(() => {
        if (!fault || pos >= fault.steps.length) return stop();
        pos++;
        render();
      }, 650);
    });
    root.querySelectorAll<HTMLInputElement>('.faults input').forEach((input) =>
      input.addEventListener('change', () => {
        fault = faults.find((f) => f.id === input.value) ?? faults[0];
        stop();
        pos = 0;
        root.querySelectorAll<HTMLLabelElement>('.faults label').forEach((l) => l.classList.toggle('on', Boolean(l.querySelector('input')?.checked)));
        render();
      }),
    );
    render();
  });
</script>
