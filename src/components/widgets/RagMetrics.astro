---
// Retrieval metric calculator. The reader marks results in a ranked list as relevant, sets how many relevant documents
// the retriever never returned, and picks k; recall@k, precision@k, hit@k, reciprocal rank and nDCG@k update live.
// Props: docs (ranked result labels, best first), relevant (0-based indexes marked relevant at start), missing (relevant
// documents not in the list at start), title.
interface Props {
  docs?: string[];
  relevant?: number[];
  missing?: number;
  title?: string;
}
const {
  docs = [
    'Refund policy for annual plans',
    'How to cancel a monthly plan',
    'Refunds for cancelled annual plans',
    'Billing FAQ',
    'Changing your payment card',
    'Refund timelines by payment method',
    'Pricing page',
    'Invoice download',
  ],
  relevant = [2, 5],
  missing = 1,
  title = 'Metric calculator',
} = Astro.props;
const ks = [1, 3, 5, docs.length].filter((k, i, a) => k <= docs.length && a.indexOf(k) === i);
---
<div class="widget" data-ragmetrics data-rel={JSON.stringify(relevant)} data-missing={missing}>
  <header>
    <h4>{title}</h4>
    <div class="toggle" role="group" aria-label="Cut-off k">
      {ks.map((k) => <button type="button" data-k={k} aria-pressed={k === 5 ? 'true' : 'false'}>k = {k}</button>)}
    </div>
  </header>
  <p class="tiny" style="margin-top: 0">Query: "can I get a refund on an annual plan?" Select a result to mark it relevant or not relevant.</p>
  <ol class="rm-list">
    {docs.map((d, i) => (
      <li><button type="button" class="rm-doc" data-i={i} aria-pressed="false"><span class="rm-rank">{i + 1}</span><span class="rm-text">{d}</span><span class="rm-flag" data-flag></span></button></li>
    ))}
  </ol>
  <div class="row" style="margin: 10px 0 12px">
    <span class="tiny" id="rm-missing-label">Relevant documents the retriever never returned</span>
    <div class="row" style="gap: 6px" role="group" aria-labelledby="rm-missing-label">
      <button class="btn sm" type="button" data-dec aria-label="One fewer missing document">-</button>
      <b class="rm-count" data-missing-out aria-live="polite">0</b>
      <button class="btn sm" type="button" data-inc aria-label="One more missing document">+</button>
    </div>
  </div>
  <div aria-live="polite">
    <div class="kv"><span>recall@k: relevant found in top k / all relevant</span><b data-out="recall"></b></div>
    <div class="kv"><span>precision@k: relevant in top k / k</span><b data-out="precision"></b></div>
    <div class="kv"><span>hit@k: any relevant in top k</span><b data-out="hit"></b></div>
    <div class="kv"><span>reciprocal rank: 1 / rank of first relevant</span><b data-out="rr"></b></div>
    <div class="kv"><span>nDCG@k, binary gains</span><b data-out="ndcg"></b></div>
  </div>
  <p class="tiny" style="margin: 10px 0 0" data-note></p>
</div>

<style is:global>
  [data-ragmetrics] .kv b { white-space: nowrap; }
  .rm-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .rm-doc { width: 100%; display: flex; align-items: center; gap: 10px; text-align: left; font: inherit; font-size: 14px; padding: 8px 10px; min-height: 40px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); color: var(--ink); cursor: pointer; }
  .rm-doc[aria-pressed='true'] { border-color: var(--mint); background: var(--bg-2); }
  .rm-doc:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .rm-rank { font-family: var(--mono); color: var(--ink-3); width: 18px; flex: none; }
  .rm-text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .rm-flag { font-size: 12px; font-weight: 650; color: var(--ink-3); flex: none; }
  .rm-doc[aria-pressed='true'] .rm-flag { color: var(--mint); }
  .rm-count { font-family: var(--mono); min-width: 20px; text-align: center; }
</style>

<script>
  const fmt = (x: number | null) => (x === null ? 'n/a' : x.toFixed(3));

  document.querySelectorAll<HTMLElement>('[data-ragmetrics]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.rm-doc')];
    const kButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-k]')];
    const rel = new Set<number>(JSON.parse(root.dataset.rel ?? '[]') as number[]);
    let missing = Number(root.dataset.missing ?? 0);
    let k = Math.min(5, buttons.length);
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!;
    const missingOut = root.querySelector<HTMLElement>('[data-missing-out]')!;
    const note = root.querySelector<HTMLElement>('[data-note]')!;

    const render = () => {
      buttons.forEach((b, i) => {
        const on = rel.has(i);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.querySelector('[data-flag]')!.textContent = on ? 'relevant' : '';
        b.style.opacity = i < k ? '1' : '0.6';
      });
      kButtons.forEach((b) => b.setAttribute('aria-pressed', Number(b.dataset.k) === k ? 'true' : 'false'));
      missingOut.textContent = String(missing);

      const total = rel.size + missing;
      const inTop = [...rel].filter((i) => i < k).length;
      const ranks = [...rel].sort((a, b) => a - b);
      let dcg = 0;
      for (let i = 0; i < k; i++) if (rel.has(i)) dcg += 1 / Math.log2(i + 2);
      let idcg = 0;
      for (let i = 0; i < Math.min(k, total); i++) idcg += 1 / Math.log2(i + 2);

      out('recall').textContent = total ? `${inTop} / ${total} = ${fmt(inTop / total)}` : 'n/a';
      out('precision').textContent = `${inTop} / ${k} = ${fmt(inTop / k)}`;
      out('hit').textContent = inTop ? '1' : '0';
      out('rr').textContent = ranks.length ? `1 / ${ranks[0]! + 1} = ${fmt(1 / (ranks[0]! + 1))}` : '0';
      out('ndcg').textContent = idcg ? fmt(dcg / idcg) : 'n/a';
      note.textContent = missing
        ? `Recall counts the ${missing} relevant document${missing > 1 ? 's' : ''} the retriever never returned; hit@k and reciprocal rank cannot see ${missing > 1 ? 'them' : 'it'}.`
        : 'With nothing missing, recall at the full list length is 1 as soon as anything is marked: recall only knows about the relevant documents the labels say exist.';
    };

    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        if (rel.has(i)) rel.delete(i);
        else rel.add(i);
        render();
      }),
    );
    kButtons.forEach((b) =>
      b.addEventListener('click', () => {
        k = Number(b.dataset.k);
        render();
      }),
    );
    root.querySelector('[data-inc]')!.addEventListener('click', () => {
      missing = Math.min(9, missing + 1);
      render();
    });
    root.querySelector('[data-dec]')!.addEventListener('click', () => {
      missing = Math.max(0, missing - 1);
      render();
    });
    render();
  });
</script>
