---
// Speculative decoding: expected tokens per target pass and walltime speedup from Leviathan et al. (2023),
// Equation 1 and Theorem 3.8. Assumes each draft token is accepted independently with probability alpha.
// Props: title, id (unique on the page).
interface Props {
  title?: string;
  id?: string;
}
const { title = 'Speculative decoding: draft length against acceptance rate', id = 'specsim' } = Astro.props;
const MAXG = 12;
---
<div class="widget iss" data-iss data-maxg={MAXG}>
  <header><h4>{title}</h4><span class="tiny">formula from the paper, not a benchmark</span></header>
  <div class="row">
    <label class="iss-field" for={`${id}-a`}>acceptance rate alpha <b class="mono" data-v="a"></b>
      <input type="range" id={`${id}-a`} min="0.3" max="0.95" step="0.05" value="0.8" data-k="a" />
    </label>
    <label class="iss-field" for={`${id}-g`}>draft length gamma <b class="mono" data-v="g"></b>
      <input type="range" id={`${id}-g`} min="1" max={MAXG} step="1" value="4" data-k="g" />
    </label>
    <label class="iss-field" for={`${id}-c`}>draft cost c, relative to one target pass <b class="mono" data-v="c"></b>
      <input type="range" id={`${id}-c`} min="0.01" max="0.5" step="0.01" value="0.05" data-k="c" />
    </label>
  </div>
  <div class="iss-bars" data-bars role="img"></div>
  <div class="iss-axis" aria-hidden="true">{Array.from({ length: MAXG }, (_, i) => <span>{i + 1}</span>)}</div>
  <p class="tiny" style="margin: 2px 0 0">Bars: walltime speedup for each draft length at the current alpha and c. The dark bar is your gamma; the line marks 1x, no gain.</p>
  <div class="gauges">
    <div><b data-o="e"></b><span>tokens per target pass</span></div>
    <div><b data-o="s"></b><span>walltime speedup</span></div>
    <div><b data-o="best"></b><span>best gamma here</span></div>
    <div><b data-o="cap"></b><span>ceiling, 1 / (1 - alpha)</span></div>
  </div>
  <p class="sr-only" aria-live="polite" data-o="live"></p>
</div>

<style>
  .iss-field { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--ink-2); flex: 1; min-width: 180px; }
  .iss-bars { position: relative; display: flex; align-items: flex-end; gap: 4px; height: 110px; margin-top: 14px; border-bottom: 1px solid var(--line); }
  .iss-bars i { flex: 1; min-width: 0; background: color-mix(in srgb, var(--accent) 45%, var(--bg-2)); border-radius: 3px 3px 0 0; }
  .iss-bars i.on { background: var(--accent); }
  .iss-bars i.loss { background: color-mix(in srgb, var(--rose) 45%, var(--bg-2)); }
  .iss-bars i.on.loss { background: var(--rose); }
  .iss-bars .one { position: absolute; left: 0; right: 0; border-top: 1px dashed var(--ink-3); pointer-events: none; }
  .iss-axis { display: flex; gap: 4px; font-family: var(--mono); font-size: 11px; color: var(--ink-3); }
  .iss-axis span { flex: 1; min-width: 0; text-align: center; }
</style>

<script>
  const expected = (a: number, g: number) => (1 - a ** (g + 1)) / (1 - a);
  const speedup = (a: number, g: number, c: number) => expected(a, g) / (g * c + 1);

  document.querySelectorAll<HTMLElement>('[data-iss]').forEach((root) => {
    const maxg = Number(root.dataset.maxg);
    const input = (k: string) => root.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const bars = root.querySelector<HTMLElement>('[data-bars]')!;
    const render = () => {
      const a = Number(input('a').value);
      const g = Number(input('g').value);
      const c = Number(input('c').value);
      root.querySelector('[data-v="a"]')!.textContent = a.toFixed(2);
      root.querySelector('[data-v="g"]')!.textContent = String(g);
      root.querySelector('[data-v="c"]')!.textContent = c.toFixed(2);
      const all = Array.from({ length: maxg }, (_, i) => speedup(a, i + 1, c));
      const top = Math.max(2, ...all) * 1.1;
      const best = all.indexOf(Math.max(...all)) + 1;
      const cols = all.map((s, i) => {
        const el = document.createElement('i');
        el.style.height = `${(s / top) * 100}%`;
        el.classList.toggle('on', i + 1 === g);
        el.classList.toggle('loss', s < 1);
        el.title = `gamma ${i + 1}: ${s.toFixed(2)}x`;
        return el;
      });
      const line = document.createElement('div');
      line.className = 'one';
      line.style.bottom = `${(1 / top) * 100}%`;
      bars.replaceChildren(...cols, line);
      const s = all[g - 1]!;
      out('e').textContent = expected(a, g).toFixed(2);
      out('s').textContent = `${s.toFixed(2)}x`;
      out('s').classList.toggle('bad', s < 1);
      out('best').textContent = `${best} (${all[best - 1]!.toFixed(2)}x)`;
      out('cap').textContent = (1 / (1 - a)).toFixed(1);
      bars.setAttribute('aria-label', `Speedup by draft length; best is gamma ${best}`);
      out('live').textContent = `Gamma ${g}: ${expected(a, g).toFixed(2)} tokens per pass, speedup ${s.toFixed(2)} times. Best gamma is ${best}.`;
    };
    ['a', 'g', 'c'].forEach((k) => input(k).addEventListener('input', render));
    render();
  });
</script>
