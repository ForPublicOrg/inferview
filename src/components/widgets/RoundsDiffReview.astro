---
// Code review drill for AI-assisted rounds: the reader flags the lines of an assistant's suggestion they think are wrong,
// then checks the flags against the known defects. Props: title, note, lines ({ code, why? }[]; a line with `why` is a defect).
interface Line {
  code: string;
  why?: string;
}
interface Props {
  title?: string;
  note?: string;
  lines?: Line[];
}
const {
  title = 'Review the assistant\'s retry helper',
  note = 'written for this lesson; flag every line you would not ship',
  lines = [
    { code: 'import time' },
    { code: '' },
    { code: 'def call_with_retry(send, request, max_retries=3):' },
    { code: '    delay = 1.0' },
    { code: '    for attempt in range(max_retries):' },
    { code: '        try:' },
    { code: '            return send(request)' },
    {
      code: '        except Exception:',
      why: 'Catches everything, so a 400 validation error or a bug in send is retried as if it were a timeout. Retry only transient failures (429, 5xx, 529, connection errors).',
    },
    {
      code: '            time.sleep(delay)',
      why: 'Ignores the retry-after header the server sends, has no jitter so many clients retry in lockstep, and still sleeps after the final attempt.',
    },
    { code: '            delay *= 2' },
    {
      code: '    return None',
      why: 'Swallows the last error. The caller gets None and cannot tell "the API failed" from "the API returned nothing". Re-raise instead.',
    },
  ],
} = Astro.props;
const uid = `rdr-${Math.abs([...title].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, 7))}`;
const defects = lines.filter((l) => l.why).length;
---
<div class="widget" data-diffreview>
  <header><h4 id={`${uid}-h`}>{title}</h4><span class="tiny">{note}</span></header>
  <p class="tiny" style="margin: 0 0 8px">Select a line to flag it, select again to clear. {defects} lines have a defect.</p>
  <div class="rdr-code" role="group" aria-labelledby={`${uid}-h`}>
    {lines.map((l, i) => (
      <button type="button" class="rdr-line" aria-pressed="false" data-line={i} data-bug={l.why ? '1' : '0'} disabled={l.code.trim() === ''}>
        <span class="rdr-n" aria-hidden="true">{i + 1}</span>
        <code>{l.code || ' '}</code>
        <span class="rdr-mark" data-mark></span>
      </button>
    ))}
  </div>
  <div class="row" style="margin-top: 10px">
    <button class="btn sm primary" type="button" data-check>Check my review</button>
    <button class="btn sm" type="button" data-reset>Start again</button>
  </div>
  <div class="reveal" data-result aria-live="polite">
    <p data-score></p>
    <ol class="rdr-why">
      {lines.map((l, i) => l.why && <li value={i + 1}><b>Line {i + 1}.</b> {l.why}</li>)}
    </ol>
  </div>
</div>

<style is:global>
  .rdr-code { border: 1px solid var(--line); border-radius: 8px; background: var(--bg); overflow-x: auto; padding: 6px 0; }
  .rdr-line { display: flex; align-items: center; gap: 10px; width: 100%; min-width: max-content; min-height: 30px; padding: 2px 10px;
    border: 0; background: transparent; color: var(--ink); font: inherit; text-align: left; cursor: pointer; }
  .rdr-line:disabled { cursor: default; }
  .rdr-line code { font-family: var(--mono); font-size: 13px; white-space: pre; background: none; padding: 0; }
  .rdr-n { font-family: var(--mono); font-size: 12px; color: var(--ink-3); width: 2ch; text-align: right; flex: none; }
  .rdr-line[aria-pressed="true"] { background: var(--bg-2); }
  .rdr-mark.flag { color: var(--ink-2); }
  .rdr-mark { font-size: 12px; font-weight: 650; margin-left: 12px; }
  .rdr-mark.hit { color: var(--mint); }
  .rdr-mark.miss, .rdr-mark.extra { color: var(--rose); }
  .rdr-why { margin: 8px 0 0; padding-left: 22px; }
  .widget .rdr-why li { margin-bottom: 6px; font-size: 14px; font-family: var(--font); }
  @media (pointer: coarse) { .rdr-line { min-height: 44px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-diffreview]').forEach((root) => {
    const lines = [...root.querySelectorAll<HTMLButtonElement>('[data-line]')];
    const result = root.querySelector<HTMLElement>('[data-result]')!;
    const score = root.querySelector<HTMLElement>('[data-score]')!;
    const check = root.querySelector<HTMLButtonElement>('[data-check]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    let checked = false;

    const clearMarks = () => {
      lines.forEach((b) => {
        const m = b.querySelector<HTMLElement>('[data-mark]')!;
        m.textContent = '';
        m.className = 'rdr-mark';
      });
    };

    // Before checking, a flagged line says so in text, so the state does not rest on the background alone.
    const showFlags = () => {
      lines.forEach((b) => {
        const m = b.querySelector<HTMLElement>('[data-mark]')!;
        const on = b.getAttribute('aria-pressed') === 'true';
        m.textContent = on ? 'flagged' : '';
        m.className = on ? 'rdr-mark flag' : 'rdr-mark';
      });
    };

    lines.forEach((b) =>
      b.addEventListener('click', () => {
        const on = b.getAttribute('aria-pressed') !== 'true';
        b.setAttribute('aria-pressed', String(on));
        if (checked) {
          checked = false;
          clearMarks();
          result.classList.remove('show');
        }
        showFlags();
      }),
    );

    check.addEventListener('click', () => {
      let hit = 0, miss = 0, extra = 0;
      lines.forEach((b) => {
        const bug = b.dataset.bug === '1';
        const on = b.getAttribute('aria-pressed') === 'true';
        const m = b.querySelector<HTMLElement>('[data-mark]')!;
        if (bug && on) { hit++; m.textContent = 'found'; m.className = 'rdr-mark hit'; }
        else if (bug) { miss++; m.textContent = 'missed'; m.className = 'rdr-mark miss'; }
        else if (on) { extra++; m.textContent = 'fine as written'; m.className = 'rdr-mark extra'; }
        else { m.textContent = ''; m.className = 'rdr-mark'; }
      });
      const total = hit + miss;
      score.textContent =
        `You found ${hit} of ${total} defects` +
        (extra ? `, and flagged ${extra} line${extra === 1 ? '' : 's'} that ${extra === 1 ? 'is' : 'are'} fine as written.` : '.') +
        (miss ? ' The missed lines are marked in the code.' : '');
      result.classList.add('show');
      checked = true;
    });

    reset.addEventListener('click', () => {
      lines.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      clearMarks();
      result.classList.remove('show');
      checked = false;
      lines.find((b) => !b.disabled)?.focus();
    });
  });
</script>
