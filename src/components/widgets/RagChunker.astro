---
// Chunk boundary explorer. A short policy page with a table is chunked either by fixed word windows with overlap or by
// structure (headings and blank lines, packed up to the size). The widget reports chunk count, stored words versus
// source words, and whether the answer row and the table header land in the same chunk. Words stand in for tokens.
// Props: title.
interface Props {
  title?: string;
}
const { title = 'Where does the table get cut?' } = Astro.props;
const doc = `# Leaving the company

All staff give written notice to their manager. Notice starts the day after the manager receives it. Unused annual leave is paid out with the final salary, except for contractors, whose agreements govern leave.

## Notice periods

| Role | Notice period |
| Employee, first year | 30 days |
| Employee, after first year | 60 days |
| Manager | 90 days |
| Contractor | 14 days |

## Equipment

Return your laptop, badge and any hardware tokens on your last day. IT wipes returned laptops within a week. Lost equipment is deducted from the final salary at its depreciated value.

## Final pay

Final salary is paid on the next regular payroll date. Expense claims must be submitted before the last day.`;
---
<div class="widget" data-ragchunker data-doc={doc}>
  <header>
    <h4>{title}</h4>
    <div class="toggle" role="group" aria-label="Chunking strategy">
      <button type="button" data-mode="fixed" aria-pressed="true">Fixed size</button>
      <button type="button" data-mode="structure" aria-pressed="false">Headings and blank lines</button>
    </div>
  </header>
  <p class="tiny" style="margin-top: 0">Question: "What notice does a contractor give?" The answer row only means something next to the header row that names the column.</p>
  <label class="kv" for="rc-size"><span>chunk size (words)</span><b data-size-out></b></label>
  <input type="range" id="rc-size" min="15" max="120" step="5" value="60" data-size />
  <label class="kv" for="rc-overlap"><span>overlap (words, fixed size only)</span><b data-overlap-out></b></label>
  <input type="range" id="rc-overlap" min="0" max="30" step="5" value="0" data-overlap />
  <div aria-live="polite" style="margin: 10px 0">
    <div class="kv"><span>chunks</span><b data-count></b></div>
    <div class="kv"><span>stored words / source words</span><b data-ratio></b></div>
    <div class="kv"><span>answer row and header in one chunk</span><b data-verdict></b></div>
  </div>
  <div class="rc-chunks" data-chunks></div>
</div>

<style is:global>
  [data-ragchunker] .kv b { white-space: nowrap; }
  .rc-chunks { display: grid; gap: 8px; }
  .rc-chunk { border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; font-family: var(--mono); font-size: 12.5px; line-height: 1.55; background: var(--bg); overflow-wrap: anywhere; white-space: pre-wrap; }
  .rc-chunk.hit { border-color: var(--mint); }
  .rc-chunk.half { border-color: var(--rose); }
  .rc-chunk .lab { display: block; font-family: var(--font); font-size: 12px; font-weight: 650; color: var(--ink-3); margin-bottom: 4px; white-space: normal; }
  .rc-chunk mark { background: none; color: var(--accent); font-weight: 700; }
</style>

<script>
  type Chunk = { words: string[]; start: number };
  const HEADER = ['|', 'Role', '|', 'Notice', 'period', '|'];
  const ANSWER = ['|', 'Contractor', '|', '14', 'days', '|'];

  function findSeq(words: string[], seq: string[]): number {
    for (let i = 0; i + seq.length <= words.length; i++) if (seq.every((s, j) => words[i + j] === s)) return i;
    return -1;
  }

  function fixed(words: string[], size: number, overlap: number): Chunk[] {
    const step = Math.max(1, size - overlap);
    const out: Chunk[] = [];
    for (let start = 0; start < words.length; start += step) {
      out.push({ words: words.slice(start, start + size), start });
      if (start + size >= words.length) break;
    }
    return out;
  }

  function structural(blocks: string[][], size: number): Chunk[] {
    const out: Chunk[] = [];
    let cur: string[] = [];
    let start = 0;
    let pos = 0;
    for (const b of blocks) {
      const isHeading = b[0]?.startsWith('#') ?? false;
      if (cur.length && (isHeading || cur.length + b.length > size)) {
        out.push({ words: cur, start });
        cur = [];
      }
      if (!cur.length) start = pos;
      cur = cur.concat(b);
      pos += b.length;
    }
    if (cur.length) out.push({ words: cur, start });
    return out;
  }

  document.querySelectorAll<HTMLElement>('[data-ragchunker]').forEach((root) => {
    const text = root.dataset.doc ?? '';
    const blocks = text.split(/\n\s*\n/).map((b) => b.split(/\s+/).filter(Boolean));
    const words = blocks.flat();
    const hStart = findSeq(words, HEADER);
    const aStart = findSeq(words, ANSWER);
    const sizeIn = root.querySelector<HTMLInputElement>('[data-size]')!;
    const ovIn = root.querySelector<HTMLInputElement>('[data-overlap]')!;
    const modeBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    const box = root.querySelector<HTMLElement>('[data-chunks]')!;
    let mode = 'fixed';

    const covers = (c: Chunk, s: number, len: number) => c.start <= s && s + len <= c.start + c.words.length;

    const render = () => {
      const size = Number(sizeIn.value);
      const overlap = Math.min(Number(ovIn.value), size - 5);
      root.querySelector('[data-size-out]')!.textContent = String(size);
      root.querySelector('[data-overlap-out]')!.textContent = mode === 'fixed' ? String(overlap) : 'not used';
      ovIn.disabled = mode !== 'fixed';
      modeBtns.forEach((b) => b.setAttribute('aria-pressed', b.dataset.mode === mode ? 'true' : 'false'));
      const chunks = mode === 'fixed' ? fixed(words, size, overlap) : structural(blocks, size);
      const stored = chunks.reduce((n, c) => n + c.words.length, 0);
      const good = chunks.some((c) => covers(c, hStart, HEADER.length) && covers(c, aStart, ANSWER.length));
      root.querySelector('[data-count]')!.textContent = String(chunks.length);
      root.querySelector('[data-ratio]')!.textContent = `${stored} / ${words.length} = ${(stored / words.length).toFixed(2)}`;
      root.querySelector('[data-verdict]')!.textContent = good ? 'yes' : 'no';
      box.replaceChildren();
      chunks.forEach((c, i) => {
        const div = document.createElement('div');
        const hasA = covers(c, aStart, ANSWER.length);
        const hasH = covers(c, hStart, HEADER.length);
        div.className = `rc-chunk${hasA && hasH ? ' hit' : hasA ? ' half' : ''}`;
        const lab = document.createElement('span');
        lab.className = 'lab';
        lab.textContent = `Chunk ${i + 1}, ${c.words.length} words${hasA && !hasH ? ': answer row without its header' : hasA ? ': answer row with its header' : ''}`;
        div.append(lab);
        c.words.forEach((w, j) => {
          const g = c.start + j;
          const inA = g >= aStart && g < aStart + ANSWER.length;
          const inH = g >= hStart && g < hStart + HEADER.length;
          if (j) div.append(' ');
          if (inA || inH) {
            const m = document.createElement('mark');
            m.textContent = w;
            div.append(m);
          } else div.append(w);
        });
        box.append(div);
      });
    };

    sizeIn.addEventListener('input', render);
    ovIn.addEventListener('input', render);
    modeBtns.forEach((b) =>
      b.addEventListener('click', () => {
        mode = b.dataset.mode ?? 'fixed';
        render();
      }),
    );
    render();
  });
</script>
