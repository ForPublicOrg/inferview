---
// KV cache per sequence and sequences that fit, per attention layout, from published configs.
// Llama 3.1 70B config (80 layers, 8 KV heads, head_dim 128); DeepSeek-V3 config (61 layers, kv_lora_rank 512,
// qk_rope_head_dim 64); Gemma 3 27B config (62 layers, 16 KV heads, head_dim 128, window 1024, every sixth layer
// global); gpt-oss-120b config (36 layers alternating window 128 and full, 8 KV heads, head_dim 64). Props: title, id.
interface Props {
  title?: string;
  id?: string;
}
const { title = 'KV cache by attention layout', id = 'falc' } = Astro.props;
const f = (k: string) => `${id}-${k}`;
---
<div class="widget falc" data-falc>
  <header><h4>{title}</h4><span class="tiny">computed from published configs, cache only</span></header>
  <div class="falc-grid">
    <label for={f('ctx')}>Context per sequence
      <select id={f('ctx')} data-k="ctx">
        <option value="8192">8,192 tokens</option>
        <option value="32768">32,768 tokens</option>
        <option value="131072" selected>131,072 tokens</option>
      </select>
    </label>
    <label for={f('bytes')}>Cache precision
      <select id={f('bytes')} data-k="bytes">
        <option value="2" selected>bf16, 2 bytes</option>
        <option value="1">8-bit, 1 byte</option>
      </select>
    </label>
    <label for={f('budget')}>Memory left for cache (GiB)
      <input id={f('budget')} data-k="budget" type="number" min="1" max="10000" step="1" value="400" inputmode="numeric" />
    </label>
    <label class="falc-check"><input type="checkbox" data-k="full" /> engine allocates windowed layers at full context</label>
  </div>
  <div class="tablewrap">
    <table class="falc-table">
      <thead>
        <tr><th scope="col">model</th><th scope="col">layout</th><th scope="col">bytes per token</th><th scope="col">per sequence</th><th scope="col">sequences</th></tr>
      </thead>
      <tbody data-rows></tbody>
    </table>
  </div>
  <p class="tiny falc-note" data-note></p>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style>
  .falc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px 14px; margin-bottom: 12px; }
  .falc-grid label { display: flex; flex-direction: column; gap: 4px; font-size: 13.5px; }
  .falc-grid select, .falc-grid input[type='number'] { min-height: 36px; max-width: 100%; }
  .falc-grid .falc-check { flex-direction: row; align-items: center; gap: 6px; min-height: 36px; }
  .falc-table td, .falc-table th { padding: 6px 8px; font-size: 13px; }
  .falc-table td { font-family: var(--mono); white-space: nowrap; }
  .falc-table td.lay { font-family: inherit; white-space: normal; min-width: 120px; }
  .falc-note { margin-top: 8px; }
</style>

<script>
  type Layout = {
    name: string;
    layout: string;
    perLayer: number; // cached values per layer per token
    full: number; // layers whose cache grows with context
    win: number; // windowed layers
    window: number;
  };
  const MODELS: Layout[] = [
    { name: 'Llama 3.1 70B', layout: 'GQA, 80 full layers, 8 KV heads', perLayer: 2 * 8 * 128, full: 80, win: 0, window: 0 },
    { name: 'Llama 3.1 70B, 64 KV heads', layout: 'hypothetical MHA, for comparison', perLayer: 2 * 64 * 128, full: 80, win: 0, window: 0 },
    { name: 'DeepSeek-V3', layout: 'MLA, 61 layers, 512 + 64 values', perLayer: 512 + 64, full: 61, win: 0, window: 0 },
    { name: 'Gemma 3 27B', layout: '10 global, 52 local at 1,024', perLayer: 2 * 16 * 128, full: 10, win: 52, window: 1024 },
    { name: 'gpt-oss-120b', layout: '18 full, 18 windowed at 128', perLayer: 2 * 8 * 64, full: 18, win: 18, window: 128 },
  ];
  const GIB = 2 ** 30;

  function fmtBytes(b: number): string {
    if (b >= GIB) return `${(b / GIB).toFixed(2)} GiB`;
    if (b >= 2 ** 20) return `${(b / 2 ** 20).toFixed(1)} MiB`;
    return `${(b / 1024).toFixed(1)} KiB`;
  }

  function perSequence(m: Layout, ctx: number, bytes: number, allocFull: boolean): { perToken: number; total: number } {
    const growing = allocFull ? m.full + m.win : m.full;
    const perToken = bytes * m.perLayer * growing;
    const windowed = allocFull ? 0 : bytes * m.perLayer * m.win * Math.min(ctx, m.window);
    return { perToken, total: perToken * ctx + windowed };
  }

  function cell(text: string, cls = ''): HTMLTableCellElement {
    const c = document.createElement('td');
    c.textContent = text;
    if (cls) c.className = cls;
    return c;
  }

  document.querySelectorAll<HTMLElement>('[data-falc]').forEach((root) => {
    const ctxEl = root.querySelector<HTMLSelectElement>('[data-k="ctx"]')!;
    const bytesEl = root.querySelector<HTMLSelectElement>('[data-k="bytes"]')!;
    const budgetEl = root.querySelector<HTMLInputElement>('[data-k="budget"]')!;
    const fullEl = root.querySelector<HTMLInputElement>('[data-k="full"]')!;
    const rows = root.querySelector<HTMLElement>('[data-rows]')!;
    const note = root.querySelector<HTMLElement>('[data-note]')!;
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;

    const render = () => {
      const ctx = Number(ctxEl.value);
      const bytes = Number(bytesEl.value);
      const raw = Number(budgetEl.value);
      const budget = Number.isFinite(raw) && raw > 0 ? Math.min(raw, 10000) : 1;
      const allocFull = fullEl.checked;
      const results = MODELS.map((m) => ({ m, ...perSequence(m, ctx, bytes, allocFull) }));
      rows.replaceChildren(
        ...results.map(({ m, perToken, total }) => {
          const tr = document.createElement('tr');
          const th = document.createElement('th');
          th.scope = 'row';
          th.textContent = m.name;
          const fit = Math.floor((budget * GIB) / total);
          tr.append(th, cell(m.layout, 'lay'), cell(perToken.toLocaleString('en-US')), cell(fmtBytes(total)), cell(fit.toLocaleString('en-US')));
          return tr;
        }),
      );
      note.textContent = allocFull
        ? 'Windowed layers are charged for every token, as an engine without per-layer allocation would charge them.'
        : 'Windowed layers stop growing at their window; bytes per token counts only the layers that grow with context.';
      const best = results.reduce((a, b) => (a.total < b.total ? a : b));
      summary.textContent = `At ${ctx.toLocaleString('en-US')} tokens, ${best.m.name} needs the least cache, ${fmtBytes(best.total)} per sequence.`;
    };

    [ctxEl, bytesEl, fullEl].forEach((el) => el.addEventListener('change', render));
    budgetEl.addEventListener('input', render);
    render();
  });
</script>
