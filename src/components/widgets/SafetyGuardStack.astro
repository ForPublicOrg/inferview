---
// Stack guardrails and see two costs move: benign requests wrongly blocked, and latency added before the user sees an
// answer. Props: title, traffic (benign requests per day). The guard numbers are toy values, labelled as such.
interface Guard {
  id: string;
  name: string;
  side: 'input' | 'output';
  fpr: number;
  ms: number;
}
interface Props {
  title?: string;
  traffic?: number;
}
const GUARDS: Guard[] = [
  { id: 'inj', name: 'Injection classifier', side: 'input', fpr: 0.02, ms: 40 },
  { id: 'pii', name: 'PII scanner', side: 'input', fpr: 0.01, ms: 15 },
  { id: 'topic', name: 'Off-topic classifier', side: 'input', fpr: 0.04, ms: 120 },
  { id: 'judge', name: 'LLM judge on the answer', side: 'output', fpr: 0.03, ms: 300 },
];
const { title = 'Guardrail stack: false positives and latency', traffic = 100000 } = Astro.props;
const uid = `gs-${title.replace(/[^a-z0-9]+/gi, '-').toLowerCase().slice(0, 20)}`;
---
<div class="widget" data-guardstack={JSON.stringify(GUARDS)} data-traffic={traffic}>
  <header><h4>{title}</h4><span class="tiny">toy rates and latencies, not measurements</span></header>
  <fieldset class="faults">
    <legend>Guards in the request path</legend>
    {GUARDS.map((g, i) => (
      <label for={`${uid}-${g.id}`}>
        <input type="checkbox" id={`${uid}-${g.id}`} data-guard={g.id} checked={i === 0 || i === 3} />
        <span>{g.name}<small>{g.side} guard, blocks {(g.fpr * 100).toFixed(0)}% of benign requests, {g.ms} ms</small></span>
      </label>
    ))}
  </fieldset>
  <label class="row" style="margin-top: 12px; font-size: 14px; min-height: 44px" for={`${uid}-par`}>
    <input type="checkbox" id={`${uid}-par`} data-par />
    Run the input guards side by side instead of one after another
  </label>
  <div class="meter">
    <div><b data-o="rate">0</b><span>benign requests blocked</span></div>
    <div><b data-o="sum">0</b><span>naive sum of the rates</span></div>
    <div><b data-o="count">0</b><span>wrongly blocked per day</span></div>
    <div><b data-o="ms">0</b><span>latency added</span></div>
  </div>
  <p class="tiny" aria-live="polite" data-o="note" style="margin-top: 12px"></p>
</div>

<script>
  type Guard = { id: string; name: string; side: 'input' | 'output'; fpr: number; ms: number };

  document.querySelectorAll<HTMLElement>('[data-guardstack]').forEach((root) => {
    const guards = JSON.parse(root.dataset.guardstack ?? '[]') as Guard[];
    const traffic = Number(root.dataset.traffic ?? 100000);
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[data-guard]')];
    const par = root.querySelector<HTMLInputElement>('[data-par]');
    const set = (k: string, v: string) => {
      const el = root.querySelector<HTMLElement>(`[data-o="${k}"]`);
      if (el) el.textContent = v;
    };

    const render = () => {
      const on = new Set(boxes.filter((b) => b.checked).map((b) => b.dataset.guard));
      boxes.forEach((b) => b.closest('label')?.classList.toggle('on', b.checked));
      const active = guards.filter((g) => on.has(g.id));
      // Assumes each guard's mistakes are independent of the others'.
      const pass = active.reduce((acc, g) => acc * (1 - g.fpr), 1);
      const rate = 1 - pass;
      const naive = active.reduce((acc, g) => acc + g.fpr, 0);
      const inputs = active.filter((g) => g.side === 'input').map((g) => g.ms);
      const outputs = active.filter((g) => g.side === 'output').map((g) => g.ms);
      const inputMs = par?.checked ? Math.max(0, ...inputs) : inputs.reduce((a, b) => a + b, 0);
      const ms = inputMs + outputs.reduce((a, b) => a + b, 0);
      set('rate', `${(rate * 100).toFixed(2)}%`);
      set('sum', `${(naive * 100).toFixed(2)}%`);
      set('count', Math.round(rate * traffic).toLocaleString('en-US'));
      set('ms', `${ms} ms`);
      set(
        'note',
        active.length === 0
          ? 'No guards: nothing is blocked and nothing is checked.'
          : `Out of ${traffic.toLocaleString('en-US')} benign requests a day. ${outputs.length ? 'The output guard has to wait for the full answer, so its time adds after generation; streaming the answer means checking chunks or holding them back.' : 'With no output guard, nothing checks what the model actually says.'}`,
      );
    };

    boxes.forEach((b) => b.addEventListener('change', render));
    par?.addEventListener('change', render);
    render();
  });
</script>
