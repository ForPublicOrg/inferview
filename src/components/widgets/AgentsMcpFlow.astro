---
// Steps through the MCP messages for one tool call that needs extra input from the user, under the stateful
// 2025-11-25 revision and the stateless 2026-07-28 revision. Frames are abbreviated; "..." marks omitted fields.
interface Props {
  title?: string;
}
const { title = 'One tool call, two MCP revisions' } = Astro.props;
type Frame = { from: 'client' | 'server' | 'note'; body: string };
const FLOWS: Record<string, { label: string; frames: Frame[]; facts: [string, string][] }> = {
  old: {
    label: '2025-11-25 (stateful)',
    frames: [
      { from: 'client', body: 'POST initialize\n{"protocolVersion": "2025-11-25", "capabilities": {"elicitation": {}}, "clientInfo": {...}}' },
      { from: 'server', body: 'result {"protocolVersion": "2025-11-25", "capabilities": {"tools": {...}}, ...}\nheader Mcp-Session-Id: s-41c9' },
      { from: 'client', body: 'POST notifications/initialized\nheader Mcp-Session-Id: s-41c9' },
      { from: 'client', body: 'POST tools/call {"name": "create_ticket", "arguments": {"title": "Disk full"}}\nheader Mcp-Session-Id: s-41c9' },
      { from: 'server', body: 'request on the open SSE stream: elicitation/create\n{"message": "Which project?", "requestedSchema": {...}}' },
      { from: 'client', body: 'POST response to elicitation/create {"action": "accept", "content": {"project": "OPS"}}\nheader Mcp-Session-Id: s-41c9' },
      { from: 'server', body: 'result {"content": [{"type": "text", "text": "Created OPS-118"}], "isError": false}' },
      { from: 'note', body: 'The half-finished tools/call lives in memory on the instance that minted s-41c9. Every request in the session must reach that instance.' },
    ],
    facts: [['handshake messages before the first call', '3'], ['server-initiated requests', '1'], ['state held between requests', 'session on one server instance']],
  },
  now: {
    label: '2026-07-28 (stateless)',
    frames: [
      { from: 'client', body: 'POST tools/call {"name": "create_ticket", "arguments": {"title": "Disk full"},\n "_meta": {"io.modelcontextprotocol/protocolVersion": "2026-07-28",\n           "io.modelcontextprotocol/clientCapabilities": {...}}}\nheaders MCP-Protocol-Version: 2026-07-28, Mcp-Method: tools/call, Mcp-Name: create_ticket' },
      { from: 'server', body: 'result {"resultType": "input_required", "inputRequests": {...an elicitation asking "Which project?"...}}' },
      { from: 'client', body: 'POST tools/call, the same request again with "inputResponses": {...{"project": "OPS"}...}\nand the same _meta and headers' },
      { from: 'server', body: 'result {"resultType": "complete", "content": [{"type": "text", "text": "Created OPS-118"}], "isError": false}' },
      { from: 'note', body: 'No handshake, no session id, no server-initiated request. Any instance behind the load balancer can answer either POST. Servers must also implement the new server/discover RPC, not shown here.' },
    ],
    facts: [['handshake messages before the first call', '0'], ['server-initiated requests', '0'], ['state held between requests', 'none; the retry carries it']],
  },
};
---
<div class="widget" data-mcpflow={JSON.stringify(FLOWS)}>
  <header><h4>{title}</h4><span class="tiny">abbreviated frames; ids and values are examples</span></header>
  <div class="ctrls">
    <div class="toggle" role="group" aria-label="Protocol revision">
      {Object.entries(FLOWS).map(([k, f], i) => <button type="button" data-rev={k} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
    </div>
  </div>
  <div class="ctrls">
    <button class="btn sm" type="button" data-back>Back</button>
    <button class="btn sm primary" type="button" data-fwd>Next message</button>
    <button class="btn sm" type="button" data-all>Show all</button>
    <span class="tiny" data-pos aria-live="polite"></span>
  </div>
  <div class="trace" data-frames tabindex="0" aria-label="Protocol messages"></div>
  <div data-facts style="margin-top: 12px"></div>
</div>

<script>
  type Frame = { from: 'client' | 'server' | 'note'; body: string };
  type Flow = { label: string; frames: Frame[]; facts: [string, string][] };

  const ROLE_CLASS = { client: 'user', server: 'tool', note: 'system' } as const;

  document.querySelectorAll<HTMLElement>('[data-mcpflow]').forEach((root) => {
    const flows = JSON.parse(root.dataset.mcpflow ?? '{}') as Record<string, Flow>;
    const list = root.querySelector<HTMLElement>('[data-frames]')!;
    const facts = root.querySelector<HTMLElement>('[data-facts]')!;
    const revs = [...root.querySelectorAll<HTMLButtonElement>('[data-rev]')];
    let rev = revs[0]?.dataset.rev ?? 'old';
    let pos = 1;

    const render = () => {
      const flow = flows[rev]!;
      pos = Math.max(1, Math.min(pos, flow.frames.length));
      list.replaceChildren(
        ...flow.frames.map((f, i) => {
          const row = document.createElement('div');
          row.className = `step ${ROLE_CLASS[f.from]}${i < pos ? ' seen' : ''}${i === pos - 1 ? ' cur' : ''}`;
          const n = document.createElement('span');
          n.className = 'n';
          n.textContent = f.from === 'note' ? '' : String(i + 1);
          const wrap = document.createElement('div');
          const role = document.createElement('span');
          role.className = 'role';
          role.textContent = f.from === 'note' ? 'note' : `${f.from} sends`;
          const body = document.createElement('span');
          body.className = 'body';
          body.textContent = f.body;
          wrap.append(role, body);
          row.append(n, wrap);
          return row;
        }),
      );
      root.querySelector('[data-pos]')!.textContent = `${pos} / ${flow.frames.length}`;
      facts.replaceChildren(
        ...flow.facts.map(([k, v]) => {
          const d = document.createElement('div');
          d.className = 'kv';
          const s = document.createElement('span');
          s.textContent = k;
          const b = document.createElement('b');
          b.textContent = v;
          d.append(s, b);
          return d;
        }),
      );
    };

    revs.forEach((b) =>
      b.addEventListener('click', () => {
        rev = b.dataset.rev ?? rev;
        revs.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        pos = 1;
        render();
      }),
    );
    root.querySelector('[data-fwd]')!.addEventListener('click', () => {
      pos++;
      render();
    });
    root.querySelector('[data-back]')!.addEventListener('click', () => {
      pos--;
      render();
    });
    root.querySelector('[data-all]')!.addEventListener('click', () => {
      pos = flows[rev]!.frames.length;
      render();
    });
    render();
  });
</script>
