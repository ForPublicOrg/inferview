---
// Raw storage for an embedding index: vectors x dimensions x bytes per value. Props: title.
// ANN index structures, metadata and replicas come on top and vary by engine.
interface Props {
  title?: string;
}
const { title = 'Index size calculator' } = Astro.props;
const dims = [3072, 1536, 1024, 768, 512, 256, 128];
const formats = [
  { label: 'float32', bytes: 4 },
  { label: 'float16', bytes: 2 },
  { label: 'int8', bytes: 1 },
  { label: 'binary', bytes: 0.125 },
];
---
<div class="widget" data-fidx>
  <header><h4>{title}</h4><span class="tiny">raw vectors only, no index overhead</span></header>
  <div class="row" style="margin-bottom: 10px">
    <label style="font-size: 13.5px" for="fidx-n">Vectors, in millions</label>
    <input type="number" id="fidx-n" min="0.001" max="100000" step="any" value="10" style="width: 120px" data-n />
  </div>
  <div class="row" style="margin-bottom: 10px">
    <span class="label">Dimensions</span>
    <span class="toggle" role="group" aria-label="Dimensions" style="flex-wrap: wrap">
      {dims.map((d, i) => <button type="button" data-dim={d} aria-pressed={i === 0 ? 'true' : 'false'}>{d}</button>)}
    </span>
  </div>
  <div class="row" style="margin-bottom: 12px">
    <span class="label">Stored as</span>
    <span class="toggle" role="group" aria-label="Value format" style="flex-wrap: wrap">
      {formats.map((f, i) => <button type="button" data-bytes={f.bytes} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
    </span>
  </div>
  <div class="meter" style="grid-template-columns: repeat(auto-fit, minmax(130px, 1fr))">
    <div><b data-gb>0</b><span>GB of raw vectors</span></div>
    <div><b data-per>0</b><span>bytes per vector</span></div>
    <div><b data-ratio>1x</b><span>smaller than 3072 float32</span></div>
  </div>
  <p class="tiny" style="margin: 10px 0 0" aria-live="polite" data-formula></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-fidx]').forEach((root) => {
    const n = root.querySelector<HTMLInputElement>('[data-n]')!;
    const dimBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-dim]')];
    const fmtBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-bytes]')];
    let dim = Number(dimBtns[0]!.dataset.dim);
    let bytes = Number(fmtBtns[0]!.dataset.bytes);

    const pick = (list: HTMLButtonElement[], chosen: HTMLButtonElement) =>
      list.forEach((b) => b.setAttribute('aria-pressed', String(b === chosen)));

    const render = () => {
      const millions = Math.max(0, Number(n.value) || 0);
      const per = dim * bytes;
      const total = millions * 1e6 * per;
      const ratio = (3072 * 4) / per;
      root.querySelector('[data-gb]')!.textContent = (total / 1e9).toLocaleString('en-US', { maximumFractionDigits: 2 });
      root.querySelector('[data-per]')!.textContent = per.toLocaleString('en-US');
      root.querySelector('[data-ratio]')!.textContent = `${ratio.toLocaleString('en-US', { maximumFractionDigits: 1 })}x`;
      root.querySelector('[data-formula]')!.textContent =
        `${millions.toLocaleString('en-US')} million vectors × ${dim} dimensions × ${bytes} bytes = ${(total / 1e9).toLocaleString('en-US', { maximumFractionDigits: 2 })} GB (1 GB = 10^9 bytes).`;
    };

    dimBtns.forEach((b) => b.addEventListener('click', () => { dim = Number(b.dataset.dim); pick(dimBtns, b); render(); }));
    fmtBtns.forEach((b) => b.addEventListener('click', () => { bytes = Number(b.dataset.bytes); pick(fmtBtns, b); render(); }));
    n.addEventListener('input', render);
    render();
  });
</script>
