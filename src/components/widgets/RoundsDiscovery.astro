---
// Branching customer-discovery drill. Each turn the customer speaks and the reader picks one of three replies; some replies
// uncover facts on a hidden checklist, which is revealed at the end. Deterministic, no free text. Props: title, note.
interface Props {
  title?: string;
  note?: string;
}
const { title = 'Discovery simulator: "we want an AI agent for support"', note = 'a scripted scenario, not a real customer' } = Astro.props;

const checklist = [
  { key: 'volume', label: 'Which tickets dominate, and at what volume' },
  { key: 'baseline', label: 'How success is measured today' },
  { key: 'past', label: 'What went wrong with the last tool' },
  { key: 'compliance', label: 'Data residency and audit rules' },
  { key: 'actions', label: 'Which actions need checks before an agent may take them' },
  { key: 'decision', label: 'Who signs off, and what they need to see' },
  { key: 'evaldata', label: 'Real past tickets to evaluate a pilot on' },
];

const turns = [
  {
    customer: 'We want an AI agent for support. Everyone is doing it. Can you build us one?',
    options: [
      { say: 'Yes. Our models are very good at support. I can show you a demo this week.', reply: 'Sure, send the demo.', note: 'A pitch. You learned nothing about their support.', uncovers: [] },
      { say: 'Before I suggest anything, which kinds of tickets take most of your team\'s time?', reply: 'Shipment status, mostly. Where is my parcel, can I change the address. It peaks after holidays.', note: 'An open question about their work. They told you where the volume is.', uncovers: ['volume'] },
      { say: 'What would make this a success for you in six months?', reply: 'Fewer tickets reaching my agents. Today we track first-response time and satisfaction scores.', note: 'You got the metric they already report, which becomes your baseline.', uncovers: ['baseline'] },
    ],
  },
  {
    customer: 'We tried a chatbot two years ago. It did not go well.',
    options: [
      { say: 'That was older technology. Things are completely different now.', reply: 'That is what the last vendor said too.', note: 'Dismissing their experience costs trust and skips the most useful story they have.', uncovers: [] },
      { say: 'What happened with it, and how did you find out?', reply: 'It gave customers wrong delivery dates. We heard about it from complaints and switched it off after a month.', note: 'Now you know the failure they fear most, and that nobody was measuring it.', uncovers: ['past'] },
      { say: 'Understood. Shall we talk about pricing?', reply: 'Let us not get ahead of ourselves.', note: 'Closing before you understand the problem.', uncovers: [] },
    ],
  },
  {
    customer: 'Our legal team will want to know where the data goes.',
    options: [
      { say: 'It is all secure, you do not need to worry about that.', reply: 'Legal will want more than that.', note: 'An assurance with nothing behind it. Ask what the rules are instead.', uncovers: [] },
      { say: 'What data would the agent see, and are there rules on where it can be stored or processed?', reply: 'Names, addresses, phone numbers. EU customer data has to stay in the EU, and every change to an order is logged for audit.', note: 'Two hard constraints that shape the architecture, found in one question.', uncovers: ['compliance'] },
      { say: 'We could keep customer data out of it entirely.', reply: 'Then it cannot answer where-is-my-parcel.', note: 'A solution before the requirement. It does not survive their main use case.', uncovers: [] },
    ],
  },
  {
    customer: 'So could it just change the delivery address when someone asks?',
    options: [
      { say: 'Yes, it can do anything your agents can do.', reply: 'That is what worries me.', note: 'Overpromising on the riskiest action in the conversation.', uncovers: [] },
      { say: 'It could. What checks does a human agent do before changing an address today?', reply: 'They verify the tracking number and postcode, and nobody can change it once the parcel is out for delivery.', note: 'You found the guard rails the tool would need.', uncovers: ['actions'] },
      { say: 'So reading status is low risk, but changing an address needs verification and a cut-off. Is that right?', reply: 'Yes. And anything involving a refund goes to a supervisor.', note: 'Reflecting back confirmed the rule and drew out a second one.', uncovers: ['actions'] },
    ],
  },
  {
    customer: 'Fine. What happens next?',
    options: [
      { say: 'I will write up a proposal for a full deployment.', reply: 'Send it over.', note: 'A large next step with no agreed measure of success.', uncovers: [] },
      { say: 'Who else needs to agree before we run a pilot, and what would they want to see?', reply: 'Our COO signs off on anything customer-facing. After last time she will want numbers on wrong answers.', note: 'You know the decision-maker and the evidence she needs.', uncovers: ['decision'] },
      { say: 'Could you share a few hundred past where-is-my-parcel tickets with their resolutions, so we can test a pilot against them?', reply: 'I will check with legal, but probably, if they are redacted.', note: 'A concrete, small ask that sets up an evaluation.', uncovers: ['evaldata'] },
    ],
  },
];
---
<div class="widget" data-discovery={JSON.stringify({ checklist, turns })}>
  <header><h4>{title}</h4><span class="tiny">{note}</span></header>
  <ol class="dsc-log" data-log aria-live="polite"></ol>
  <div data-turn>
    <p class="dsc-customer" data-customer tabindex="-1"></p>
    <div class="dsc-options" role="group" aria-label="Your reply" data-options></div>
  </div>
  <div data-end hidden>
    <p class="dsc-score" data-score tabindex="-1"></p>
    <ul class="dsc-check" data-check></ul>
    <p class="tiny">No path uncovers all seven items in five turns. A real discovery call runs longer; the drill is about which kind of reply earns information.</p>
  </div>
  <div class="row" style="margin-top: 10px">
    <button class="btn sm" type="button" data-restart>Start the conversation again</button>
  </div>
</div>

<style is:global>
  .widget .dsc-log { list-style: none; margin: 0 0 8px; padding: 0; }
  .widget .dsc-log li { margin: 0 0 10px; font-size: 14px; font-family: var(--font); }
  .dsc-log .who { display: block; font-size: 12.5px; font-weight: 650; color: var(--ink-3); }
  .dsc-log .coach { display: block; font-size: 13px; color: var(--ink-2); margin-top: 2px; }
  .dsc-customer { font-size: 15px; margin: 4px 0 10px; padding: 10px 12px; background: var(--bg-2); border-radius: 8px; }
  .dsc-options { display: flex; flex-direction: column; gap: 8px; }
  .dsc-options .btn { justify-content: flex-start; text-align: left; font-weight: 500; white-space: normal; height: auto; }
  .dsc-score { font-weight: 650; margin: 0 0 8px; }
  .dsc-check { margin: 0 0 8px; padding-left: 20px; }
  .widget .dsc-check li { font-size: 14px; margin-bottom: 4px; font-family: var(--font); }
  .dsc-check .st { font-weight: 650; }
  .dsc-check .got { color: var(--mint); }
  .dsc-check .miss { color: var(--rose); }
</style>

<script>
  type Option = { say: string; reply: string; note: string; uncovers: string[] };
  type Script = { checklist: { key: string; label: string }[]; turns: { customer: string; options: Option[] }[] };

  document.querySelectorAll<HTMLElement>('[data-discovery]').forEach((root) => {
    const script = JSON.parse(root.dataset.discovery ?? '{}') as Script;
    const log = root.querySelector<HTMLOListElement>('[data-log]')!;
    const turnBox = root.querySelector<HTMLElement>('[data-turn]')!;
    const customer = root.querySelector<HTMLElement>('[data-customer]')!;
    const options = root.querySelector<HTMLElement>('[data-options]')!;
    const end = root.querySelector<HTMLElement>('[data-end]')!;
    const score = root.querySelector<HTMLElement>('[data-score]')!;
    const check = root.querySelector<HTMLUListElement>('[data-check]')!;
    let turn = 0;
    let found = new Set<string>();

    const line = (who: string, text: string, coach?: string) => {
      const li = document.createElement('li');
      const w = document.createElement('span');
      w.className = 'who';
      w.textContent = who;
      li.append(w, document.createTextNode(text));
      if (coach) {
        const c = document.createElement('span');
        c.className = 'coach';
        c.textContent = `Coach: ${coach}`;
        li.append(c);
      }
      log.append(li);
    };

    const finish = () => {
      turnBox.hidden = true;
      end.hidden = false;
      check.replaceChildren();
      script.checklist.forEach((item) => {
        const li = document.createElement('li');
        const st = document.createElement('span');
        const got = found.has(item.key);
        st.className = `st ${got ? 'got' : 'miss'}`;
        st.textContent = got ? 'Uncovered: ' : 'Missed: ';
        li.append(st, document.createTextNode(item.label));
        check.append(li);
      });
      score.textContent = `You uncovered ${found.size} of ${script.checklist.length} things a strong discovery call finds out.`;
      score.focus();
    };

    const show = (focus: boolean) => {
      const t = script.turns[turn];
      if (!t) return finish();
      customer.textContent = `Customer: ${t.customer}`;
      options.replaceChildren();
      t.options.forEach((o) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'btn sm';
        b.textContent = o.say;
        b.addEventListener('click', () => {
          line('Customer', t.customer);
          line('You', o.say);
          line('Customer', o.reply, o.note);
          o.uncovers.forEach((k) => found.add(k));
          turn += 1;
          show(true);
        });
        options.append(b);
      });
      if (focus) customer.focus();
    };

    root.querySelector<HTMLButtonElement>('[data-restart]')!.addEventListener('click', () => {
      turn = 0;
      found = new Set();
      log.replaceChildren();
      end.hidden = true;
      turnBox.hidden = false;
      show(true);
    });

    show(false);
  });
</script>
