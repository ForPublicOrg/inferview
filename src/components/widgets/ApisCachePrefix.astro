---
// Prefix-cache order puzzle. Reorder prompt sections and see how many tokens fall inside the reusable prefix and
// what one request costs at Claude Opus 5.5 list prices. Teaching model of exact-prefix matching, not a provider's algorithm.
// Props: title, read (USD per million cached input tokens), base (USD per million uncached input tokens).
interface Props {
  title?: string;
  read?: number;
  base?: number;
}
const { title = 'Prefix cache: put the parts that change last', read = 0.2, base = 4 } = Astro.props;
---
<div class="widget cp" data-cacheprefix data-read={read} data-base={base}>
  <header><h4>{title}</h4><span class="tiny">section sizes are illustrative; prices are Opus 5.5 list prices</span></header>
  <p>The cache reuses the longest prefix that is identical to an earlier request. Everything after the first section that changed is billed at the full input price. Tool definitions always come first on the Claude API, so that row is fixed.</p>
  <ol class="cp-list" data-list></ol>
  <div class="meter">
    <div><b data-m-hit>0</b><span>tokens read from cache</span></div>
    <div><b data-m-miss>0</b><span>tokens at full price</span></div>
    <div><b data-m-req>0</b><span>input cost per request</span></div>
    <div><b data-m-k>0</b><span>input cost per 1,000 requests</span></div>
  </div>
  <p class="tiny" style="margin-top: 10px">Assumes steady traffic, so every request finds a warm cache, and ignores the one-off cache write. Prices: ${base.toFixed(2)} per million uncached input tokens, ${read.toFixed(2)} per million cache reads.</p>
  <button class="btn sm" type="button" data-reset>Restore the starting order</button>
  <p class="sr-only" aria-live="polite" data-summary></p>
</div>

<style>
  .cp-list { list-style: none; padding: 0; margin: 12px 0; display: flex; flex-direction: column; gap: 6px; }
  .cp-list li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; align-items: center; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); }
  .cp-list li.hit { border-color: color-mix(in srgb, var(--mint) 60%, var(--line)); }
  .cp-list li.miss { border-color: color-mix(in srgb, var(--rose) 45%, var(--line)); }
  .cp-list .nm { font-weight: 600; font-size: 14px; }
  .cp-list .sub { display: block; font-size: 12.5px; color: var(--ink-3); }
  .cp-list .cp-st { font-family: var(--mono); font-size: 12px; }
  .cp-list li.hit .cp-st { color: var(--mint); }
  .cp-list li.miss .cp-st { color: var(--rose); }
  .cp-list .mv { display: flex; gap: 6px; }
</style>

<script>
  type Change = 'never' | 'grows' | 'every';
  type Section = { id: string; name: string; tokens: number; change: Change; fixed?: boolean; fresh?: number };
  const START: Section[] = [
    { id: 'tools', name: 'Tool definitions', tokens: 1500, change: 'never', fixed: true },
    { id: 'ts', name: 'Line with the current time', tokens: 20, change: 'every' },
    { id: 'sys', name: 'System instructions', tokens: 3000, change: 'never' },
    { id: 'docs', name: 'Product documentation', tokens: 40000, change: 'never' },
    { id: 'rag', name: 'Passages retrieved for this question', tokens: 4000, change: 'every' },
    { id: 'hist', name: 'Conversation so far', tokens: 6000, change: 'grows', fresh: 1000 },
    { id: 'user', name: 'New user message', tokens: 150, change: 'every' },
  ];
  const CHANGE_TEXT: Record<Change, string> = {
    never: 'same on every request',
    grows: 'earlier turns repeat; the last 1,000 tokens are new',
    every: 'different on every request',
  };

  // Walk the sections in order: static ones extend the cached prefix; a growing one adds its old part, then stops it.
  function score(order: Section[]) {
    let hit = 0;
    let open = true;
    const states = order.map((s) => {
      if (!open) return 'miss';
      if (s.change === 'never') {
        hit += s.tokens;
        return 'hit';
      }
      open = false;
      if (s.change === 'grows') {
        hit += s.tokens - (s.fresh ?? 0);
        return 'part';
      }
      return 'miss';
    });
    const total = order.reduce((a, s) => a + s.tokens, 0);
    return { hit, miss: total - hit, states };
  }

  document.querySelectorAll<HTMLElement>('[data-cacheprefix]').forEach((root) => {
    const read = Number(root.dataset.read ?? 0.2);
    const base = Number(root.dataset.base ?? 4);
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    let order = START.map((s) => ({ ...s }));
    const fmt = (n: number) => n.toLocaleString('en-US');
    const set = (sel: string, v: string) => {
      const el = root.querySelector(sel);
      if (el) el.textContent = v;
    };

    function move(i: number, dir: -1 | 1) {
      const j = i + dir;
      if (j < 0 || j >= order.length || order[j]!.fixed || order[i]!.fixed) return;
      [order[i], order[j]] = [order[j]!, order[i]!];
      render(`${order[j]!.name} moved ${dir < 0 ? 'up' : 'down'}.`, order[j]!.id, dir);
    }

    function render(note = '', focusId = '', dir: -1 | 1 = 1) {
      const r = score(order);
      list.replaceChildren();
      order.forEach((s, i) => {
        const li = document.createElement('li');
        const state = r.states[i];
        li.className = state === 'miss' ? 'miss' : 'hit';
        const text = document.createElement('div');
        const nm = document.createElement('span');
        nm.className = 'nm';
        nm.textContent = `${s.name}, ${fmt(s.tokens)} tokens`;
        const sub = document.createElement('span');
        sub.className = 'sub';
        const st = document.createElement('span');
        st.className = 'cp-st';
        st.textContent = state === 'hit' ? 'cached' : state === 'part' ? `${fmt(s.tokens - (s.fresh ?? 0))} cached` : 'full price';
        sub.append(`${CHANGE_TEXT[s.change]}. `, st);
        text.append(nm, sub);
        const mv = document.createElement('div');
        mv.className = 'mv';
        if (!s.fixed) {
          (['up', 'down'] as const).forEach((d) => {
            const b = document.createElement('button');
            b.type = 'button';
            b.className = 'btn sm';
            b.textContent = d === 'up' ? 'Up' : 'Down';
            b.setAttribute('aria-label', `Move ${s.name} ${d}`);
            const blocked = d === 'up' ? i === 0 || Boolean(order[i - 1]?.fixed) : i === order.length - 1;
            b.disabled = blocked;
            b.dataset.focus = `${s.id}-${d}`;
            b.addEventListener('click', () => move(i, d === 'up' ? -1 : 1));
            mv.append(b);
          });
        } else {
          const t = document.createElement('span');
          t.className = 'tiny';
          t.textContent = 'fixed first';
          mv.append(t);
        }
        li.append(text, mv);
        list.append(li);
      });
      const perReq = (r.hit * read + r.miss * base) / 1e6;
      set('[data-m-hit]', fmt(r.hit));
      set('[data-m-miss]', fmt(r.miss));
      set('[data-m-req]', `$${perReq.toFixed(4)}`);
      set('[data-m-k]', `$${(perReq * 1000).toFixed(2)}`);
      set('[data-summary]', `${note} ${fmt(r.hit)} tokens cached, $${(perReq * 1000).toFixed(2)} per 1,000 requests.`.trim());
      if (focusId) {
        const want = list.querySelector<HTMLButtonElement>(`[data-focus="${focusId}-${dir < 0 ? 'up' : 'down'}"]`);
        const other = list.querySelector<HTMLButtonElement>(`[data-focus="${focusId}-${dir < 0 ? 'down' : 'up'}"]`);
        (want && !want.disabled ? want : other)?.focus();
      }
    }

    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      order = START.map((s) => ({ ...s }));
      render('Starting order restored.');
    });
    render();
  });
</script>
