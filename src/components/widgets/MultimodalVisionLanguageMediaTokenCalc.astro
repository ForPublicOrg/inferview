---
// Image tokens and input cost per model family for one image size. Props: title, id (unique on the page).
// Rules: Claude vision and vision-coordinates docs (28 px patches, tier limits, reference resize), OpenAI images and
// vision guide (32 px patches with budget and multiplier; 512 px tiles), Gemini token docs (258 tokens per 768 px tile).
// Prices: Claude vision docs (Opus 5.5 $4, Haiku 4.5 $1), OpenAI pricing (gpt-5.5 $5, gpt-4.1 $2), Gemini pricing
// (3.8 Flash $0.75 through 2026-12-31). All checked 2026-10-28.
interface Props {
  title?: string;
  id?: string;
}
const { title = 'Image token calculator', id = 'mtc' } = Astro.props;
const f = (k: string) => `${id}-${k}`;
---
<div class="widget mtc" data-mtc>
  <header><h4>{title}</h4><span class="tiny">published counting rules, input tokens only, checked 2026-10-28</span></header>
  <div class="mtc-grid">
    <label for={f('w')}>Width (px)
      <input type="number" id={f('w')} min="1" max="8000" step="1" value="1920" data-k="w" inputmode="numeric" />
    </label>
    <label for={f('h')}>Height (px)
      <input type="number" id={f('h')} min="1" max="8000" step="1" value="1080" data-k="h" inputmode="numeric" />
    </label>
    <label for={f('s')} class="mtc-wide">Downsample before sending to <b class="mono" data-sv>100%</b>
      <input type="range" id={f('s')} min="20" max="100" step="5" value="100" data-k="s" />
    </label>
  </div>
  <table class="mtc-table">
    <caption class="sr-only">Tokens and cost per model family</caption>
    <thead><tr><th scope="col">Model and setting</th><th scope="col">Sent as</th><th scope="col">Tokens</th><th scope="col">$ per 1,000</th></tr></thead>
    <tbody data-rows></tbody>
  </table>
  <p class="tiny" data-o="note"></p>
  <p class="sr-only" aria-live="polite" data-o="live"></p>
</div>

<style>
  .mtc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 14px; }
  .mtc-grid label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--ink-2); min-width: 0; }
  .mtc-grid .mtc-wide { grid-column: 1 / -1; }
  .mtc-grid input[type='number'] { font: inherit; font-size: 14px; padding: 8px 10px; min-height: 44px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); max-width: 100%; }
  .mtc-grid input[type='range'] { min-height: 44px; }
  .mtc-table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 13px; table-layout: fixed; }
  .mtc-table th, .mtc-table td { text-align: left; padding: 6px 4px; border-bottom: 1px solid var(--line); vertical-align: top; overflow-wrap: anywhere; }
  .mtc-table thead th:nth-child(1) { width: 40%; }
  .mtc-table td { font-variant-numeric: tabular-nums; }
  @media (max-width: 480px) { .mtc-table { font-size: 12px; } }
</style>

<script>
  const ceil = Math.ceil;
  // Python round(): half to even, as in the Claude reference implementation.
  const rte = (v: number) => {
    const fl = Math.floor(v);
    if (v - fl !== 0.5) return Math.round(v);
    return fl % 2 === 0 ? fl : fl + 1;
  };
  // Largest aspect-preserving size, searched along the long edge, for which ok(w, h) holds.
  const shrink = (w: number, h: number, ok: (a: number, b: number) => boolean): [number, number] => {
    if (ok(w, h)) return [w, h];
    if (h > w) {
      const [b, a] = shrink(h, w, (x, y) => ok(y, x));
      return [a, b];
    }
    const ar = w / h;
    let lo = 1;
    let hi = w;
    while (lo + 1 < hi) {
      const mid = Math.floor((lo + hi) / 2);
      if (ok(mid, Math.max(rte(mid / ar), 1))) lo = mid;
      else hi = mid;
    }
    return [lo, Math.max(rte(lo / ar), 1)];
  };
  const fitEdge = (w: number, h: number, edge: number): [number, number] => {
    const s = Math.min(1, edge / Math.max(w, h));
    return s === 1 ? [w, h] : [Math.max(1, Math.round(w * s)), Math.max(1, Math.round(h * s))];
  };

  type Out = { size: [number, number]; tokens: number; flag?: string };
  type Row = { name: string; price: number; calc: (w: number, h: number) => Out };

  const claude = (edge: number, cap: number) => (w: number, h: number): Out => {
    const t = (a: number, b: number) => ceil(a / 28) * ceil(b / 28);
    const size = shrink(w, h, (a, b) => ceil(a / 28) * 28 <= edge && ceil(b / 28) * 28 <= edge && t(a, b) <= cap);
    return { size, tokens: t(size[0], size[1]) };
  };
  const patches = (maxDim: number, budget: number, mult: number) => (w: number, h: number): Out => {
    const p = (a: number, b: number) => ceil(a / 32) * ceil(b / 32);
    const fitted = fitEdge(w, h, maxDim);
    const size = shrink(fitted[0], fitted[1], (a, b) => p(a, b) <= budget);
    return { size, tokens: ceil(p(size[0], size[1]) * mult) };
  };
  const tiles = (base: number, per: number) => (w: number, h: number): Out => {
    let [a, b] = fitEdge(w, h, 2048);
    const short = Math.min(a, b);
    if (short > 768) {
      const s = 768 / short;
      [a, b] = a <= b ? [768, Math.floor(b * s)] : [Math.floor(a * s), 768];
    }
    return { size: [a, b], tokens: base + ceil(a / 512) * ceil(b / 512) * per };
  };
  const gemini = (w: number, h: number): Out =>
    w <= 384 && h <= 384
      ? { size: [w, h], tokens: 258 }
      : { size: [w, h], tokens: ceil(w / 768) * ceil(h / 768) * 258, flag: 'upper bound' };

  const ROWS: Row[] = [
    { name: 'Claude Opus 5.5 (high-resolution tier)', price: 4, calc: claude(2576, 4784) },
    { name: 'Claude Haiku 4.5 (standard tier)', price: 1, calc: claude(1568, 1568) },
    { name: 'OpenAI gpt-5.5, detail high', price: 5, calc: patches(2048, 2500, 1.2) },
    { name: 'OpenAI gpt-5.5, detail original or auto', price: 5, calc: patches(6000, 10000, 1.2) },
    { name: 'OpenAI gpt-4.1, detail high (tiles)', price: 2, calc: tiles(85, 170) },
    { name: 'Gemini 3.8 Flash (768 px tiles)', price: 0.75, calc: gemini },
  ];

  document.querySelectorAll<HTMLElement>('[data-mtc]').forEach((root) => {
    const input = (k: string) => root.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const body = root.querySelector<HTMLElement>('[data-rows]')!;
    const clamp = (v: number) => Math.min(8000, Math.max(1, Math.round(Number.isFinite(v) ? v : 1)));
    const render = () => {
      const s = Number(input('s').value) / 100;
      const w = Math.max(1, Math.round(clamp(Number(input('w').value)) * s));
      const h = Math.max(1, Math.round(clamp(Number(input('h').value)) * s));
      root.querySelector('[data-sv]')!.textContent = `${Math.round(s * 100)}% (${w} × ${h})`;
      body.replaceChildren();
      const live: string[] = [];
      for (const r of ROWS) {
        const o = r.calc(w, h);
        const tr = document.createElement('tr');
        const cells = [
          r.name,
          `${o.size[0]} × ${o.size[1]}`,
          o.tokens.toLocaleString('en-US') + (o.flag ? ` (${o.flag})` : ''),
          `$${((o.tokens * r.price) / 1000).toFixed(2)}`,
        ];
        cells.forEach((c, i) => {
          const cell = document.createElement(i === 0 ? 'th' : 'td');
          if (i === 0) cell.setAttribute('scope', 'row');
          cell.textContent = c;
          tr.appendChild(cell);
        });
        body.appendChild(tr);
        live.push(`${r.name}: ${o.tokens} tokens`);
      }
      out('note').textContent =
        'Prices per million input tokens: Opus 5.5 $4, Haiku 4.5 $1, gpt-5.5 $5, gpt-4.1 $2, Gemini 3.8 Flash $0.75 (until 2026-12-31, then $1.50). ' +
        'Gemini documents 258 tokens per 768 px tile but not how a partial tile is counted, so its figure counts every partial tile whole. ' +
        'Text prompt and output tokens are not included.';
      out('live').textContent = live.join('; ');
    };
    root.querySelectorAll('[data-k]').forEach((el) => {
      el.addEventListener('input', render);
      el.addEventListener('change', render);
    });
    render();
  });
</script>
