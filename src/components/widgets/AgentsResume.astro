---
// Crash-and-resume simulator for a five-step agent run. The learner picks where the worker dies and whether step
// results are journaled and side effects carry idempotency keys, then reads the second attempt and the damage counters.
interface Props {
  title?: string;
}
const { title = 'Crash and resume: what runs twice?' } = Astro.props;
const STEPS = [
  { id: 'plan', label: 'plan the refund (model call)', kind: 'llm' },
  { id: 'fetch', label: 'read the invoice', kind: 'read' },
  { id: 'charge', label: 'refund the card', kind: 'charge' },
  { id: 'email', label: 'email the receipt', kind: 'email' },
  { id: 'reply', label: 'write the reply (model call)', kind: 'llm' },
];
const CRASHES = [
  { id: 'none', label: 'No crash' },
  { id: 'after-fetch', label: 'Worker dies after step 2 finishes' },
  { id: 'mid-charge', label: 'Worker dies inside step 3, after the refund, before its result is saved' },
  { id: 'after-email', label: 'Worker dies after step 4 finishes' },
];
const name = `crash-${title.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
---
<div class="widget" data-resume={JSON.stringify(STEPS)}>
  <header><h4>{title}</h4><span class="tiny">simulated; no model or payment runs here</span></header>
  <fieldset class="faults">
    <legend>Where does the worker die?</legend>
    {CRASHES.map((c, i) => (
      <label class:list={{ on: i === 2 }}>
        <input type="radio" name={name} value={c.id} checked={i === 2} />
        <span>{c.label}</span>
      </label>
    ))}
  </fieldset>
  <div class="row" style="margin-top: 12px">
    <label style="font-size: 14px; display: flex; gap: 8px; align-items: center; min-height: 44px"><input type="checkbox" data-journal checked /> journal each step result (checkpoint)</label>
    <label style="font-size: 14px; display: flex; gap: 8px; align-items: center; min-height: 44px"><input type="checkbox" data-idem /> idempotency key on refund and email</label>
  </div>
  <div class="split">
    <div><div class="striplabel">Attempt 1</div><div class="trace" data-a1></div></div>
    <div><div class="striplabel">Attempt 2, after restart</div><div class="trace" data-a2></div></div>
  </div>
  <div class="gauges">
    <div><b data-o="charges">0</b><span>refunds the customer received</span></div>
    <div><b data-o="emails">0</b><span>receipt emails sent</span></div>
    <div><b data-o="llm">0</b><span>model calls paid for</span></div>
    <div><b data-o="rerun">0</b><span>steps executed twice</span></div>
  </div>
  <p class="sr-only" aria-live="polite" data-o="summary"></p>
</div>

<script>
  type Step = { id: string; label: string; kind: 'llm' | 'read' | 'charge' | 'email' };
  type Row = { label: string; status: string; bad?: boolean };

  function simulate(steps: Step[], crash: string, journal: boolean, idem: boolean) {
    const saved = new Set<string>();
    const ran = new Map<string, number>();
    const keys = new Set<string>();
    const tally = { charges: 0, emails: 0, llm: 0 };
    const exec = (s: Step): string => {
      ran.set(s.id, (ran.get(s.id) ?? 0) + 1);
      if (s.kind === 'llm') tally.llm++;
      if (s.kind === 'charge' || s.kind === 'email') {
        if (idem && keys.has(s.id)) return 'executed; provider saw the same key and did nothing';
        keys.add(s.id);
        tally[s.kind === 'charge' ? 'charges' : 'emails']++;
      }
      return 'executed';
    };
    const attempt = (first: boolean): Row[] => {
      const rows: Row[] = [];
      for (const s of steps) {
        if (!first && journal && saved.has(s.id)) {
          rows.push({ label: s.label, status: 'result read from the journal' });
          continue;
        }
        const status = exec(s);
        const twice = (ran.get(s.id) ?? 0) > 1 && status === 'executed';
        const again = twice && (s.kind === 'charge' || s.kind === 'email');
        if (first && crash === 'mid-charge' && s.id === 'charge') {
          rows.push({ label: s.label, status: 'refund sent, then the worker died', bad: true });
          return rows;
        }
        if (journal) saved.add(s.id);
        rows.push({ label: s.label, status: twice ? 'executed again' : status, bad: again });
        if (first && ((crash === 'after-fetch' && s.id === 'fetch') || (crash === 'after-email' && s.id === 'email'))) {
          rows.push({ label: 'worker died', status: '', bad: true });
          return rows;
        }
      }
      return rows;
    };
    const a1 = attempt(true);
    const a2 = crash === 'none' ? [] : attempt(false);
    const rerun = [...ran.values()].filter((n) => n > 1).length;
    return { a1, a2, rerun, ...tally };
  }

  function rowEl(r: Row, i: number): HTMLElement {
    const el = document.createElement('div');
    el.className = 'step seen';
    const n = document.createElement('span');
    n.className = 'n';
    n.textContent = r.status ? String(i + 1) : '';
    const body = document.createElement('div');
    const b = document.createElement('span');
    b.className = 'role';
    b.textContent = r.label;
    const s = document.createElement('span');
    s.className = `body${r.bad ? ' warn' : ''}`;
    s.textContent = r.status;
    body.append(b, s);
    el.append(n, body);
    return el;
  }

  document.querySelectorAll<HTMLElement>('[data-resume]').forEach((root) => {
    const steps = JSON.parse(root.dataset.resume ?? '[]') as Step[];
    const journal = root.querySelector<HTMLInputElement>('[data-journal]')!;
    const idem = root.querySelector<HTMLInputElement>('[data-idem]')!;
    const radios = [...root.querySelectorAll<HTMLInputElement>('.faults input')];
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-o="${k}"]`)!;
    const render = () => {
      const crash = radios.find((r) => r.checked)?.value ?? 'none';
      radios.forEach((r) => r.closest('label')?.classList.toggle('on', r.checked));
      const r = simulate(steps, crash, journal.checked, idem.checked);
      root.querySelector('[data-a1]')!.replaceChildren(...r.a1.map(rowEl));
      const a2 = root.querySelector<HTMLElement>('[data-a2]')!;
      if (r.a2.length) a2.replaceChildren(...r.a2.map(rowEl));
      else a2.textContent = 'No restart needed.';
      out('charges').textContent = String(r.charges);
      out('charges').classList.toggle('bad', r.charges > 1);
      out('emails').textContent = String(r.emails);
      out('emails').classList.toggle('bad', r.emails > 1);
      out('llm').textContent = String(r.llm);
      out('rerun').textContent = String(r.rerun);
      out('summary').textContent = `${r.charges} refunds, ${r.emails} emails, ${r.llm} model calls, ${r.rerun} steps executed twice.`;
    };
    [journal, idem, ...radios].forEach((el) => el.addEventListener('change', render));
    render();
  });
</script>
