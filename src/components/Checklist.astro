---
// Self-check for critique and workflow problems. Props: id = progress key ("problem:<id>"), items = what a strong answer
// contains (4 to 12 plain strings; `backticks` render as code), title, doneAt (default 3).
// The reader ticks what they covered; the button rates the item from the tick ratio (all = 4, at least three quarters = 3,
// at least half = 2, less = 1) through the progress store, which schedules the review as SelfRate does.
import Inline from './Inline.astro';

interface Props {
  id: string;
  items: string[];
  title?: string;
  doneAt?: 1 | 2 | 3 | 4;
}
const { id, items, title = 'What a strong answer covers', doneAt = 3 } = Astro.props;
const total = items.length;
---
<div class="widget" data-checklist={id} data-done-at={doneAt} data-total={total}>
  <header><h4>{title}</h4><span class="tiny" data-count aria-live="polite">0 of {total} ticked</span></header>
  <fieldset class="faults checks">
    <legend>Tick each point your answer covered.</legend>
    {items.map((t, i) => (
      <label>
        <input type="checkbox" data-i={i} />
        <span><Inline text={t} /></span>
      </label>
    ))}
  </fieldset>
  <div class="row" style="margin-top: 12px">
    <button class="btn sm primary" type="button" data-record>Rate from my ticks</button>
    <span class="tiny" data-msg aria-live="polite">The rating sets when this problem comes back for review.</span>
  </div>
</div>

<script>
  import { rate, getItem, complete, onProgress } from '../lib/progress.ts';
  import { localDate, intervalFrom, RATING_LABELS, type Rating } from '../lib/schedule.ts';
  import { formatDate } from '../lib/daily.ts';

  /** All ticked = 4, at least three quarters = 3, at least half = 2, anything less = 1. */
  function ratingFor(ticked: number, total: number): Rating {
    if (total > 0 && ticked === total) return 4;
    const ratio = total ? ticked / total : 0;
    if (ratio >= 0.75) return 3;
    if (ratio >= 0.5) return 2;
    return 1;
  }

  document.querySelectorAll<HTMLElement>('[data-checklist]').forEach((root) => {
    const key = root.dataset.checklist ?? '';
    const total = Number(root.dataset.total ?? 0);
    const doneAt = Number(root.dataset.doneAt ?? 3);
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
    const count = root.querySelector<HTMLElement>('[data-count]');
    const msg = root.querySelector<HTMLElement>('[data-msg]');
    const btn = root.querySelector<HTMLButtonElement>('[data-record]');
    const ticked = () => boxes.filter((b) => b.checked).length;

    const update = () => {
      if (count) count.textContent = `${ticked()} of ${total} ticked`;
      boxes.forEach((b) => b.closest('label')?.classList.toggle('on', b.checked));
    };
    boxes.forEach((b) => b.addEventListener('change', update));

    let lastTicks: number | null = null;
    const showSaved = () => {
      const item = getItem(key);
      if (!msg || !item?.r || !item.due) return;
      const days = intervalFrom(localDate(), item.due);
      const when = days <= 0 ? 'Due for review today.' : `Next review in ${days} day${days === 1 ? '' : 's'}, on ${formatDate(item.due)}.`;
      const covered = lastTicks === null ? '' : `${lastTicks} of ${total} covered. `;
      msg.textContent = `${covered}Rated ${RATING_LABELS[item.r]}. ${when}`;
    };

    btn?.addEventListener('click', () => {
      lastTicks = ticked();
      const r = ratingFor(lastTicks, total);
      rate(key, r);
      if (r >= doneAt && getItem(key)?.s !== 'done') complete(key, false);
      showSaved();
    });

    update();
    onProgress(showSaved);
  });
</script>
