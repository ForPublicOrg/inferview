---
// Boxed aside inside a lesson or problem. Props: kind = interview | gotcha | aside; label overrides the default heading.
interface Props {
  kind?: 'interview' | 'gotcha' | 'aside';
  label?: string;
}
const DEFAULTS = { interview: 'In the interview', gotcha: 'Common trap', aside: 'Aside' } as const;
const { kind = 'aside', label } = Astro.props;
---
<div class:list={['callout', kind]}>
  <span class="kind">{label ?? DEFAULTS[kind]}</span>
  <slot />
</div>
