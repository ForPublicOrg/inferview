---
// Nav sign-in control: Google sign-in when Firebase is configured, otherwise a link explaining local-only storage.
import { firebaseConfigured } from '../lib/firebase.ts';
---
<span class="signin" data-signin>
  {firebaseConfigured ? (
    <>
      <button class="btn sm" type="button" data-signin-btn>Sign in</button>
      <a class="btn sm" href="/account" data-account-link hidden>Account</a>
    </>
  ) : (
    <a class="btn sm" href="/account" title="Progress is saved in this browser only">Sign-in not configured</a>
  )}
</span>

<script>
  import { onAuth, signIn } from '../lib/progress.ts';
  document.querySelectorAll<HTMLElement>('[data-signin]').forEach((wrap) => {
    const btn = wrap.querySelector<HTMLButtonElement>('[data-signin-btn]');
    const link = wrap.querySelector<HTMLAnchorElement>('[data-account-link]');
    if (!btn || !link) return;
    btn.addEventListener('click', () => void signIn());
    onAuth((a) => {
      const signedIn = a.status === 'signed-in';
      btn.hidden = signedIn;
      link.hidden = !signedIn;
      btn.disabled = a.status === 'loading';
      btn.textContent = a.status === 'loading' ? 'Signing in' : 'Sign in';
      btn.title = a.status === 'error' ? `Sign-in failed: ${a.message}` : 'Sign in with Google to sync progress';
    });
  });
</script>
