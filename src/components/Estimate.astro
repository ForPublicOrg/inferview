---
// Numeric self-check for estimate problems. Props: id (problem id), low, high, unit, gradable (default true).
// A value inside [low, high] records a gradable completion; any check unlocks the worked answer.
interface Props {
  id: string;
  low: number;
  high: number;
  unit: string;
  gradable?: boolean;
  label?: string;
}
const { id, low, high, unit, gradable = true, label = 'Your estimate' } = Astro.props;
const inputId = `estimate-${id}`;
---
<div class="widget" data-estimate={id} data-low={low} data-high={high} data-unit={unit} data-gradable={gradable ? '1' : '0'}>
  <header><h4>Check your estimate</h4><span class="tiny">work it out on paper first</span></header>
  <div class="row">
    <label for={inputId} style="font-size: 14px">{label} ({unit})</label>
    <input type="number" id={inputId} inputmode="decimal" step="any" style="width: 160px" />
    <button class="btn sm primary" type="button" data-check>Check</button>
  </div>
  <div class="verdict" data-verdict aria-live="polite"></div>
</div>

<script>
  import { complete, markSeen, getItem } from '../lib/progress.ts';

  document.querySelectorAll<HTMLElement>('[data-estimate]').forEach((root) => {
    const id = root.dataset.estimate ?? '';
    const key = `problem:${id}`;
    const low = Number(root.dataset.low);
    const high = Number(root.dataset.high);
    const unit = root.dataset.unit ?? '';
    const input = root.querySelector<HTMLInputElement>('input');
    const verdict = root.querySelector<HTMLElement>('[data-verdict]');
    const check = () => {
      if (!input || !verdict) return;
      const v = Number(input.value);
      if (input.value.trim() === '' || Number.isNaN(v)) {
        verdict.textContent = 'Enter a number first.';
        verdict.classList.add('show');
        return;
      }
      const inside = v >= low && v <= high;
      verdict.replaceChildren();
      const b = document.createElement('b');
      b.textContent = inside ? 'Inside the accepted band. ' : `Outside the accepted band, too ${v < low ? 'low' : 'high'}. `;
      if (inside) b.className = 'ok';
      verdict.append(b, `The band is ${low} to ${high} ${unit}. The worked answer is below.`);
      verdict.classList.add('show');
      if (inside && root.dataset.gradable === '1') complete(key, true);
      else if (!getItem(key)) markSeen(key);
      document.dispatchEvent(new CustomEvent('inferview:reveal', { detail: { id, solved: inside } }));
    };
    root.querySelector('[data-check]')?.addEventListener('click', check);
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') check();
    });
  });
</script>
