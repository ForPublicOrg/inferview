---
// Incident replay for replay problems. Props: id (problem id), events [{ event, choices? }] where an event with
// choices is a checkpoint (exactly one correct), title.
// Events appear one at a time; at a checkpoint the first pick is final and the next event stays hidden until the reader
// picks. Once every checkpoint is answered it shows picks correct over checkpoints, records a gradable completion and
// unlocks the answer. Event and choice text are plain strings; `backticks` render as code.
import Inline from './Inline.astro';

interface Choice {
  text: string;
  correct?: boolean;
  why: string;
}
interface ReplayEvent {
  event: string;
  choices?: Choice[];
}
interface Props {
  id: string;
  events: ReplayEvent[];
  title?: string;
}
const { id, events, title = 'Replay the incident' } = Astro.props;
const letters = 'ABCDE';
const checkpoints = events.filter((e) => e.choices?.length).length;
for (const [i, e] of events.entries()) {
  if (e.choices && e.choices.filter((c) => c.correct).length !== 1) throw new Error(`Replay ${id}: checkpoint at event ${i + 1} needs exactly one correct choice.`);
}
---
<div class="widget replay" data-replay={id} data-checkpoints={checkpoints} data-events={events.length}>
  <header>
    <h4>{title}</h4>
    <span class="tiny" data-replay-score aria-live="polite">0 of {checkpoints} checkpoints answered</span>
  </header>
  <p class="tiny" style="margin: 0 0 10px">Events appear in the order they happened. At each checkpoint, commit to a call before the next event shows; your first pick counts.</p>
  <ol class="replay-events" aria-live="polite">
    {events.map((e, i) => (
      <li data-event={i} hidden={i > 0}>
        <div class="label">Event {i + 1} of {events.length}{e.choices && ', checkpoint'}</div>
        <p><Inline text={e.event} /></p>
        {e.choices && (
          <div data-checkpoint={i}>
            <div class="choices" role="group" aria-label={`Checkpoint at event ${i + 1}`}>
              {e.choices.map((c, j) => (
                <button type="button" class="choice" data-i={j} data-ok={c.correct ? '1' : '0'}>
                  <span class="letter">{letters[j]}.</span><Inline text={c.text} />
                </button>
              ))}
            </div>
            <div class="verdict" data-verdict>
              {e.choices.map((c, j) => (
                <p data-why={j} hidden>
                  <b class={c.correct ? 'ok' : undefined}>{letters[j]}. {c.correct ? 'The call that held up.' : 'Not this one.'}</b> <Inline text={c.why} />
                </p>
              ))}
            </div>
          </div>
        )}
      </li>
    ))}
  </ol>
  <div class="row" style="margin-top: 12px">
    <button class="btn sm primary" type="button" data-next>Show the next event</button>
    <span class="tiny" data-replay-msg aria-live="polite"></span>
  </div>
</div>

<script>
  import { complete, markSeen, getItem } from '../lib/progress.ts';

  document.querySelectorAll<HTMLElement>('[data-replay]').forEach((root) => {
    const id = root.dataset.replay ?? '';
    const key = `problem:${id}`;
    const total = Number(root.dataset.checkpoints ?? 0);
    const items = [...root.querySelectorAll<HTMLElement>('[data-event]')];
    const nextBtn = root.querySelector<HTMLButtonElement>('[data-next]');
    const score = root.querySelector<HTMLElement>('[data-replay-score]');
    const msg = root.querySelector<HTMLElement>('[data-replay-msg]');
    if (!nextBtn || !items.length) return;
    let shown = 1;
    let answered = 0;
    let correct = 0;
    let finished = false;

    const pending = () => {
      const cp = items[shown - 1]?.querySelector<HTMLElement>('[data-checkpoint]');
      return Boolean(cp && !cp.dataset.picked);
    };
    const update = () => {
      if (score) score.textContent = `${answered} of ${total} checkpoints answered`;
      const last = shown >= items.length;
      nextBtn.hidden = last;
      nextBtn.disabled = pending();
      if (msg) msg.textContent = pending() ? 'Pick at this checkpoint to see what happened next.' : '';
      if (last && !pending() && answered === total && !finished) {
        finished = true;
        if (score) score.textContent = `${correct} of ${total} checkpoints correct`;
        if (msg) msg.textContent = `Replay finished: ${correct} of ${total} checkpoint picks matched the published postmortem.`;
        complete(key, true);
        document.dispatchEvent(new CustomEvent('inferview:reveal', { detail: { id, solved: true } }));
      }
    };

    root.querySelectorAll<HTMLElement>('[data-checkpoint]').forEach((cp) => {
      const buttons = [...cp.querySelectorAll<HTMLButtonElement>('button.choice')];
      const whys = [...cp.querySelectorAll<HTMLElement>('[data-why]')];
      const verdict = cp.querySelector<HTMLElement>('[data-verdict]');
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          if (cp.dataset.picked) return;
          cp.dataset.picked = b.dataset.i ?? '';
          const ok = b.dataset.ok === '1';
          answered++;
          if (ok) correct++;
          b.classList.add(ok ? 'right' : 'wrong');
          b.setAttribute('aria-pressed', 'true');
          const right = buttons.find((x) => x.dataset.ok === '1');
          right?.classList.add('right');
          buttons.forEach((x) => (x.disabled = true));
          whys.forEach((w) => (w.hidden = w.dataset.why !== b.dataset.i && w.dataset.why !== right?.dataset.i));
          verdict?.classList.add('show');
          if (!getItem(key)) markSeen(key);
          update();
        }),
      );
    });

    nextBtn.addEventListener('click', () => {
      if (pending() || shown >= items.length) return;
      items[shown]!.hidden = false;
      shown++;
      update();
      items[shown - 1]!.querySelector<HTMLElement>('button.choice')?.focus({ preventScroll: false });
    });

    update();
  });
</script>
