---
// Light and dark theme toggle (port of prototypes/inferview.js); the pick persists in localStorage.
---
<button class="theme" type="button" data-theme-toggle>Theme</button>

<script>
  const root = document.documentElement;
  const current = () => root.getAttribute('data-theme') ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const label = (btn: HTMLElement) => {
    const word = document.createElement('span');
    word.className = 'hide-narrow';
    word.textContent = ' theme';
    btn.replaceChildren(current() === 'dark' ? 'Light' : 'Dark', word);
    btn.setAttribute('aria-label', current() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
  };
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    label(btn);
    btn.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('inferview-theme', next);
      } catch {
        // Private browsing can refuse storage; the theme still applies to this page.
      }
      label(btn);
    });
  });
</script>
