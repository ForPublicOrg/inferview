---
// Three-depth answer: 30-second, 3-minute and follow-ups. Props: short, long (strings; blank lines split paragraphs),
// followups (string[]); or pass rich content with <Fragment slot="short">, slot="long", slot="followups".
interface Props {
  short?: string;
  long?: string;
  followups?: string[];
  open?: 'short' | 'long' | 'followups' | 'none';
}
const { short, long, followups = [], open = 'short' } = Astro.props;
const paras = (s?: string) => (s ? s.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean) : []);
const hasShort = Astro.slots.has('short') || Boolean(short);
const hasLong = Astro.slots.has('long') || Boolean(long);
const hasFollow = Astro.slots.has('followups') || followups.length > 0;
---
<div class="depthset">
  {hasShort && (
    <details class="depth" open={open === 'short'}>
      <summary>30-second answer <span class="t">the conclusion</span></summary>
      <div class="body">
        {Astro.slots.has('short') ? <slot name="short" /> : paras(short).map((p) => <p>{p}</p>)}
      </div>
    </details>
  )}
  {hasLong && (
    <details class="depth" open={open === 'long'}>
      <summary>3-minute answer <span class="t">with trade-offs</span></summary>
      <div class="body">
        {Astro.slots.has('long') ? <slot name="long" /> : paras(long).map((p) => <p>{p}</p>)}
      </div>
    </details>
  )}
  {hasFollow && (
    <details class="depth" open={open === 'followups'}>
      <summary>Follow-ups they ask <span class="t">verify, fail, alternative</span></summary>
      <div class="body">
        {Astro.slots.has('followups') ? <slot name="followups" /> : <ul>{followups.map((f) => <li>{f}</li>)}</ul>}
      </div>
    </details>
  )}
</div>
