---
// Python exercise run in the browser. Props: id (problem id), starter, tests (assert statements; each top-level
// statement is reported separately), hidden (extra tests run after the visible ones and never shown, reported as
// "hidden test n"), solution (optional, shown in a details element), gradable (default true), title.
// Repo problems also pass files (path to content) and target: every file is written into the worker filesystem before
// the run, the editor holds the target file, and the other files are shown read-only.
// When every test passes it records a gradable completion and unlocks the answer.
interface Props {
  id: string;
  starter: string;
  tests: string;
  hidden?: string;
  solution?: string;
  files?: Record<string, string>;
  target?: string;
  gradable?: boolean;
  title?: string;
}
const { id, starter, tests, hidden = '', solution, files, target, gradable = true, title = 'Your solution' } = Astro.props;
const editorId = `code-${id}`;
const isRepo = Boolean(files && target);
const others = isRepo ? Object.entries(files!).filter(([path]) => path !== target).sort(([a], [b]) => a.localeCompare(b)) : [];
const label = isRepo ? `${title}: ${target}` : title;
---
<div class="widget" data-coderunner={id} data-gradable={gradable ? '1' : '0'} data-target={isRepo ? target : undefined}>
  <header>
    <h4><label for={editorId}>{label}</label></h4>
    <span class="tiny">Python 3 in your browser, standard library only. Tab indents; press Esc first to tab out.</span>
  </header>
  {isRepo && (
    <details class="solution repo-files">
      <summary>The other {others.length === 1 ? 'file' : `${others.length} files`} in the repository (read-only)</summary>
      {others.map(([path, content]) => (
        <>
          <div class="label" style="margin-top: 10px">{path}</div>
          <pre><code>{content}</code></pre>
        </>
      ))}
    </details>
  )}
  <textarea class="editor" id={editorId} rows="14" spellcheck="false" autocapitalize="off" autocomplete="off" data-editor>{starter}</textarea>
  <template data-starter>{starter}</template>
  <template data-tests>{tests}</template>
  <template data-hidden data-pagefind-ignore>{hidden}</template>
  {isRepo && <template data-files data-pagefind-ignore>{JSON.stringify(files)}</template>}
  <div class="row" style="margin-top: 10px">
    <button class="btn sm primary" type="button" data-run>Run tests</button>
    <button class="btn sm" type="button" data-reset>Reset to starter</button>
    <span class="tiny" data-status aria-live="polite"></span>
  </div>
  {hidden.trim() && <p class="tiny" style="margin: 6px 0 0">Hidden tests run after the visible ones; they report only whether they pass.</p>}
  <div class="runout" data-out hidden>
    <div class="label" data-summary></div>
    <ul class="results" data-results></ul>
    <div data-stdout-wrap hidden><div class="label" style="margin-top: 10px">Output</div><pre data-stdout></pre></div>
  </div>
  {solution && (
    <details class="solution">
      <summary>Show reference solution{isRepo && ` for ${target}`}</summary>
      <pre><code>{solution}</code></pre>
    </details>
  )}
</div>

<script>
  import { complete, markSeen, getItem } from '../lib/progress.ts';
  import { runTests, bindEditor, renderRun } from '../lib/pyodide.ts';

  const text = (root: HTMLElement, sel: string) => root.querySelector<HTMLTemplateElement>(sel)?.content.textContent ?? '';

  document.querySelectorAll<HTMLElement>('[data-coderunner]').forEach((root) => {
    const id = root.dataset.coderunner ?? '';
    const key = `problem:${id}`;
    const editor = root.querySelector<HTMLTextAreaElement>('[data-editor]');
    const starter = text(root, '[data-starter]');
    const tests = text(root, '[data-tests]');
    const hidden = text(root, '[data-hidden]');
    const target = root.dataset.target;
    let files: Record<string, string> | null = null;
    if (target) {
      try {
        files = JSON.parse(text(root, '[data-files]')) as Record<string, string>;
      } catch {
        files = null;
      }
    }
    const status = root.querySelector<HTMLElement>('[data-status]');
    const runBtn = root.querySelector<HTMLButtonElement>('[data-run]');
    if (!editor || !runBtn) return;
    const setStatus = (s: string) => {
      if (status) status.textContent = s;
    };

    bindEditor(editor);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      editor.value = starter;
      editor.focus();
    });

    runBtn.addEventListener('click', async () => {
      runBtn.disabled = true;
      setStatus('Starting');
      try {
        // Repo problems run nothing directly: the tests import from the files, with the editor as the target file.
        const run =
          target && files
            ? await runTests('', tests, setStatus, { hidden, files: { ...files, [target]: editor.value } })
            : await runTests(editor.value, tests, setStatus, { hidden });
        const allPass = renderRun(root, run);
        setStatus(allPass ? 'All tests pass.' : '');
        if (allPass) {
          if (root.dataset.gradable === '1') complete(key, true);
          document.dispatchEvent(new CustomEvent('inferview:reveal', { detail: { id, solved: true } }));
        } else if (!getItem(key)) markSeen(key);
      } catch (e) {
        setStatus((e as Error).message);
      } finally {
        runBtn.disabled = false;
      }
    });
  });
</script>
