---
// Python exercise run in the browser. Props: id (problem id), starter, tests (assert statements; each top-level
// statement is reported separately), solution (optional, shown in a details element), gradable (default true), title.
// Pyodide loads from jsDelivr in a Web Worker on the first Run; when every assert passes it records a gradable completion and unlocks the answer.
interface Props {
  id: string;
  starter: string;
  tests: string;
  solution?: string;
  gradable?: boolean;
  title?: string;
}
const { id, starter, tests, solution, gradable = true, title = 'Your solution' } = Astro.props;
const editorId = `code-${id}`;
---
<div class="widget" data-coderunner={id} data-gradable={gradable ? '1' : '0'}>
  <header>
    <h4><label for={editorId}>{title}</label></h4>
    <span class="tiny">Python 3 in your browser, standard library only. Tab indents; press Esc first to tab out.</span>
  </header>
  <textarea class="editor" id={editorId} rows="14" spellcheck="false" autocapitalize="off" autocomplete="off" data-editor>{starter}</textarea>
  <template data-starter>{starter}</template>
  <template data-tests>{tests}</template>
  <div class="row" style="margin-top: 10px">
    <button class="btn sm primary" type="button" data-run>Run tests</button>
    <button class="btn sm" type="button" data-reset>Reset to starter</button>
    <span class="tiny" data-status aria-live="polite"></span>
  </div>
  <div class="runout" data-out hidden>
    <div class="label" data-summary></div>
    <ul class="results" data-results></ul>
    <div data-stdout-wrap hidden><div class="label" style="margin-top: 10px">Output</div><pre data-stdout></pre></div>
  </div>
  {solution && (
    <details class="solution">
      <summary>Show reference solution</summary>
      <pre><code>{solution}</code></pre>
    </details>
  )}
</div>

<script>
  import { complete, markSeen, getItem } from '../lib/progress.ts';

  type Result = { src: string; ok: boolean; msg?: string };
  type Reply =
    | { type: 'status'; text: string }
    | { type: 'result'; runId: number; stdout: string; error: string | null; results: Result[] };

  const TIMEOUT_MS = 30000;
  let worker: Worker | null = null;
  let runSeq = 0;
  // The worker is shared by every runner on the page; its error listener ends whichever run is active.
  let activeFinish: ((msg: string) => void) | null = null;

  function getWorker(): Worker {
    if (!worker) {
      worker = new Worker('/workers/pyodide-worker.js');
      worker.addEventListener('error', () => {
        activeFinish?.('Python could not start. Check your connection; it loads from cdn.jsdelivr.net.');
      });
    }
    return worker;
  }

  const text = (root: HTMLElement, sel: string) => root.querySelector<HTMLTemplateElement>(sel)?.content.textContent ?? '';

  document.querySelectorAll<HTMLElement>('[data-coderunner]').forEach((root) => {
    const id = root.dataset.coderunner ?? '';
    const key = `problem:${id}`;
    const editor = root.querySelector<HTMLTextAreaElement>('[data-editor]');
    const starter = text(root, '[data-starter]');
    const tests = text(root, '[data-tests]');
    const status = root.querySelector<HTMLElement>('[data-status]');
    const out = root.querySelector<HTMLElement>('[data-out]');
    const summary = root.querySelector<HTMLElement>('[data-summary]');
    const list = root.querySelector<HTMLElement>('[data-results]');
    const stdout = root.querySelector<HTMLElement>('[data-stdout]');
    const stdoutWrap = root.querySelector<HTMLElement>('[data-stdout-wrap]');
    const runBtn = root.querySelector<HTMLButtonElement>('[data-run]');
    if (!editor || !runBtn || !out || !summary || !list || !stdout || !stdoutWrap) return;
    const setStatus = (s: string) => {
      if (status) status.textContent = s;
    };

    // Tab inserts four spaces; Esc releases the next Tab so keyboard users can leave the editor.
    let released = false;
    editor.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        released = true;
        return;
      }
      if (e.key === 'Tab' && !released && !e.shiftKey) {
        e.preventDefault();
        const { selectionStart: s, selectionEnd: end, value } = editor;
        editor.value = value.slice(0, s) + '    ' + value.slice(end);
        editor.selectionStart = editor.selectionEnd = s + 4;
      }
      released = false;
    });

    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      editor.value = starter;
      editor.focus();
    });

    function render(results: Result[], error: string | null, printed: string) {
      out!.hidden = false;
      list!.replaceChildren();
      const passed = results.filter((r) => r.ok).length;
      const allPass = !error && results.length > 0 && passed === results.length;
      summary!.textContent = error ? 'Your code raised an error before the tests ran.' : `${passed} of ${results.length} tests pass`;
      setStatus(allPass ? 'All tests pass.' : '');
      for (const r of results) {
        const li = document.createElement('li');
        const mark = document.createElement('span');
        mark.className = r.ok ? 'pass' : 'fail';
        mark.textContent = r.ok ? 'pass ' : 'fail ';
        const code = document.createElement('code');
        code.textContent = r.src;
        li.append(mark, code);
        if (r.msg) li.append(` ${r.msg}`);
        list!.append(li);
      }
      const shown = [printed, error].filter(Boolean).join('\n');
      stdoutWrap!.hidden = !shown;
      stdout!.textContent = shown;
      if (allPass) {
        if (root.dataset.gradable === '1') complete(key, true);
        document.dispatchEvent(new CustomEvent('inferview:reveal', { detail: { id, solved: true } }));
      } else if (!getItem(key)) markSeen(key);
    }

    runBtn.addEventListener('click', () => {
      const runId = ++runSeq;
      const w = getWorker();
      runBtn.disabled = true;
      setStatus('Starting');
      const finish = (msg?: string) => {
        clearTimeout(timer);
        w.removeEventListener('message', onMsg);
        if (activeFinish === finish) activeFinish = null;
        runBtn.disabled = false;
        if (msg) setStatus(msg);
      };
      const onTimeout = () => {
        w.terminate();
        worker = null;
        finish(`Stopped after ${TIMEOUT_MS / 1000} seconds. Look for an infinite loop, or try again if Python was still loading.`);
      };
      // Re-armed when the tests start, so a slow first download of Python does not count against the code.
      let timer = setTimeout(onTimeout, TIMEOUT_MS);
      const onMsg = (e: MessageEvent<Reply>) => {
        const m = e.data;
        if (m.type === 'status') {
          if (m.text === 'Running tests') {
            clearTimeout(timer);
            timer = setTimeout(onTimeout, TIMEOUT_MS);
          }
          return setStatus(m.text);
        }
        if (m.runId !== runId) return;
        finish();
        render(m.results, m.error, m.stdout);
      };
      activeFinish = finish;
      w.addEventListener('message', onMsg);
      w.postMessage({ type: 'run', runId, code: editor.value, tests });
    });
  });
</script>
