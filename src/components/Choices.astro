---
// Pick-one question for mcq and debug problems. Props: id (problem id), choices [{ text, correct, why }] with exactly
// one correct, title, gradable (default true). A correct pick records a gradable completion and unlocks the answer.
// Choice text and why are plain strings; `backticks` render as code.
import Inline from './Inline.astro';

interface Choice {
  text: string;
  correct?: boolean;
  why: string;
}
interface Props {
  id: string;
  choices: Choice[];
  title?: string;
  gradable?: boolean;
}
const { id, choices, title = 'Pick one', gradable = true } = Astro.props;
const letters = 'ABCDE';
const correct = choices.filter((c) => c.correct).length;
if (correct !== 1) throw new Error(`Choices for ${id} need exactly one correct entry, found ${correct}.`);
---
<div class="widget" data-choices={id} data-gradable={gradable ? '1' : '0'}>
  <header><h4>{title}</h4><span class="tiny">a wrong pick explains why and lets you try again</span></header>
  <div class="choices" role="group" aria-label={title}>
    {choices.map((c, i) => (
      <button type="button" class="choice" data-i={i} data-ok={c.correct ? '1' : '0'}>
        <span class="letter">{letters[i]}.</span><Inline text={c.text} />
      </button>
    ))}
  </div>
  <div class="verdict" data-verdict aria-live="polite">
    {choices.map((c, i) => (
      <p data-why={i} hidden>
        <b class={c.correct ? 'ok' : undefined}>{c.correct ? 'Correct.' : 'Not this one.'}</b> <Inline text={c.why} />
      </p>
    ))}
  </div>
</div>

<script>
  import { complete, markSeen, getItem } from '../lib/progress.ts';

  document.querySelectorAll<HTMLElement>('[data-choices]').forEach((root) => {
    const id = root.dataset.choices ?? '';
    const key = `problem:${id}`;
    const gradable = root.dataset.gradable === '1';
    const verdict = root.querySelector<HTMLElement>('[data-verdict]');
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('button.choice')];
    const whys = [...root.querySelectorAll<HTMLElement>('[data-why]')];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const ok = b.dataset.ok === '1';
        buttons.forEach((x) => x.classList.remove('right', 'wrong'));
        b.classList.add(ok ? 'right' : 'wrong');
        whys.forEach((w) => (w.hidden = w.dataset.why !== b.dataset.i));
        verdict?.classList.add('show');
        if (ok) {
          if (gradable) complete(key, true);
          document.dispatchEvent(new CustomEvent('inferview:reveal', { detail: { id, solved: true } }));
        } else if (!getItem(key)) markSeen(key);
      }),
    );
  });
</script>
