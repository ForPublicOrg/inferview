---
// Embeds build-time data as an inert JSON script block that page scripts read with readJson(id).
interface Props {
  id: string;
  data: unknown;
}
const { id, data } = Astro.props;
// Writes the six characters \u003c so a string containing </script cannot close the block; JSON.parse restores it.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<script type="application/json" id={id} set:html={json} />
