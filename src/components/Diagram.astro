---
// System diagram for teardowns, drawn from data so no lesson hand-writes SVG. Usage in MDX:
//
//   import Diagram from '../../../../components/Diagram.astro';
//   <Diagram
//     title="Request path through the support agent"
//     nodes={[
//       { id: 'client', label: 'Chat client' },
//       { id: 'gateway', label: 'API gateway', note: 'auth, rate limits' },
//       { id: 'agent', label: 'Agent loop', note: 'step budget 20' },
//       { id: 'tools', label: 'Tool servers' },
//       { id: 'model', label: 'Model API' },
//     ]}
//     edges={[
//       { from: 'client', to: 'gateway', label: 'HTTPS' },
//       { from: 'gateway', to: 'agent' },
//       { from: 'agent', to: 'model', label: 'messages' },
//       { from: 'agent', to: 'tools', label: 'MCP' },
//     ]}
//     rows={[['client'], ['gateway'], ['agent'], ['model', 'tools']]}
//   />
//
// Props: title (the caption), nodes [{ id, label, note? }], edges [{ from, to, label? }], rows (node ids per row, top to
// bottom; every node appears in exactly one row). Lines are 1px in the site tokens and labels are IBM Plex Mono.
// Edge direction is marked with a small filled square at the target end instead of an arrowhead, because the design
// uses no arrows anywhere (DESIGN.md). The SVG scales with its viewBox down to 70% of its drawn width, then scrolls
// sideways inside the figure so labels stay legible on a phone; a screen-reader list repeats it as text.

export type DiagramNode = { id: string; label: string; note?: string };
export type DiagramEdge = { from: string; to: string; label?: string };

interface Props {
  title: string;
  nodes: DiagramNode[];
  edges: DiagramEdge[];
  rows: string[][];
}
const { title, nodes, edges, rows } = Astro.props;

const byId = new Map(nodes.map((n) => [n.id, n]));
const placed = rows.flat();
for (const id of placed) if (!byId.has(id)) throw new Error(`Diagram "${title}": row lists unknown node "${id}".`);
for (const n of nodes) if (placed.filter((id) => id === n.id).length !== 1) throw new Error(`Diagram "${title}": node "${n.id}" must appear in exactly one row.`);
for (const e of edges) if (!byId.has(e.from) || !byId.has(e.to)) throw new Error(`Diagram "${title}": edge ${e.from} to ${e.to} names an unknown node.`);

const PAD = 8;
const GAP_X = 24;
const MAX_BOX = 200;
const widest = Math.max(1, ...rows.map((r) => r.length));
const W = Math.max(320, widest * MAX_BOX + (widest - 1) * GAP_X + 2 * PAD);
const GAP_Y = 52;
const LABEL_FS = 14;
const NOTE_FS = 12;
const EDGE_FS = 11;
// Plex Mono advances 0.6 em per character, so text width can be estimated without measuring.
const CHAR = 0.6;
const SQUARE = 6;

function wrap(text: string, maxChars: number): string[] {
  const lines: string[] = [];
  let line = '';
  for (const word of text.split(/\s+/).filter(Boolean)) {
    if (!line) line = word;
    else if ((line + ' ' + word).length <= maxChars) line += ' ' + word;
    else {
      lines.push(line);
      line = word;
    }
  }
  if (line) lines.push(line);
  return lines;
}

type Box = { id: string; x: number; y: number; w: number; h: number; label: string[]; note: string[] };
const boxes = new Map<string, Box>();
let y = PAD;
for (const row of rows) {
  const n = row.length;
  const w = Math.min(MAX_BOX, (W - 2 * PAD - (n - 1) * GAP_X) / n);
  const laid = row.map((id) => {
    const node = byId.get(id)!;
    const label = wrap(node.label, Math.floor((w - 16) / (LABEL_FS * CHAR)));
    const note = node.note ? wrap(node.note, Math.floor((w - 16) / (NOTE_FS * CHAR))) : [];
    return { id, label, note };
  });
  const h = Math.max(...laid.map((b) => 14 + b.label.length * 18 + b.note.length * 16 + 4));
  const rowW = n * w + (n - 1) * GAP_X;
  const x0 = (W - rowW) / 2;
  laid.forEach((b, i) => boxes.set(b.id, { ...b, x: x0 + i * (w + GAP_X), y, w, h }));
  y += h + GAP_Y;
}
const H = y - GAP_Y + PAD;

const rowOf = new Map(rows.flatMap((r, i) => r.map((id) => [id, i] as const)));
const lines = edges.map((e) => {
  const a = boxes.get(e.from)!;
  const b = boxes.get(e.to)!;
  const ra = rowOf.get(e.from)!;
  const rb = rowOf.get(e.to)!;
  let x1: number, y1: number, x2: number, y2: number;
  if (rb > ra) [x1, y1, x2, y2] = [a.x + a.w / 2, a.y + a.h, b.x + b.w / 2, b.y];
  else if (rb < ra) [x1, y1, x2, y2] = [a.x + a.w / 2, a.y, b.x + b.w / 2, b.y + b.h];
  else if (b.x > a.x) [x1, y1, x2, y2] = [a.x + a.w, a.y + a.h / 2, b.x, b.y + b.h / 2];
  else [x1, y1, x2, y2] = [a.x, a.y + a.h / 2, b.x + b.w, b.y + b.h / 2];
  const labelW = e.label ? e.label.length * EDGE_FS * CHAR + 8 : 0;
  return { ...e, x1, y1, x2, y2, mx: (x1 + x2) / 2, my: (y1 + y2) / 2, labelW };
});
const label = (id: string) => byId.get(id)?.label ?? id;
---
<figure class="diagram">
  <div class="scroll" tabindex="0" role="region" aria-label={`${title}, diagram`}>
  <svg viewBox={`0 0 ${W} ${Math.ceil(H)}`} style={`min-width: ${Math.round(W * 0.7)}px`} xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    {lines.map((l) => (
      <g>
        <line class="edge" x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} vector-effect="non-scaling-stroke" />
        <rect class="end" x={l.x2 - SQUARE / 2} y={l.y2 - SQUARE / 2} width={SQUARE} height={SQUARE} />
      </g>
    ))}
    {[...boxes.values()].map((b) => (
      <g>
        <rect class="box" x={b.x} y={b.y} width={b.w} height={b.h} rx="6" vector-effect="non-scaling-stroke" />
        {b.label.map((t, i) => <text class="node" x={b.x + b.w / 2} y={b.y + 22 + i * 18} text-anchor="middle">{t}</text>)}
        {b.note.map((t, i) => <text class="note" x={b.x + b.w / 2} y={b.y + 22 + b.label.length * 18 + i * 16} text-anchor="middle">{t}</text>)}
      </g>
    ))}
    {lines.filter((l) => l.label).map((l) => (
      <g>
        <rect class="edge-bg" x={l.mx - l.labelW / 2} y={l.my - 9} width={l.labelW} height="16" rx="3" />
        <text class="edge-label" x={l.mx} y={l.my + 3} text-anchor="middle">{l.label}</text>
      </g>
    ))}
  </svg>
  </div>
  <figcaption>{title}</figcaption>
  <div class="sr-only">
    <p>Components:</p>
    <ul>{nodes.map((n) => <li>{n.label}{n.note && `: ${n.note}`}</li>)}</ul>
    <p>Connections:</p>
    <ul>{edges.map((e) => <li>{label(e.from)} to {label(e.to)}{e.label && `, ${e.label}`}</li>)}</ul>
  </div>
</figure>

<script>
  // Start a sideways-scrolling diagram at its centre, where the rows are centred.
  document.querySelectorAll<HTMLElement>('.diagram .scroll').forEach((el) => {
    el.scrollLeft = (el.scrollWidth - el.clientWidth) / 2;
  });
</script>
