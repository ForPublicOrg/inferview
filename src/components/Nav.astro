---
// Site navigation: section links, live streak and review status, theme toggle and sign-in.
import ThemeToggle from './ThemeToggle.astro';
import SignIn from './SignIn.astro';

interface Props {
  active?: 'learn' | 'problems' | 'daily' | 'review' | 'none';
}
const { active = 'none' } = Astro.props;
const links = [
  { key: 'learn', href: '/learn', label: 'Learn' },
  { key: 'problems', href: '/problems', label: 'Problems' },
  { key: 'daily', href: '/daily', label: 'Daily' },
  { key: 'review', href: '/review', label: 'Review' },
] as const;
---
<nav class="nav" aria-label="Main">
  <div class="wrap">
    <a class="logo" href="/"><span class="mark" aria-hidden="true">if</span>Inferview</a>
    <div class="links">
      {links.map((l) => (
        <a class:list={['link', { on: active === l.key }]} href={l.href} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>
    <div class="tools">
      <span class="status" data-nav-status></span>
      <ThemeToggle />
      <SignIn />
    </div>
  </div>
</nav>

<script>
  import { onProgress, currentStreak, dueKeys } from '../lib/progress.ts';
  const el = document.querySelector<HTMLElement>('[data-nav-status]');
  if (el) {
    onProgress((p) => {
      const streak = currentStreak(p);
      const due = dueKeys(p).length;
      el.textContent = `${streak}-day streak · ${due} ${due === 1 ? 'card' : 'cards'} due`;
    });
  }
</script>
