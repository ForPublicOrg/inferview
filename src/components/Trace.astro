---
// Annotated request lifecycle for teardowns: a numbered stepper in the style of AgentTrace, for any actors. Usage in MDX:
//
//   import Trace from '../../../../components/Trace.astro';
//   <Trace
//     title="One support request, start to finish"
//     steps={[
//       { actor: 'user', text: 'Asks why the March invoice is higher than February.' },
//       { actor: 'gateway', text: 'Checks the session and the per-tenant rate limit.', note: 'Rejected requests never reach the model.' },
//       { actor: 'agent', text: 'Sends the system prompt, tool list and question to the model.', tokens: 4200 },
//       { actor: 'tool', text: 'billing.get_invoice returns two invoices as JSON.', tokens: 900 },
//     ]}
//   />
//
// Props: title, steps [{ actor, text, tokens?, note? }], note (the line beside the title). Without JavaScript every step
// shows; with it, Step, Back and Show all walk through them, and later steps are dimmed until reached.

export type TraceStep = { actor: string; text: string; tokens?: number; note?: string };

interface Props {
  title: string;
  steps: TraceStep[];
  note?: string;
}
const { title, steps, note } = Astro.props;
const KNOWN = new Set(['user', 'assistant', 'tool', 'system']);
---
<div class="widget" data-gtrace data-total={steps.length}>
  <header><h4>{title}</h4>{note && <span class="tiny">{note}</span>}</header>
  <div class="ctrls">
    <button class="btn sm" type="button" data-back>Back</button>
    <button class="btn sm primary" type="button" data-fwd>Step</button>
    <button class="btn sm" type="button" data-all>Show all</button>
    <span class="tiny" data-pos aria-live="polite"></span>
  </div>
  <ol class="gtrace">
    {steps.map((s, i) => (
      <li class:list={['step', 'seen', { [s.actor]: KNOWN.has(s.actor) }]} data-i={i}>
        <span class="n">{i + 1}</span>
        <div>
          <span class="role">{s.actor}</span>
          <span class="body">{s.text}</span>
          {s.tokens !== undefined && <span class="tag" style="margin-left: 6px">{s.tokens.toLocaleString('en-GB')} tokens</span>}
          {s.note && <div class="tiny">{s.note}</div>}
        </div>
      </li>
    ))}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gtrace]').forEach((root) => {
    const total = Number(root.dataset.total ?? 0);
    const rows = [...root.querySelectorAll<HTMLElement>('li[data-i]')];
    const label = root.querySelector<HTMLElement>('[data-pos]');
    const back = root.querySelector<HTMLButtonElement>('[data-back]');
    const fwd = root.querySelector<HTMLButtonElement>('[data-fwd]');
    let pos = Math.min(1, total);
    const show = () => {
      rows.forEach((r, i) => {
        r.classList.toggle('seen', i < pos);
        r.classList.toggle('cur', i === pos - 1);
      });
      if (label) label.textContent = `Step ${pos} of ${total}`;
      if (back) back.disabled = pos <= 1;
      if (fwd) fwd.disabled = pos >= total;
    };
    back?.addEventListener('click', () => {
      pos = Math.max(1, pos - 1);
      show();
    });
    fwd?.addEventListener('click', () => {
      pos = Math.min(total, pos + 1);
      show();
    });
    root.querySelector('[data-all]')?.addEventListener('click', () => {
      pos = total;
      show();
    });
    show();
  });
</script>
