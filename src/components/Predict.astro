---
// Numeric predict-then-reveal. Props: id (unique on the page), question, answer (number), tolerance (absolute, default 0),
// unit. Optional slot "prompt" sits above the input; the default slot is the reveal text.
interface Props {
  id: string;
  question: string;
  answer: number;
  tolerance?: number;
  unit?: string;
  title?: string;
}
const { id, question, answer, tolerance = 0, unit = '', title = 'Guess before you look' } = Astro.props;
const inputId = `predict-${id}`;
---
<div class="widget predict" data-predict data-answer={answer} data-tolerance={tolerance} data-unit={unit}>
  <header><h4>{title}</h4><span class="tiny">no penalty for being wrong</span></header>
  <slot name="prompt" />
  <p><label for={inputId}>{question}</label></p>
  <div class="row">
    <input type="number" id={inputId} inputmode="decimal" placeholder={unit || 'your guess'} style="width: 140px" />
    <button class="btn sm primary" type="button" data-reveal>Reveal</button>
  </div>
  <div class="reveal" data-reveal-box aria-live="polite">
    <p data-verdict></p>
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-predict]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('input');
    const btn = root.querySelector<HTMLButtonElement>('[data-reveal]');
    const box = root.querySelector<HTMLElement>('[data-reveal-box]');
    const verdict = root.querySelector<HTMLElement>('[data-verdict]');
    if (!input || !btn || !box || !verdict) return;
    const answer = Number(root.dataset.answer);
    const tol = Number(root.dataset.tolerance ?? 0);
    const unit = root.dataset.unit ? ` ${root.dataset.unit}` : '';
    const reveal = () => {
      const raw = input.value.trim();
      const g = Number(raw);
      verdict.replaceChildren();
      const b = document.createElement('b');
      if (!raw || Number.isNaN(g)) b.textContent = 'No guess? Fine.';
      else if (Math.abs(g - answer) <= tol) {
        b.textContent = tol ? `You guessed ${g}${unit}. Within ${tol} of ${answer}.` : `You guessed ${g}${unit}. Exactly right.`;
        b.style.color = 'var(--mint)';
      } else b.textContent = `You guessed ${g}${unit}, too ${g > answer ? 'high' : 'low'}. The answer is ${answer}${unit}.`;
      verdict.append(b);
      box.classList.add('show');
    };
    btn.addEventListener('click', reveal);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') reveal();
    });
  });
</script>
