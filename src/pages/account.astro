---
// Account and data: export and import of progress JSON, deleting everything, and Google sign-in and sign-out when the
// build has Firebase settings. Without them there is no sign-in control; progress stays in this browser.
import Base from '../layouts/Base.astro';
import { firebaseConfigured } from '../lib/firebase.ts';
---
<Base title={firebaseConfigured ? 'Account and data' : 'Your data'} description="Export, import or delete your Inferview progress." active="none" noindex>
  <div class="wrap page narrow">
    <h1>{firebaseConfigured ? 'Account and data' : 'Your data'}</h1>
    {firebaseConfigured ? (
      <p class="muted">Progress is saved in this browser. Signing in with Google also keeps a copy in your own Firestore document so it follows you to other devices. <a href="/privacy">What is stored and where</a>.</p>
    ) : (
      <p class="muted">Progress is stored in this browser, and nowhere else. To move it to another browser or keep a copy, export it here and import the file there. <a href="/privacy">What is stored</a>.</p>
    )}

    {firebaseConfigured && (
      <section class="card" style="margin-top: 20px">
        <h2 style="font-size: 20px">Sign-in</h2>
        <p data-auth-text aria-live="polite">Checking whether you are signed in.</p>
        <div class="row">
          <button class="btn primary" type="button" data-signin hidden>Sign in with Google</button>
          <button class="btn" type="button" data-signout hidden>Sign out</button>
        </div>
      </section>
    )}

    <section class="card" style="margin-top: 16px">
      <h2 style="font-size: 20px">Your progress</h2>
      <dl class="kvlist">
        <dt>Items tracked</dt><dd data-stat-items>0</dd>
        <dt>Solved or rated done</dt><dd data-stat-done>0</dd>
        <dt>Current streak</dt><dd data-stat-streak>0 days</dd>
        <dt>Cards due</dt><dd data-stat-due>0</dd>
        <dt>Labs started</dt><dd data-stat-labs>0</dd>
      </dl>
    </section>

    <section class="card" style="margin-top: 16px">
      <h2 style="font-size: 20px">Export and import</h2>
      <p class="muted" style="font-size: 14.5px">Export downloads a JSON file with exactly what is stored. Import checks the file against the same format and merges it, keeping the newer entry for each item. Files over 1 MB are refused.</p>
      <div class="row">
        <button class="btn" type="button" data-export>Export progress</button>
        <input id="import-file" type="file" accept="application/json,.json" class="sr-only" data-import />
        <label class="btn" for="import-file">Import a file</label>
      </div>
      <p class="tiny" data-io-msg aria-live="polite" style="margin-top: 10px"></p>
    </section>

    <section class="card" style="margin-top: 16px; border-color: color-mix(in srgb, var(--rose) 45%, var(--line))">
      <h2 style="font-size: 20px">Delete all data</h2>
      {firebaseConfigured ? (
        <p class="muted" style="font-size: 14.5px">Removes your progress from this browser. If you are signed in, it also deletes your Firestore document and your sign-in record in Firebase Authentication; Google asks you to confirm your account first, and nothing is deleted if you close that window. This cannot be undone, so export first if you want a copy.</p>
      ) : (
        <p class="muted" style="font-size: 14.5px">Removes your progress, lab code and streak from this browser. This cannot be undone, so export first if you want a copy.</p>
      )}
      <div class="row">
        <button class="btn" type="button" data-delete>Delete all my data</button>
        <button class="btn primary" type="button" data-delete-confirm hidden>Yes, delete everything</button>
        <button class="btn" type="button" data-delete-cancel hidden>Cancel</button>
      </div>
      <p class="tiny" data-delete-msg aria-live="polite" style="margin-top: 10px"></p>
    </section>
  </div>
</Base>

<script>
  import { onAuth, onProgress, signIn, signOut, exportJSON, importJSON, deleteAll, currentStreak, dueKeys, getAuth } from '../lib/progress.ts';
  import { localDate } from '../lib/schedule.ts';

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s);
  const authText = $('[data-auth-text]');
  const signinBtn = $<HTMLButtonElement>('[data-signin]');
  const signoutBtn = $<HTMLButtonElement>('[data-signout]');

  onAuth((a) => {
    if (!authText || !signinBtn || !signoutBtn) return;
    signinBtn.hidden = a.status === 'signed-in' || a.status === 'unconfigured';
    signoutBtn.hidden = a.status !== 'signed-in';
    signinBtn.disabled = a.status === 'loading';
    if (a.status === 'signed-in') authText.textContent = `Signed in as ${a.user.email ?? a.user.name ?? 'a Google account'}. Progress syncs to your Firestore document.`;
    else if (a.status === 'loading') authText.textContent = 'Signing in.';
    else if (a.status === 'error') authText.textContent = `Sign-in failed: ${a.message}`;
    else authText.textContent = 'You are not signed in. Progress is saved in this browser only.';
  });
  signinBtn?.addEventListener('click', () => void signIn());
  signoutBtn?.addEventListener('click', () => void signOut());

  onProgress((p) => {
    const items = Object.values(p.items);
    $('[data-stat-items]')!.textContent = String(items.length);
    $('[data-stat-done]')!.textContent = String(items.filter((i) => i.s === 'done').length);
    const s = currentStreak(p);
    $('[data-stat-streak]')!.textContent = `${s} ${s === 1 ? 'day' : 'days'}`;
    $('[data-stat-due]')!.textContent = String(dueKeys(p).length);
    $('[data-stat-labs]')!.textContent = String(Object.keys(p.labs ?? {}).length);
  });

  const ioMsg = $('[data-io-msg]')!;
  $('[data-export]')?.addEventListener('click', () => {
    const blob = new Blob([exportJSON()], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `inferview-progress-${localDate()}.json`;
    document.body.append(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    ioMsg.textContent = 'Exported.';
  });

  const fileInput = $<HTMLInputElement>('[data-import]');
  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    try {
      if (file.size > 1_000_000) throw new Error('That file is larger than 1 MB, which is more than any real progress file.');
      const n = importJSON(await file.text());
      ioMsg.textContent = `Imported ${n} ${n === 1 ? 'item' : 'items'}, merged with what was here.`;
    } catch (e) {
      ioMsg.textContent = (e as Error).message;
    } finally {
      fileInput.value = '';
    }
  });

  const del = $<HTMLButtonElement>('[data-delete]')!;
  const confirmBtn = $<HTMLButtonElement>('[data-delete-confirm]')!;
  const cancel = $<HTMLButtonElement>('[data-delete-cancel]')!;
  const delMsg = $('[data-delete-msg]')!;
  const arm = (on: boolean) => {
    del.hidden = on;
    confirmBtn.hidden = !on;
    cancel.hidden = !on;
    if (on) confirmBtn.focus();
  };
  del.addEventListener('click', () => {
    delMsg.textContent = getAuth().status === 'signed-in' ? 'This deletes the Firestore document and the sign-in record too.' : 'This clears this browser.';
    arm(true);
  });
  cancel.addEventListener('click', () => {
    delMsg.textContent = '';
    arm(false);
  });
  confirmBtn.addEventListener('click', async () => {
    confirmBtn.disabled = true;
    try {
      await deleteAll();
      delMsg.textContent = 'Deleted.';
    } catch (e) {
      delMsg.textContent = `Could not finish: ${(e as Error).message}. Your progress in this browser is unchanged; try again.`;
    } finally {
      confirmBtn.disabled = false;
      arm(false);
    }
  });
</script>
