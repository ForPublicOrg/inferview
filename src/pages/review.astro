---
// Review deck: rated lessons and problems whose review date has arrived, then the ones due later this week.
import Base from '../layouts/Base.astro';
import JsonData from '../components/JsonData.astro';
import { itemIndex } from '../lib/content.ts';

const index = await itemIndex();
---
<Base title="Review" description="Cards due for review, from lessons and problems you rated." active="review">
  <div class="wrap page narrow">
    <h1>Review</h1>
    <p class="muted">Every lesson and problem you rate comes back here. Ratings set the gap: Blanked 1 day, Shaky 3, Solid 7, Could teach it 21. Repeating Solid or Could teach it doubles the previous gap, up to 120 days; any lower rating resets it.</p>

    <h2 style="margin-top: 28px">Due now <span class="tiny" data-due-count></span></h2>
    <ul class="itemlist" data-due></ul>
    <div data-pager hidden></div>
    <p class="muted" data-empty hidden>Nothing is due. Rate a lesson or a problem and it comes back here on schedule. The <a href="/daily">daily problem</a> is a good place to start.</p>

    <h2 style="margin-top: 28px">Due in the next 7 days</h2>
    <ul class="itemlist" data-upcoming></ul>
    <p class="muted" data-upcoming-empty hidden>Nothing scheduled this week.</p>
    <noscript><p class="muted">The review deck lives in your browser. Turn on JavaScript to see it.</p></noscript>
  </div>
  <JsonData id="item-index" data={index} />
</Base>

<script>
  import { onProgress, dueKeys, upcomingKeys, type Progress } from '../lib/progress.ts';
  import { RATING_LABELS, localDate, type Rating } from '../lib/schedule.ts';
  import { formatDate } from '../lib/daily.ts';
  import { readJson, h } from '../lib/dom.ts';
  import { createPager } from '../lib/pager.ts';

  type Entry = { title: string; url: string; kind: 'lesson' | 'problem'; track: string };
  const index = readJson<Record<string, Entry>>('item-index', {});
  const $ = (s: string) => document.querySelector<HTMLElement>(s);

  const row = (p: Progress, key: string) => {
    const e = index[key];
    const it = p.items[key];
    const last = it?.r ? `last rated ${RATING_LABELS[it.r as Rating]}` : '';
    const title = e ? h('a', { href: e.url }, e.title) : h('span', {}, `${key} (no longer in the bank)`);
    return h('li', {},
      h('div', {}, title, h('div', { class: 'tiny' }, [e?.kind ?? '', last].filter(Boolean).join(' · '))),
      h('div', { class: 'tags' }, h('span', { class: 'tag' }, it?.due ? `due ${formatDate(it.due)}` : '')),
    );
  };

  let current: Progress | null = null;
  const pager = createPager($('[data-pager]')!, 30, (page) => {
    if (current) renderDue(current, page);
    $('[data-due]')!.scrollIntoView({ block: 'start' });
  });
  function renderDue(p: Progress, page = pager.page) {
    const due = dueKeys(p, localDate());
    pager.set(due.length, page);
    $('[data-due]')!.replaceChildren(...pager.slice(due).map((k) => row(p, k)));
  }

  onProgress((p) => {
    current = p;
    const today = localDate();
    const due = dueKeys(p, today);
    const upcoming = upcomingKeys(p, today, 7);
    renderDue(p);
    $('[data-due-count]')!.textContent = due.length ? `(${due.length})` : '';
    $('[data-empty]')!.hidden = due.length > 0;
    $('[data-upcoming]')!.replaceChildren(...upcoming.map((k) => row(p, k)));
    $('[data-upcoming-empty]')!.hidden = upcoming.length > 0;
  });
</script>
