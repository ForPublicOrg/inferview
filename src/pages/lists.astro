---
// Named lists: Core 100, computed from `core: true`, and the crunch path, a fixed id list from src/data/lists.ts.
import Base from '../layouts/Base.astro';
import { CORE, CRUNCH } from '../data/lists.ts';
import { problems, problemUrl, problemKey, toRow, DIFF_LABEL, type ProblemRow } from '../lib/content.ts';

const rows = (await problems()).map(toRow);
const core = rows.filter((r) => r.core);
const byId = new Map(rows.map((r) => [r.id, r]));
const crunch = CRUNCH.ids.map((id) => byId.get(id)).filter((r): r is ProblemRow => Boolean(r));
const minutes = (rs: ProblemRow[]) => rs.reduce((n, r) => n + r.minutes, 0);
const lists = [
  { ...CORE, rows: core },
  { ...CRUNCH, rows: crunch },
];
---
<Base title="Lists" description="Core 100 and the crunch path." active="problems">
  <div class="wrap page narrow">
    <h1>Lists</h1>
    <p class="muted">Named lists give "done" a shape. Both are filtered views of the same problem bank.</p>

    {lists.map((l) => (
      <section style="margin-top: 32px" id={l.slug}>
        <h2>{l.title}</h2>
        <p class="muted">{l.description}</p>
        {'placeholder' in l && l.placeholder && (
          <p class="notice warn">Placeholder: this list was picked from the sample content and will change when authors choose the real crunch path.</p>
        )}
        <p class="tiny">{l.rows.length} {l.rows.length === 1 ? 'problem' : 'problems'}, about {minutes(l.rows)} minutes in total. <span data-list-done={l.slug}></span></p>
        {l.rows.length ? (
          <ol class="itemlist">
            {l.rows.map((r) => (
              <li>
                <div>
                  <a href={problemUrl(r.id)}><b>{r.title}</b></a>
                  <div class="tiny">{r.trackShort} · {r.minutes} min</div>
                </div>
                <div class="tags">
                  <span class="type">{r.type}</span>
                  <span class:list={['tag', r.difficulty]}>{DIFF_LABEL[r.difficulty]}</span>
                  <span class="tag" data-key={problemKey(r.id)} data-list={l.slug} hidden></span>
                </div>
              </li>
            ))}
          </ol>
        ) : (
          <p class="muted">No problems on this list yet.</p>
        )}
      </section>
    ))}
  </div>
</Base>

<script>
  import { onProgress } from '../lib/progress.ts';
  onProgress((p) => {
    const done: Record<string, number> = {};
    document.querySelectorAll<HTMLElement>('[data-key]').forEach((t) => {
      const it = p.items[t.dataset.key ?? ''];
      t.hidden = !it;
      t.textContent = it?.s === 'done' ? 'Solved' : 'Attempted';
      const list = t.dataset.list ?? '';
      done[list] = (done[list] ?? 0) + (it?.s === 'done' ? 1 : 0);
    });
    document.querySelectorAll<HTMLElement>('[data-list-done]').forEach((el) => {
      el.textContent = `${done[el.dataset.listDone ?? ''] ?? 0} solved.`;
    });
  });
</script>
