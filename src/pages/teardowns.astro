---
// Teardowns: every lesson of kind teardown across the tracks, in site order, with a level filter.
import Base from '../layouts/Base.astro';
import { TRACKS, getModule } from '../data/tracks.ts';
import { lessons, lessonUrl, lessonKey, moduleUrl, trackUrl, plural, LEVEL_LABEL } from '../lib/content.ts';
import { LEVELS } from '../lib/schemas.ts';

const all = (await lessons()).filter((l) => l.data.kind === 'teardown');
const groups = TRACKS.map((t) => ({ track: t, items: all.filter((l) => l.data.track === t.slug) })).filter((g) => g.items.length > 0);
const levels = LEVELS.map((v) => ({ v, label: LEVEL_LABEL[v] ?? v, n: all.filter((l) => l.data.level === v).length })).filter((l) => l.n > 0);
---
<Base title="Teardowns" description="How named AI systems work, reconstructed from public sources: a diagram, one request traced end to end, and what is not public." active="learn">
  <div class="wrap page narrow">
    <h1>Teardowns</h1>
    <p class="muted">A teardown takes one named system apart using public sources only: the components as a diagram, one request traced through them, the context strategy, the permission model, cost and latency, failure modes, and a plain list of what is not public. Each one sits in the module whose decisions it illustrates.</p>

    {all.length ? (
      <>
        <p class="tiny">{plural(all.length, 'teardown')} across {plural(groups.length, 'track')}. <span data-shown></span></p>
        {levels.length > 1 && (
          <div class="list-sel" role="group" aria-label="Level">
            {levels.map((l) => (
              <button type="button" class="chip" data-level-chip={l.v} aria-pressed="false">{l.label} <span class="c">{l.n}</span></button>
            ))}
          </div>
        )}
        {groups.map((g) => (
          <section style="margin-top: 28px" data-group>
            <h2 style="font-size: 21px"><a href={trackUrl(g.track.slug)} style="color: var(--ink)">{g.track.title}</a></h2>
            <ul class="itemlist">
              {g.items.map((l) => (
                <li data-level={l.data.level}>
                  <div>
                    <a href={lessonUrl(l)}><b>{l.data.title}</b></a>
                    <div class="tiny">{l.data.summary}</div>
                    <div class="tiny"><a href={moduleUrl(l.data.track, l.data.module)}>{getModule(l.data.track, l.data.module)?.title}</a></div>
                  </div>
                  <div class="tags">
                    <span class="tag">{LEVEL_LABEL[l.data.level]}</span>
                    <span class="tag">{l.data.minutes} min</span>
                    <span class="tag" data-key={lessonKey(l)} hidden></span>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </>
    ) : (
      <p class="notice" style="margin-top: 20px">No teardowns are published in this build.</p>
    )}
  </div>
</Base>

<script>
  import { onProgress } from '../lib/progress.ts';

  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-level-chip]')];
  const rows = [...document.querySelectorAll<HTMLElement>('li[data-level]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const shown = document.querySelector<HTMLElement>('[data-shown]');
  const picked = new Set<string>();

  function render() {
    let n = 0;
    for (const r of rows) {
      r.hidden = picked.size > 0 && !picked.has(r.dataset.level ?? '');
      if (!r.hidden) n++;
    }
    for (const g of groups) g.hidden = !g.querySelector('li[data-level]:not([hidden])');
    if (shown) shown.textContent = picked.size ? `Showing ${n}.` : '';
  }
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      const v = c.dataset.levelChip ?? '';
      if (picked.has(v)) picked.delete(v);
      else picked.add(v);
      c.setAttribute('aria-pressed', String(picked.has(v)));
      render();
    }),
  );

  const tags = [...document.querySelectorAll<HTMLElement>('[data-key]')];
  onProgress((p) => {
    for (const t of tags) {
      const it = p.items[t.dataset.key ?? ''];
      t.hidden = !it;
      t.textContent = it?.s === 'done' ? 'Rated' : 'Opened';
    }
  });
</script>
