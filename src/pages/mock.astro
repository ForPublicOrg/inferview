---
// Timed mock loop (SPEC section 11): pick a preset and a length; a seed in the URL picks the problems deterministically
// from the built index; one problem at a time with a countdown; a summary where the reader ticks what they solved.
import Base from '../layouts/Base.astro';
import JsonData from '../components/JsonData.astro';
import { LOOPS, LOOP_MINUTES, DEFAULT_MINUTES } from '../data/loops.ts';
import { getTrack } from '../data/tracks.ts';
import { problems, toRow } from '../lib/content.ts';

const rows = (await problems()).map(toRow).map((r) => ({
  id: r.id,
  title: r.subtitle ? `${r.title}: ${r.subtitle}` : r.title,
  track: r.track,
  trackShort: r.trackShort,
  type: r.type,
  typeLabel: r.typeLabel,
  difficulty: r.difficulty,
  minutes: r.minutes,
}));
const topTracks = (weights: Record<string, number>) =>
  Object.entries(weights)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 3)
    .map(([slug]) => getTrack(slug)?.short ?? slug)
    .join(', ');
---
<Base title="Mock loop" description="A timed mock interview loop built from the Inferview problem bank, shareable by link." active="mock">
  <div class="wrap page narrow">
    <h1>Mock loop</h1>
    <p class="muted">Pick a loop shape and a length. The problems are drawn from the bank with a seed, so the same link gives the same session to anyone, for as long as the bank is unchanged. Each problem gets a countdown from its estimated minutes. At the end you tick what you solved; there is no other scoring.</p>

    <form class="card" method="get" action="/mock" data-setup style="margin-top: 20px">
      <fieldset class="faults">
        <legend>Loop shape</legend>
        {LOOPS.map((l, i) => (
          <label class:list={{ on: i === 0 }}>
            <input type="radio" name="preset" value={l.slug} checked={i === 0} />
            <span>
              <b>{l.title}</b> <small>{l.summary} Weighted toward {topTracks(l.tracks)}.</small>
              <small>
                {l.source ? <>Based on <a href={l.source.url} rel="noopener">{l.source.title}</a>. </> : null}{l.note}
              </small>
            </span>
          </label>
        ))}
      </fieldset>
      <div class="row" style="margin-top: 14px; align-items: flex-end">
        <div>
          <label class="label" for="mock-minutes" style="display: block; margin-bottom: 4px">Length</label>
          <select id="mock-minutes" name="minutes" class="field">
            {LOOP_MINUTES.map((m) => <option value={m} selected={m === DEFAULT_MINUTES}>{m} minutes</option>)}
          </select>
        </div>
        <div style="flex: 1; min-width: 160px">
          <label class="label" for="mock-seed" style="display: block; margin-bottom: 4px">Seed (letters, digits and hyphens)</label>
          <input id="mock-seed" name="seed" class="field" style="width: 100%" type="text" maxlength="32" pattern="[A-Za-z0-9-]*" autocomplete="off" spellcheck="false" required data-seed />
        </div>
        <button class="btn primary" type="submit">Build the session</button>
      </div>
      <p class="tiny" style="margin: 10px 0 0">A new seed is filled in each time you open this page. Keep it to repeat a session, or change it for a different one.</p>
    </form>
    <noscript><p class="notice">The mock loop picks problems and runs the timer in your browser. Turn on JavaScript to use it.</p></noscript>

    <section data-plan hidden style="margin-top: 28px">
      <h2 data-plan-title>Your session</h2>
      <p class="muted" data-plan-meta></p>
      <ol class="itemlist" data-plan-list></ol>
      <p class="notice" data-plan-empty hidden>No problems in the bank fit this shape and length. Pick a longer session or another shape.</p>
      <div class="row" style="margin-top: 16px">
        <button class="btn primary" type="button" data-start>Start the timer</button>
        <button class="btn" type="button" data-copy>Copy the link to this session</button>
        <span class="tiny" data-copy-msg aria-live="polite"></span>
      </div>
      <label class="label" for="mock-link" style="display: block; margin: 12px 0 4px">Link to this session</label>
      <input id="mock-link" class="field" type="text" readonly data-link style="width: 100%" />
    </section>

    <section class="card" data-run hidden style="margin-top: 28px; border-color: var(--ink)">
      <div class="row" style="justify-content: space-between">
        <span class="label" data-run-pos></span>
        <span class="tiny" data-run-total></span>
      </div>
      <h2 style="font-size: 24px; margin: 8px 0" data-run-title></h2>
      <div class="row" style="gap: 6px" data-run-tags></div>
      <div class="timer" role="timer" aria-label="Time left on this problem" data-timer>0:00</div>
      <p class="tiny" data-timer-note aria-live="polite"></p>
      <div class="row">
        <a class="btn" href="/problems" target="_blank" rel="noopener" data-run-link>Open the problem in a new tab</a>
        <button class="btn primary" type="button" data-next>Next problem</button>
        <button class="btn" type="button" data-end>End the session</button>
      </div>
    </section>

    <section data-summary hidden style="margin-top: 28px">
      <h2>How it went</h2>
      <p class="muted">Tick each problem you solved. Saving marks ticked problems as solved and the rest as attempted in your progress. Problems you did not reach are left out. Ticks are your own judgement, so they do not count toward the streak.</p>
      <fieldset class="faults" data-summary-list>
        <legend>Solved</legend>
      </fieldset>
      <div class="row" style="margin-top: 14px">
        <button class="btn primary" type="button" data-save>Save to my progress</button>
        <a class="btn" href="/mock">Start a new session</a>
        <span class="tiny" data-save-msg aria-live="polite"></span>
      </div>
    </section>
  </div>
  <JsonData id="mock-pool" data={rows} />
</Base>

<script>
  import { complete, markSeen, getItem } from '../lib/progress.ts';
  import { LOOPS, LOOP_MINUTES, DEFAULT_MINUTES, getLoop, pickSession, cleanSeed } from '../data/loops.ts';
  import { readJson, h } from '../lib/dom.ts';

  type Row = { id: string; title: string; track: string; trackShort: string; type: string; typeLabel: string; difficulty: string; minutes: number };
  const pool = readJson<Row[]>('mock-pool', []);
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const DIFF: Record<string, string> = { easy: 'Easy', medium: 'Medium', hard: 'Hard' };

  const clock = (sec: number) => {
    const s = Math.abs(Math.round(sec));
    return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  };
  const newSeed = () => {
    const bytes = crypto.getRandomValues(new Uint8Array(4));
    return [...bytes].map((b) => b.toString(36).padStart(2, '0')).join('');
  };

  const form = $<HTMLFormElement>('[data-setup]');
  const seedInput = $<HTMLInputElement>('[data-seed]');
  const minutesSelect = $<HTMLSelectElement>('#mock-minutes');
  const radios = [...form.querySelectorAll<HTMLInputElement>('input[name=preset]')];
  const syncRadios = () => radios.forEach((r) => r.closest('label')?.classList.toggle('on', r.checked));
  radios.forEach((r) => r.addEventListener('change', syncRadios));

  const params = new URLSearchParams(location.search);
  const seed = cleanSeed(params.get('seed'));
  const preset = getLoop(params.get('preset'));
  const asked = Number(params.get('minutes'));
  const minutes = (LOOP_MINUTES as readonly number[]).includes(asked) ? asked : DEFAULT_MINUTES;

  seedInput.value = seed || newSeed();
  const radio = radios.find((r) => r.value === preset.slug);
  if (radio) radio.checked = true;
  minutesSelect.value = String(minutes);
  syncRadios();

  if (seed && LOOPS.some((l) => l.slug === params.get('preset'))) {
    const session = pickSession(pool, preset, minutes, seed);
    const total = session.reduce((n, p) => n + p.minutes, 0);
    const link = `${location.origin}/mock?preset=${preset.slug}&minutes=${minutes}&seed=${seed}`;
    $('[data-plan]').hidden = false;
    $('[data-plan-title]').textContent = `${preset.title}, ${minutes} minutes`;
    $('[data-plan-meta]').textContent = session.length
      ? `${session.length} ${session.length === 1 ? 'problem' : 'problems'}, ${total} minutes of countdown in total. Seed ${seed}.`
      : `Seed ${seed}.`;
    $('[data-plan-list]').replaceChildren(
      ...session.map((p, i) =>
        h('li', {},
          h('div', {}, h('span', { class: 'label' }, `Problem ${i + 1}`), h('div', {}, h('b', {}, p.title))),
          h('div', { class: 'tags' }, h('span', { class: 'type' }, p.typeLabel), h('span', { class: `tag ${p.difficulty}` }, DIFF[p.difficulty] ?? p.difficulty), h('span', { class: 'tag' }, `${p.minutes} min`)),
        ),
      ),
    );
    $('[data-plan-empty]').hidden = session.length > 0;
    $<HTMLButtonElement>('[data-start]').hidden = session.length === 0;
    const linkInput = $<HTMLInputElement>('[data-link]');
    linkInput.value = link;

    $('[data-copy]').addEventListener('click', async () => {
      const msg = $('[data-copy-msg]');
      try {
        await navigator.clipboard.writeText(link);
        msg.textContent = 'Copied.';
      } catch {
        linkInput.select();
        msg.textContent = 'Copy the selected link with your keyboard.';
      }
    });

    const spent: number[] = session.map(() => 0);
    let index = 0;
    let startedAt = 0;
    let tick: ReturnType<typeof setInterval> | null = null;
    const timer = $('[data-timer]');
    const note = $('[data-timer-note]');
    let warned = false;

    const render = () => {
      const p = session[index]!;
      const left = p.minutes * 60 - (Date.now() - startedAt) / 1000;
      timer.textContent = left >= 0 ? clock(left) : `${clock(left)} over`;
      timer.classList.toggle('over', left < 0);
      if (left < 0 && !warned) {
        warned = true;
        note.textContent = 'Time is up for this problem. Finish your sentence, then move on.';
      }
    };

    const show = (i: number) => {
      index = i;
      startedAt = Date.now();
      warned = false;
      note.textContent = '';
      const p = session[i]!;
      $('[data-run-pos]').textContent = `Problem ${i + 1} of ${session.length}`;
      $('[data-run-total]').textContent = `${p.minutes} minutes`;
      $('[data-run-title]').textContent = p.title;
      $('[data-run-tags]').replaceChildren(
        ...[p.trackShort, p.typeLabel].map((t) => h('span', { class: 'tag' }, t)),
        h('span', { class: `tag ${p.difficulty}` }, DIFF[p.difficulty] ?? p.difficulty),
      );
      $<HTMLAnchorElement>('[data-run-link]').href = `/problems/${p.id}`;
      $('[data-next]').textContent = i === session.length - 1 ? 'Finish' : 'Next problem';
      render();
    };

    const stopClock = () => {
      spent[index] = (spent[index] ?? 0) + (Date.now() - startedAt) / 1000;
    };

    const finish = () => {
      if (tick) clearInterval(tick);
      tick = null;
      stopClock();
      $('[data-run]').hidden = true;
      $('[data-summary]').hidden = false;
      const list = $('[data-summary-list]');
      list.replaceChildren(
        h('legend', {}, 'Solved'),
        ...session.slice(0, index + 1).map((p, i) => {
          const box = h('input', { type: 'checkbox', 'data-id': p.id });
          const label = h('label', {}, box, h('span', {}, p.title, ' ', h('small', {}, `${clock(spent[i] ?? 0)} used of ${p.minutes}:00`)));
          box.addEventListener('change', () => label.classList.toggle('on', box.checked));
          return label;
        }),
      );
      $('[data-summary]').scrollIntoView({ block: 'start' });
    };

    $('[data-start]').addEventListener('click', () => {
      form.hidden = true;
      $('[data-plan]').hidden = true;
      $('[data-run]').hidden = false;
      show(0);
      tick = setInterval(render, 250);
      $('[data-run]').scrollIntoView({ block: 'start' });
    });
    $('[data-next]').addEventListener('click', () => {
      if (index < session.length - 1) {
        stopClock();
        show(index + 1);
      } else finish();
    });
    $('[data-end]').addEventListener('click', finish);

    $('[data-save]').addEventListener('click', () => {
      let solved = 0;
      let tried = 0;
      $('[data-summary-list]').querySelectorAll<HTMLInputElement>('input[data-id]').forEach((box) => {
        const key = `problem:${box.dataset.id}`;
        if (box.checked) {
          complete(key, false);
          solved++;
        } else if (!getItem(key)) {
          markSeen(key);
          tried++;
        } else tried++;
      });
      $('[data-save-msg]').textContent = `Saved: ${solved} solved, ${tried} attempted.`;
      $<HTMLButtonElement>('[data-save]').disabled = true;
    });
  }
</script>
