---
// Track list: every track with its modules and lesson counts, labs, and a search over lessons and problems.
import Base from '../../layouts/Base.astro';
import { TRACKS, MODULE_COUNT } from '../../data/tracks.ts';
import { lessons, labs, moduleUrl, trackUrl, labUrl, plural } from '../../lib/content.ts';

const all = await lessons();
const labList = await labs();
const teardownCount = all.filter((l) => l.data.kind === 'teardown').length;
const count = (track: string, module: string) => all.filter((l) => l.data.track === track && l.data.module === module).length;
---
<Base title="Learn" description={`${TRACKS.length} tracks of AI engineering interview prep, in order.`} active="learn">
  <div class="wrap page">
    <h1>Learn</h1>
    <p class="muted" style="max-width: 680px">{TRACKS.length} tracks in one order, {MODULE_COUNT} modules, {plural(all.length, 'lesson')}{labList.length > 0 && `, ${plural(labList.length, 'lab')}`}{teardownCount > 0 && <>, <a href="/teardowns">{plural(teardownCount, 'teardown')}</a></>}. Each module page lists its lessons in order, its problems and its labs. Evals comes third on purpose: the other tracks depend on it.</p>

    <div class="card" style="margin: 20px 0 28px">
      <form class="search" role="search" data-search style="margin: 0">
        <label class="sr-only" for="site-search">Search lessons and problems</label>
        <input id="site-search" type="search" placeholder="Search lessons and problems" autocomplete="off" />
      </form>
      <p class="tiny" data-search-status style="margin: 6px 0 0" aria-live="polite"></p>
      <ul class="pf-results" data-search-results></ul>
    </div>

    <div class="stack">
      {TRACKS.map((t, i) => (
        <section class="card">
          <div class="row" style="justify-content: space-between; align-items: baseline">
            <h2 style="font-size: 21px; margin: 0"><a href={trackUrl(t.slug)} style="color: var(--ink)">Track {i + 1}. {t.title}</a></h2>
            <a class="tiny" href={`/problems?track=${t.slug}`}>Problems in this track</a>
          </div>
          <p class="muted" style="font-size: 14.5px; margin: 6px 0 10px">{t.blurb}</p>
          <ol class="modlist">
            {t.modules.map((m) => (
              <li>
                <a href={moduleUrl(t.slug, m.slug)}>{m.title}</a>
                <span class="tiny"> {plural(count(t.slug, m.slug), 'lesson')}</span>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>

    {labList.length > 0 && (
      <section style="margin-top: 32px">
        <h2>Labs</h2>
        <p class="muted">A lab grows one program over several steps, each with tests that run in your browser. <a href="/labs">All labs</a></p>
        <ul class="itemlist">
          {labList.map((lab) => (
            <li>
              <div><a href={labUrl(lab.id)}><b>{lab.data.title}</b></a><div class="tiny">{lab.data.summary}</div></div>
              <div class="tags"><span class="tag">{plural(lab.data.steps.length, lab.data.kind === 'multistage' ? 'stage' : 'step')}</span></div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<script>
  type PfResult = { data: () => Promise<{ url: string; meta: { title?: string }; excerpt: string }> };
  type Pagefind = { search: (q: string) => Promise<{ results: PfResult[] }> };

  const form = document.querySelector<HTMLFormElement>('[data-search]');
  const input = document.querySelector<HTMLInputElement>('#site-search');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const list = document.querySelector<HTMLElement>('[data-search-results]');
  let pf: Pagefind | null = null;
  let failed = false;
  let seq = 0;

  async function load(): Promise<Pagefind | null> {
    if (pf || failed) return pf;
    try {
      const url = '/pagefind/pagefind.js';
      pf = (await import(/* @vite-ignore */ url)) as Pagefind;
    } catch {
      failed = true;
      if (status) status.textContent = 'Search is built with the site; it is not available in the dev server.';
    }
    return pf;
  }

  // Pagefind excerpts mark matches with <mark>; they are rebuilt here as text so no markup from the index is injected.
  function excerptNodes(excerpt: string): Node[] {
    return excerpt.split(/(<mark>.*?<\/mark>)/g).map((part) => {
      const m = part.match(/^<mark>(.*)<\/mark>$/);
      const decode = (s: string) => new DOMParser().parseFromString('<body><span>' + s + '</span>', 'text/html').body.textContent ?? '';
      if (m) {
        const mark = document.createElement('mark');
        mark.textContent = decode(m[1] ?? '');
        return mark;
      }
      return document.createTextNode(decode(part));
    });
  }

  async function run() {
    if (!input || !list || !status) return;
    const q = input.value.trim();
    const mine = ++seq;
    if (!q) {
      list.replaceChildren();
      status.textContent = '';
      return;
    }
    const engine = await load();
    if (!engine || mine !== seq) return;
    const res = await engine.search(q);
    const top = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
    if (mine !== seq) return;
    status.textContent = res.results.length ? `${res.results.length} result${res.results.length === 1 ? '' : 's'}` : 'No matches.';
    list.replaceChildren(
      ...top.map((r) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = r.url;
        a.textContent = r.meta.title ?? r.url;
        const p = document.createElement('p');
        p.append(...excerptNodes(r.excerpt));
        li.append(a, p);
        return li;
      }),
    );
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    void run();
  });
  input?.addEventListener('input', () => void run());
</script>
