---
// Track list: the nine tracks with their modules, links to written lessons, and a search over lessons and problems.
import Base from '../../layouts/Base.astro';
import { TRACKS, MODULE_COUNT } from '../../data/tracks.ts';
import { lessons, lessonUrl } from '../../lib/content.ts';

const all = await lessons();
const byModule = new Map(all.map((l) => [`${l.data.track}/${l.data.module}`, l]));
---
<Base title="Learn" description="Nine tracks of AI engineering interview prep, in order." active="learn">
  <div class="wrap page">
    <h1>Learn</h1>
    <p class="muted" style="max-width: 680px">Nine tracks in one order, {MODULE_COUNT} modules, one lesson per module. Evals comes third on purpose: it builds on the API track and is the skill most loops reward. {all.length} of {MODULE_COUNT} lessons are written so far; the rest are listed so you can see the whole path.</p>

    <div class="card" style="margin: 20px 0 28px">
      <form class="search" role="search" data-search style="margin: 0">
        <label class="sr-only" for="site-search">Search lessons and problems</label>
        <input id="site-search" type="search" placeholder="Search lessons and problems" autocomplete="off" />
      </form>
      <p class="tiny" data-search-status style="margin: 6px 0 0" aria-live="polite"></p>
      <ul class="pf-results" data-search-results></ul>
    </div>

    <div class="stack">
      {TRACKS.map((t, i) => (
        <section class="card">
          <div class="row" style="justify-content: space-between; align-items: baseline">
            <h2 style="font-size: 21px; margin: 0"><a href={`/learn/${t.slug}`} style="color: var(--ink)">Track {i + 1}. {t.title}</a></h2>
            <a class="tiny" href={`/problems?track=${t.slug}`}>Problems in this track</a>
          </div>
          <p class="muted" style="font-size: 14.5px; margin: 6px 0 10px">{t.blurb}</p>
          <ol class="modlist">
            {t.modules.map((m) => {
              const l = byModule.get(`${t.slug}/${m.slug}`);
              return (
                <li>
                  {l ? <a href={lessonUrl(l)}>{l.data.title}</a> : <span>{m.title}</span>}
                  {l ? <span class="tiny"> {l.data.minutes} min</span> : <span class="tiny"> not written yet</span>}
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
  </div>
</Base>

<script>
  type PfResult = { data: () => Promise<{ url: string; meta: { title?: string }; excerpt: string }> };
  type Pagefind = { search: (q: string) => Promise<{ results: PfResult[] }> };

  const form = document.querySelector<HTMLFormElement>('[data-search]');
  const input = document.querySelector<HTMLInputElement>('#site-search');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const list = document.querySelector<HTMLElement>('[data-search-results]');
  let pf: Pagefind | null = null;
  let failed = false;
  let seq = 0;

  async function load(): Promise<Pagefind | null> {
    if (pf || failed) return pf;
    try {
      const url = '/pagefind/pagefind.js';
      pf = (await import(/* @vite-ignore */ url)) as Pagefind;
    } catch {
      failed = true;
      if (status) status.textContent = 'Search is built with the site; it is not available in the dev server.';
    }
    return pf;
  }

  // Pagefind excerpts mark matches with <mark>; they are rebuilt here as text so no markup from the index is injected.
  function excerptNodes(excerpt: string): Node[] {
    return excerpt.split(/(<mark>.*?<\/mark>)/g).map((part) => {
      const m = part.match(/^<mark>(.*)<\/mark>$/);
      const decode = (s: string) => new DOMParser().parseFromString('<body><span>' + s + '</span>', 'text/html').body.textContent ?? '';
      if (m) {
        const mark = document.createElement('mark');
        mark.textContent = decode(m[1] ?? '');
        return mark;
      }
      return document.createTextNode(decode(part));
    });
  }

  async function run() {
    if (!input || !list || !status) return;
    const q = input.value.trim();
    const mine = ++seq;
    if (!q) {
      list.replaceChildren();
      status.textContent = '';
      return;
    }
    const engine = await load();
    if (!engine || mine !== seq) return;
    const res = await engine.search(q);
    const top = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
    if (mine !== seq) return;
    status.textContent = res.results.length ? `${res.results.length} result${res.results.length === 1 ? '' : 's'}` : 'No matches.';
    list.replaceChildren(
      ...top.map((r) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = r.url;
        a.textContent = r.meta.title ?? r.url;
        const p = document.createElement('p');
        p.append(...excerptNodes(r.excerpt));
        li.append(a, p);
        return li;
      }),
    );
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    void run();
  });
  input?.addEventListener('input', () => void run());
</script>
