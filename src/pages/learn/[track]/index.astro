---
// One track: its modules in order, each with its lesson list, lesson count and the reader's progress.
import Base from '../../../layouts/Base.astro';
import JsonData from '../../../components/JsonData.astro';
import { TRACKS } from '../../../data/tracks.ts';
import { lessons, problems, labs, lessonUrl, lessonKey, problemKey, moduleUrl, trackUrl, labUrl, plural } from '../../../lib/content.ts';

export function getStaticPaths() {
  return TRACKS.map((t, i) => ({ params: { track: t.slug }, props: { track: t, index: i } }));
}

const { track, index } = Astro.props;
const trackLessons = (await lessons()).filter((l) => l.data.track === track.slug);
const trackProblems = (await problems()).filter((p) => p.data.track === track.slug);
const trackLabs = (await labs()).filter((l) => l.data.track === track.slug);
const modules = track.modules.map((m) => ({
  ...m,
  lessons: trackLessons.filter((l) => l.data.module === m.slug),
  problems: trackProblems.filter((p) => p.data.module === m.slug).length,
}));
const moduleKeys = Object.fromEntries(modules.map((m) => [m.slug, m.lessons.map((l) => lessonKey(l))]));
const allKeys = [...trackLessons.map((l) => lessonKey(l)), ...trackProblems.map((p) => problemKey(p.data.id))];
const next = TRACKS[index + 1];
const prev = TRACKS[index - 1];
---
<Base title={track.title} description={track.blurb} active="learn">
  <div class="wrap page narrow">
    <div class="crumb"><a href="/learn">Learn</a> / Track {index + 1}</div>
    <h1>{track.title}</h1>
    <p class="lede serif">{track.blurb}</p>
    <p class="tiny">{plural(track.modules.length, 'module')}, {plural(trackLessons.length, 'lesson')}, {plural(trackProblems.length, 'problem')}{trackLabs.length > 0 && `, ${plural(trackLabs.length, 'lab')}`}.</p>
    <div class="progress" style="margin: 16px 0 6px; max-width: 320px" aria-hidden="true"><i data-bar style="width: 0%"></i></div>
    <p class="tiny" data-progress-label></p>

    <h2 style="margin-top: 32px">Modules</h2>
    <ol class="itemlist modules">
      {modules.map((m, i) => (
        <li>
          <div>
            <div class="label">Module {i + 1}</div>
            <a href={moduleUrl(track.slug, m.slug)}><b>{m.title}</b></a>
            <div class="tiny">{plural(m.lessons.length, 'lesson')}, {plural(m.problems, 'problem')}<span data-module-done={m.slug}></span></div>
            {m.lessons.length > 0 && (
              <ol class="modlist" style="margin: 8px 0 0">
                {m.lessons.map((l) => (
                  <li><a href={lessonUrl(l)}>{l.data.title}</a> <span class="tiny">{l.data.minutes} min</span></li>
                ))}
              </ol>
            )}
          </div>
        </li>
      ))}
    </ol>

    {trackLabs.length > 0 && (
      <>
        <h2 style="margin-top: 32px">Labs</h2>
        <ul class="itemlist">
          {trackLabs.map((lab) => (
            <li>
              <div>
                <a href={labUrl(lab.id)}><b>{lab.data.title}</b></a>
                <div class="tiny">{lab.data.summary}</div>
              </div>
              <div class="tags"><span class="tag">{plural(lab.data.steps.length, lab.data.kind === 'multistage' ? 'stage' : 'step')}</span></div>
            </li>
          ))}
        </ul>
      </>
    )}

    <p style="margin-top: 24px"><a href={`/problems?track=${track.slug}`}>All {plural(trackProblems.length, 'problem')} in this track</a></p>

    <div class="row" style="justify-content: space-between; margin-top: 32px">
      {prev ? <a href={trackUrl(prev.slug)}>Track {index}: {prev.short}</a> : <span></span>}
      {next && <a href={trackUrl(next.slug)}>Track {index + 2}: {next.short}</a>}
    </div>
  </div>
  <JsonData id="track-progress" data={{ moduleKeys, allKeys }} />
</Base>

<script>
  import { onProgress } from '../../../lib/progress.ts';
  import { readJson } from '../../../lib/dom.ts';

  const data = readJson<{ moduleKeys: Record<string, string[]>; allKeys: string[] }>('track-progress', { moduleKeys: {}, allKeys: [] });
  const bar = document.querySelector<HTMLElement>('[data-bar]');
  const label = document.querySelector<HTMLElement>('[data-progress-label]');
  onProgress((p) => {
    const isDone = (k: string) => p.items[k]?.s === 'done';
    const done = data.allKeys.filter(isDone).length;
    const pct = data.allKeys.length ? Math.round((done / data.allKeys.length) * 100) : 0;
    if (bar) bar.style.width = `${pct}%`;
    if (label) label.textContent = `${done} of ${data.allKeys.length} lessons and problems done`;
    for (const [slug, keys] of Object.entries(data.moduleKeys)) {
      const el = document.querySelector<HTMLElement>(`[data-module-done="${slug}"]`);
      if (el) el.textContent = ` · ${keys.filter(isDone).length} of ${keys.length} rated`;
    }
  });
</script>
