---
// One track: its modules with lesson links, and the problems filed under it.
import Base from '../../../layouts/Base.astro';
import { TRACKS } from '../../../data/tracks.ts';
import { lessons, problems, lessonUrl, problemUrl, lessonKey, problemKey, DIFF_LABEL } from '../../../lib/content.ts';

export function getStaticPaths() {
  return TRACKS.map((t, i) => ({ params: { track: t.slug }, props: { track: t, index: i } }));
}

const { track, index } = Astro.props;
const trackLessons = (await lessons()).filter((l) => l.data.track === track.slug);
const trackProblems = (await problems()).filter((p) => p.data.track === track.slug);
const byModule = new Map(trackLessons.map((l) => [l.data.module, l]));
const next = TRACKS[index + 1];
const prev = TRACKS[index - 1];
---
<Base title={track.title} description={track.blurb} active="learn">
  <div class="wrap page narrow">
    <div class="crumb"><a href="/learn">Learn</a> / Track {index + 1}</div>
    <h1>{track.title}</h1>
    <p class="lede serif">{track.blurb}</p>
    <div class="progress" style="margin: 16px 0 6px; max-width: 320px" aria-hidden="true"><i data-bar style="width: 0%"></i></div>
    <p class="tiny" data-progress-label></p>

    <h2 style="margin-top: 32px">Modules</h2>
    <ol class="itemlist">
      {track.modules.map((m, i) => {
        const l = byModule.get(m.slug);
        return (
          <li>
            <div>
              <div class="label">Module {i + 1}</div>
              {l ? <a href={lessonUrl(l)}><b>{l.data.title}</b></a> : <b>{m.title}</b>}
              <div class="tiny">{l ? l.data.summary : 'Lesson not written yet.'}</div>
            </div>
            <div class="tags">
              {l && <span class="tag">{l.data.minutes} min</span>}
              {l && <span class="tag" data-key={lessonKey(l)}></span>}
            </div>
          </li>
        );
      })}
    </ol>

    <h2 style="margin-top: 32px">Problems</h2>
    {trackProblems.length ? (
      <ul class="itemlist">
        {trackProblems.map((p) => (
          <li>
            <div>
              <a href={problemUrl(p.data.id)}><b>{p.data.title}</b></a>
              <div class="tiny">{p.data.subtitle && `${p.data.subtitle} · `}{p.data.minutes} min · {p.data.seniority.join(', ')}</div>
            </div>
            <div class="tags">
              <span class="type">{p.data.type}</span>
              <span class:list={['tag', p.data.difficulty]}>{DIFF_LABEL[p.data.difficulty]}</span>
              <span class="tag" data-key={problemKey(p.data.id)}></span>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">No problems written for this track yet.</p>
    )}

    <div class="row" style="justify-content: space-between; margin-top: 32px">
      {prev ? <a href={`/learn/${prev.slug}`}>Track {index}: {prev.short}</a> : <span></span>}
      {next && <a href={`/learn/${next.slug}`}>Track {index + 2}: {next.short}</a>}
    </div>
  </div>
</Base>

<script>
  import { onProgress } from '../../../lib/progress.ts';
  const tags = [...document.querySelectorAll<HTMLElement>('[data-key]')];
  const bar = document.querySelector<HTMLElement>('[data-bar]');
  const label = document.querySelector<HTMLElement>('[data-progress-label]');
  onProgress((p) => {
    let done = 0;
    for (const t of tags) {
      const it = p.items[t.dataset.key ?? ''];
      if (it?.s === 'done') done++;
      t.hidden = !it;
      t.textContent = it?.s === 'done' ? 'Done' : 'Started';
    }
    const pct = tags.length ? Math.round((done / tags.length) * 100) : 0;
    if (bar) bar.style.width = `${pct}%`;
    if (label) label.textContent = tags.length ? `${done} of ${tags.length} written lessons and problems done` : 'Nothing written for this track yet.';
  });
</script>
