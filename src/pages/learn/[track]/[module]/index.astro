---
// One module: its lessons in order, the problems filed under it, and its labs.
import Base from '../../../../layouts/Base.astro';
import { TRACKS } from '../../../../data/tracks.ts';
import {
  moduleLessons, problems, labs, lessonUrl, lessonKey, problemUrl, problemKey, labUrl, trackUrl, moduleUrl,
  DIFF_LABEL, KIND_LABEL, LEVEL_LABEL, plural,
} from '../../../../lib/content.ts';
import { typeLabel } from '../../../../lib/schemas.ts';

export function getStaticPaths() {
  return TRACKS.flatMap((t, ti) => t.modules.map((m, mi) => ({ params: { track: t.slug, module: m.slug }, props: { track: t, ti, mi } })));
}

const { track, ti, mi } = Astro.props;
const mod = track.modules[mi]!;
const lessonList = await moduleLessons(track.slug, mod.slug);
const problemList = (await problems()).filter((p) => p.data.track === track.slug && p.data.module === mod.slug);
const labList = (await labs()).filter((l) => l.data.track === track.slug && l.data.module === mod.slug);
const minutes = lessonList.reduce((n, l) => n + l.data.minutes, 0);
const prev = track.modules[mi - 1];
const next = track.modules[mi + 1];
---
<Base title={mod.title} description={`Module ${mi + 1} of ${track.title}: lessons, problems and labs.`} active="learn">
  <div class="wrap page narrow">
    <div class="crumb"><a href="/learn">Learn</a> / <a href={trackUrl(track.slug)}>Track {ti + 1}, {track.short}</a> / Module {mi + 1}</div>
    <h1>{mod.title}</h1>
    <p class="muted">{plural(lessonList.length, 'lesson')}, about {minutes} minutes of reading. {plural(problemList.length, 'problem')}{labList.length > 0 && `, ${plural(labList.length, 'lab')}`}.</p>
    <div class="progress" style="margin: 16px 0 6px; max-width: 320px" aria-hidden="true"><i data-bar style="width: 0%"></i></div>
    <p class="tiny" data-progress-label></p>

    <h2 style="margin-top: 32px">Lessons</h2>
    {lessonList.length ? (
      <ol class="itemlist">
        {lessonList.map((l, i) => (
          <li>
            <div>
              <div class="label">Lesson {i + 1}{l.data.kind !== 'lesson' && `, ${KIND_LABEL[l.data.kind]}`}</div>
              <a href={lessonUrl(l)}><b>{l.data.title}</b></a>
              <div class="tiny">{l.data.summary}</div>
            </div>
            <div class="tags">
              <span class="tag">{LEVEL_LABEL[l.data.level]}</span>
              <span class="tag">{l.data.minutes} min</span>
              <span class="tag" data-key={lessonKey(l)} data-kind="lesson" hidden></span>
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="muted">This module has no lessons. Its problems are listed below.</p>
    )}

    {labList.length > 0 && (
      <>
        <h2 style="margin-top: 32px">Labs</h2>
        <ul class="itemlist">
          {labList.map((lab) => (
            <li>
              <div>
                <a href={labUrl(lab.id)}><b>{lab.data.title}</b></a>
                <div class="tiny">{lab.data.summary}</div>
              </div>
              <div class="tags">
                <span class="tag">{plural(lab.data.steps.length, lab.data.kind === 'multistage' ? 'stage' : 'step')}</span>
                <span class="tag">{lab.data.minutes} min</span>
              </div>
            </li>
          ))}
        </ul>
      </>
    )}

    <h2 style="margin-top: 32px">Problems</h2>
    {problemList.length ? (
      <ul class="itemlist">
        {problemList.map((p) => (
          <li>
            <div>
              <a href={problemUrl(p.data.id)}><b>{p.data.title}</b></a>
              <div class="tiny">{p.data.subtitle && `${p.data.subtitle} · `}{p.data.minutes} min · {p.data.seniority.join(', ')}</div>
            </div>
            <div class="tags">
              <span class="type">{typeLabel(p.data.type)}</span>
              <span class:list={['tag', p.data.difficulty]}>{DIFF_LABEL[p.data.difficulty]}</span>
              <span class="tag" data-key={problemKey(p.data.id)} data-kind="problem" hidden></span>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">No problems are filed under this module. <a href={`/problems?track=${track.slug}`}>Problems in this track</a></p>
    )}

    <div class="row" style="justify-content: space-between; margin-top: 32px">
      {prev ? <a href={moduleUrl(track.slug, prev.slug)}>Module {mi}: {prev.title}</a> : <a href={trackUrl(track.slug)}>Track {ti + 1}: {track.short}</a>}
      {next && <a href={moduleUrl(track.slug, next.slug)}>Module {mi + 2}: {next.title}</a>}
    </div>
  </div>
</Base>

<script>
  import { onProgress } from '../../../../lib/progress.ts';
  const tags = [...document.querySelectorAll<HTMLElement>('[data-key]')];
  const bar = document.querySelector<HTMLElement>('[data-bar]');
  const label = document.querySelector<HTMLElement>('[data-progress-label]');
  onProgress((p) => {
    let done = 0;
    for (const t of tags) {
      const it = p.items[t.dataset.key ?? ''];
      if (it?.s === 'done') done++;
      t.hidden = !it;
      const lesson = t.dataset.kind === 'lesson';
      t.textContent = it?.s === 'done' ? (lesson ? 'Rated' : 'Solved') : lesson ? 'Opened' : 'Attempted';
    }
    const pct = tags.length ? Math.round((done / tags.length) * 100) : 0;
    if (bar) bar.style.width = `${pct}%`;
    if (label) label.textContent = `${done} of ${tags.length} lessons and problems done`;
  });
</script>
