---
// One lesson: /learn/<track>/<module>/<lesson-slug>.
import { render } from 'astro:content';
import LessonLayout from '../../../../layouts/Lesson.astro';
import { lessons, lessonSlug } from '../../../../lib/content.ts';

export async function getStaticPaths() {
  const all = await lessons();
  return all.map((entry) => ({ params: { track: entry.data.track, module: entry.data.module, lesson: lessonSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<LessonLayout entry={entry} headings={headings}>
  <Content />
</LessonLayout>
