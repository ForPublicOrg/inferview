---
// One lesson per module: /learn/<track>/<module>.
import { render } from 'astro:content';
import LessonLayout from '../../../layouts/Lesson.astro';
import { lessons } from '../../../lib/content.ts';

export async function getStaticPaths() {
  const all = await lessons();
  return all.map((entry) => ({ params: { track: entry.data.track, lesson: entry.data.module }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<LessonLayout entry={entry} headings={headings}>
  <Content />
</LessonLayout>
