---
// Daily problem: today's pick from the graded problems, computed from the visitor's local date, plus the last 30 days.
import Base from '../layouts/Base.astro';
import JsonData from '../components/JsonData.astro';
import { problems, problemUrl, toRow, DIFF_LABEL } from '../lib/content.ts';
import { DAILY_TYPES, typeLabel } from '../lib/schemas.ts';
import { dailyFor } from '../lib/daily.ts';
import { localDate } from '../lib/schedule.ts';

const pool = (await problems()).map(toRow).filter((r) => r.daily);
const dailyTypes = DAILY_TYPES.map((t) => typeLabel(t).toLowerCase());
const typeList = `${dailyTypes.slice(0, -1).join(', ')} or ${dailyTypes[dailyTypes.length - 1]}`;
const today = dailyFor(localDate(), pool);
const entries = pool.map((r) => ({ id: r.id, title: r.subtitle ? `${r.title}: ${r.subtitle}` : r.title, type: r.typeLabel, difficulty: r.difficulty, minutes: r.minutes, track: r.trackShort }));
---
<Base title="Daily problem" description="One graded problem a day, the same for everyone on the same date." active="daily">
  <div class="wrap page narrow">
    <h1>Daily problem</h1>
    <p class="muted">One problem a day, picked from the date, so everyone sees the same one. It is always a graded type short enough for one sitting ({typeList}), and solving any graded problem keeps your streak going.</p>

    {today ? (
      <div class="card" style="border-color: var(--ink); margin: 20px 0">
        <div class="row" style="justify-content: space-between">
          <span class="label" data-label>Today's problem</span>
          <span class:list={['tag', today.difficulty]} data-diff>{DIFF_LABEL[today.difficulty]}</span>
        </div>
        <h2 style="font-size: 24px; margin: 8px 0" data-title>{today.subtitle ? `${today.title}: ${today.subtitle}` : today.title}</h2>
        <p class="tiny" data-meta>{today.trackShort} · {today.typeLabel} · {today.minutes} min</p>
        <div class="row" style="margin-top: 12px">
          <a class="btn primary" href={problemUrl(today.id)} data-link>Open today's problem</a>
          <span class="tiny" data-status></span>
        </div>
      </div>
    ) : (
      <p class="notice">The bank has no graded problems, so there is no daily problem.</p>
    )}

    <p class="tiny">The pick changes at midnight in your time zone. It is drawn from the {pool.length} graded {pool.length === 1 ? 'problem' : 'problems'} in the bank, so the same problem can come up again.</p>

    <h2 style="margin-top: 32px">The last 30 days</h2>
    <ul class="itemlist" data-archive></ul>
    <noscript><p class="muted">The archive is computed in your browser from your local date. Turn on JavaScript to see it.</p></noscript>
  </div>
  <JsonData id="daily-pool" data={entries} />
</Base>

<script>
  import { onProgress, type Progress } from '../lib/progress.ts';
  import { dailyFor, archive, formatDate, type DailyEntry } from '../lib/daily.ts';
  import { localDate } from '../lib/schedule.ts';
  import { readJson, h } from '../lib/dom.ts';

  const pool = readJson<DailyEntry[]>('daily-pool', []);
  const DIFF: Record<string, string> = { easy: 'Easy', medium: 'Medium', hard: 'Hard' };
  const today = localDate();
  const $ = (s: string) => document.querySelector<HTMLElement>(s);
  const pick = dailyFor(today, pool);
  const status = (p: Progress, id: string) => {
    const it = p.items[`problem:${id}`];
    return it?.s === 'done' ? 'Solved' : it ? 'Attempted' : 'Not tried';
  };

  if (pick) {
    $('[data-label]')!.textContent = `Today's problem, ${formatDate(today)}`;
    $('[data-title]')!.textContent = pick.title;
    $('[data-meta]')!.textContent = `${pick.track} · ${pick.type} · ${pick.minutes} min`;
    $('[data-link]')!.setAttribute('href', `/problems/${pick.id}`);
    const diff = $('[data-diff]')!;
    diff.className = `tag ${pick.difficulty}`;
    diff.textContent = DIFF[pick.difficulty] ?? pick.difficulty;
  }

  onProgress((p) => {
    if (pick) $('[data-status]')!.textContent = status(p, pick.id);
    const list = $('[data-archive]');
    if (!list) return;
    list.replaceChildren(
      ...archive(today, pool, 30).map(({ date, problem }) =>
        h('li', {},
          h('div', {}, h('span', { class: 'label' }, formatDate(date)), h('div', {}, h('a', { href: `/problems/${problem.id}` }, problem.title))),
          h('div', { class: 'tags' }, h('span', { class: 'type' }, problem.type), h('span', { class: `tag ${problem.difficulty}` }, DIFF[problem.difficulty] ?? problem.difficulty), h('span', { class: 'tag' }, status(p, problem.id))),
        ),
      ),
    );
  });
</script>
