---
// One page per problem: /problems/<id>.
import { render } from 'astro:content';
import ProblemLayout from '../../layouts/Problem.astro';
import { problems } from '../../lib/content.ts';

export async function getStaticPaths() {
  const all = await problems();
  return all.map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<ProblemLayout entry={entry}>
  <Content />
</ProblemLayout>
