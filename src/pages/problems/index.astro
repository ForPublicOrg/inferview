---
// Problem catalog: rows rendered at build time, filtered in the browser by track, type, difficulty, seniority,
// company, status, list and search text. Status comes from the progress store.
import Base from '../../layouts/Base.astro';
import JsonData from '../../components/JsonData.astro';
import { TRACKS } from '../../data/tracks.ts';
import { PROBLEM_TYPES, DIFFICULTIES, SENIORITIES } from '../../lib/schemas.ts';
import { problems, problemUrl, toRow, DIFF_LABEL } from '../../lib/content.ts';
import { dailyFor } from '../../lib/daily.ts';
import { localDate } from '../../lib/schedule.ts';

const rows = (await problems()).map(toRow);
const pool = rows.filter((r) => r.gradable);
const today = dailyFor(localDate(), pool);
const core = rows.filter((r) => r.core);
const companies = [...new Set(rows.flatMap((r) => r.companies.map((c) => c.name)))].sort();
const count = (pred: (r: (typeof rows)[number]) => boolean) => rows.filter(pred).length;
const groups = [
  { key: 'track', legend: 'Track', items: TRACKS.map((t) => ({ v: t.slug, label: t.short, n: count((r) => r.track === t.slug) })) },
  { key: 'type', legend: 'Type', items: PROBLEM_TYPES.map((t) => ({ v: t, label: t, n: count((r) => r.type === t) })) },
  { key: 'difficulty', legend: 'Difficulty', items: DIFFICULTIES.map((d) => ({ v: d, label: DIFF_LABEL[d] ?? d, n: count((r) => r.difficulty === d) })) },
  { key: 'seniority', legend: 'Seniority', items: SENIORITIES.map((s) => ({ v: s, label: s, n: count((r) => r.seniority.includes(s)) })) },
];
const search = (r: (typeof rows)[number]) => [r.title, r.subtitle, r.trackShort, r.moduleTitle, r.type, ...r.tags, ...r.companies.map((c) => c.name)].join(' ').toLowerCase();
---
<Base title="Problems" description="Every Inferview problem, filterable by track, type, difficulty and seniority." active="problems">
  <div class="wrap">
    <h1>Problems</h1>
    <div class="top">
      <div class="card" style="border-color: var(--ink)">
        <div class="label">Today's problem</div>
        {today ? (
          <>
            <b style="display: block; margin: 4px 0" data-today-title>{today.title}</b>
            <div class="row" style="justify-content: space-between">
              <span class="tiny" data-today-meta>{DIFF_LABEL[today.difficulty]} · {today.type} · {today.minutes} min</span>
              <a class="btn sm primary" href={problemUrl(today.id)} data-today-link>Open</a>
            </div>
          </>
        ) : <p class="tiny">No graded problems yet.</p>}
      </div>
      <div class="card">
        <div class="label">Review deck</div>
        <b class="big"><span data-due>0</span> <span class="tiny" style="font-weight: 500">cards due</span></b>
        <a class="tiny" href="/review">Open the review list</a>
      </div>
      <div class="card">
        <div class="label">Core 100</div>
        <b class="big"><span data-core-done>0</span> <span class="tiny" style="font-weight: 500">of {core.length} written</span></b>
        <div class="progress" style="margin: 6px 0" aria-hidden="true"><i data-core-bar style="width: 0%"></i></div>
        <span class="tiny" data-core-next></span>
      </div>
    </div>

    <div class="catalog-layout">
      <aside class="filters" aria-label="Filters">
        {groups.map((g) => (
          <div class="card">
            <fieldset>
              <legend>{g.legend}</legend>
              {g.items.map((it) => (
                <button type="button" class="chip" data-k={g.key} data-v={it.v} aria-pressed="false">{it.label} <span class="c">{it.n}</span></button>
              ))}
            </fieldset>
          </div>
        ))}
        <div class="card">
          <fieldset>
            <legend>Company</legend>
            {companies.length ? companies.map((c) => (
              <button type="button" class="chip" data-k="company" data-v={c} aria-pressed="false">{c} <span class="c">{count((r) => r.companies.some((x) => x.name === c))}</span></button>
            )) : <p class="tiny" style="margin: 0">No company tags yet. A tag needs a public source that names the company and the topic.</p>}
          </fieldset>
        </div>
        <div class="card">
          <fieldset>
            <legend>Status</legend>
            {['Unsolved', 'Attempted', 'Solved'].map((s) => (
              <button type="button" class="chip" data-k="status" data-v={s} aria-pressed="false">{s} <span class="c" data-status-count={s}></span></button>
            ))}
          </fieldset>
        </div>
      </aside>

      <section>
        <div class="list-sel" role="group" aria-label="List">
          <button class="chip" type="button" data-list="all" aria-pressed="true">All problems <span class="c">{rows.length}</span></button>
          <button class="chip" type="button" data-list="core" aria-pressed="false">Core 100 <span class="c">{core.length}</span></button>
        </div>
        <div class="search">
          <label class="sr-only" for="q">Search problems</label>
          <input id="q" type="search" placeholder="Search: KV cache, recall@k, prompt injection" autocomplete="off" />
        </div>
        <div class="card" style="padding: 0; overflow: hidden">
          <div class="tablewrap">
            <table class="catalog">
              <thead><tr><th style="width: 36px"><span class="sr-only">Status</span></th><th>Problem</th><th>Type</th><th>Difficulty</th><th class="hide-sm">Companies</th></tr></thead>
              <tbody>
                {rows.map((r) => (
                  <tr data-row data-id={r.id} data-track={r.track} data-type={r.type} data-difficulty={r.difficulty} data-seniority={r.seniority.join(' ')} data-company={r.companies.map((c) => c.name).join('|')} data-core={r.core ? '1' : '0'} data-search={search(r)}>
                    <td><span class="st" data-st title="unsolved"><span class="sr-only" data-st-text>unsolved</span></span></td>
                    <td class="t">
                      <a href={problemUrl(r.id)}>{r.title}</a>
                      <span class="sub">{r.subtitle && `${r.subtitle} · `}{r.trackShort} · {r.minutes} min · {r.seniority.join(', ')}{r.core && ' · Core 100'}</span>
                    </td>
                    <td><span class="type">{r.type}</span></td>
                    <td><span class:list={['tag', r.difficulty]}>{DIFF_LABEL[r.difficulty]}</span></td>
                    <td class="cos hide-sm">{r.companies.length ? r.companies.map((c) => <a href={c.url} rel="noopener">{c.name}</a>) : <span class="tiny">none</span>}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="empty" data-empty hidden>Nothing matches. Loosen a filter.</div>
        </div>
        <p class="tiny" style="margin-top: 12px">Showing <b data-count>{rows.length}</b> of {rows.length}. Company tags link to the public source that names the company and the topic.</p>
      </section>
    </div>
  </div>
  <JsonData id="catalog-data" data={{ pool: pool.map((r) => ({ id: r.id, title: r.title, type: r.type, difficulty: r.difficulty, minutes: r.minutes })), core: core.map((r) => ({ id: r.id, title: r.title })) }} />
</Base>

<script>
  import { onProgress, dueKeys, type Progress } from '../../lib/progress.ts';
  import { dailyFor } from '../../lib/daily.ts';
  import { localDate } from '../../lib/schedule.ts';
  import { readJson } from '../../lib/dom.ts';

  type Entry = { id: string; title: string; type: string; difficulty: string; minutes: number };
  const data = readJson<{ pool: Entry[]; core: { id: string; title: string }[] }>('catalog-data', { pool: [], core: [] });
  const DIFF: Record<string, string> = { easy: 'Easy', medium: 'Medium', hard: 'Hard' };
  const $ = (s: string) => document.querySelector<HTMLElement>(s);

  const pick = dailyFor(localDate(), data.pool);
  if (pick) {
    $('[data-today-title]')!.textContent = pick.title;
    $('[data-today-meta]')!.textContent = `${DIFF[pick.difficulty]} · ${pick.type} · ${pick.minutes} min`;
    $('[data-today-link]')!.setAttribute('href', `/problems/${pick.id}`);
  }

  const rows = [...document.querySelectorAll<HTMLTableRowElement>('tr[data-row]')];
  const sel: Record<string, Set<string>> = { track: new Set(), type: new Set(), difficulty: new Set(), seniority: new Set(), company: new Set(), status: new Set() };
  let list: 'all' | 'core' = 'all';
  let progress: Progress | null = null;
  const q = document.querySelector<HTMLInputElement>('#q');

  const statusOf = (id: string): 'Unsolved' | 'Attempted' | 'Solved' => {
    const it = progress?.items[`problem:${id}`];
    return it?.s === 'done' ? 'Solved' : it ? 'Attempted' : 'Unsolved';
  };

  function render() {
    const text = (q?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const tr of rows) {
      const d = tr.dataset;
      const ok =
        (list === 'all' || d.core === '1') &&
        (!sel.track!.size || sel.track!.has(d.track ?? '')) &&
        (!sel.type!.size || sel.type!.has(d.type ?? '')) &&
        (!sel.difficulty!.size || sel.difficulty!.has(d.difficulty ?? '')) &&
        (!sel.seniority!.size || (d.seniority ?? '').split(' ').some((s) => sel.seniority!.has(s))) &&
        (!sel.company!.size || (d.company ?? '').split('|').some((c) => sel.company!.has(c))) &&
        (!sel.status!.size || sel.status!.has(statusOf(d.id ?? ''))) &&
        (!text || (d.search ?? '').includes(text));
      tr.hidden = !ok;
      if (ok) shown++;
    }
    $('[data-count]')!.textContent = String(shown);
    $('[data-empty]')!.hidden = shown > 0;
  }

  document.querySelectorAll<HTMLButtonElement>('.chip[data-k]').forEach((c) =>
    c.addEventListener('click', () => {
      const set = sel[c.dataset.k ?? ''];
      const v = c.dataset.v ?? '';
      if (!set) return;
      if (set.has(v)) set.delete(v);
      else set.add(v);
      c.setAttribute('aria-pressed', String(set.has(v)));
      render();
    }),
  );
  const listChips = [...document.querySelectorAll<HTMLButtonElement>('[data-list]')];
  listChips.forEach((c) =>
    c.addEventListener('click', () => {
      list = c.dataset.list === 'core' ? 'core' : 'all';
      listChips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
      render();
    }),
  );
  q?.addEventListener('input', render);

  // Deep links such as /problems?track=agents or ?list=core preselect a filter.
  const params = new URLSearchParams(location.search);
  for (const key of Object.keys(sel)) {
    for (const v of params.getAll(key)) {
      const chip = document.querySelector<HTMLButtonElement>(`.chip[data-k="${key}"][data-v="${CSS.escape(v)}"]`);
      if (chip) chip.click();
    }
  }
  if (params.get('list') === 'core') listChips.find((c) => c.dataset.list === 'core')?.click();

  onProgress((p) => {
    progress = p;
    const counts = { Unsolved: 0, Attempted: 0, Solved: 0 };
    for (const tr of rows) {
      const s = statusOf(tr.dataset.id ?? '');
      counts[s]++;
      const st = tr.querySelector<HTMLElement>('[data-st]')!;
      st.className = `st${s === 'Solved' ? ' done' : s === 'Attempted' ? ' try' : ''}`;
      st.title = s.toLowerCase();
      tr.querySelector('[data-st-text]')!.textContent = s.toLowerCase();
    }
    for (const [k, n] of Object.entries(counts)) {
      const el = document.querySelector<HTMLElement>(`[data-status-count="${k}"]`);
      if (el) el.textContent = String(n);
    }
    $('[data-due]')!.textContent = String(dueKeys(p).length);
    const done = data.core.filter((c) => p.items[`problem:${c.id}`]?.s === 'done');
    $('[data-core-done]')!.textContent = String(done.length);
    $('[data-core-bar]')!.style.width = `${data.core.length ? (done.length / data.core.length) * 100 : 0}%`;
    const next = data.core.find((c) => p.items[`problem:${c.id}`]?.s !== 'done');
    const nextEl = $('[data-core-next]')!;
    nextEl.replaceChildren();
    if (next) {
      const a = document.createElement('a');
      a.href = `/problems/${next.id}`;
      a.textContent = next.title;
      nextEl.append('Next up: ', a);
    } else if (data.core.length) nextEl.textContent = 'Every written Core 100 problem is solved.';
    render();
  });
</script>
