---
// One lab: /labs/<lab-slug>. The intro comes from the MDX body, then the LabRunner with the steps from frontmatter.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LabRunner from '../../components/LabRunner.astro';
import { TRACKS, trackIndex } from '../../data/tracks.ts';
import { labs, moduleLessons, lessonUrl, moduleUrl, trackUrl, formatDay, plural } from '../../lib/content.ts';

export async function getStaticPaths() {
  return (await labs()).map((entry) => ({ params: { lab: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const tIdx = trackIndex(d.track);
const track = TRACKS[tIdx]!;
const mIdx = track.modules.findIndex((m) => m.slug === d.module);
const mod = track.modules[mIdx]!;
const related = await moduleLessons(d.track, d.module);
---
<Base title={d.title} description={d.summary} active="learn">
  <div class="wrap page narrow">
    <div class="crumb"><a href="/labs">Labs</a> / <a href={trackUrl(track.slug)}>Track {tIdx + 1}, {track.short}</a> / <a href={moduleUrl(track.slug, mod.slug)}>{mod.title}</a></div>
    <h1>{d.title}</h1>
    <p class="lede serif">{d.summary}</p>
    <div class="meta-tags">
      <span class="tag">{plural(d.steps.length, d.kind === 'multistage' ? 'stage' : 'step')}</span>
      <span class="tag">About {d.minutes} min</span>
      <span class="tag">Checked against sources {formatDay(d.updated)}</span>
    </div>
    <div class="prose" data-pagefind-body>
      <Content />
      {related.length > 0 && (
        <p>Lessons for this module: {related.map((l, i) => <>{i > 0 && ', '}<a href={lessonUrl(l)}>{l.data.title}</a></>)}.</p>
      )}
    </div>

    <LabRunner slug={entry.id} steps={d.steps} kind={d.kind} />

    <h2 id="sources">Sources</h2>
    <ol class="sources">
      {d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a>{s.note && <span>. {s.note}</span>}</li>)}
    </ol>
  </div>
</Base>
