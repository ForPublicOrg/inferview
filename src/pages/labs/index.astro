---
// Lab list: every lab with its track, module, step count and the reader's step reached.
import Base from '../../layouts/Base.astro';
import { getTrack, getModule } from '../../data/tracks.ts';
import { labs, labUrl, moduleUrl, plural } from '../../lib/content.ts';

const all = await labs();
---
<Base title="Labs" description="Progressive builds: one program grown over several steps, with tests that run in your browser." active="learn">
  <div class="wrap page narrow">
    <h1>Labs</h1>
    <p class="muted">A lab grows one program over several steps. Each step adds a few functions and has tests that run in your browser; passing them unlocks the next step and counts toward your streak. Your code is saved with your progress.</p>
    {all.length ? (
      <ul class="itemlist" style="margin-top: 20px">
        {all.map((lab) => (
          <li>
            <div>
              <a href={labUrl(lab.id)}><b>{lab.data.title}</b></a>
              <div class="tiny">{lab.data.summary}</div>
              <div class="tiny">
                {getTrack(lab.data.track)?.short}, <a href={moduleUrl(lab.data.track, lab.data.module)}>{getModule(lab.data.track, lab.data.module)?.title}</a>
              </div>
            </div>
            <div class="tags">
              <span class="tag">{plural(lab.data.steps.length, lab.data.kind === 'multistage' ? 'stage' : 'step')}</span>
              <span class="tag">{lab.data.minutes} min</span>
              <span class="tag" data-lab-state={lab.id} data-steps={lab.data.steps.length} hidden></span>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">There are no labs in this build.</p>
    )}
  </div>
</Base>

<script>
  import { onProgress } from '../../lib/progress.ts';
  const tags = [...document.querySelectorAll<HTMLElement>('[data-lab-state]')];
  onProgress((p) => {
    for (const t of tags) {
      const slug = t.dataset.labState ?? '';
      const total = Number(t.dataset.steps ?? 0);
      const passed = Array.from({ length: total }, (_, i) => p.items[`lab:${slug}/${i + 1}`]?.s === 'done').filter(Boolean).length;
      const started = Boolean(p.labs?.[slug]) || passed > 0;
      t.hidden = !started;
      t.textContent = passed === total ? 'All steps passed' : `${passed} of ${total} passed`;
    }
  });
</script>
