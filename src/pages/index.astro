---
// Landing page: pitch, today's problem with live streak and review counts, the nine tracks, and the sampling lab.
import Base from '../layouts/Base.astro';
import JsonData from '../components/JsonData.astro';
import SamplingLab from '../components/widgets/SamplingLab.astro';
import { TRACKS, MODULE_COUNT } from '../data/tracks.ts';
import { lessons, problems, lessonUrl, problemUrl, toRow, trackKeys, DIFF_LABEL } from '../lib/content.ts';
import { dailyFor } from '../lib/daily.ts';
import { localDate } from '../lib/schedule.ts';

const allLessons = await lessons();
const allProblems = await problems();
const rows = allProblems.map(toRow);
const pool = rows.filter((r) => r.gradable);
const buildDate = localDate();
const today = dailyFor(buildDate, pool);
const coreIds = rows.filter((r) => r.core).map((r) => r.id);
const keys = await trackKeys();
const firstLesson = allLessons[0];
const debugRound = rows.find((r) => r.type === 'debug');
const writtenModules = new Set(allLessons.map((l) => `${l.data.track}/${l.data.module}`));
---
<Base title="Inferview" active="learn">
  <div class="wrap">
    <section class="hero">
      <div>
        <h1>Interview prep for AI engineering, for people who already <em>ship software.</em></h1>
        <p class="sub">Free. Lessons you can poke at, problems graded in your browser with no API key, and the rounds that are hard to practise alone: evals, agent debugging, LLM system design, inference internals.</p>
        <div class="row" style="margin-top: 20px">
          {debugRound && <a class="btn primary" href={problemUrl(debugRound.id)}>Try a debug round ({debugRound.minutes} min)</a>}
          {firstLesson && <a class="btn" href={lessonUrl(firstLesson)}>Start Track 1: {firstLesson.data.title} ({firstLesson.data.minutes} min)</a>}
        </div>
        <p class="tiny" style="margin-top: 14px">
          {TRACKS.length} tracks, {MODULE_COUNT} modules. {allLessons.length} {allLessons.length === 1 ? 'lesson' : 'lessons'} and {rows.length} {rows.length === 1 ? 'problem' : 'problems'} written so far. Every problem is tagged with difficulty and seniority; a company tag appears only with a public source that names the company and the topic.
        </p>
      </div>

      <div class="card today" data-today>
        {today ? (
          <>
            <div class="row" style="justify-content: space-between">
              <span class="label" data-today-label>Today's problem</span>
              <span class:list={['tag', today.difficulty]} data-today-diff>{DIFF_LABEL[today.difficulty]}</span>
            </div>
            <h3 data-today-title>{today.title}{today.subtitle && `: ${today.subtitle}`}</h3>
            <div class="row" style="gap: 6px" data-today-tags>
              <span class="tag">{today.trackShort}</span><span class="tag">{today.type}</span><span class="tag">{today.minutes} min</span>
            </div>
            <p class="muted" style="font-size: 14.5px; margin: 10px 0 0">The same problem for everyone on the same date, always a type that is graded, so it counts toward your streak.</p>
            <div class="row" style="margin-top: 14px">
              <a class="btn primary sm" href={problemUrl(today.id)} data-today-link>Open today's problem</a>
              <a class="btn sm" href="/daily">Archive</a>
            </div>
          </>
        ) : (
          <p class="muted">No graded problems exist yet, so there is no daily problem.</p>
        )}
        <div class="stat">
          <div>
            <b data-streak>0</b><span>day streak: one graded problem a day keeps it going</span>
            <div class="streak" data-streak-days aria-hidden="true"></div>
          </div>
          <div><b data-due>0</b><span>cards due for review</span></div>
          <div>
            <b><span data-core-done>0</span> / {coreIds.length}</b><span>Core 100 problems solved, of {coreIds.length} written</span>
            <div class="progress" style="margin-top: 8px" aria-hidden="true"><i data-core-bar style="width: 0%"></i></div>
          </div>
        </div>
      </div>
    </section>

    <section class="tracks">
      <h2>Nine tracks in one order. Skip what you already know.</h2>
      <p class="muted" style="margin-bottom: 16px">Written for experienced software engineers. No calculus, no computer vision, no speech.</p>
      <div class="grid g2">
        {TRACKS.map((t, i) => (
          <a class="track" href={`/learn/${t.slug}`}>
            <div class="n">{i + 1}</div>
            <div>
              <h3>{t.title}</h3>
              <div class="mods">{t.modules.map((m) => m.title).join(' · ')}</div>
            </div>
            <div class="meta">
              {t.modules.length} modules, {t.modules.filter((m) => writtenModules.has(`${t.slug}/${m.slug}`)).length} written
              <div class="progress"><i data-track-bar={t.slug} style="width: 0%"></i></div>
              <span data-track-label={t.slug}>0% done</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="why">
      <div>
        <h2>What the site does differently</h2>
        <p class="muted">The reading material for AI engineering already exists and much of it is excellent. What is missing is practice that grades you, in an order, with a reason to return tomorrow. That is the whole product.</p>
      </div>
      <dl>
        <dt>Predict before you see the answer</dt><dd>Widgets ask for your guess first. That is the moment an interview tests, rehearsed on every page.</dd>
        <dt>Graded in your browser</dt><dd>Python runs in Pyodide against tests. Agent debugging runs on recorded traces. No API key, and no account unless you want sync.</dd>
        <dt>Questions come back on a schedule</dt><dd>Each question you rate becomes a review card, due again in 1, 3, 7 or 21 days depending on the rating. The daily problem is picked from the date, so everyone gets the same one.</dd>
        <dt>Answers at three depths</dt><dd>The 30-second conclusion, the 3-minute version with trade-offs, then the follow-ups interviewers ask: how do you verify it, how does it fail, what is the alternative.</dd>
        <dt>Company tags need a source</dt><dd>A company appears on a problem only with a public link that names the company and the topic. No tag beats an invented one.</dd>
      </dl>
    </section>

    <section class="teaser">
      <div>
        <h2>Temperature is a knob on a histogram</h2>
        <p class="muted">The model does not pick a word. It outputs a probability for every token in the vocabulary, and the sampling settings decide how to draw from that table. Drag temperature and watch the distribution flatten or spike. Lower top-p and watch tokens drop out of the draw. It runs on fixed example logits.</p>
      </div>
      <SamplingLab inline />
    </section>

    <section style="padding: 24px 0">
      <h2>Named lists, so "done" has a shape</h2>
      <ul class="lists muted">
        <li><b>Core 100.</b> The problems marked core across all nine tracks, the default path. {coreIds.length} written so far.</li>
        <li><b>Crunch path.</b> A short subset for a loop that starts within a week. A placeholder until the bank fills in.</li>
      </ul>
      <p><a href="/lists">See both lists</a></p>
    </section>
  </div>

  <JsonData id="landing-data" data={{ pool: pool.map((r) => ({ id: r.id, title: r.subtitle ? `${r.title}: ${r.subtitle}` : r.title, difficulty: r.difficulty, type: r.type, minutes: r.minutes, track: r.trackShort })), coreIds, keys }} />
</Base>

<script>
  import { onProgress, currentStreak, dueKeys } from '../lib/progress.ts';
  import { dailyFor, formatDate } from '../lib/daily.ts';
  import { localDate, addDays } from '../lib/schedule.ts';
  import { readJson } from '../lib/dom.ts';

  type Entry = { id: string; title: string; difficulty: string; type: string; minutes: number; track: string };
  const data = readJson<{ pool: Entry[]; coreIds: string[]; keys: Record<string, string[]> }>('landing-data', { pool: [], coreIds: [], keys: {} });
  const DIFF: Record<string, string> = { easy: 'Easy', medium: 'Medium', hard: 'Hard' };
  const today = localDate();
  const $ = (sel: string) => document.querySelector<HTMLElement>(sel);

  const pick = dailyFor(today, data.pool);
  if (pick) {
    $('[data-today-label]')!.textContent = `Today's problem, ${formatDate(today)}`;
    $('[data-today-title]')!.textContent = pick.title;
    const diff = $('[data-today-diff]')!;
    diff.className = `tag ${pick.difficulty}`;
    diff.textContent = DIFF[pick.difficulty] ?? pick.difficulty;
    const tags = $('[data-today-tags]')!;
    tags.replaceChildren(
      ...[pick.track, pick.type, `${pick.minutes} min`].map((t) => {
        const s = document.createElement('span');
        s.className = 'tag';
        s.textContent = t;
        return s;
      }),
    );
    $('[data-today-link]')!.setAttribute('href', `/problems/${pick.id}`);
  }

  onProgress((p) => {
    const streak = currentStreak(p, today);
    $('[data-streak]')!.textContent = String(streak);
    const days = $('[data-streak-days]')!;
    days.replaceChildren();
    for (let i = 13; i >= 0; i--) {
      const d = addDays(today, -i);
      const hit = streak > 0 && d <= p.streak.last && d > addDays(p.streak.last, -streak);
      const dot = document.createElement('i');
      if (hit) dot.className = d === today ? 'today' : 'hit';
      days.append(dot);
    }
    $('[data-due]')!.textContent = String(dueKeys(p, today).length);
    const coreDone = data.coreIds.filter((id) => p.items[`problem:${id}`]?.s === 'done').length;
    $('[data-core-done]')!.textContent = String(coreDone);
    $('[data-core-bar]')!.style.width = `${data.coreIds.length ? (coreDone / data.coreIds.length) * 100 : 0}%`;
    for (const [slug, keys] of Object.entries(data.keys)) {
      const done = keys.filter((k) => p.items[k]?.s === 'done').length;
      const pct = keys.length ? Math.round((done / keys.length) * 100) : 0;
      const bar = document.querySelector<HTMLElement>(`[data-track-bar="${slug}"]`);
      const label = document.querySelector<HTMLElement>(`[data-track-label="${slug}"]`);
      if (bar) bar.style.width = `${pct}%`;
      if (label) label.textContent = keys.length ? `${pct}% of written items done` : 'nothing written yet';
    }
  });
</script>
