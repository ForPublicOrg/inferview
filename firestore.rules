rules_version = '2';

// One document per user at users/{uid}, readable and writable only by that signed-in user.
// Writes must have exactly the progress shape from SPEC section 8; every other path is denied.
// Rules cannot iterate over map values, so items are bounded by count here and validated per item by the client.
// Labs and multistage problems (key "problem:<id>") are checked per known key to cap code at 20,000 characters;
// npm run validate fails if labSlugs() misses a lab or a multistage problem.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validStreak(s) {
      return s is map
        && s.keys().hasAll(['count', 'last'])
        && s.keys().hasOnly(['count', 'last'])
        && s.count is int && s.count >= 0 && s.count <= 100000
        && s.last is string
        && (s.last == '' || s.last.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function labSlugs() {
      return [
        'ai-assisted-rate-limiter',
        'attention-block',
        'autograd',
        'batch-extraction',
        'bpe-tokenizer',
        'continuous-batching',
        'egress-policy',
        'embedding-training',
        'error-analysis',
        'eval-data-pipeline',
        'eval-harness',
        'grpo-toy',
        'harness-eval-runner',
        'hnsw',
        'integration-round',
        'long-context-probes',
        'minhash-dedup',
        'mini-agent-harness',
        'notebook-reconciliation',
        'permission-gate',
        'pickle-scanner',
        'pipeline-schedule',
        'preference-learning',
        'progressive-db',
        'prompt-optimiser',
        'rag-pipeline',
        'release-gate',
        'repo-bug-squash',
        'ring-allreduce',
        'sampler',
        'secure-tool-gateway',
        'training-memory-planner',
        'voice-turn',
        'workflow-engine',
        'problem:inf-033',
        'problem:rnd-023',
        'problem:rnd-024',
        'problem:rnd-025',
        'problem:rnd-026',
        'problem:rnd-027',
      ];
    }

    function validLab(l) {
      return l is map
        && l.keys().hasAll(['step', 'code', 'at'])
        && l.keys().hasOnly(['step', 'code', 'at'])
        && l.step is int && l.step >= 1 && l.step <= 10
        && l.code is string && l.code.size() <= 20000
        && (l.at is int || l.at is float) && l.at >= 0;
    }

    function validLabs(m) {
      return m is map
        && m.keys().hasOnly(labSlugs())
        && (!('ai-assisted-rate-limiter' in m) || validLab(m['ai-assisted-rate-limiter']))
        && (!('attention-block' in m) || validLab(m['attention-block']))
        && (!('autograd' in m) || validLab(m['autograd']))
        && (!('batch-extraction' in m) || validLab(m['batch-extraction']))
        && (!('bpe-tokenizer' in m) || validLab(m['bpe-tokenizer']))
        && (!('continuous-batching' in m) || validLab(m['continuous-batching']))
        && (!('egress-policy' in m) || validLab(m['egress-policy']))
        && (!('embedding-training' in m) || validLab(m['embedding-training']))
        && (!('error-analysis' in m) || validLab(m['error-analysis']))
        && (!('eval-data-pipeline' in m) || validLab(m['eval-data-pipeline']))
        && (!('eval-harness' in m) || validLab(m['eval-harness']))
        && (!('grpo-toy' in m) || validLab(m['grpo-toy']))
        && (!('harness-eval-runner' in m) || validLab(m['harness-eval-runner']))
        && (!('hnsw' in m) || validLab(m['hnsw']))
        && (!('integration-round' in m) || validLab(m['integration-round']))
        && (!('long-context-probes' in m) || validLab(m['long-context-probes']))
        && (!('minhash-dedup' in m) || validLab(m['minhash-dedup']))
        && (!('mini-agent-harness' in m) || validLab(m['mini-agent-harness']))
        && (!('notebook-reconciliation' in m) || validLab(m['notebook-reconciliation']))
        && (!('permission-gate' in m) || validLab(m['permission-gate']))
        && (!('pickle-scanner' in m) || validLab(m['pickle-scanner']))
        && (!('pipeline-schedule' in m) || validLab(m['pipeline-schedule']))
        && (!('preference-learning' in m) || validLab(m['preference-learning']))
        && (!('progressive-db' in m) || validLab(m['progressive-db']))
        && (!('prompt-optimiser' in m) || validLab(m['prompt-optimiser']))
        && (!('rag-pipeline' in m) || validLab(m['rag-pipeline']))
        && (!('release-gate' in m) || validLab(m['release-gate']))
        && (!('repo-bug-squash' in m) || validLab(m['repo-bug-squash']))
        && (!('ring-allreduce' in m) || validLab(m['ring-allreduce']))
        && (!('sampler' in m) || validLab(m['sampler']))
        && (!('secure-tool-gateway' in m) || validLab(m['secure-tool-gateway']))
        && (!('training-memory-planner' in m) || validLab(m['training-memory-planner']))
        && (!('voice-turn' in m) || validLab(m['voice-turn']))
        && (!('workflow-engine' in m) || validLab(m['workflow-engine']))
        && (!('problem:inf-033' in m) || validLab(m['problem:inf-033']))
        && (!('problem:rnd-023' in m) || validLab(m['problem:rnd-023']))
        && (!('problem:rnd-024' in m) || validLab(m['problem:rnd-024']))
        && (!('problem:rnd-025' in m) || validLab(m['problem:rnd-025']))
        && (!('problem:rnd-026' in m) || validLab(m['problem:rnd-026']))
        && (!('problem:rnd-027' in m) || validLab(m['problem:rnd-027']));
    }

    function validProgress(d) {
      return d.keys().hasAll(['v', 'streak', 'items'])
        && d.keys().hasOnly(['v', 'streak', 'items', 'labs'])
        && d.v == 1
        && validStreak(d.streak)
        && d.items is map
        && d.items.size() <= 5000
        && (!('labs' in d) || validLabs(d.labs));
    }

    match /users/{uid} {
      allow get, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProgress(request.resource.data);
      allow list: if false;
    }
  }
}
