rules_version = '2';

// One document per user at users/{uid}, readable and writable only by that signed-in user.
// Writes must have exactly the progress shape from SPEC section 8; every other path is denied.
// Rules cannot iterate over map values, so items are bounded by count here and validated per item by the client.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validStreak(s) {
      return s is map
        && s.keys().hasAll(['count', 'last'])
        && s.keys().hasOnly(['count', 'last'])
        && s.count is int && s.count >= 0 && s.count <= 100000
        && s.last is string
        && (s.last == '' || s.last.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validProgress(d) {
      return d.keys().hasAll(['v', 'streak', 'items'])
        && d.keys().hasOnly(['v', 'streak', 'items'])
        && d.v == 1
        && validStreak(d.streak)
        && d.items is map
        && d.items.size() <= 5000;
    }

    match /users/{uid} {
      allow get, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProgress(request.resource.data);
      allow list: if false;
    }
  }
}
