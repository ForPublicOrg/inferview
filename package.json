    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
