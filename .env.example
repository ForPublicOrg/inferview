# Firebase web config. These are public identifiers, not secrets: access is
# controlled by firestore.rules and the authorised-domain list in Firebase Auth.
# Leave them empty to run the site with progress stored in the browser only.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Not read by the site: Inferview ships no analytics.
PUBLIC_FIREBASE_MEASUREMENT_ID=
